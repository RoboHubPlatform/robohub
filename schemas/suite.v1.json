{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robohub.org/schemas/suite.v1.json",
  "title": "A suite manifest of the RoboHub ecosystem",
  "description": "What a module's tests are. A manifest may include another, which is how a project keeps its unit tests and its smoke tests in folders and says so in one place.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "include": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "command": { "type": "array", "items": { "type": "string" } },
          "build": { "type": "object" },
          "status": { "type": "string" },
          "enabled": { "type": "boolean" },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
