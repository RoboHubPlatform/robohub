module journal

// It is included by a host application. The host owns the HTTP port and the
// router; this file registers the module's routes under /journal and
// /api/journal. Its records live in the host application's database.

include "journal.rho"
include "notifications"

import std.sql
import std.web.http
import std.web.template

extern fn rho_exec(program: string, arguments: string, output_path: string) u32
// The clock and a program's output, from the runtime rather than through a file.
extern fn rho_now_s() u32
extern fn rho_utc_offset_at(epoch: i64) i64
extern fn rho_read_text(path: string) string

route GET  "/journal"              => journal_page
route POST "/journal/resolve"      => journal_resolve_form
route GET  "/api/journal"          => journal_api
