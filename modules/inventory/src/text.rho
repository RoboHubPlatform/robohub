module inventory

// The small form helpers the pages need. They are the same shapes the keeper
// uses; a module carries them so it does not depend on an application's source.

fn trim(text: string) string {
    var out: string = text
    while strlen(out) > 0 && str_eq(str_slice(out, 0, 1), " ") {
        out = str_slice(out, 1, u32(strlen(out)) - 1)
    }
    while strlen(out) > 0 &&
        str_eq(str_slice(out, u32(strlen(out)) - 1, 1), " ") {
        out = str_slice(out, 0, u32(strlen(out)) - 1)
    }
    return out
}

fn url_decode(value: string) string {
    var out: string = ""
    var i: u32 = 0
    let length: u32 = u32(strlen(value))
    while i < length {
        let ch: string = str_slice(value, i, 1)
        if str_eq(ch, "+") {
            out = out + " "
            i = i + 1
        } else if str_eq(ch, "%") && i + 2 < length {
            let high: u32 = decode_hex(str_slice(value, i + 1, 1))
            let low: u32 = decode_hex(str_slice(value, i + 2, 1))
            out = out + str_from_byte(u8(high * 16 + low))
            i = i + 3
        } else {
            out = out + ch
            i = i + 1
        }
    }
    return out
}

fn form_value(body: string, name: string) string {
    var rest: string = body + "&"
    while strlen(rest) > 0 {
        let amp: i32 = str_index_of(rest, "&")
        if amp < 0 {
            break
        }
        let pair: string = str_slice(rest, 0, u32(amp))
        rest = str_slice(rest, u32(amp) + 1, u32(strlen(rest)) - u32(amp) - 1)
        let equals: i32 = str_index_of(pair, "=")
        if equals < 0 {
            continue
        }
        let key: string = url_decode(str_slice(pair, 0, u32(equals)))
        if str_eq(key, name) {
            return url_decode(str_slice(pair, u32(equals) + 1,
                u32(strlen(pair)) - u32(equals) - 1))
        }
    }
    return ""
}

fn decode_hex(ch: string) u32 {
    if strlen(ch) == 0 {
        return 0
    }
    let digits: string = "0123456789abcdef"
    let lower: string = "0123456789abcdef"
    var i: u32 = 0
    while i < 16 {
        if str_eq(ch, str_slice(lower, i, 1)) {
            return i
        }
        i = i + 1
    }
    let upper: string = "0123456789ABCDEF"
    i = 0
    while i < 16 {
        if str_eq(ch, str_slice(upper, i, 1)) {
            return i
        }
        i = i + 1
    }
    return 0
}
