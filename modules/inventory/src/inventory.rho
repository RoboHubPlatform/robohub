module inventory

import rho.log

// The inventory and expense tracker's pages and the statements behind them.
//
// Stock and money are integers: quantity in thousandths, money in cents. The
// decimal point appears only in the formatting helpers. A purchase is recorded
// twice on purpose — once as spending, once as stock arriving — and both are
// linked to the item it belongs to.

import std.core.ptr
import std.core.result
import std.core.slice
import std.sql
import std.web.http
import std.web.template

// A module's own files, embedded in the program that includes it.
extern fn rho_asset(module: string, path: string) string

const INVENTORY_ITEM_CAPACITY: u32 = 512
const INVENTORY_EXPENSES_CAPACITY: u32 = 512
const INVENTORY_CATEGORY_CAPACITY: u32 = 64
const INVENTORY_LOW_STOCK_CAPACITY: u32 = 128

/* -------------------------------------------------------------------------- */
/*  Where the database and its schema are                                     */
/* -------------------------------------------------------------------------- */

fn inventory_workspace() string {
    let workspace: string = app_workspace()
    return workspace
}

fn inventory_template(name: string) string {
    return rho_asset("inventory", "templates/" + name + ".html")
}

fn inventory_db_path() string {
    let override: string = getenv("RHO_INVENTORY_DB")
    if override != "" {
        return override
    }
    // The records belong to the application that consumes the module, not to
    // the module folder. Two applications using the same module therefore get
    // two databases, and a module update never moves one out from under the
    // other.
    let dir: string = inventory_workspace() + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    return dir + "/app.db"
}

fn inventory_schema() string {
    return rho_asset("inventory", "db/schema.sql")
}

fn inventory_host_config(key: string) string {
    let manifest: string = getenv("ROBOHUB_APP_MANIFEST")
    if manifest == "" {
        return ""
    }
    let text: string = rho_read_text(manifest)
    let marker: string = "\napp_modules:\n"
    let start: i32 = str_index_of(text, marker)
    if start < 0 {
        return ""
    }
    var i: u32 = u32(start) + u32(strlen(marker))
    var mine: bool = false
    var in_config: bool = false
    var config_indent: u32 = 0
    while i < u32(strlen(text)) {
        let at: i32 = str_index_of(
            str_slice(text, i, u32(strlen(text)) - i), "\n")
        let end: u32 = u32(strlen(text))
        if at >= 0 {
            end = i + u32(at)
        }
        let line: string = str_slice(text, i, end - i)
        let trimmed: string = str_trim(line)
        if strlen(trimmed) == 0 {
            i = end + 1
            continue
        }
        if inventory_indent(line) == 0 && !str_eq(trimmed, "app_modules:") {
            break
        }
        if str_index_of(trimmed, "- name:") == 0 {
            let name: string = inventory_unquote(str_slice(trimmed, 7,
                u32(strlen(trimmed)) - 7))
            mine = str_eq(name, "inventory")
            in_config = false
        } else if mine && str_index_of(trimmed, "config:") == 0 {
            in_config = true
            config_indent = inventory_indent(line)
        } else if mine && in_config && inventory_indent(line) > config_indent {
            let colon: i32 = str_index_of(trimmed, ":")
            if colon > 0 && str_eq(inventory_unquote(str_slice(trimmed, 0, u32(colon))), key) {
                return inventory_unquote(str_slice(trimmed, u32(colon) + 1,
                    u32(strlen(trimmed)) - u32(colon) - 1))
            }
        }
        i = end + 1
    }
    return ""
}

fn inventory_setting(key: string, fallback: string) string {
    // The host application owns the module's settings, so two applications
    // including this module can give it different values. Nothing is read from
    // beside the module itself. Older hosts kept a module config block; it is
    // still read after the settings store so an upgrade keeps working.
    let from_settings: string = settings_get("inventory." + key, "")
    if from_settings != "" {
        return from_settings
    }
    let from_host: string = inventory_host_config(key)
    if from_host != "" {
        return from_host
    }
    return fallback
}

fn inventory_unquote(text: string) string {
    let value: string = str_trim(text)
    if strlen(value) >= 2 {
        let first: string = str_slice(value, 0, 1)
        let last: string = str_slice(value, u32(strlen(value)) - 1, 1)
        if (str_eq(first, "\"") || str_eq(first, "'")) &&
            str_eq(first, last) {
            return str_slice(value, 1, u32(strlen(value)) - 2)
        }
    }
    return value
}

fn inventory_indent(line: string) u32 {
    var count: u32 = 0
    while count < u32(strlen(line)) &&
        str_eq(str_slice(line, count, 1), " ") {
        count = count + 1
    }
    return count
}

fn inventory_date() string {
    return rho_local_date()
}

/* -------------------------------------------------------------------------- */
/*  Formatting and parsing                                                    */
/* -------------------------------------------------------------------------- */

fn inventory_ignore(value: Result[u32, SqlError]) void {
}

fn inventory_money(cents: i64) string {
    var value: i64 = cents
    var sign: string = ""
    if value < 0 {
        sign = "-"
        value = -value
    }
    let whole: u32 = u32(value / 100)
    let fraction: u32 = u32(value % 100)
    var frac: string = int_to_str(fraction)
    if fraction < 10 {
        frac = "0" + frac
    }
    return sign + int_to_str(whole) + "." + frac
}

// inventory_quantity writes thousandths as a quantity: a stock taken below zero
// is shown as a negative number, not as four billion.
fn inventory_quantity(milli: i64) string {
    var value: i64 = milli
    var sign: string = ""
    if value < 0 {
        sign = "-"
        value = 0 - value
    }
    let whole: u32 = u32(value / 1000)
    let fraction: u32 = u32(value % 1000)
    if fraction == 0 {
        return sign + int_to_str(whole)
    }
    var frac: string = int_to_str(fraction)
    while strlen(frac) < 3 {
        frac = "0" + frac
    }
    while strlen(frac) > 0 &&
        str_eq(str_slice(frac, u32(strlen(frac)) - 1, 1), "0") {
        frac = str_slice(frac, 0, u32(strlen(frac)) - 1)
    }
    return sign + int_to_str(whole) + "." + frac
}

fn inventory_parse_scaled(text: string, scale: u32) u32 {
    let milli: i64 = milli_parse(text)
    if milli <= 0 {
        return 0
    }
    return u32(milli * i64(scale) / 1000)
}

/* -------------------------------------------------------------------------- */
/*  Options and lookups                                                       */
/* -------------------------------------------------------------------------- */

fn inventory_categories(categories: Categories[64], count: u32, selected: string) string {
    var out: string = "<option value=\"\">Uncategorised</option>"
    var i: u32 = 0
    while i < count {
        let id: string = int_to_str(u32(categories[i].id))
        out = out + "<option value=\"" + id + "\""
        if str_eq(id, selected) {
            out = out + " selected"
        }
        out = out + ">" + escape_html(categories[i].name) + "</option>"
        i = i + 1
    }
    return out
}

fn inventory_items(items: ListItemsRow[512], count: u32, selected: string) string {
    var out: string = "<option value=\"\">Choose an item</option>"
    var i: u32 = 0
    while i < count {
        let id: string = int_to_str(u32(items[i].id))
        out = out + "<option value=\"" + id + "\""
        if str_eq(id, selected) {
            out = out + " selected"
        }
        out = out + ">" + escape_html(items[i].name) + "</option>"
        i = i + 1
    }
    return out
}

fn inventory_category_choices(categories: Categories[64], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        if out != "" { out = out + "," }
        out = out + int_to_str(u32(categories[i].id)) + "|" + categories[i].name
        i = i + 1
    }
    return out
}

fn inventory_item_choices(items: ListItemsRow[512], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        if out != "" { out = out + "," }
        out = out + int_to_str(u32(items[i].id)) + "|" + items[i].name
        i = i + 1
    }
    return out
}

fn inventory_find_item(items: ListItemsRow[512], count: u32, id: u32) i32 {
    var i: u32 = 0
    while i < count {
        if u32(items[i].id) == id {
            return i32(i)
        }
        i = i + 1
    }
    return -1
}

fn inventory_item_rows(req: Request, items: ListItemsRow[512], count: u32,
    bindings: ListBindingsRow[512], binding_count: u32) string {
    var out: string = ""
    var i: u32 = 0
    let automated: bool = inventory_automated()
    while i < count {
        let row: ListItemsRow = items[i]
        let id: string = int_to_str(u32(row.id))
        var low: string = ""
        if row.reorderMilli > 0 && row.quantityMilli <= row.reorderMilli {
            low = "<span class=\"badge low\">reorder</span>"
        }
        var kind_badge: string = ""
        var automation_link: string = ""
        if str_eq(row.kind, "equipment") {
            kind_badge = "<span class=\"badge kind\">" + escape_html(i18n_t(req, "inventory.kind_equipment")) + "</span>"
            if automated && row.capabilities != "" {
                if inventory_connected(row, bindings, binding_count) {
                    kind_badge = kind_badge + "<span class=\"badge on\">" + escape_html(i18n_t(req, "inventory.connected")) + "</span>"
                } else {
                    kind_badge = kind_badge + "<span class=\"badge off\">" + escape_html(i18n_t(req, "inventory.not_connected")) + "</span>"
                }
                automation_link = " · <a class=\"edit\" href=\"/expenses/items/automation?id=" + id + "\">" +
                    escape_html(i18n_t(req, "inventory.automation")) + "</a>"
            }
        } else if str_eq(row.kind, "part") {
            kind_badge = "<span class=\"badge kind\">" + escape_html(i18n_t(req, "inventory.kind_part")) + "</span>"
        }
        let html: string = template_fill(inventory_template("rows/item-row"),
            vars("id", id) +
            vars("name", row.name) +
            vars("category", row.category) +
            vars("quantity", inventory_quantity(row.quantityMilli)) +
            vars("unit", row.unit) +
            vars("reorder", inventory_quantity(row.reorderMilli)) +
            vars("location", row.location) +
            vars("low", low) +
            vars("kind_badge", kind_badge) +
            vars("automation_link", automation_link) +
            vars("notes", row.notes))
        out = out + html + "\n"
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"8\">No items in the inventory yet.</td></tr>"
    }
    return out
}

fn inventory_low_rows(rows: LowStockItemsRow[128], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let row: LowStockItemsRow = rows[i]
        let html: string = template_fill(inventory_template("rows/low-row"),
            vars("name", row.name) +
            vars("on_hand", inventory_quantity(row.quantityMilli)) +
            vars("reorder_at", inventory_quantity(row.reorderMilli)) +
            vars("unit", row.unit) +
            vars("location", row.location))
        out = out + html + "\n"
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"4\">Nothing needs reordering.</td></tr>"
    }
    return out
}

fn inventory_expense_rows(rows: ListExpensesRow[512], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let row: ListExpensesRow = rows[i]
        let html: string = template_fill(inventory_template("rows/expense-row"),
            vars("id", int_to_str(u32(row.id))) +
            vars("item", row.item) +
            vars("category", row.category) +
            vars("quantity", inventory_quantity(row.quantityMilli)) +
            vars("unit_price", inventory_money(row.unitPriceCents)) +
            vars("total", inventory_money(row.totalCents)) +
            vars("source", row.source) +
            vars("date", row.purchasedAt) +
            vars("comment", row.comment))
        out = out + html + "\n"
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"9\">No purchases recorded yet.</td></tr>"
    }
    return out
}

fn inventory_kind_choices(req: Request) string {
    return "consumable|" + i18n_t(req, "inventory.kind_consumable") + ",part|" +
        i18n_t(req, "inventory.kind_part") + ",equipment|" + i18n_t(req, "inventory.kind_equipment")
}

fn inventory_kind_options(req: Request, selected: string) string {
    var out: string = ""
    var rest: string = "consumable\npart\nequipment\n"
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        let kind: string = str_slice(rest, 0, u32(at))
        rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        out = out + "<option value=\"" + kind + "\""
        if str_eq(kind, selected) {
            out = out + " selected"
        }
        out = out + ">" + escape_html(i18n_t(req, "inventory.kind_" + kind)) + "</option>"
    }
    return out
}

// inventory_kind is a kind as written, or the category's when none was chosen.
fn inventory_kind(chosen: string, category_id: string, categories: Categories[64], count: u32) string {
    let kind: string = str_trim(chosen)
    if str_eq(kind, "consumable") || str_eq(kind, "part") || str_eq(kind, "equipment") {
        return kind
    }
    var i: u32 = 0
    while i < count {
        if str_eq(int_to_str(u32(categories[i].id)), category_id) {
            return categories[i].kind
        }
        i = i + 1
    }
    return "consumable"
}

// inventory_handle is a handle as an item is named by elsewhere: lower case,
// letters, digits and dashes, a space or an underscore read as a dash.
fn inventory_handle(text: string) string {
    let lower: string = "abcdefghijklmnopqrstuvwxyz"
    let upper: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var out: string = ""
    var i: u32 = 0
    let value: string = str_trim(text)
    while i < u32(strlen(value)) {
        let ch: string = str_slice(value, i, 1)
        let up: i32 = str_index_of(upper, ch)
        if up >= 0 {
            out = out + str_slice(lower, u32(up), 1)
        } else if str_index_of(lower + "0123456789", ch) >= 0 {
            out = out + ch
        } else if (str_eq(ch, "-") || str_eq(ch, " ") || str_eq(ch, "_")) && out != "" &&
            !inventory_ends_with(out, "-") {
            out = out + "-"
        }
        i = i + 1
    }
    while inventory_ends_with(out, "-") {
        out = str_slice(out, 0, u32(strlen(out)) - 1)
    }
    return out
}

// inventory_handle_taken says whether another item than `except` has a handle.
fn inventory_handle_taken(db: SqlDb, handle: string, except: u32) bool {
    if handle == "" {
        return false
    }
    let items: ListItemsRow[512]
    let item_slice: Slice[ListItemsRow] = Slice[ListItemsRow]{ Ptr[ListItemsRow](&items[0]), INVENTORY_ITEM_CAPACITY }
    let listed: Result[u32, SqlError] = ListItems(db, item_slice, INVENTORY_ITEM_CAPACITY)
    if !listed.is_ok {
        return false
    }
    let at: i32 = inventory_find_handle(items, listed.ok, handle)
    if at < 0 {
        return false
    }
    let row: u32 = u32(at)
    return u32(items[row].id) != except
}

fn inventory_bindings(db: SqlDb, out: Slice[ListBindingsRow]) u32 {
    let bound: Result[u32, SqlError] = ListBindings(db, out, INVENTORY_BINDING_CAPACITY)
    if bound.is_ok {
        return bound.ok
    }
    return 0
}

/* -------------------------------------------------------------------------- */
/*  Queries                                                                   */
/* -------------------------------------------------------------------------- */

fn inventory_total(db: SqlDb) i64 {
    let out: TotalExpensesRow[1]
    let slice: Slice[TotalExpensesRow] = Slice[TotalExpensesRow]{
        Ptr[TotalExpensesRow](&out[0]), 1 }
    let total: Result[u32, SqlError] = TotalExpenses(db, slice, 1)
    if !total.is_ok {
        return 0
    }
    return out[0].totalCents
}

/* -------------------------------------------------------------------------- */
/*  Pages                                                                     */
/* -------------------------------------------------------------------------- */

fn inventory_docs() string {
    let text: string = rho_asset("inventory", "docs/index.md")
    if text == "" {
        return "No documentation found."
    }
    return text
}

fn inventory_category_rows(req: Request, categories: Categories[64], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let c: Categories = categories[i]
        let id: string = int_to_str(u32(c.id))
        var preset: string = ""
        var actions: string = ""
        if str_eq(c.origin, "preset") {
            preset = " <small class=\"muted\">(" + escape_html(i18n_t(req, "inventory.category_preset")) + ")</small>"
        } else {
            actions = "<form method=\"post\" action=\"/expenses/categories/rename\" class=\"inline\">" + forms_csrf_field() +
                "<input type=\"hidden\" name=\"id\" value=\"" + id + "\"><input name=\"name\" value=\"" + escape_html(c.name) +
                "\" aria-label=\"" + escape_html(i18n_t(req, "inventory.name")) + "\"><button class=\"quiet\">" +
                escape_html(i18n_t(req, "inventory.rename")) + "</button></form> " +
                "<form method=\"post\" action=\"/expenses/categories/delete\" class=\"inline\" onsubmit=\"return confirm(" +
                escape_html(json_string(i18n_t(req, "inventory.delete_category_confirm"))) + ")\">" + forms_csrf_field() +
                "<input type=\"hidden\" name=\"id\" value=\"" + id + "\"><button class=\"quiet\">" +
                escape_html(i18n_t(req, "inventory.delete")) + "</button></form>"
        }
        out = out + template_fill(inventory_template("rows/category-row"),
            vars("name", c.name) + vars("preset", preset) + vars("actions", actions)) + "\n"
        i = i + 1
    }
    if out == "" {
        out = "<tr><td>" + escape_html(i18n_t(req, "inventory.no_categories")) + "</td></tr>"
    }
    return out
}

fn inventory_count(req: Request) Response {
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return html(status_internal(), "{\"count\":0}")
    }
    let db: SqlDb = opened.ok
    sql_apply(db, inventory_schema())
    let items: ListItemsRow[512]
    let item_slice: Slice[ListItemsRow] = Slice[ListItemsRow]{
        Ptr[ListItemsRow](&items[0]), INVENTORY_ITEM_CAPACITY }
    let listed: Result[u32, SqlError] = ListItems(db, item_slice, INVENTORY_ITEM_CAPACITY)
    var n: u32 = 0
    if listed.is_ok { n = listed.ok }
    sql_close(db)
    return html(status_ok(), "{\"count\":" + int_to_str(n) + "}")
}

fn inventory_page_message(req: Request, message: string) Response {
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return html(status_internal(), "<h1>Inventory</h1><p>The database could not be opened: " +
            escape_html(opened.err) + "</p>")
    }
    let db: SqlDb = opened.ok
    sql_apply(db, inventory_schema())

    let categories: Categories[64]
    let category_slice: Slice[Categories] = Slice[Categories]{
        Ptr[Categories](&categories[0]), INVENTORY_CATEGORY_CAPACITY }
    let listed_categories: Result[u32, SqlError] = ListCategories(
        db, category_slice, INVENTORY_CATEGORY_CAPACITY)
    var category_count: u32 = 0
    if listed_categories.is_ok {
        category_count = listed_categories.ok
    }

    let items: ListItemsRow[512]
    let item_slice: Slice[ListItemsRow] = Slice[ListItemsRow]{
        Ptr[ListItemsRow](&items[0]), INVENTORY_ITEM_CAPACITY }
    let listed_items: Result[u32, SqlError] = ListItems(db, item_slice, INVENTORY_ITEM_CAPACITY)
    var item_count: u32 = 0
    if listed_items.is_ok {
        item_count = listed_items.ok
    }

    let low: LowStockItemsRow[128]
    let low_slice: Slice[LowStockItemsRow] = Slice[LowStockItemsRow]{
        Ptr[LowStockItemsRow](&low[0]), INVENTORY_LOW_STOCK_CAPACITY }
    let listed_low: Result[u32, SqlError] = LowStockItems(db, low_slice, INVENTORY_LOW_STOCK_CAPACITY)
    var low_count: u32 = 0
    if listed_low.is_ok {
        low_count = listed_low.ok
    }

    let expenses: ListExpensesRow[512]
    let expense_slice: Slice[ListExpensesRow] = Slice[ListExpensesRow]{
        Ptr[ListExpensesRow](&expenses[0]), INVENTORY_EXPENSES_CAPACITY }
    let listed_expenses: Result[u32, SqlError] = ListExpenses(
        db, expense_slice, INVENTORY_EXPENSES_CAPACITY)
    var expense_count: u32 = 0
    if listed_expenses.is_ok {
        expense_count = listed_expenses.ok
    }

    let total: i64 = inventory_total(db)
    let bindings: ListBindingsRow[512]
    let binding_count: u32 = inventory_bindings(db, Slice[ListBindingsRow]{
        Ptr[ListBindingsRow](&bindings[0]), INVENTORY_BINDING_CAPACITY })
    sql_close(db)

    let toast_js: string = ""
    if message != "" {
        toast_js = "<script>document.addEventListener(\"DOMContentLoaded\",function(){if(window.rhoToast){window.rhoToast(" +
            json_string(message) + ", \"info\");}});</script>"
    }
    var add_fields: FormField[9]
    add_fields[0] = FormField{ "name", "text", i18n_t(req, "inventory.name"), "",
        "", true, "", "", "", "", "" }
    add_fields[1] = FormField{ "category_id", "select", i18n_t(req, "inventory.category"), "",
        i18n_t(req, "inventory.uncategorised"), false, "",
        inventory_category_choices(categories, category_count), "", "", "" }
    add_fields[2] = FormField{ "unit", "text", i18n_t(req, "inventory.unit"), "",
        "unit, kg, L", false, "", "", inventory_setting("default_unit", ""), "", "" }
    add_fields[3] = FormField{ "quantity", "text", i18n_t(req, "inventory.opening_quantity"), "",
        "0", false, "", "", "0", "", "decimal" }
    add_fields[4] = FormField{ "reorder", "text", i18n_t(req, "inventory.reorder_at"), "",
        "0", false, "", "", inventory_setting("reorder", "0"), "", "decimal" }
    add_fields[5] = FormField{ "location", "text", i18n_t(req, "inventory.location"), "",
        "", false, "", "", "", "", "" }
    add_fields[6] = FormField{ "notes", "text", i18n_t(req, "inventory.notes"), "",
        "", false, "", "", "", "", "" }
    add_fields[7] = FormField{ "kind", "select", i18n_t(req, "inventory.kind"), "",
        "", false, "", inventory_kind_choices(req), "", "", "" }
    add_fields[8] = FormField{ "handle", "text", i18n_t(req, "inventory.handle"), "",
        "filter-main", false, "", "", "", "", "" }
    let add_item_form: string = forms_open(add_fields, 9, "/expenses/items/add",
        i18n_t(req, "inventory.add_item"), i18n_locale(req))

    var purchase_fields: FormField[7]
    purchase_fields[0] = FormField{ "item_id", "select", i18n_t(req, "inventory.item"), "",
        i18n_t(req, "inventory.choose_item"), true, "",
        inventory_item_choices(items, item_count), "", "", "" }
    purchase_fields[1] = FormField{ "quantity", "text", i18n_t(req, "inventory.qty"), "",
        "1", false, "", "", "1", "", "decimal" }
    purchase_fields[2] = FormField{ "unit_price", "text", i18n_t(req, "inventory.unit_price"), "",
        "0.00", true, "", "", "", "", "decimal" }
    purchase_fields[3] = FormField{ "category_id", "select", i18n_t(req, "inventory.category"), "",
        i18n_t(req, "inventory.uncategorised"), false, "",
        inventory_category_choices(categories, category_count), "", "", "" }
    purchase_fields[4] = FormField{ "source", "text", i18n_t(req, "inventory.store"), "",
        "", false, "", "", "", "", "" }
    purchase_fields[5] = FormField{ "purchased_at", "date", i18n_t(req, "inventory.date"), "",
        "", false, "", "", inventory_date(), "", "" }
    purchase_fields[6] = FormField{ "comment", "text", i18n_t(req, "inventory.comment"), "",
        "", false, "", "", "", "", "" }
    let purchase_form: string = forms_open(purchase_fields, 7, "/expenses/purchases/add",
        i18n_t(req, "inventory.record_purchase"), i18n_locale(req))

    var consume_fields: FormField[3]
    consume_fields[0] = FormField{ "item_id", "select", i18n_t(req, "inventory.item"), "",
        i18n_t(req, "inventory.choose_item"), true, "",
        inventory_item_choices(items, item_count), "", "", "" }
    consume_fields[1] = FormField{ "quantity", "text", i18n_t(req, "inventory.qty"), "",
        "", true, "", "", "", "", "decimal" }
    consume_fields[2] = FormField{ "comment", "text", i18n_t(req, "inventory.reason"), "",
        "", false, "", "", "", "", "" }
    let consume_form: string = forms_open(consume_fields, 3, "/expenses/items/consume",
        i18n_t(req, "inventory.remove_stock"), i18n_locale(req))

    var category_fields: FormField[1]
    category_fields[0] = FormField{ "category", "text", i18n_t(req, "inventory.new_category"), "",
        "", true, "", "", "", "", "" }
    let category_form: string = forms_open(category_fields, 1, "/expenses/categories/add",
        i18n_t(req, "inventory.add_category"), i18n_locale(req))

    let body: string = template_fill(inventory_template("pages/inventory"),
        i18n_vars(req) +
        vars("inventory_style", inventory_template("parts/style")) +
        vars("tabs_class", settings_get("ui.tabs", "vertical")) +
        vars("add_item_form", add_item_form) +
        vars("purchase_form", purchase_form) +
        vars("consume_form", consume_form) +
        vars("category_form", category_form) +
        vars("notice", "") +
        vars("today", escape_html(inventory_date())) +
        vars("currency", escape_html(inventory_setting("currency", "RON"))) +
        vars("category_options", inventory_categories(categories, category_count, "")) +
        vars("item_options", inventory_items(items, item_count, "")) +
        vars("item_rows", inventory_item_rows(req, items, item_count, bindings, binding_count)) +
        vars("low_rows", inventory_low_rows(low, low_count)) +
        vars("expense_rows", inventory_expense_rows(expenses, expense_count)) +
        vars("category_rows", inventory_category_rows(req, categories, category_count)) +
        vars("total", escape_html(inventory_money(total))) +
        vars("item_count", int_to_str(item_count)) +
        vars("low_count", int_to_str(low_count)) +
        vars("expense_count", int_to_str(expense_count)) +
        vars("docs", inventory_docs()))

    return host_shell(req, i18n_t(req, "inventory.title"), body, toast_js)
}

fn inventory_page(req: Request) Response {
    return inventory_page_message(req, request_query_param(req, "msg"))
}

fn inventory_keeper_link() string {
    let port: string = getenv("RHO_KEEPER_PORT")
    if port == "" {
        return ""
    }
    return "<a class=\"keeper\" href=\"#\" data-keeper-port=\"" + escape_html(port) +
        "\">← Keeper</a>"
}

fn inventory_edit_page(req: Request) Response {
    let id: u32 = int_from_str(request_query_param(req, "id"))
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, inventory_schema())
    let categories: Categories[64]
    let category_slice: Slice[Categories] = Slice[Categories]{
        Ptr[Categories](&categories[0]), INVENTORY_CATEGORY_CAPACITY }
    let listed_categories: Result[u32, SqlError] = ListCategories(
        db, category_slice, INVENTORY_CATEGORY_CAPACITY)
    var category_count: u32 = 0
    if listed_categories.is_ok {
        category_count = listed_categories.ok
    }
    let items: ListItemsRow[512]
    let item_slice: Slice[ListItemsRow] = Slice[ListItemsRow]{
        Ptr[ListItemsRow](&items[0]), INVENTORY_ITEM_CAPACITY }
    let listed_items: Result[u32, SqlError] = ListItems(db, item_slice, INVENTORY_ITEM_CAPACITY)
    var item_count: u32 = 0
    if listed_items.is_ok {
        item_count = listed_items.ok
    }
    let at: i32 = inventory_find_item(items, item_count, id)
    sql_close(db)
    if at < 0 {
        return inventory_page_message(req, "That item was not found.")
    }
    let row_index: u32 = u32(at)
    let row: ListItemsRow = items[row_index]
    var automation_tab: string = ""
    if str_eq(row.kind, "equipment") && inventory_automated() {
        automation_tab = "<a href=\"/expenses/items/automation?id=" + int_to_str(u32(row.id)) + "\">" +
            escape_html(i18n_t(req, "inventory.automation")) + "</a>"
    }
    let body: string = template_fill(inventory_template("pages/item-edit"),
        i18n_vars(req) +
        vars("csrf", forms_csrf_field()) +
        vars("delete_confirm", json_string(i18n_t(req, "inventory.delete_item_confirm"))) +
        vars("inventory_style", inventory_template("parts/style")) +
        vars("id", int_to_str(u32(row.id))) +
        vars("name", row.name) +
        vars("category_options", inventory_categories(categories, category_count,
            int_to_str(u32(row.categoryId)))) +
        vars("unit", row.unit) +
        vars("quantity", inventory_quantity(row.quantityMilli)) +
        vars("reorder", inventory_quantity(row.reorderMilli)) +
        vars("location", row.location) +
        vars("notes", row.notes) +
        vars("kind_options", inventory_kind_options(req, row.kind)) +
        vars("handle", row.handle) +
        vars("portion", inventory_quantity(row.portionMilli)) +
        vars("automation_tab", automation_tab))
    return host_shell(req, i18n_t(req, "inventory.edit_title"), body, "")
}

/* -------------------------------------------------------------------------- */
/*  Actions                                                                   */
/* -------------------------------------------------------------------------- */

fn inventory_items_add(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_page_message(req, i18n_t(req, "inventory.csrf_refused"))
    }
    let name: string = str_trim(form_field(body, "name"))
    if strlen(name) == 0 {
        return inventory_page_message(req, "An item needs a name.")
    }
    let quantity: u32 = inventory_parse_scaled(form_field(body, "quantity"), 1000)
    let reorder: u32 = inventory_parse_scaled(form_field(body, "reorder"), 1000)
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, inventory_schema())
    let categories: Categories[64]
    let category_slice: Slice[Categories] = Slice[Categories]{
        Ptr[Categories](&categories[0]), INVENTORY_CATEGORY_CAPACITY }
    let listed_categories: Result[u32, SqlError] = ListCategories(db, category_slice, INVENTORY_CATEGORY_CAPACITY)
    var category_count: u32 = 0
    if listed_categories.is_ok {
        category_count = listed_categories.ok
    }
    let category_id: string = str_trim(form_field(body, "category_id"))
    let handle: string = inventory_handle(form_field(body, "handle"))
    if inventory_handle_taken(db, handle, 0) {
        sql_close(db)
        return inventory_page_message(req, i18n_t(req, "inventory.handle_taken"))
    }
    let added: Result[u32, SqlError] = InsertItem(
        name,
        category_id,
        str_trim(form_field(body, "unit")),
        int_to_str(quantity),
        int_to_str(reorder),
        str_trim(form_field(body, "location")),
        str_trim(form_field(body, "notes")),
        inventory_kind(form_field(body, "kind"), category_id, categories, category_count),
        handle,
        db)
    let failure: string = sql_last_message(db)
    sql_close(db)
    if !added.is_ok {
        notification_push_level_locale(i18n_t(req, "toast.item_add_failed") + ": " + failure, "error", 10, i18n_locale(req))
        return inventory_page_message(req, "Item could not be added: " + failure)
    }
    notification_push_level_locale(i18n_t(req, "toast.item_added"), "info", 10, i18n_locale(req))
    return inventory_page_message(req, "Item added.")
}

fn inventory_items_edit_save(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_page_message(req, i18n_t(req, "inventory.csrf_refused"))
    }
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    if id == 0 {
        return inventory_page_message(req, "That item was not found.")
    }
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, inventory_schema())
    let handle: string = inventory_handle(form_field(body, "handle"))
    if inventory_handle_taken(db, handle, id) {
        sql_close(db)
        return inventory_page_message(req, i18n_t(req, "inventory.handle_taken"))
    }
    let reorder: u32 = inventory_parse_scaled(form_field(body, "reorder"), 1000)
    let portion: u32 = inventory_parse_scaled(form_field(body, "portion"), 1000)
    var kind: string = str_trim(form_field(body, "kind"))
    if !str_eq(kind, "part") && !str_eq(kind, "equipment") {
        kind = "consumable"
    }
    let updated: Result[u32, SqlError] = UpdateItemDetails(
        str_trim(form_field(body, "name")),
        str_trim(form_field(body, "category_id")),
        str_trim(form_field(body, "unit")),
        i64(reorder),
        str_trim(form_field(body, "location")),
        str_trim(form_field(body, "notes")),
        kind,
        handle,
        i64(portion),
        i64(id), db)
    sql_close(db)
    if !updated.is_ok {
        return inventory_page_message(req, "The item could not be saved: " + updated.err.message)
    }
    info("inventory", "item saved")
    return inventory_page_message(req, "Item saved.")
}

fn inventory_items_consume(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_page_message(req, i18n_t(req, "inventory.csrf_refused"))
    }
    let id: u32 = int_from_str(str_trim(form_field(body, "item_id")))
    let amount: u32 = inventory_parse_scaled(form_field(body, "quantity"), 1000)
    if id == 0 || amount == 0 {
        return inventory_page_message(req, "Choose an item and a quantity to remove.")
    }
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, inventory_schema())
    let delta: string = "-" + int_to_str(amount)
    let updated: Result[u32, SqlError] = UpdateItemStock(delta, i64(id), db)
    if updated.is_ok {
        inventory_ignore(InsertMovement(int_to_str(id), "consume", delta, "0", "0",
            str_trim(form_field(body, "source")), inventory_date(),
            str_trim(form_field(body, "comment")), db))
    }
    sql_close(db)
    if !updated.is_ok {
        notification_push_level_locale(i18n_t(req, "toast.stock_failed") + ": " + updated.err.message, "error", 10, i18n_locale(req))
        return inventory_page_message(req, "The stock could not be changed: " + updated.err.message)
    }
    notification_push_level_locale(i18n_t(req, "toast.stock_removed"), "info", 10, i18n_locale(req))
    return inventory_page_message(req, "Stock removed.")
}

fn inventory_expenses_add(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_page_message(req, i18n_t(req, "inventory.csrf_refused"))
    }
    let item_id: u32 = int_from_str(str_trim(form_field(body, "item_id")))
    let quantity: u32 = inventory_parse_scaled(form_field(body, "quantity"), 1000)
    let unit_price: u32 = inventory_parse_scaled(form_field(body, "unit_price"), 100)
    if item_id == 0 {
        return inventory_page_message(req, "Choose the item this purchase belongs to.")
    }
    let qty: u32 = quantity
    if qty == 0 {
        qty = 1000
    }
    // In 64 bits: 100 units at 500.00 is more cents than 32 bits hold.
    let total: i64 = (i64(qty) * i64(unit_price)) / 1000
    var purchased: string = str_trim(form_field(body, "purchased_at"))
    if strlen(purchased) == 0 {
        purchased = inventory_date()
    }
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, inventory_schema())

    let items: ListItemsRow[512]
    let item_slice: Slice[ListItemsRow] = Slice[ListItemsRow]{
        Ptr[ListItemsRow](&items[0]), INVENTORY_ITEM_CAPACITY }
    let listed_items: Result[u32, SqlError] = ListItems(db, item_slice, INVENTORY_ITEM_CAPACITY)
    var item_count: u32 = 0
    if listed_items.is_ok {
        item_count = listed_items.ok
    }
    let at: i32 = inventory_find_item(items, item_count, item_id)
    if at < 0 {
        sql_close(db)
        return inventory_page_message(req, "That item was not found.")
    }
    let item_index: u32 = u32(at)
    let item_name: string = items[item_index].name

    let inserted: Result[u32, SqlError] = InsertExpense(
        int_to_str(item_id), item_name,
        str_trim(form_field(body, "category_id")),
        int_to_str(qty), int_to_str(unit_price), i64_to_str(total),
        str_trim(form_field(body, "source")), purchased,
        str_trim(form_field(body, "comment")), db)
    if inserted.is_ok {
        inventory_ignore(UpdateItemStock(int_to_str(qty), i64(item_id), db))
        inventory_ignore(InsertMovement(int_to_str(item_id), "purchase",
            int_to_str(qty), int_to_str(unit_price), i64_to_str(total),
            str_trim(form_field(body, "source")), purchased,
            str_trim(form_field(body, "comment")), db))
    }
    sql_close(db)
    if !inserted.is_ok {
        notification_push_level_locale(i18n_t(req, "toast.purchase_failed") + ": " + inserted.err.message, "error", 10, i18n_locale(req))
        return inventory_page_message(req, "The purchase could not be saved: " + inserted.err.message)
    }
    notification_push_level_locale(i18n_t(req, "toast.purchase_recorded"), "info", 10, i18n_locale(req))
    return inventory_page_message(req, "Purchase recorded and stock increased.")
}

fn inventory_expenses_delete(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    if id == 0 {
        return inventory_page_message(req, "That purchase was not found.")
    }
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, inventory_schema())
    let removed: Result[u32, SqlError] = DeleteExpense(i64(id), db)
    sql_close(db)
    if !removed.is_ok {
        return inventory_page_message(req, "The purchase could not be removed: " + removed.err.message)
    }
    return inventory_page_message(req, "Purchase removed. Stock was not adjusted.")
}

fn inventory_categories_add(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_page_message(req, i18n_t(req, "inventory.csrf_refused"))
    }
    let name: string = str_trim(form_field(body, "category"))
    if strlen(name) == 0 {
        return inventory_page_message(req, "A category needs a name.")
    }
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, inventory_schema())
    let added: Result[u32, SqlError] = InsertCategory(name, db)
    sql_close(db)
    if !added.is_ok {
        return inventory_page_message(req, "The category could not be added: " + added.err.message)
    }
    return inventory_page_message(req, "Category added.")
}

// inventory_back is the inventory page again, by GET, with what happened.
fn inventory_back(message: string) Response {
    return redirect("/expenses?msg=" + str_url_encode(message))
}

// inventory_items_delete deletes an item with its bindings and stock history;
// the purchases of it stay in the expenses, no longer naming it.
fn inventory_items_delete(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_back(i18n_t(req, "inventory.csrf_refused"))
    }
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if id == 0 || !opened.is_ok {
        return inventory_back(i18n_t(req, "inventory.devices.no_item"))
    }
    let db: SqlDb = opened.ok
    sql_apply(db, inventory_schema())
    let one: InventoryOne = inventory_one(db, int_to_str(id))
    inventory_ignore(DeleteItemBindings(i64(id), db))
    inventory_ignore(DeleteItemMovements(i64(id), db))
    inventory_ignore(DetachItemExpenses(i64(id), db))
    let removed: Result[u32, SqlError] = DeleteItem(i64(id), db)
    sql_close(db)
    if !removed.is_ok || removed.ok == 0 {
        return inventory_back(i18n_t(req, "inventory.devices.no_item"))
    }
    info("inventory", "item deleted: " + one.row.name)
    return inventory_back(one.row.name + ": " + i18n_t(req, "inventory.item_deleted"))
}

fn inventory_categories_rename(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_back(i18n_t(req, "inventory.csrf_refused"))
    }
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    let name: string = str_trim(form_field(body, "name"))
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if id == 0 || name == "" || !opened.is_ok {
        return inventory_back(i18n_t(req, "inventory.category_unchanged"))
    }
    sql_apply(opened.ok, inventory_schema())
    let renamed: Result[u32, SqlError] = RenameCategory(name, i64(id), opened.ok)
    sql_close(opened.ok)
    if !renamed.is_ok || renamed.ok == 0 {
        return inventory_back(i18n_t(req, "inventory.category_unchanged"))
    }
    return inventory_back(name + ": " + i18n_t(req, "inventory.category_renamed"))
}

fn inventory_categories_delete(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_back(i18n_t(req, "inventory.csrf_refused"))
    }
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if id == 0 || !opened.is_ok {
        return inventory_back(i18n_t(req, "inventory.category_in_use"))
    }
    sql_apply(opened.ok, inventory_schema())
    let removed: Result[u32, SqlError] = DeleteCategory(i64(id), opened.ok)
    if removed.is_ok && removed.ok > 0 {
        inventory_ignore(DetachCategoryExpenses(i64(id), opened.ok))
    }
    sql_close(opened.ok)
    if !removed.is_ok || removed.ok == 0 {
        return inventory_back(i18n_t(req, "inventory.category_in_use"))
    }
    return inventory_back(i18n_t(req, "inventory.category_deleted"))
}
