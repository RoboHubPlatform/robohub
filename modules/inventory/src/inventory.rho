module inventory

// The inventory and expense tracker's pages and the statements behind them.
//
// Stock and money are integers: quantity in thousandths, money in cents. The
// decimal point appears only in the formatting helpers. A purchase is recorded
// twice on purpose — once as spending, once as stock arriving — and both are
// linked to the item it belongs to.

import std.core.ptr
import std.core.result
import std.core.slice
import std.sql
import std.web.http
import std.web.template

const ITEM_CAPACITY: u32 = 512
const EXPENSES_CAPACITY: u32 = 512
const CATEGORY_CAPACITY: u32 = 64
const LOW_STOCK_CAPACITY: u32 = 128

/* -------------------------------------------------------------------------- */
/*  Where the database and its schema are                                     */
/* -------------------------------------------------------------------------- */

fn inventory_root() string {
    if rho_path_exists("module.yml") &&
        yaml.value("module.yml", "module.name") == "inventory" {
        return "."
    }
    let root: string = getenv("ROBOHUB_WORKSPACE")
    if root != "" {
        if rho_path_exists(root + "/modules/inventory/module.yml") {
            return root + "/modules/inventory"
        }
        if rho_path_exists(root + "/robohub/modules/inventory/module.yml") {
            return root + "/robohub/modules/inventory"
        }
    }
    return "modules/inventory"
}

fn inventory_workspace() string {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/inventory"
    }
    return workspace
}

fn inventory_template(name: string) string {
    let path: string = inventory_root() + "/templates/" + name + ".html"
    if rho_path_exists(path) {
        return rho_read_text(path)
    }
    return rho_read_text("templates/" + name + ".html")
}

fn inventory_db_path() string {
    let override: string = getenv("RHO_INVENTORY_DB")
    if override != "" {
        return override
    }
    // The records belong to the application that consumes the module, not to
    // the module folder. Two applications using the same module therefore get
    // two databases, and a module update never moves one out from under the
    // other.
    let dir: string = inventory_workspace() + "/data"
    ignore_u32(rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt"))
    return dir + "/app.db"
}

fn inventory_schema() string {
    let path: string = inventory_root() + "/db/schema.sql"
    if rho_path_exists(path) {
        return rho_read_text(path)
    }
    return rho_read_text("db/schema.sql")
}

fn inventory_host_config(key: string) string {
    let manifest: string = getenv("ROBOHUB_APP_MANIFEST")
    if manifest == "" {
        return ""
    }
    let text: string = rho_read_text(manifest)
    let marker: string = "\napp_modules:\n"
    let start: i32 = rho_str_index_of(text, marker)
    if start < 0 {
        return ""
    }
    var i: u32 = u32(start) + u32(rho_strlen(marker))
    var mine: bool = false
    var in_config: bool = false
    var config_indent: u32 = 0
    while i < u32(rho_strlen(text)) {
        let at: i32 = rho_str_index_of(
            rho_str_slice(text, i, u32(rho_strlen(text)) - i), "\n")
        let end: u32 = u32(rho_strlen(text))
        if at >= 0 {
            end = i + u32(at)
        }
        let line: string = rho_str_slice(text, i, end - i)
        let trimmed: string = trim(line)
        if rho_strlen(trimmed) == 0 {
            i = end + 1
            continue
        }
        if plugin_indent(line) == 0 && !rho_str_eq(trimmed, "app_modules:") {
            break
        }
        if rho_str_index_of(trimmed, "- name:") == 0 {
            let name: string = unquote(rho_str_slice(trimmed, 7,
                u32(rho_strlen(trimmed)) - 7))
            mine = rho_str_eq(name, "inventory")
            in_config = false
        } else if mine && rho_str_index_of(trimmed, "config:") == 0 {
            in_config = true
            config_indent = plugin_indent(line)
        } else if mine && in_config && plugin_indent(line) > config_indent {
            let colon: i32 = rho_str_index_of(trimmed, ":")
            if colon > 0 && rho_str_eq(unquote(rho_str_slice(trimmed, 0, u32(colon))), key) {
                return unquote(rho_str_slice(trimmed, u32(colon) + 1,
                    u32(rho_strlen(trimmed)) - u32(colon) - 1))
            }
        }
        i = end + 1
    }
    return ""
}

fn inventory_setting(key: string, fallback: string) string {
    // The host application owns the module's settings, so two applications
    // including this module can give it different values. Nothing is read from
    // beside the module itself. Older hosts kept a module config block; it is
    // still read after the settings store so an upgrade keeps working.
    let from_settings: string = settings_get("inventory." + key, "")
    if from_settings != "" {
        return from_settings
    }
    let from_host: string = inventory_host_config(key)
    if from_host != "" {
        return from_host
    }
    return fallback
}

fn unquote(text: string) string {
    let value: string = trim(text)
    if rho_strlen(value) >= 2 {
        let first: string = rho_str_slice(value, 0, 1)
        let last: string = rho_str_slice(value, u32(rho_strlen(value)) - 1, 1)
        if (rho_str_eq(first, "\"") || rho_str_eq(first, "'")) &&
            rho_str_eq(first, last) {
            return rho_str_slice(value, 1, u32(rho_strlen(value)) - 2)
        }
    }
    return value
}

fn plugin_indent(line: string) u32 {
    var count: u32 = 0
    while count < u32(rho_strlen(line)) &&
        rho_str_eq(rho_str_slice(line, count, 1), " ") {
        count = count + 1
    }
    return count
}

fn inventory_date() string {
    let report: string = inventory_db_path() + ".date"
    if rho_exec("date", "+%Y-%m-%d", report) == 0 {
        let text: string = rho_read_text(report)
        let at: i32 = rho_str_index_of(text, "\n")
        if at < 0 {
            return text
        }
        return rho_str_slice(text, 0, u32(at))
    }
    return ""
}

/* -------------------------------------------------------------------------- */
/*  Formatting and parsing                                                    */
/* -------------------------------------------------------------------------- */

fn ignore_result(value: Result[u32, SqlError]) void {
}

fn inventory_money(cents: i64) string {
    var value: i64 = cents
    var sign: string = ""
    if value < 0 {
        sign = "-"
        value = -value
    }
    let whole: u32 = u32(value / 100)
    let fraction: u32 = u32(value % 100)
    var frac: string = rho_int_to_str(fraction)
    if fraction < 10 {
        frac = "0" + frac
    }
    return sign + rho_int_to_str(whole) + "." + frac
}

fn inventory_quantity(milli: i64) string {
    let whole: u32 = u32(milli / 1000)
    let fraction: u32 = u32(milli % 1000)
    if fraction == 0 {
        return rho_int_to_str(whole)
    }
    var frac: string = rho_int_to_str(fraction)
    while rho_strlen(frac) < 3 {
        frac = "0" + frac
    }
    while rho_strlen(frac) > 0 &&
        rho_str_eq(rho_str_slice(frac, u32(rho_strlen(frac)) - 1, 1), "0") {
        frac = rho_str_slice(frac, 0, u32(rho_strlen(frac)) - 1)
    }
    return rho_int_to_str(whole) + "." + frac
}

fn inventory_parse_scaled(text: string, scale: u32) u32 {
    var value: string = trim(text)
    if rho_strlen(value) == 0 {
        return 0
    }
    if rho_str_eq(rho_str_slice(value, 0, 1), "+") {
        value = rho_str_slice(value, 1, u32(rho_strlen(value)) - 1)
    }
    if rho_str_eq(rho_str_slice(value, 0, 1), "-") {
        return 0
    }
    var whole: string = value
    var fraction: string = ""
    let dot: i32 = rho_str_index_of(value, ".")
    if dot >= 0 {
        whole = rho_str_slice(value, 0, u32(dot))
        fraction = rho_str_slice(value, u32(dot) + 1,
            u32(rho_strlen(value)) - u32(dot) - 1)
    }
    if rho_strlen(whole) == 0 {
        whole = "0"
    }
    let whole_value: u32 = rho_int_from_str(whole)
    var frac_value: u32 = 0
    var i: u32 = 0
    while i < 3 {
        if i < u32(rho_strlen(fraction)) {
            let ch: string = rho_str_slice(fraction, i, 1)
            frac_value = frac_value * 10 + rho_int_from_str(ch)
        } else {
            frac_value = frac_value * 10
        }
        i = i + 1
    }
    return whole_value * scale + (frac_value * scale) / 1000
}

/* -------------------------------------------------------------------------- */
/*  Options and lookups                                                       */
/* -------------------------------------------------------------------------- */

fn inventory_categories(categories: Categories[64], count: u32, selected: string) string {
    var out: string = "<option value=\"\">Uncategorised</option>"
    var i: u32 = 0
    while i < count {
        let id: string = rho_int_to_str(u32(categories[i].id))
        out = out + "<option value=\"" + id + "\""
        if rho_str_eq(id, selected) {
            out = out + " selected"
        }
        out = out + ">" + escape_html(categories[i].name) + "</option>"
        i = i + 1
    }
    return out
}

fn inventory_items(items: ListItemsRow[512], count: u32, selected: string) string {
    var out: string = "<option value=\"\">Choose an item</option>"
    var i: u32 = 0
    while i < count {
        let id: string = rho_int_to_str(u32(items[i].id))
        out = out + "<option value=\"" + id + "\""
        if rho_str_eq(id, selected) {
            out = out + " selected"
        }
        out = out + ">" + escape_html(items[i].name) + "</option>"
        i = i + 1
    }
    return out
}

fn inventory_category_choices(categories: Categories[64], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        if out != "" { out = out + "," }
        out = out + rho_int_to_str(u32(categories[i].id)) + "|" + categories[i].name
        i = i + 1
    }
    return out
}

fn inventory_item_choices(items: ListItemsRow[512], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        if out != "" { out = out + "," }
        out = out + rho_int_to_str(u32(items[i].id)) + "|" + items[i].name
        i = i + 1
    }
    return out
}

fn inventory_find_item(items: ListItemsRow[512], count: u32, id: u32) i32 {
    var i: u32 = 0
    while i < count {
        if u32(items[i].id) == id {
            return i32(i)
        }
        i = i + 1
    }
    return -1
}

fn inventory_item_rows(items: ListItemsRow[512], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let row: ListItemsRow = items[i]
        let id: string = rho_int_to_str(u32(row.id))
        var low: string = ""
        if row.reorderMilli > 0 && row.quantityMilli <= row.reorderMilli {
            low = "<span class=\"badge low\">reorder</span>"
        }
        let html: string = template_fill(inventory_template("rows/item-row"),
            vars("id", id) +
            vars("name", row.name) +
            vars("category", row.category) +
            vars("quantity", inventory_quantity(row.quantityMilli)) +
            vars("unit", row.unit) +
            vars("reorder", inventory_quantity(row.reorderMilli)) +
            vars("location", row.location) +
            vars("low", low) +
            vars("notes", row.notes))
        out = out + html + "\n"
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"8\">No items in the inventory yet.</td></tr>"
    }
    return out
}

fn inventory_low_rows(rows: LowStockItemsRow[128], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let row: LowStockItemsRow = rows[i]
        let html: string = template_fill(inventory_template("rows/low-row"),
            vars("name", row.name) +
            vars("on_hand", inventory_quantity(row.quantityMilli)) +
            vars("reorder_at", inventory_quantity(row.reorderMilli)) +
            vars("unit", row.unit) +
            vars("location", row.location))
        out = out + html + "\n"
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"4\">Nothing needs reordering.</td></tr>"
    }
    return out
}

fn inventory_expense_rows(rows: ListExpensesRow[512], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let row: ListExpensesRow = rows[i]
        let html: string = template_fill(inventory_template("rows/expense-row"),
            vars("id", rho_int_to_str(u32(row.id))) +
            vars("item", row.item) +
            vars("category", row.category) +
            vars("quantity", inventory_quantity(row.quantityMilli)) +
            vars("unit_price", inventory_money(row.unitPriceCents)) +
            vars("total", inventory_money(row.totalCents)) +
            vars("source", row.source) +
            vars("date", row.purchasedAt) +
            vars("comment", row.comment))
        out = out + html + "\n"
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"9\">No purchases recorded yet.</td></tr>"
    }
    return out
}

/* -------------------------------------------------------------------------- */
/*  Queries                                                                   */
/* -------------------------------------------------------------------------- */

fn inventory_total(db: SqlDb) i64 {
    let out: TotalExpensesRow[1]
    let slice: Slice[TotalExpensesRow] = Slice[TotalExpensesRow]{
        Ptr[TotalExpensesRow](&out[0]), 1 }
    let total: Result[u32, SqlError] = TotalExpenses(db, slice, 1)
    if !total.is_ok {
        return 0
    }
    return out[0].totalCents
}

/* -------------------------------------------------------------------------- */
/*  Pages                                                                     */
/* -------------------------------------------------------------------------- */

fn inventory_docs() string {
    let root: string = inventory_root()
    let path: string = root + "/docs/index.md"
    if rho_path_exists(path) {
        return rho_read_text(path)
    }
    return "No documentation found."
}

fn inventory_category_rows(categories: Categories[64], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let html: string = template_fill(inventory_template("rows/category-row"),
            vars("name", categories[i].name))
        out = out + html + "\n"
        i = i + 1
    }
    if out == "" {
        out = "<tr><td>No categories yet.</td></tr>"
    }
    return out
}

fn inventory_count(req: Request) Response {
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return html(status_internal(), "{\"count\":0}")
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, inventory_schema()))
    let items: ListItemsRow[512]
    let item_slice: Slice[ListItemsRow] = Slice[ListItemsRow]{
        Ptr[ListItemsRow](&items[0]), ITEM_CAPACITY }
    let listed: Result[u32, SqlError] = ListItems(db, item_slice, ITEM_CAPACITY)
    var n: u32 = 0
    if listed.is_ok { n = listed.ok }
    sql_close(db)
    return html(status_ok(), "{\"count\":" + rho_int_to_str(n) + "}")
}

fn inventory_page_message(req: Request, message: string) Response {
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return html(status_internal(), "<h1>Inventory</h1><p>The database could not be opened: " +
            escape_html(opened.err) + "</p>")
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, inventory_schema()))

    let categories: Categories[64]
    let category_slice: Slice[Categories] = Slice[Categories]{
        Ptr[Categories](&categories[0]), CATEGORY_CAPACITY }
    let listed_categories: Result[u32, SqlError] = ListCategories(
        db, category_slice, CATEGORY_CAPACITY)
    var category_count: u32 = 0
    if listed_categories.is_ok {
        category_count = listed_categories.ok
    }

    let items: ListItemsRow[512]
    let item_slice: Slice[ListItemsRow] = Slice[ListItemsRow]{
        Ptr[ListItemsRow](&items[0]), ITEM_CAPACITY }
    let listed_items: Result[u32, SqlError] = ListItems(db, item_slice, ITEM_CAPACITY)
    var item_count: u32 = 0
    if listed_items.is_ok {
        item_count = listed_items.ok
    }

    let low: LowStockItemsRow[128]
    let low_slice: Slice[LowStockItemsRow] = Slice[LowStockItemsRow]{
        Ptr[LowStockItemsRow](&low[0]), LOW_STOCK_CAPACITY }
    let listed_low: Result[u32, SqlError] = LowStockItems(db, low_slice, LOW_STOCK_CAPACITY)
    var low_count: u32 = 0
    if listed_low.is_ok {
        low_count = listed_low.ok
    }

    let expenses: ListExpensesRow[512]
    let expense_slice: Slice[ListExpensesRow] = Slice[ListExpensesRow]{
        Ptr[ListExpensesRow](&expenses[0]), EXPENSES_CAPACITY }
    let listed_expenses: Result[u32, SqlError] = ListExpenses(
        db, expense_slice, EXPENSES_CAPACITY)
    var expense_count: u32 = 0
    if listed_expenses.is_ok {
        expense_count = listed_expenses.ok
    }

    let total: i64 = inventory_total(db)
    sql_close(db)

    let toast_js: string = ""
    if message != "" {
        toast_js = "<script>document.addEventListener(\"DOMContentLoaded\",function(){if(window.rhoToast){window.rhoToast(\"" +
            message + "\", \"info\");}});</script>"
    }
    var add_fields: FormField[7]
    add_fields[0] = FormField{ "name", "text", i18n_t(req, "inventory.name"), "",
        "", true, "", "", "", "", "" }
    add_fields[1] = FormField{ "category_id", "select", i18n_t(req, "inventory.category"), "",
        i18n_t(req, "inventory.uncategorised"), false, "",
        inventory_category_choices(categories, category_count), "", "", "" }
    add_fields[2] = FormField{ "unit", "text", i18n_t(req, "inventory.unit"), "",
        "unit, kg, L", false, "", "", inventory_setting("default_unit", ""), "", "" }
    add_fields[3] = FormField{ "quantity", "text", i18n_t(req, "inventory.opening_quantity"), "",
        "0", false, "", "", "0", "", "decimal" }
    add_fields[4] = FormField{ "reorder", "text", i18n_t(req, "inventory.reorder_at"), "",
        "0", false, "", "", inventory_setting("reorder", "0"), "", "decimal" }
    add_fields[5] = FormField{ "location", "text", i18n_t(req, "inventory.location"), "",
        "", false, "", "", "", "", "" }
    add_fields[6] = FormField{ "notes", "text", i18n_t(req, "inventory.notes"), "",
        "", false, "", "", "", "", "" }
    let add_item_form: string = forms_open(add_fields, 7, "/expenses/items/add",
        i18n_t(req, "inventory.add_item"), i18n_locale(req))

    var purchase_fields: FormField[7]
    purchase_fields[0] = FormField{ "item_id", "select", i18n_t(req, "inventory.item"), "",
        i18n_t(req, "inventory.choose_item"), true, "",
        inventory_item_choices(items, item_count), "", "", "" }
    purchase_fields[1] = FormField{ "quantity", "text", i18n_t(req, "inventory.qty"), "",
        "1", false, "", "", "1", "", "decimal" }
    purchase_fields[2] = FormField{ "unit_price", "text", i18n_t(req, "inventory.unit_price"), "",
        "0.00", true, "", "", "", "", "decimal" }
    purchase_fields[3] = FormField{ "category_id", "select", i18n_t(req, "inventory.category"), "",
        i18n_t(req, "inventory.uncategorised"), false, "",
        inventory_category_choices(categories, category_count), "", "", "" }
    purchase_fields[4] = FormField{ "source", "text", i18n_t(req, "inventory.store"), "",
        "", false, "", "", "", "", "" }
    purchase_fields[5] = FormField{ "purchased_at", "date", i18n_t(req, "inventory.date"), "",
        "", false, "", "", inventory_date(), "", "" }
    purchase_fields[6] = FormField{ "comment", "text", i18n_t(req, "inventory.comment"), "",
        "", false, "", "", "", "", "" }
    let purchase_form: string = forms_open(purchase_fields, 7, "/expenses/purchases/add",
        i18n_t(req, "inventory.record_purchase"), i18n_locale(req))

    var consume_fields: FormField[3]
    consume_fields[0] = FormField{ "item_id", "select", i18n_t(req, "inventory.item"), "",
        i18n_t(req, "inventory.choose_item"), true, "",
        inventory_item_choices(items, item_count), "", "", "" }
    consume_fields[1] = FormField{ "quantity", "text", i18n_t(req, "inventory.qty"), "",
        "", true, "", "", "", "", "decimal" }
    consume_fields[2] = FormField{ "comment", "text", i18n_t(req, "inventory.reason"), "",
        "", false, "", "", "", "", "" }
    let consume_form: string = forms_open(consume_fields, 3, "/expenses/items/consume",
        i18n_t(req, "inventory.remove_stock"), i18n_locale(req))

    var category_fields: FormField[1]
    category_fields[0] = FormField{ "category", "text", i18n_t(req, "inventory.new_category"), "",
        "", true, "", "", "", "", "" }
    let category_form: string = forms_open(category_fields, 1, "/expenses/categories/add",
        i18n_t(req, "inventory.add_category"), i18n_locale(req))

    let body: string = template_fill(inventory_template("pages/inventory"),
        i18n_vars(req) +
        vars("add_item_form", add_item_form) +
        vars("purchase_form", purchase_form) +
        vars("consume_form", consume_form) +
        vars("category_form", category_form) +
        vars("notice", "") +
        vars("today", escape_html(inventory_date())) +
        vars("currency", escape_html(inventory_setting("currency", "RON"))) +
        vars("category_options", inventory_categories(categories, category_count, "")) +
        vars("item_options", inventory_items(items, item_count, "")) +
        vars("item_rows", inventory_item_rows(items, item_count)) +
        vars("low_rows", inventory_low_rows(low, low_count)) +
        vars("expense_rows", inventory_expense_rows(expenses, expense_count)) +
        vars("category_rows", inventory_category_rows(categories, category_count)) +
        vars("total", escape_html(inventory_money(total))) +
        vars("item_count", rho_int_to_str(item_count)) +
        vars("low_count", rho_int_to_str(low_count)) +
        vars("expense_count", rho_int_to_str(expense_count)) +
        vars("docs", inventory_docs()))

    let document: string = template_fill(inventory_template("layouts/layout"),
        vars("title", i18n_t(req, "inventory.title")) + i18n_vars(req) + vars("body", body) +
        vars("keeper", inventory_keeper_link()) +
        vars("notifications", notification_embed()) +
        vars("toast_js", toast_js))
    return html(status_ok(), document)
}

fn inventory_page(req: Request) Response {
    return inventory_page_message(req, request_query_param(req, "msg"))
}

fn inventory_keeper_link() string {
    let port: string = getenv("RHO_KEEPER_PORT")
    if port == "" {
        return ""
    }
    return "<a class=\"keeper\" href=\"#\" data-keeper-port=\"" + escape_html(port) +
        "\">← Keeper</a>"
}

fn item_edit_page(req: Request) Response {
    let id: u32 = rho_int_from_str(request_query_param(req, "id"))
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, inventory_schema()))
    let categories: Categories[64]
    let category_slice: Slice[Categories] = Slice[Categories]{
        Ptr[Categories](&categories[0]), CATEGORY_CAPACITY }
    let listed_categories: Result[u32, SqlError] = ListCategories(
        db, category_slice, CATEGORY_CAPACITY)
    var category_count: u32 = 0
    if listed_categories.is_ok {
        category_count = listed_categories.ok
    }
    let items: ListItemsRow[512]
    let item_slice: Slice[ListItemsRow] = Slice[ListItemsRow]{
        Ptr[ListItemsRow](&items[0]), ITEM_CAPACITY }
    let listed_items: Result[u32, SqlError] = ListItems(db, item_slice, ITEM_CAPACITY)
    var item_count: u32 = 0
    if listed_items.is_ok {
        item_count = listed_items.ok
    }
    let at: i32 = inventory_find_item(items, item_count, id)
    sql_close(db)
    if at < 0 {
        return inventory_page_message(req, "That item was not found.")
    }
    let row_index: u32 = u32(at)
    let row: ListItemsRow = items[row_index]
    let body: string = template_fill(inventory_template("pages/item-edit"),
        i18n_vars(req) +
        vars("id", rho_int_to_str(u32(row.id))) +
        vars("name", row.name) +
        vars("category_options", inventory_categories(categories, category_count,
            rho_int_to_str(u32(row.categoryId)))) +
        vars("unit", row.unit) +
        vars("quantity", inventory_quantity(row.quantityMilli)) +
        vars("reorder", inventory_quantity(row.reorderMilli)) +
        vars("location", row.location) +
        vars("notes", row.notes))
    let document: string = template_fill(inventory_template("layouts/layout"),
        vars("title", i18n_t(req, "inventory.edit_title")) + i18n_vars(req) + vars("body", body) +
        vars("keeper", inventory_keeper_link()))
    return html(status_ok(), document)
}

/* -------------------------------------------------------------------------- */
/*  Actions                                                                   */
/* -------------------------------------------------------------------------- */

fn items_add(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_page_message(req, i18n_t(req, "inventory.csrf_refused"))
    }
    let name: string = trim(form_value(body, "name"))
    if rho_strlen(name) == 0 {
        return inventory_page_message(req, "An item needs a name.")
    }
    let quantity: u32 = inventory_parse_scaled(form_value(body, "quantity"), 1000)
    let reorder: u32 = inventory_parse_scaled(form_value(body, "reorder"), 1000)
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, inventory_schema()))
    let added: Result[u32, SqlError] = InsertItem(
        name,
        trim(form_value(body, "category_id")),
        trim(form_value(body, "unit")),
        rho_int_to_str(quantity),
        rho_int_to_str(reorder),
        trim(form_value(body, "location")),
        trim(form_value(body, "notes")),
        db)
    sql_close(db)
    if !added.is_ok {
        notification_push_level_locale(i18n_t(req, "toast.item_add_failed") + ": " + added.err.message, "error", 10, i18n_locale(req))
        return inventory_page_message(req, "Item could not be added: " + added.err.message)
    }
    notification_push_level_locale(i18n_t(req, "toast.item_added"), "info", 10, i18n_locale(req))
    return inventory_page_message(req, "Item added.")
}

fn items_edit_save(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = rho_int_from_str(trim(form_value(body, "id")))
    if id == 0 {
        return inventory_page_message(req, "That item was not found.")
    }
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, inventory_schema()))
    let reorder: u32 = inventory_parse_scaled(form_value(body, "reorder"), 1000)
    let updated: Result[u32, SqlError] = UpdateItemDetails(
        trim(form_value(body, "name")),
        trim(form_value(body, "category_id")),
        trim(form_value(body, "unit")),
        i64(reorder),
        trim(form_value(body, "location")),
        trim(form_value(body, "notes")),
        i64(id), db)
    sql_close(db)
    if !updated.is_ok {
        return inventory_page_message(req, "The item could not be saved: " + updated.err.message)
    }
    return inventory_page_message(req, "Item saved.")
}

fn items_consume(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_page_message(req, i18n_t(req, "inventory.csrf_refused"))
    }
    let id: u32 = rho_int_from_str(trim(form_value(body, "item_id")))
    let amount: u32 = inventory_parse_scaled(form_value(body, "quantity"), 1000)
    if id == 0 || amount == 0 {
        return inventory_page_message(req, "Choose an item and a quantity to remove.")
    }
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, inventory_schema()))
    let delta: string = "-" + rho_int_to_str(amount)
    let updated: Result[u32, SqlError] = UpdateItemStock(delta, i64(id), db)
    if updated.is_ok {
        ignore_result(InsertMovement(rho_int_to_str(id), "consume", delta, "0", "0",
            trim(form_value(body, "source")), inventory_date(),
            trim(form_value(body, "comment")), db))
    }
    sql_close(db)
    if !updated.is_ok {
        notification_push_level_locale(i18n_t(req, "toast.stock_failed") + ": " + updated.err.message, "error", 10, i18n_locale(req))
        return inventory_page_message(req, "The stock could not be changed: " + updated.err.message)
    }
    notification_push_level_locale(i18n_t(req, "toast.stock_removed"), "info", 10, i18n_locale(req))
    return inventory_page_message(req, "Stock removed.")
}

fn expenses_add(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_page_message(req, i18n_t(req, "inventory.csrf_refused"))
    }
    let item_id: u32 = rho_int_from_str(trim(form_value(body, "item_id")))
    let quantity: u32 = inventory_parse_scaled(form_value(body, "quantity"), 1000)
    let unit_price: u32 = inventory_parse_scaled(form_value(body, "unit_price"), 100)
    if item_id == 0 {
        return inventory_page_message(req, "Choose the item this purchase belongs to.")
    }
    let qty: u32 = quantity
    if qty == 0 {
        qty = 1000
    }
    let total: u32 = (qty * unit_price) / 1000
    var purchased: string = trim(form_value(body, "purchased_at"))
    if rho_strlen(purchased) == 0 {
        purchased = inventory_date()
    }
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, inventory_schema()))

    let items: ListItemsRow[512]
    let item_slice: Slice[ListItemsRow] = Slice[ListItemsRow]{
        Ptr[ListItemsRow](&items[0]), ITEM_CAPACITY }
    let listed_items: Result[u32, SqlError] = ListItems(db, item_slice, ITEM_CAPACITY)
    var item_count: u32 = 0
    if listed_items.is_ok {
        item_count = listed_items.ok
    }
    let at: i32 = inventory_find_item(items, item_count, item_id)
    if at < 0 {
        sql_close(db)
        return inventory_page_message(req, "That item was not found.")
    }
    let item_index: u32 = u32(at)
    let item_name: string = items[item_index].name

    let inserted: Result[u32, SqlError] = InsertExpense(
        rho_int_to_str(item_id), item_name,
        trim(form_value(body, "category_id")),
        rho_int_to_str(qty), rho_int_to_str(unit_price), rho_int_to_str(total),
        trim(form_value(body, "source")), purchased,
        trim(form_value(body, "comment")), db)
    if inserted.is_ok {
        ignore_result(UpdateItemStock(rho_int_to_str(qty), i64(item_id), db))
        ignore_result(InsertMovement(rho_int_to_str(item_id), "purchase",
            rho_int_to_str(qty), rho_int_to_str(unit_price), rho_int_to_str(total),
            trim(form_value(body, "source")), purchased,
            trim(form_value(body, "comment")), db))
    }
    sql_close(db)
    if !inserted.is_ok {
        notification_push_level_locale(i18n_t(req, "toast.purchase_failed") + ": " + inserted.err.message, "error", 10, i18n_locale(req))
        return inventory_page_message(req, "The purchase could not be saved: " + inserted.err.message)
    }
    notification_push_level_locale(i18n_t(req, "toast.purchase_recorded"), "info", 10, i18n_locale(req))
    return inventory_page_message(req, "Purchase recorded and stock increased.")
}

fn expenses_delete(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = rho_int_from_str(trim(form_value(body, "id")))
    if id == 0 {
        return inventory_page_message(req, "That purchase was not found.")
    }
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, inventory_schema()))
    let removed: Result[u32, SqlError] = DeleteExpense(i64(id), db)
    sql_close(db)
    if !removed.is_ok {
        return inventory_page_message(req, "The purchase could not be removed: " + removed.err.message)
    }
    return inventory_page_message(req, "Purchase removed. Stock was not adjusted.")
}

fn categories_add(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return inventory_page_message(req, i18n_t(req, "inventory.csrf_refused"))
    }
    let name: string = trim(form_value(body, "category"))
    if rho_strlen(name) == 0 {
        return inventory_page_message(req, "A category needs a name.")
    }
    let opened: Result[SqlDb, string] = sql_open(inventory_db_path())
    if !opened.is_ok {
        return inventory_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, inventory_schema()))
    let added: Result[u32, SqlError] = InsertCategory(name, db)
    sql_close(db)
    if !added.is_ok {
        return inventory_page_message(req, "The category could not be added: " + added.err.message)
    }
    return inventory_page_message(req, "Category added.")
}
