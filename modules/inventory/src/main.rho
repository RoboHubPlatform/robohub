module inventory

// inventory — the stock and expense module.
//
// It is included by a host application. The host owns the HTTP port and the
// router; this file registers the module's routes on that router under
// /expenses. Its database and settings live in the host application's
// workspace, not beside the module.

include "inventory.rho"
include "automation.rho"
include "notifications"
include "forms"
include "settings"

import std.sql
import std.web.http
import std.web.template
import robohub.gateway

// The runtime functions this module calls.
extern fn rho_exec(program: string, arguments: string, output_path: string) u32
// The clock and a program's output, from the runtime rather than through a file.
extern fn rho_now_s() u32
extern fn rho_local_date() string
extern fn rho_read_text(path: string) string

route GET  "/expenses"                  => inventory_page
route GET  "/api/expenses/count"         => inventory_count
route GET  "/expenses/items/edit"       => item_edit_page
route POST "/expenses/items/add"        => items_add
route POST "/expenses/items/edit"       => items_edit_save
route POST "/expenses/items/consume"    => items_consume
route POST "/expenses/purchases/add"    => expenses_add
route POST "/expenses/purchases/delete" => expenses_delete
route POST "/expenses/categories/add"   => categories_add
route GET  "/expenses/items/automation" => item_automation_page
route POST "/expenses/items/bind"       => items_bind
route POST "/expenses/items/switch"     => items_switch
