module widgets

import rho.log

// The widget manager, the dashboard cards and the API.
//
// A widget is a definition: a number, a chart of recent values, or a button
// that calls a hook. Its values live in the host's main SQL database.

import std.core.ptr
import std.core.result
import std.core.slice
import std.sql
import std.web.http
import std.web.template

// A module's own files, embedded in the program that includes it.
extern fn rho_asset(module: string, path: string) string

const WIDGET_CAPACITY: u32 = 128
const WIDGETS_VALUE_CAPACITY: u32 = 100

fn widget_workspace() string {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/widgets"
    }
    return workspace
}

fn widget_db_path() string {
    let override: string = getenv("RHO_WIDGETS_DB")
    if override != "" {
        return override
    }
    let dir: string = widget_workspace() + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    return dir + "/app.db"
}

fn widget_schema() string {
    return rho_asset("widgets", "db/schema.sql")
}

fn widget_template(name: string) string {
    return rho_asset("widgets", "templates/" + name + ".html")
}

fn widgets_style() string {
    return widget_template("partials/widgets-style")
}

fn widget_now() u32 {
    return rho_now_s()
}

// widget_url_ok is whether a URL a person gave a widget may be fetched: http or
// https, one line, so it cannot become a second argument or another protocol.
fn widget_url_ok(url: string) bool {
    if !str_starts_with(url, "http://") && !str_starts_with(url, "https://") {
        return false
    }
    return str_index_of(url, "\n") < 0 && str_index_of(url, "\r") < 0
}

// widget_method is the HTTP method a widget presses with: GET, POST or PUT.
fn widget_method(method: string) string {
    if str_eq(method, "POST") || str_eq(method, "PUT") {
        return method
    }
    return "GET"
}

// widget_curl_args runs curl with one argument per line and no shell. The
// gateway's token is sent only to the gateway itself: a URL a person typed into
// a widget may be anywhere.
fn widget_curl_args(method: string, url: string, timeout: string, report: string) u32 {
    if !widget_url_ok(url) {
        return 255
    }
    return rho_exec_args("curl", widget_curl_line(method, url, timeout), report)
}

// widget_curl_line is curl's arguments for one request, one per line.
fn widget_curl_line(method: string, url: string, timeout: string) string {
    var args: string = "-fsS\n--proto\n=http,https\n-m\n" + timeout + "\n-X\n" + widget_method(method) + "\n"
    let token: string = gateway.token()
    let base: string = gateway.config("url")
    if token != "" && base != "" && str_index_of(token, "\n") < 0 && str_starts_with(url, base + "/") {
        args = args + "-H\nAuthorization: Bearer " + token + "\n"
    }
    return args + url + "\n"
}

fn widget_report(name: string) string {
    let dir: string = widget_workspace() + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    return dir + "/" + name + ".txt"
}

// widget_curl is what a URL answers, read as a value rather than from a file
// another request could be writing; "" when it does not answer.
fn widget_curl(url: string, report: string) string {
    if !widget_url_ok(url) {
        return ""
    }
    return rho_exec_capture("curl", widget_curl_line("GET", url, "3"))
}

fn widget_epoch_seconds(text: string) u32 {
    let value: string = str_trim(text)
    if strlen(value) <= 10 {
        return int_from_str(value)
    }
    return int_from_str(str_slice(value, 0, u32(strlen(value)) - 3))
}

// widget_mesh_source says whether a widget reads through the gateway: a gateway
// source (by its stable id), or an inventory item's capability, which inventory
// resolves to the source it is bound to.
fn widget_mesh_source(widget: Widgets) bool {
    return str_eq(widget.sourceKind, "mesh") || str_eq(widget.sourceKind, "item") ||
        str_index_of(widget.source, "/mesh/api/") >= 0
}

// widget_gateway_id is the gateway source a widget reads: its own source, or for
// an item (`heater.temperature`) the source the item's capability is bound to.
fn widget_gateway_id(widget: Widgets) string {
    if str_eq(widget.sourceKind, "item") {
        let dot: i32 = str_index_of(widget.source, ".")
        if dot <= 0 {
            return ""
        }
        return inventory_resolve(str_slice(widget.source, 0, u32(dot)),
            str_slice(widget.source, u32(dot) + 1, u32(strlen(widget.source)) - u32(dot) - 1))
    }
    return widget.source
}

// widget_switch switches what a toggle stands for, and answers whether it did:
// an item through inventory, a gateway source through the gateway, anything
// else through its hook, as before.
fn widget_switch(widget: Widgets, state: string) bool {
    if str_eq(widget.sourceKind, "item") {
        let dot: i32 = str_index_of(widget.source, ".")
        var handle: string = widget.source
        if dot > 0 {
            handle = str_slice(widget.source, 0, u32(dot))
        }
        return inventory_switch(handle, str_eq(state, "on"), "person:widget")
    }
    if str_eq(widget.sourceKind, "mesh") && str_index_of(widget.source, "/") < 0 {
        return gateway.action(widget.source, state)
    }
    var hook: string = widget.source
    if str_eq(widget.kind, "toggle") {
        hook = widget_hook(widget.source, state)
    }
    let report: string = widget_report("press-" + int_to_str(u32(widget.id)))
    return widget_curl_args(widget.method, hook, "5", report) == 0
}

// widgets_migrate_sources rewrites what older widgets stored — a Mesh URL, or
// the positional id Mesh used to give a source (`device.3.switch`) — as the
// source's stable id (`<node id>.switch`), from the legacy ids the gateway
// lists. It answers how many widgets it rewrote.
fn widgets_migrate_sources() u32 {
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return 0
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    // The gateway is asked only when some widget still has an older source, and
    // not again within a minute when what it listed did not have it.
    var pending: bool = false
    if listed.is_ok {
        var j: u32 = 0
        while j < listed.ok {
            if str_index_of(widgets[j].source, "/sources/") >= 0 ||
                (str_eq(widgets[j].sourceKind, "mesh") && (str_starts_with(widgets[j].source, "device.") ||
                str_starts_with(widgets[j].source, "module."))) {
                pending = true
            }
            j = j + 1
        }
    }
    let stamp: string = widget_state_dir() + "/migrate.wait"
    let now: u32 = widget_now()
    if !pending || now < int_from_str(str_trim(rho_read_text(stamp))) {
        sql_close(db)
        return 0
    }
    let listed_sources: string = gateway.sources()
    var moved: u32 = 0
    if listed.is_ok && listed_sources != "" {
        var i: u32 = 0
        while i < listed.ok {
            let widget: Widgets = widgets[i]
            var legacy: string = ""
            let marker: i32 = str_index_of(widget.source, "/sources/")
            if marker >= 0 {
                let tail: string = str_slice(widget.source, u32(marker) + 9,
                    u32(strlen(widget.source)) - u32(marker) - 9)
                let slash: i32 = str_index_of(tail, "/")
                legacy = tail
                if slash >= 0 {
                    legacy = str_slice(tail, 0, u32(slash))
                }
            } else if str_eq(widget.sourceKind, "mesh") && (str_starts_with(widget.source, "device.") ||
                str_starts_with(widget.source, "module.")) {
                legacy = widget.source
            }
            if legacy != "" {
                var stable: string = ""
                let by_legacy: i32 = str_index_of(listed_sources, "\"legacy_id\":" + json_string(legacy))
                if by_legacy >= 0 {
                    // The entry's id is before its legacy_id, in the same object.
                    let before: string = str_slice(listed_sources, 0, u32(by_legacy))
                    var open: i32 = -1
                    var k: u32 = 0
                    while k < u32(strlen(before)) {
                        if str_eq(str_slice(before, k, 7), "{\"id\":\"") {
                            open = i32(k)
                        }
                        k = k + 1
                    }
                    if open >= 0 {
                        stable = widget_json_string_field(str_slice(before, u32(open), u32(strlen(before)) - u32(open)), "id")
                    }
                } else if str_index_of(listed_sources, "\"id\":" + json_string(legacy)) >= 0 {
                    stable = legacy
                }
                if stable != "" && (!str_eq(stable, widget.source) || !str_eq(widget.sourceKind, "mesh")) {
                    widget_ignore_result(UpdateWidgetSourceOnly("mesh", stable, widget.id, db))
                    moved = moved + 1
                }
            }
            i = i + 1
        }
    }
    sql_close(db)
    if moved > 0 {
        info("widgets", int_to_str(moved) + " widget sources moved to stable gateway ids")
    } else {
        rho_write_text(stamp, int_to_str(now + 60))
    }
    return moved
}

fn widget_latest_text(db: SqlDb, widget_id: u32) string {
    let values: WidgetValues[100]
    let slice: Slice[WidgetValues] = Slice[WidgetValues]{
        Ptr[WidgetValues](&values[0]), WIDGETS_VALUE_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgetValues(i64(widget_id), db, slice,
        WIDGETS_VALUE_CAPACITY)
    if listed.is_ok && listed.ok > 0 {
        return values[0].valueText
    }
    return ""
}

fn widget_toggle_state(db: SqlDb, widget_id: u32) string {
    let latest: string = widget_latest_text(db, widget_id)
    if str_eq(latest, "on") {
        return "on"
    }
    return "off"
}

fn widget_replace(text: string, needle: string, value: string) string {
    let at: i32 = str_index_of(text, needle)
    if at < 0 {
        return text
    }
    return str_slice(text, 0, u32(at)) + value +
        str_slice(text, u32(at) + u32(strlen(needle)),
            u32(strlen(text)) - u32(at) - u32(strlen(needle)))
}

fn widget_hook(source: string, state: string) string {
    if str_index_of(source, "{state}") >= 0 {
        return widget_replace(source, "{state}", state)
    }
    if str_index_of(source, "?") >= 0 {
        return source + "&state=" + state
    }
    return source + "?state=" + state
}

fn widget_ignore_result(value: Result[u32, SqlError]) void {
}

fn widgets_ignore(value: Result[u32, SqlError]) void {
}

fn widgets_ignore_u32(value: u32) void {
}

fn widget_ignore_string(value: string) void {
}

fn widget_refresh(widget: Widgets) string {
    if widget_mesh_source(widget) {
        return gateway.source_latest(widget_gateway_id(widget))
    }
    if str_eq(widget.sourceKind, "value") {
        // One of the application's own values (appapi): kept like a URL's, so
        // a chart has its history.
        let text: string = appapi_value(widget.source)
        if text == "" {
            return ""
        }
        let opened: Result[SqlDb, string] = sql_open(widget_db_path())
        if !opened.is_ok {
            return ""
        }
        let db: SqlDb = opened.ok
        sql_apply(db, "")
        if str_eq(widget_latest_text(db, u32(widget.id)), text) {
            sql_close(db)
            return ""
        }
        widget_ignore_result(InsertWidgetValue(int_to_str(u32(widget.id)), text,
            int_to_str(u32(milli_parse(text))), int_to_str(widget_now()), db))
        sql_close(db)
        return text
    }
    if str_eq(widget.kind, "button") || str_eq(widget.kind, "toggle") ||
        !str_eq(widget.sourceKind, "url") ||
        strlen(widget.source) == 0 {
        return ""
    }
    let text: string = str_trim(widget_curl(widget.source, ""))
    if strlen(text) == 0 {
        return ""
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return ""
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    if str_eq(widget_latest_text(db, u32(widget.id)), text) {
        sql_close(db)
        return ""
    }
    widget_ignore_result(InsertWidgetValue(int_to_str(u32(widget.id)), text,
        int_to_str(u32(milli_parse(text))), int_to_str(widget_now()), db))
    sql_close(db)
    return text
}

fn widget_chart(values: WidgetValues[100], count: u32, locale: string) string {
    if count < 2 {
        return template_fill(widget_template("cards/chart-empty"), vars("__locale", locale))
    }
    // Min and max are dominated by a single outlier (a sensor glitch, a
    // missed reading). Use the 5th and 95th percentiles instead, found without
    // sorting: for each value, count how many of the others are at or below it.
    // Use min and max, but remove a single dominant outlier: if the largest
    // value is more than twice as far from the second-largest as the second-
    // largest is from the smallest, drop it from the scale.
    // Sort the values (bubble sort, N <= 100) to find robust percentiles.
    var sorted: WidgetValues[100]
    var i: u32 = 0
    while i < count {
        sorted[i] = values[i]
        i = i + 1
    }
    i = 0
    while i < count {
        var j: u32 = 0
        while j + 1 < count - i {
            if sorted[j].valueMilli > sorted[j + 1].valueMilli {
                let tmp: WidgetValues = sorted[j]
                sorted[j] = sorted[j + 1]
                sorted[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    // Use 10th and 90th percentiles (clamped to at least 2 values apart)
    let lo_idx: u32 = count / 10
    let hi_idx: u32 = (count * 9) / 10
    var low: i64 = sorted[lo_idx].valueMilli
    var high: i64 = sorted[hi_idx].valueMilli
    if high - low < 1000 {
        let middle: i64 = (low + high) / 2
        low = middle - 500
        high = middle + 500
    }
    // A stable reading is a real answer, not a flat line pinned to an edge.
    // Give a nearly constant series a small window around its middle so the
    // card shows it where a person expects a value to sit.
    if high - low < 1000 {
        let middle: i64 = (low + high) / 2
        low = middle - 500
        high = middle + 500
    }
    var points: string = ""
    i = 0
    while i < count {
        let index: u32 = count - 1 - i
        let x: u32 = (i * 100) / (count - 1)
        var yval: i64 = values[index].valueMilli
        if yval < low { yval = low }
        if yval > high { yval = high }
        let y: u32 = 27 - u32(((yval - low) * 22) / (high - low + 1))
        points = points + int_to_str(x) + "," + int_to_str(y) + " "
        i = i + 1
    }
    return template_fill(widget_template("cards/chart"), vars("points", str_trim(points)) + vars("__locale", locale))
}

fn widget_setting(key: string, fallback: string) string {
    let value: string = settings_get("widgets." + key, "")
    if value != "" {
        return str_trim(value)
    }
    // Older widget installs kept one file per setting.
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/widgets"
    }
    let legacy: string = str_trim(rho_read_text(workspace + "/data/" + key))
    if legacy != "" {
        return legacy
    }
    return fallback
}

fn widget_field(line: string, index: u32) string {
    var rest: string = line
    var i: u32 = 0
    while i < index {
        let at: i32 = str_index_of(rest, "|")
        if at < 0 {
            return ""
        }
        rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        i = i + 1
    }
    let at: i32 = str_index_of(rest, "|")
    if at < 0 {
        return rest
    }
    return str_slice(rest, 0, u32(at))
}

fn widget_json_string_field(text: string, key: string) string {
    let at: i32 = str_index_of(text, "\"" + key + "\":\"")
    if at < 0 {
        return ""
    }
    let start: u32 = u32(at) + u32(strlen(key)) + 4
    let rest: string = str_slice(text, start, u32(strlen(text)) - start)
    let end: i32 = str_index_of(rest, "\"")
    if end < 0 {
        return ""
    }
    return str_slice(rest, 0, u32(end))
}

fn widget_json_number_field(text: string, key: string) string {
    let at: i32 = str_index_of(text, "\"" + key + "\":")
    if at < 0 {
        return ""
    }
    let start: u32 = u32(at) + u32(strlen(key)) + 3
    var rest: string = str_slice(text, start, u32(strlen(text)) - start)
    var out: string = ""
    var i: u32 = 0
    while i < u32(strlen(rest)) {
        let ch: string = str_slice(rest, i, 1)
        if (ch >= "0" && ch <= "9") || str_eq(ch, ".") || str_eq(ch, "-") || str_eq(ch, "e") || str_eq(ch, "E") || str_eq(ch, "+") {
            out = out + ch
            i = i + 1
        } else if out == "" && (str_eq(ch, " ") || str_eq(ch, "\t")) {
            i = i + 1
        } else {
            break
        }
    }
    return out
}

fn widget_write_setting(key: string, value: string) void {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/widgets"
    }
    let dir: string = workspace + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    rho_write_text(dir + "/" + key, value)
}

// The gateway interface, as the host binds it, supplies the sources. The widgets module knows
// only the fields of a source, not which provider produced them.
fn widget_gateway_sources() string {
    return gateway.sources()
}

struct WidgetJsonObject {
    object: string
    rest: string
}

fn widget_next_object(text: string) WidgetJsonObject {
    var out: WidgetJsonObject = WidgetJsonObject{ "", text }
    let open_rel: i32 = str_index_of(text, "{")
    if open_rel < 0 {
        return out
    }
    let open_at: u32 = u32(open_rel)
    let close_rel: i32 = str_index_of(str_slice(text, open_at + 1,
        u32(strlen(text)) - open_at - 1), "}")
    if close_rel < 0 {
        return out
    }
    let close_at: u32 = open_at + 1 + u32(close_rel)
    out.object = str_slice(text, open_at, close_at - open_at + 1)
    out.rest = str_slice(text, close_at + 1,
        u32(strlen(text)) - close_at - 1)
    return out
}

fn widget_gateway_source_options(selected: string) string {
    let text: string = widget_gateway_sources()
    var out: string = "<option value=\"\">Choose a gateway source</option>"
    if text == "" {
        return out
    }
    var rest: string = text
    while strlen(rest) > 0 {
        let parsed: WidgetJsonObject = widget_next_object(rest)
        if parsed.object == "" {
            break
        }
        let object: string = parsed.object
        rest = parsed.rest
        let id: string = widget_json_string_field(object, "id")
        let owner: string = widget_json_string_field(object, "owner")
        let label: string = widget_json_string_field(object, "label")
        let direction: string = widget_json_string_field(object, "direction")
        let unit: string = widget_json_string_field(object, "unit")
        let kinds: string = widget_json_string_field(object, "kinds")
        let value_url: string = widget_json_string_field(object, "value_url")
        let action_url: string = widget_json_string_field(object, "action_url")
        if id == "" || direction == "" || value_url == "" {
            continue
        }
        var mark: string = ""
        if (selected != "" && str_eq(value_url, selected)) ||
            (selected != "" && str_eq(action_url, selected)) ||
            (selected != "" && str_eq(id, selected)) {
            mark = " selected"
        }
        var text_label: string = owner
        if label != "" {
            text_label = text_label + " · " + label
        }
        if unit != "" {
            text_label = text_label + " (" + unit + ")"
        }
        if str_eq(direction, "output") {
            text_label = text_label + " — output"
        }
        out = out + "<option value=\"" + escape_html(id) + "\"" +
            " data-direction=\"" + escape_html(direction) + "\"" +
            " data-kinds=\"" + escape_html(kinds) + "\"" +
            " data-unit=\"" + escape_html(unit) + "\"" +
            " data-value=\"" + escape_html(value_url) + "\"" +
            " data-action=\"" + escape_html(action_url) + "\"" + mark + ">" +
            escape_html(text_label) + "</option>"
    }
    return out
}

fn widget_gateway_source_choices() string {
    let text: string = widget_gateway_sources()
    var out: string = ""
    if text == "" {
        return out
    }
    var rest: string = text
    while strlen(rest) > 0 {
        let parsed: WidgetJsonObject = widget_next_object(rest)
        if parsed.object == "" {
            break
        }
        let object: string = parsed.object
        rest = parsed.rest
        let id: string = widget_json_string_field(object, "id")
        let owner: string = widget_json_string_field(object, "owner")
        let label: string = widget_json_string_field(object, "label")
        let unit: string = widget_json_string_field(object, "unit")
        let direction: string = widget_json_string_field(object, "direction")
        let value_url: string = widget_json_string_field(object, "value_url")
        if id == "" || value_url == "" {
            continue
        }
        var text_label: string = owner
        if label != "" {
            text_label = text_label + " · " + label
        }
        if unit != "" {
            text_label = text_label + " (" + unit + ")"
        }
        if str_eq(direction, "output") {
            text_label = text_label + " — output"
        }
        if out != "" { out = out + "," }
        out = out + id + "|" + text_label
    }
    return out
}

fn widget_kind_options(selected: string) string {
    var out: string = ""
    let kinds: string = "numeric|Number\nchart|Chart\ntable|Table\nstatus|Status\nbutton|Button\ntoggle|Switch"
    var rest: string = kinds
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        var mark: string = ""
        if str_eq(widget_field(line, 0), selected) {
            mark = " selected"
        }
        out = out + "<option value=\"" + escape_html(widget_field(line, 0)) + "\"" + mark + ">" +
            escape_html(widget_field(line, 1)) + "</option>"
    }
    return out
}

fn widget_source_kind_options(selected: string) string {
    var out: string = ""
    let kinds: string = "manual|Manual\nurl|URL / hook\nmesh|Gateway source\nitem|Inventory item (handle.capability)\nvalue|Application value"
    var rest: string = kinds
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        var mark: string = ""
        if str_eq(widget_field(line, 0), selected) {
            mark = " selected"
        }
        out = out + "<option value=\"" + escape_html(widget_field(line, 0)) + "\"" + mark + ">" +
            escape_html(widget_field(line, 1)) + "</option>"
    }
    return out
}

fn widget_method_options(selected: string) string {
    var out: string = ""
    if !str_eq(selected, "POST") {
        out = "<option value=\"GET\" selected>GET</option><option value=\"POST\">POST</option>"
    } else {
        out = "<option value=\"GET\">GET</option><option value=\"POST\" selected>POST</option>"
    }
    return out
}

fn widget_round(value: string, decimals: u32) string {
    let v: string = str_trim(value)
    if v == "" {
        return v
    }
    let dot: i32 = str_index_of(v, ".")
    if dot < 0 {
        return v
    } else {
        let intpart: string = str_slice(v, 0, u32(dot))
        let frac: string = str_slice(v, u32(dot) + 1, u32(strlen(v)) - u32(dot) - 1)
        if decimals == 0 {
            return intpart
        } else {
            var n: u32 = decimals
            if n > 3 { n = 3 }
            if u32(strlen(frac)) <= n {
                return v
            } else {
                let kept: string = str_slice(frac, 0, n)
                return intpart + "." + kept
            }
        }
    }
}

fn widget_table(values: WidgetValues[100], count: u32, rows: u32, unit: string, decimals: u32, locale: string) string {
    var limit: u32 = rows
    if limit == 0 { limit = 10 }
    if limit > 100 { limit = 100 }
    if limit > count { limit = count }
    var out: string = ""
    if limit == 0 {
        out = template_fill(widget_template("cards/table-empty"), vars("__locale", locale))
    }
    var i: u32 = 0
    while i < limit {
        let value: WidgetValues = values[i]
        let epoch: u32 = u32(value.recordedEpoch)
        out = out + template_fill(widget_template("cards/table-row"),
            vars("__locale", locale) +
            vars("epoch", int_to_str(epoch)) +
            vars("value", widget_round(value.valueText, decimals)) +
            vars("unit", unit))
        i = i + 1
    }
    return template_fill(widget_template("cards/table"), vars("rows", out) + vars("__locale", locale))
}

fn widget_card_controls(id: u32, pinned: u32, kind: string, locale: string) string {
    let sid: string = int_to_str(id)
    var pinnable: string = ""
    var pinned_flag: string = ""
    var pin_val: string = "1"
    var pin_icon: string = "📌"
    if str_eq(kind, "numeric") || str_eq(kind, "chart") {
        pinnable = "true"
        if pinned == 1 {
            pinned_flag = "true"
            pin_val = "0"
            pin_icon = "📍"
        }
    }
    return template_fill(widget_template("cards/controls"),
        vars("__locale", locale) +
        vars("id", sid) +
        vars("pinnable", pinnable) +
        vars("pin_value", pin_val) +
        vars("pin_icon", pin_icon) +
        vars("pinned", pinned_flag))
}

fn widget_card(db: SqlDb, widget: Widgets, locale: string) string {
    let values: WidgetValues[100]
    var count: u32 = 0
    var latest: string = ""
    let unit: string = widget.unit
    let mesh_source: bool = widget_mesh_source(widget)
    if mesh_source && (str_eq(widget.kind, "chart") || str_eq(widget.kind, "table")) {
        // A chart shows at most widget.points buckets; reading a day of history
        // to keep 24 of them makes the page slow. Request only the recent window
        // that fills the chart, plus a little headroom.
        let history: string = gateway.source_history(widget_gateway_id(widget), "2h", "", "60000")
        let marker: i32 = str_index_of(history, "\"points\":[")
        if marker >= 0 {
            var rest: string = str_slice(history, u32(marker) + 10,
                u32(strlen(history)) - u32(marker) - 10)
            while rest != "" && count < WIDGETS_VALUE_CAPACITY {
                let at: i32 = str_index_of(rest, "},{")
                var object: string = rest
                if at < 0 {
                    rest = ""
                } else {
                    object = str_slice(rest, 0, u32(at) + 1)
                    rest = str_slice(rest, u32(at) + 3,
                        u32(strlen(rest)) - u32(at) - 3)
                }
                let value_text: string = widget_json_number_field(object, "v")
                if value_text != "" {
                    var held: WidgetValues
                    held.valueText = value_text
                    held.valueMilli = milli_parse(value_text)
                    held.recordedEpoch = i64(widget_epoch_seconds(
                        widget_json_number_field(object, "t")))
                    values[count] = held
                    count = count + 1
                }
            }
        }
        // The series is oldest first; the card shows the newest first.
        var i: u32 = 0
        while i < count / 2 {
            let held: WidgetValues = values[i]
            values[i] = values[count - 1 - i]
            values[count - 1 - i] = held
            i = i + 1
        }
        latest = gateway.source_latest(widget_gateway_id(widget))
        if latest == "" && count > 0 {
            latest = values[0].valueText
        }
    } else if mesh_source {
        latest = gateway.source_latest(widget_gateway_id(widget))
    } else {
        let slice: Slice[WidgetValues] = Slice[WidgetValues]{
            Ptr[WidgetValues](&values[0]), WIDGETS_VALUE_CAPACITY }
        let listed: Result[u32, SqlError] = ListWidgetValues(i64(u32(widget.id)), db, slice,
            WIDGETS_VALUE_CAPACITY)
        if listed.is_ok {
            count = listed.ok
        }
        latest = widget_latest_text(db, u32(widget.id))
    }
    let sid: string = int_to_str(u32(widget.id))
    let controls: string = widget_card_controls(u32(widget.id), u32(widget.pinned), widget.kind, locale)
    if str_eq(widget.kind, "button") {
        return template_fill(widget_template("cards/button"),
            vars("__locale", locale) + vars("locale", locale) +
            vars("id", sid) + vars("size", widget.size) +
            vars("title", widget.title) + vars("controls", controls))
    }
    if str_eq(widget.kind, "toggle") {
        let state: string = widget_toggle_state(db, u32(widget.id))
        var on_class: string = ""
        var on_flag: string = ""
        if str_eq(state, "on") {
            on_class = " on"
            on_flag = "true"
        }
        return template_fill(widget_template("cards/toggle"),
            vars("__locale", locale) + vars("locale", locale) +
            vars("id", sid) + vars("size", widget.size) +
            vars("title", widget.title) + vars("controls", controls) +
            vars("on_class", on_class) + vars("on", on_flag))
    }
    if str_eq(widget.kind, "table") {
        return template_fill(widget_template("cards/table-card"),
            vars("__locale", locale) + vars("locale", locale) +
            vars("refresh_seconds", widget_setting("refresh_seconds", "10")) +
            vars("id", sid) + vars("size", widget.size) +
            vars("title", widget.title) + vars("controls", controls) +
            vars("table", widget_table(values, count, u32(widget.points), unit, u32(widget.decimals), locale)) +
            vars("count", int_to_str(count)) +
            vars("source_kind", widget.sourceKind))
    }
    if str_eq(widget.kind, "status") {
        var state_class: string = "info"
        var text: string = latest
        let colon: i32 = str_index_of(latest, ":")
        if colon >= 0 {
            let prefix: string = str_slice(latest, 0, u32(colon))
            text = str_slice(latest, u32(colon) + 1,
                u32(strlen(latest)) - u32(colon) - 1)
            if str_eq(prefix, "ok") || str_eq(prefix, "warn") ||
                str_eq(prefix, "bad") || str_eq(prefix, "info") {
                state_class = prefix
            }
        }
        if text == "" {
            text = "—"
        }
        return template_fill(widget_template("cards/status"),
            vars("__locale", locale) + vars("locale", locale) +
            vars("id", sid) + vars("size", widget.size) +
            vars("title", widget.title) + vars("controls", controls) +
            vars("state_class", state_class) + vars("text", text))
    }
    var chart: string = ""
    if str_eq(widget.kind, "chart") {
        chart = widget_chart(values, count, locale)
    }
    return template_fill(widget_template("cards/numeric"),
        vars("__locale", locale) + vars("locale", locale) +
        vars("refresh_seconds", widget_setting("refresh_seconds", "10")) +
        vars("id", sid) + vars("size", widget.size) +
        vars("title", widget.title) + vars("controls", controls) +
        vars("chart", chart) + vars("unit", unit) +
        vars("latest", widget_round(latest, u32(widget.decimals))))

}

fn widgets_dashboard_cards(refresh: bool, locale: string) string {
    // A page load reads the gateway before it renders, so a plug switched in
    // another tab or application is already correct in the first paint. The
    // fragment route re-renders what is stored and does not fetch again, so a
    // client that follows an event does not start another fetch.
    if refresh {
        widgets_sync_state()
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return ""
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var out: string = ""
    var i: u32 = 0
    while i < count {
        if refresh {
            widget_ignore_string(widget_refresh(widgets[i]))
        }
        out = out + widget_card(db, widgets[i], locale)
        i = i + 1
    }
    sql_close(db)
    if out == "" {
        out = template_fill(widget_template("cards/empty"), vars("__locale", locale))
    }
    return template_fill(widget_template("cards/grid"), vars("cards", out) + vars("__locale", locale) + vars("locale", locale))
}

fn widget_rows(db: SqlDb, widgets: Widgets[128], count: u32, locale: string) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let widget: Widgets = widgets[i]
        let latest: string = widget_latest_text(db, u32(widget.id))
        out = out + template_fill(widget_template("rows/widget-row"),
            vars("__locale", locale) +
            vars("id", int_to_str(u32(widget.id))) +
            vars("title", widget.title) +
            vars("kind", widget.kind) +
            vars("source", widget.sourceKind + " · " + widget.source) +
            vars("latest", latest + " " + widget.unit) +
            vars("method", widget.method) +
            vars("manual", if str_eq(widget.sourceKind, "manual") { "1" } else { "" }) +
            vars("pressable", if str_eq(widget.kind, "button") ||
                str_eq(widget.kind, "toggle") { "1" } else { "" }))
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"5\">No widgets yet.</td></tr>"
    }
    return out
}

fn widgets_docs() string {
    let text: string = rho_asset("widgets", "docs/index.md")
    if text == "" {
        return "No documentation found."
    }
    return text
}

// widgets_refresh_all pulls every URL source once and emits an SSE event for
// each card whose value changed. A host calls it from its background worker, so
// a dashboard stays current without the host knowing how a widget is rendered
// or where a value is stored.
// widgets_live_file is where the project's live stream from Mesh is followed.
fn widgets_live_file() string {
    return widget_state_dir() + "/mesh-live.jsonl"
}

// widgets_live_changed follows the project's live stream (started once, kept
// open by the runtime) and reports whether anything arrived since it was last
// asked. An application refreshes its widgets when this says so, rather than on
// a timer, so a reading reaches a card as soon as Mesh has stored it.
fn widgets_live_changed() bool {
    let path: string = widgets_live_file()
    if !gateway.follow(path) {
        return false
    }
    let seen_file: string = widget_state_dir() + "/mesh-live.seen"
    let size: string = int_to_str(u32(strlen(rho_read_text(path))))
    if str_eq(size, rho_read_text(seen_file)) {
        return false
    }
    rho_write_text(seen_file, size)
    return true
}

fn widgets_refresh_all() u32 {
    // Older sources move to stable gateway ids.
    widgets_ignore_u32(widgets_migrate_sources())
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return 0
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var changed: u32 = 0
    var i: u32 = 0
    while i < count {
        let current: string = widget_latest_text(db, u32(widgets[i].id))
        let latest: string = widget_refresh(widgets[i])
        if latest != "" && !str_eq(latest, current) {
            widget_event(u32(widgets[i].id), latest)
            changed = changed + 1
        }
        i = i + 1
    }
    sql_close(db)
    return changed
}

fn widgets_page_message(req: Request, message: string) Response {
    widgets_sync_state()
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return html(status_internal(), "<h1>Widgets</h1><p>The database could not be opened: " +
            escape_html(opened.err) + "</p>")
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    let locale: string = i18n_locale(req)
    let rows_html: string = widget_rows(db, widgets, count, locale)
    sql_close(db)
    let notice: string = ""
    if message != "" {
        notice = template_fill(widget_template("parts/notice"), vars("message", message))
    }
    var add_fields: FormField[9]
    add_fields[0] = FormField{ "title", "text", i18n_t(req, "widget.field.title"), "",
        "Water temperature", true, "", "", "", "", "" }
    add_fields[1] = FormField{ "kind", "select", i18n_t(req, "widget.field.kind"), "",
        "", false, "", "numeric|Number,chart|Chart,table|Table,status|Status,button|Button,toggle|Switch",
        "numeric", "", "" }
    add_fields[2] = FormField{ "source_kind", "select", i18n_t(req, "widget.field.source"), "",
        "", false, "", "manual|Manual,url|URL / hook,mesh|Mesh telemetry", "manual", "", "" }
    add_fields[3] = FormField{ "mesh_source", "select", i18n_t(req, "widget.field.mesh_source"), "",
        i18n_t(req, "widget.choose_source"), false, "",
        widget_gateway_source_choices(), "", "", "" }
    add_fields[4] = FormField{ "source", "text", i18n_t(req, "widget.field.url"), "",
        "http://host/api or hook?state={state}", false, "", "", "", "", "" }
    add_fields[5] = FormField{ "method", "select", i18n_t(req, "widget.field.method"), "",
        "", false, "", "GET|GET,POST|POST", "GET", "", "" }
    add_fields[6] = FormField{ "unit", "text", i18n_t(req, "widget.field.unit"), "",
        "°C", false, "", "", "", "", "" }
    add_fields[7] = FormField{ "points", "text", i18n_t(req, "widget.field.points"), "",
        "24", false, "", "", widget_setting("points", "24"), "", "numeric" }
    add_fields[8] = FormField{ "decimals", "select", i18n_t(req, "widget.field.decimals"), "",
        "", false, "", "0|0,1|0.1,2|0.01,3|0.001", widget_setting("decimals", "2"), "", "" }
    let add_form: string = forms_open(add_fields, 9, "/widgets/add",
        i18n_t(req, "widget.add"), i18n_locale(req))
    let body: string = template_fill(widget_template("pages/widgets"),
        i18n_vars(req) +
        vars("tabs_class", settings_get("ui.tabs", "vertical")) +
        vars("add_form", add_form) +
        vars("notice", notice) + vars("rows", rows_html) +
        vars("preview", widgets_dashboard_cards(true, locale)) +
        vars("docs", widgets_docs()) +
        vars("notifications", notification_embed()))
    return host_shell(req, i18n_t(req, "widget.title"), body, "")
}

fn widgets_cards_endpoint(req: Request) Response {
    return html(status_ok(), widgets_dashboard_cards(true, i18n_locale(req)))
}

fn widgets_page(req: Request) Response {
    return widgets_page_message(req, "")
}

fn widgets_add(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return widgets_page_message(req, i18n_t(req, "widget.csrf_refused"))
    }
    let title: string = str_trim(form_field(body, "title"))
    if strlen(title) == 0 {
        return widgets_page_message(req, "A widget needs a title.")
    }
    var kind: string = form_field(body, "kind")
    if strlen(kind) == 0 {
        kind = "numeric"
    }
    var source_kind: string = form_field(body, "source_kind")
    if strlen(source_kind) == 0 {
        source_kind = "manual"
    }
    var source: string = str_trim(form_field(body, "source"))
    var method: string = str_trim(form_field(body, "method"))
    if strlen(method) == 0 {
        method = "GET"
    }
    var mesh_source: string = str_trim(form_field(body, "mesh_source"))
    var device_url: string = str_trim(form_field(body, "device_url"))
    if device_url != "" {
        source = device_url
        method = "POST"
        source_kind = "url"
    } else if mesh_source != "" {
        source = mesh_source
        source_kind = "mesh"
        method = "GET"
    }
    let unit: string = str_trim(form_field(body, "unit"))
    var points: u32 = int_from_str(str_trim(form_field(body, "points")))
    if points == 0 {
        points = 24
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let added: Result[u32, SqlError] = InsertWidget(title, kind, source_kind, source,
        method, unit, int_to_str(points), "0", "small", "2",
        int_to_str(widget_now()), db)
    sql_close(db)
    if !added.is_ok {
        notification_push_level_locale(i18n_t(req, "toast.widget_failed") + ": " + added.err.message, "error", 10, i18n_locale(req))
        return widgets_page_message(req, "The widget could not be saved: " + added.err.message)
    }
    notification_push_level_locale(i18n_t(req, "toast.widget_added"), "info", 10, i18n_locale(req))
    info("widgets", "widget added")
    return widgets_page_message(req, "Widget added.")
}

fn widget_edit_page(req: Request) Response {
    let id: u32 = int_from_str(request_query_param(req, "id"))
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    sql_close(db)
    var i: u32 = 0
    var found: i32 = -1
    while i < count {
        if u32(widgets[i].id) == id {
            found = i32(i)
        }
        i = i + 1
    }
    if found < 0 {
        return widgets_page_message(req, "That widget was not found.")
    }
    let index: u32 = u32(found)
    let widget: Widgets = widgets[index]
    let body: string = template_fill(widget_template("pages/widget-edit"),
        vars("id", int_to_str(u32(widget.id))) +
        vars("title", widget.title) +
        vars("kind", widget.kind) +
        vars("source_kind", widget.sourceKind) +
        vars("source", widget.source) +
        vars("method", widget.method) +
        vars("kind_options", widget_kind_options(widget.kind)) +
        vars("source_kind_options", widget_source_kind_options(widget.sourceKind)) +
        vars("method_options", widget_method_options(widget.method)) +
        vars("device_options", widget_gateway_source_options(widget.source)) +
        vars("unit", widget.unit) +
        vars("points", int_to_str(u32(widget.points))) +
        vars("decimals", int_to_str(u32(widget.decimals))) +
        vars("manual", if str_eq(widget.sourceKind, "manual") { "1" } else { "" }) +
        vars("pressable", if str_eq(widget.kind, "button") ||
            str_eq(widget.kind, "toggle") { "1" } else { "" }))
    return host_shell(req, "Edit widget", body, "")
}

fn widgets_edit_save(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    if id == 0 {
        return widgets_page_message(req, "That widget was not found.")
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    var source: string = str_trim(form_field(body, "source"))
    var method: string = str_trim(form_field(body, "method"))
    var source_kind: string = form_field(body, "source_kind")
    var mesh_source: string = str_trim(form_field(body, "mesh_source"))
    let device_url: string = str_trim(form_field(body, "device_url"))
    if device_url != "" {
        source = device_url
        method = "POST"
        source_kind = "url"
    } else if mesh_source != "" {
        source = mesh_source
        source_kind = "mesh"
        method = "GET"
    }
    let points: u32 = int_from_str(str_trim(form_field(body, "points")))
    var decimals: u32 = int_from_str(str_trim(form_field(body, "decimals")))
    if decimals > 3 { decimals = 3 }
    let updated: Result[u32, SqlError] = UpdateWidget(
        str_trim(form_field(body, "title")),
        form_field(body, "kind"),
        source_kind,
        source,
        method,
        str_trim(form_field(body, "unit")),
        i64(points), i64(decimals), i64(id), db)
    sql_close(db)
    if !updated.is_ok {
        return widgets_page_message(req, "The widget could not be saved: " + updated.err.message)
    }
    info("widgets", "widget saved")
    return widgets_page_message(req, "Widget saved.")
}

fn widgets_delete(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let removed: Result[u32, SqlError] = DeleteWidget(i64(id), db)
    sql_close(db)
    if !removed.is_ok {
        return widgets_page_message(req, "The widget could not be removed: " + removed.err.message)
    }
    info("widgets", "widget removed")
    return widgets_page_message(req, "Widget removed.")
}

fn widgets_move_response(req: Request) Response {
    if str_eq(header_str(req, "HX-Request"), "true") {
        return html(status_ok(), widgets_dashboard_cards(false, i18n_locale(req)))
    }
    return widgets_page_message(req, "Widget moved.")
}

fn widgets_move(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    let delta_str: string = str_trim(form_field(body, "delta"))
    var delta: i32 = 0
    if str_eq(delta_str, "-1") || str_eq(delta_str, "-") {
        delta = -1
    } else if str_eq(delta_str, "1") || str_eq(delta_str, "+") {
        delta = 1
    }
    if id == 0 {
        return widgets_page_message(req, "No such widget.")
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok { count = listed.ok }
    var idx: i32 = -1
    var i: u32 = 0
    while i < count {
        if u32(widgets[i].id) == id {
            idx = i32(i)
        }
        i = i + 1
    }
    if idx < 0 {
        sql_close(db)
        return widgets_move_response(req)
    }
    var n: u32 = 0
    while n < count {
        widgets_ignore(MoveWidget(i64(n), i64(u32(widgets[n].id)), db))
        widgets[n].position = i64(n)
        n = n + 1
    }
    var target: i32 = idx + delta
    if target < 0 { target = 0 }
    if target >= i32(count) { target = i32(count) - 1 }
    if target == idx {
        sql_close(db)
        return widgets_move_response(req)
    }
    let ai: u32 = u32(idx)
    let bi: u32 = u32(target)
    let a_id: u32 = u32(widgets[ai].id)
    let b_id: u32 = u32(widgets[bi].id)
    widgets_ignore(MoveWidget(i64(target), i64(a_id), db))
    widgets_ignore(MoveWidget(i64(idx), i64(b_id), db))
    sql_close(db)
    notification_push_level_locale(i18n_t(req, "toast.widget_moved"), "info", 5, i18n_locale(req))
    return widgets_move_response(req)
}

fn widgets_resize(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    if id == 0 {
        return widgets_page_message(req, "No such widget.")
    }
    let delta: string = str_trim(form_field(body, "delta"))
    let size_in: string = str_trim(form_field(body, "size"))
    var size: string = size_in
    if delta != "" {
        let opened0: Result[SqlDb, string] = sql_open(widget_db_path())
        if !opened0.is_ok {
            return widgets_page_message(req, "The database could not be opened: " + opened0.err)
        }
        let db0: SqlDb = opened0.ok
        sql_apply(db0, "")
        let widgets: Widgets[128]
        let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
        let listed: Result[u32, SqlError] = ListWidgets(db0, slice, WIDGET_CAPACITY)
        var cur: string = "small"
        var i: u32 = 0
        var count: u32 = 0
        if listed.is_ok { count = listed.ok }
        while i < count {
            if u32(widgets[i].id) == id {
                cur = widgets[i].size
            }
            i = i + 1
        }
        sql_close(db0)
        if str_eq(delta, "inc") {
            if str_eq(cur, "small") { size = "medium" }
            else if str_eq(cur, "medium") { size = "big" }
            else { size = "big" }
        } else {
            if str_eq(cur, "big") { size = "medium" }
            else if str_eq(cur, "medium") { size = "small" }
            else { size = "small" }
        }
    }
    if size == "" { size = "small" }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    widgets_ignore(ResizeWidget(size, i64(id), db))
    sql_close(db)
    notification_push_level_locale(i18n_t(req, "toast.widget_resized"), "info", 5, i18n_locale(req))
    if str_eq(header_str(req, "HX-Request"), "true") {
        return html(status_ok(), widget_card_html(id, i18n_locale(req)))
    }
    return widgets_page_message(req, "Widget resized.")
}

fn widgets_pin(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    let pinned: string = str_trim(form_field(body, "pinned"))
    if id == 0 {
        return widgets_page_message(req, "No such widget.")
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    var pval: i64 = 1
    if str_eq(pinned, "0") {
        pval = 0
    }
    widgets_ignore(PinWidget(pval, i64(id), db))
    sql_close(db)
    if str_eq(header_str(req, "HX-Request"), "true") {
        return html(status_ok(), widget_card_html(id, i18n_locale(req)))
    }
    return widgets_page_message(req, "Widget pinned.")
}

fn widgets_value(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    let value: string = str_trim(form_field(body, "value"))
    if id == 0 || strlen(value) == 0 {
        return widgets_page_message(req, "A value needs a widget and a number.")
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    widget_ignore_result(InsertWidgetValue(int_to_str(id), value,
        int_to_str(u32(milli_parse(value))), int_to_str(widget_now()), db))
    sql_close(db)
    return widgets_page_message(req, "Value recorded.")
}

fn widgets_press(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var i: u32 = 0
    var found: i32 = -1
    while i < count {
        if u32(widgets[i].id) == id {
            found = i32(i)
        }
        i = i + 1
    }
    if found < 0 {
        sql_close(db)
        return widgets_page_message(req, "That widget was not found.")
    }
    let found_index: u32 = u32(found)
    let widget: Widgets = widgets[found_index]
    var new_state: string = ""
    if str_eq(widget.kind, "toggle") {
        var state: string = widget_toggle_state(db, id)
        if str_eq(state, "on") {
            new_state = "off"
        } else {
            new_state = "on"
        }
    }
    var code: u32 = 0
    if !widget_switch(widget, new_state) {
        code = 1
    }
    if str_eq(widget.kind, "toggle") && code == 0 {
        widget_ignore_result(InsertWidgetValue(int_to_str(id), new_state,
            "0", int_to_str(widget_now()), db))
        // A second dashboard is listening to the stream; the press itself is
        // the event, not only the difference a poll would find later.
        widget_event(id, new_state)
    }
    var event_message: string = "Button " + widget.title + " pressed"
    if code != 0 {
        event_message = event_message + " (hook failed)"
    }
    journal_info("widget", widget.title, "person", event_message)
    let card: string = widget_card(db, widget, i18n_locale(req))
    sql_close(db)
    if str_eq(header_str(req, "HX-Request"), "true") {
        return html(status_ok(), card)
    }
    let back: string = form_field(body, "return")
    if str_eq(back, "dashboard") {
        var ok: string = "true"
        if code != 0 {
            ok = "false"
        }
        return json(status_ok(), "{\"ok\":" + ok + ",\"state\":" +
            json_string(new_state) + "}")
    }
    if code != 0 {
        return widgets_page_message(req, "The hook for " + widget.title + " failed.")
    }
    return widgets_page_message(req, widget.title + " was pressed.")
}

extern fn sse_file(path: string, interval_ms: u32) Response

fn widgets_events_file() string {
    return widget_state_dir() + "/events.jsonl"
}

fn widgets_snapshot_file() string {
    return widget_state_dir() + "/snapshot.jsonl"
}

fn widget_state_dir() string {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/widgets"
    }
    let dir: string = workspace + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    return dir
}

// widget_card_html renders one card by id, so an event can carry the same
// fragment a page shows rather than a state a client would have to interpret.
fn widget_card_html(widget_id: u32, locale: string) string {
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return ""
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var out: string = ""
    var i: u32 = 0
    while i < count {
        if u32(widgets[i].id) == widget_id {
            out = widget_card(db, widgets[i], locale)
        }
        i = i + 1
    }
    sql_close(db)
    return out
}

fn widget_event_json(event: string, data: string) string {
    return "{\"event\":" + json_string(event) + ",\"data\":" + json_string(data) + "}\n"
}

fn widget_event(widget_id: u32, state: string) void {
    let file: string = widgets_events_file()
    var lines: string = ""
    var locales: string = "en\nro"
    while locales != "" {
        let at: i32 = str_index_of(locales, "\n")
        var code: string = locales
        if at < 0 { locales = "" } else {
            code = str_slice(locales, 0, u32(at))
            locales = str_slice(locales, u32(at) + 1, u32(strlen(locales)) - u32(at) - 1)
        }
        if code != "" {
            let card: string = widget_card_html(widget_id, code)
            if card != "" {
                lines = lines + widget_event_json("widget-" + int_to_str(widget_id) + "-" + code, card)
            }
        }
    }
    rho_write_text(file, rho_read_text(file) + lines)
}

fn widgets_snapshot_events() void {
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var out: string = ""
    var i: u32 = 0
    while i < count {
        var locales: string = "en\nro"
        while locales != "" {
            let at: i32 = str_index_of(locales, "\n")
            var code: string = locales
            if at < 0 { locales = "" } else {
                code = str_slice(locales, 0, u32(at))
                locales = str_slice(locales, u32(at) + 1, u32(strlen(locales)) - u32(at) - 1)
            }
            if code != "" {
                out = out + widget_event_json("widget-" + int_to_str(u32(widgets[i].id)) + "-" + code,
                    widget_card(db, widgets[i], code))
            }
        }
        i = i + 1
    }
    sql_close(db)
    rho_write_text(widgets_snapshot_file(), out)
}

fn widgets_events(req: Request) Response {
    // A reconnect must show the current state, not replay every state the card
    // has ever had. The snapshot is sent before the live file is followed.
    widgets_snapshot_events()
    return sse_events(widgets_events_file(), widgets_snapshot_file(), 1000)
}

fn widget_device_states() string {
    return gateway.device_states()
}

// widget_gateway_state reads the state behind a source URL. The provider knows
// how its own URL answers; the widget only passes the source it stored.
fn widget_gateway_state(widget: Widgets) string {
    let id: string = widget_gateway_id(widget)
    let state: string = gateway.source_state(id)
    if state != "" || !widget_mesh_source(widget) {
        return state
    }
    // A stable id reads its value; a switch's value is on, off, 1 or 0.
    let value: string = gateway.source_latest(id)
    if str_eq(value, "on") || str_eq(value, "1") {
        return "on"
    }
    if str_eq(value, "off") || str_eq(value, "0") {
        return "off"
    }
    return ""
}

fn widgets_sync_state() u32 {
    let states: string = widget_device_states()
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return 0
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var updated: u32 = 0
    var i: u32 = 0
    while i < count {
        let widget: Widgets = widgets[i]
        if str_eq(widget.kind, "toggle") {
            let marker: i32 = str_index_of(widget.source, "/api/v1/devices/")
            if marker >= 0 {
                let tail: string = str_slice(widget.source, u32(marker) + 16,
                    u32(strlen(widget.source)) - u32(marker) - 16)
                let slash: i32 = str_index_of(tail, "/")
                if slash > 0 {
                    let device_id: string = str_slice(tail, 0, u32(slash))
                    var rest: string = states
                    var state: string = ""
                    while rest != "" {
                        let at: i32 = str_index_of(rest, "\n")
                        let line: string = ""
                        if at < 0 {
                            line = rest
                            rest = ""
                        } else {
                            line = str_slice(rest, 0, u32(at))
                            rest = str_slice(rest, u32(at) + 1,
                                u32(strlen(rest)) - u32(at) - 1)
                        }
                        let colon: i32 = str_index_of(line, ":")
                        if colon > 0 && str_eq(str_slice(line, 0, u32(colon)), device_id) {
                            state = str_slice(line, u32(colon) + 1,
                                u32(strlen(line)) - u32(colon) - 1)
                        }
                    }
                    if state != "" && !str_eq(widget_toggle_state(db, u32(widget.id)), state) {
                        widget_ignore_result(InsertWidgetValue(int_to_str(u32(widget.id)), state,
                            "0", int_to_str(widget_now()), db))
                        widget_event(u32(widget.id), state)
                        updated = updated + 1
                    }
                }
            }
            let gateway_state: string = widget_gateway_state(widget)
            if gateway_state != "" && !str_eq(widget_toggle_state(db, u32(widget.id)), gateway_state) {
                widget_ignore_result(InsertWidgetValue(int_to_str(u32(widget.id)), gateway_state,
                    "0", int_to_str(widget_now()), db))
                widget_event(u32(widget.id), gateway_state)
                updated = updated + 1
            }
        }
        i = i + 1
    }
    sql_close(db)
    return updated
}

fn widgets_refresh_values() u32 {
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return 0
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var changed: u32 = 0
    var i: u32 = 0
    while i < count {
        if widget_refresh(widgets[i]) != "" {
            changed = changed + 1
        }
        i = i + 1
    }
    sql_close(db)
    return changed
}

fn widget_event_cards() void {
    let file: string = widgets_events_file()
    var lines: string = ""
    var locales: string = "en\nro"
    while locales != "" {
        let at: i32 = str_index_of(locales, "\n")
        var code: string = locales
        if at < 0 { locales = "" } else {
            code = str_slice(locales, 0, u32(at))
            locales = str_slice(locales, u32(at) + 1, u32(strlen(locales)) - u32(at) - 1)
        }
        if code != "" {
            let grid: string = widgets_dashboard_cards(false, code)
            if grid != "" {
                lines = lines + widget_event_json("widget-cards-" + code, grid)
            }
        }
    }
    rho_write_text(file, rho_read_text(file) + lines)
}

fn widgets_refresh(req: Request) Response {
    let updated: u32 = widgets_sync_state()
    let changed: u32 = widgets_refresh_values()
    if changed > 0 {
        widget_event_cards()
    }
    return json(status_ok(), "{\"updated\":" + int_to_str(updated) +
        ",\"changed\":" + int_to_str(changed) + "}")
}

fn widgets_cards(req: Request) Response {
    return html(status_ok(), widgets_dashboard_cards(false, i18n_locale(req)))
}

fn widgets_card_endpoint(req: Request) Response {
    let id: u32 = u32(int_from_str(param(req, "id")))
    let card: string = widget_card_html(id, i18n_locale(req))
    if card == "" {
        return text(status_not_found(), "not found")
    }
    return html(status_ok(), card)
}

/* -------------------------------------------------------------------------- */
/*  API                                                                       */
/* -------------------------------------------------------------------------- */

fn widget_json(db: SqlDb, widget: Widgets) string {
    var latest: string = widget_latest_text(db, u32(widget.id))
    if widget_mesh_source(widget) {
        latest = gateway.source_latest(widget_gateway_id(widget))
    }
    return "{\"id\":" + int_to_str(u32(widget.id)) +
        ",\"title\":" + json_string(widget.title) +
        ",\"kind\":" + json_string(widget.kind) +
        ",\"source_kind\":" + json_string(widget.sourceKind) +
        ",\"latest\":" + json_string(latest) +
        ",\"unit\":" + json_string(widget.unit) +
        ",\"pinned\":" + int_to_str(u32(widget.pinned)) + "}"
}

fn widgets_api_list(req: Request) Response {
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return json(status_internal(), "{\"error\":" + json_string(opened.err) + "}")
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var out: string = "["
    var i: u32 = 0
    while i < count {
        if i > 0 {
            out = out + ","
        }
        out = out + widget_json(db, widgets[i])
        i = i + 1
    }
    sql_close(db)
    return json(status_ok(), out + "]")
}

fn widgets_api_value(req: Request) Response {
    let id: string = param(req, "id")
    let body: string = request_body(req)
    let value: string = str_trim(form_field(body, "value"))
    if strlen(id) == 0 || strlen(value) == 0 {
        return json(status_bad_request(), "{\"ok\":false}")
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return json(status_internal(), "{\"ok\":false}")
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    widget_ignore_result(InsertWidgetValue(id, value,
        int_to_str(u32(milli_parse(value))), int_to_str(widget_now()), db))
    sql_close(db)
    return json(status_ok(), "{\"ok\":true}")
}

fn widgets_api_press(req: Request) Response {
    let id: string = param(req, "id")
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return json(status_internal(), "{\"ok\":false}")
    }
    let db: SqlDb = opened.ok
    sql_apply(db, "")
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var i: u32 = 0
    var found: i32 = -1
    while i < count {
        if str_eq(int_to_str(u32(widgets[i].id)), id) {
            found = i32(i)
        }
        i = i + 1
    }
    if found < 0 {
        sql_close(db)
        return json(status_bad_request(), "{\"ok\":false}")
    }
    let found_id: u32 = u32(found)
    let widget: Widgets = widgets[found_id]
    var new_state: string = ""
    if str_eq(widget.kind, "toggle") {
        var state: string = widget_toggle_state(db, u32(widget.id))
        if str_eq(state, "on") {
            new_state = "off"
        } else {
            new_state = "on"
        }
    }
    var code: u32 = 0
    if !widget_switch(widget, new_state) {
        code = 1
    }
    if str_eq(widget.kind, "toggle") && code == 0 {
        widget_ignore_result(InsertWidgetValue(id, new_state, "0",
            int_to_str(widget_now()), db))
        widget_event(u32(widget.id), new_state)
    }
    journal_info("widget", widget.title, "person", "Button " + widget.title + " pressed")
    sql_close(db)
    var ok: string = "true"
    if code != 0 {
        ok = "false"
    }
    var state_json: string = ""
    if new_state != "" {
        state_json = ",\"state\":" + json_string(new_state)
    }
    return json(status_ok(), "{\"ok\":" + ok + state_json + "}")
}
