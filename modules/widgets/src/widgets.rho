module widgets

// The widget manager, the dashboard cards and the API.
//
// A widget is a definition: a number, a chart of recent values, or a button
// that calls a hook. Its values live in the host's main SQL database.

import std.core.ptr
import std.core.result
import std.core.slice
import std.sql
import std.web.http
import std.web.template

const WIDGET_CAPACITY: u32 = 128
const VALUE_CAPACITY: u32 = 100

fn widget_root() string {
    if rho_path_exists("module.yml") &&
        yaml.value("module.yml", "module.name") == "widgets" {
        return "."
    }
    let root: string = getenv("ROBOHUB_WORKSPACE")
    if root != "" {
        if rho_path_exists(root + "/modules/widgets/module.yml") {
            return root + "/modules/widgets"
        }
        if rho_path_exists(root + "/robohub/modules/widgets/module.yml") {
            return root + "/robohub/modules/widgets"
        }
    }
    return "modules/widgets"
}

fn widget_workspace() string {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/widgets"
    }
    return workspace
}

fn widget_db_path() string {
    let override: string = getenv("RHO_WIDGETS_DB")
    if override != "" {
        return override
    }
    let dir: string = widget_workspace() + "/data"
    ignore_u32(rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt"))
    return dir + "/app.db"
}

fn widget_schema() string {
    let path: string = widget_root() + "/db/schema.sql"
    if rho_path_exists(path) {
        return rho_read_text(path)
    }
    return rho_read_text("db/schema.sql")
}

fn widget_template(name: string) string {
    let path: string = widget_root() + "/templates/" + name + ".html"
    if rho_path_exists(path) {
        return rho_read_text(path)
    }
    return rho_read_text("templates/" + name + ".html")
}

fn widget_now() u32 {
    let report: string = widget_db_path() + ".now"
    if rho_exec("date", "+%s", report) == 0 {
        return rho_int_from_str(widget_trim(rho_read_text(report)))
    }
    return 0
}

fn widget_arg_quote(value: string) string {
    return "\"" + value + "\""
}

fn widget_report(name: string) string {
    let dir: string = widget_workspace() + "/data"
    ignore_u32(rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt"))
    return dir + "/" + name + ".txt"
}

fn widget_curl(url: string, report: string) string {
    let code: u32 = rho_exec("curl", "-fsS -m 3 " + widget_arg_quote(url), report)
    if code != 0 {
        return ""
    }
    return rho_read_text(report)
}

fn widget_parse_milli(text: string) i64 {
    var value: string = widget_trim(text)
    var sign: i64 = 1
    if rho_strlen(value) > 0 && rho_str_eq(rho_str_slice(value, 0, 1), "-") {
        sign = -1
        value = rho_str_slice(value, 1, u32(rho_strlen(value)) - 1)
    }
    var whole: string = value
    var fraction: string = ""
    let dot: i32 = rho_str_index_of(value, ".")
    if dot >= 0 {
        whole = rho_str_slice(value, 0, u32(dot))
        fraction = rho_str_slice(value, u32(dot) + 1,
            u32(rho_strlen(value)) - u32(dot) - 1)
    }
    if rho_strlen(whole) == 0 {
        whole = "0"
    }
    let whole_value: u32 = rho_int_from_str(whole)
    var frac_value: u32 = 0
    var i: u32 = 0
    while i < 3 {
        if i < u32(rho_strlen(fraction)) {
            frac_value = frac_value * 10 +
                rho_int_from_str(rho_str_slice(fraction, i, 1))
        } else {
            frac_value = frac_value * 10
        }
        i = i + 1
    }
    return sign * i64(whole_value * 1000 + frac_value)
}

fn widget_latest_text(db: SqlDb, widget_id: u32) string {
    let values: WidgetValues[100]
    let slice: Slice[WidgetValues] = Slice[WidgetValues]{
        Ptr[WidgetValues](&values[0]), VALUE_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgetValues(i64(widget_id), db, slice,
        VALUE_CAPACITY)
    if listed.is_ok && listed.ok > 0 {
        return values[0].valueText
    }
    return ""
}

fn widget_toggle_state(db: SqlDb, widget_id: u32) string {
    let latest: string = widget_latest_text(db, widget_id)
    if rho_str_eq(latest, "on") {
        return "on"
    }
    return "off"
}

fn widget_replace(text: string, needle: string, value: string) string {
    let at: i32 = rho_str_index_of(text, needle)
    if at < 0 {
        return text
    }
    return rho_str_slice(text, 0, u32(at)) + value +
        rho_str_slice(text, u32(at) + u32(rho_strlen(needle)),
            u32(rho_strlen(text)) - u32(at) - u32(rho_strlen(needle)))
}

fn widget_hook(source: string, state: string) string {
    if rho_str_index_of(source, "{state}") >= 0 {
        return widget_replace(source, "{state}", state)
    }
    if rho_str_index_of(source, "?") >= 0 {
        return source + "&state=" + state
    }
    return source + "?state=" + state
}

fn widget_ignore_result(value: Result[u32, SqlError]) void {
}

fn widget_ignore_string(value: string) void {
}

fn widget_refresh(widget: Widgets) string {
    if rho_str_eq(widget.kind, "button") || rho_str_eq(widget.kind, "toggle") ||
        !rho_str_eq(widget.sourceKind, "url") ||
        rho_strlen(widget.source) == 0 {
        return ""
    }
    let report: string = widget_report("fetch-" + rho_int_to_str(u32(widget.id)))
    let code: u32 = rho_exec("curl", "-fsS -m 3 " + widget_arg_quote(widget.source), report)
    if code != 0 {
        return ""
    }
    let text: string = widget_trim(rho_read_text(report))
    if rho_strlen(text) == 0 {
        return ""
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return ""
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    if rho_str_eq(widget_latest_text(db, u32(widget.id)), text) {
        sql_close(db)
        return ""
    }
    widget_ignore_result(InsertWidgetValue(rho_int_to_str(u32(widget.id)), text,
        rho_int_to_str(u32(widget_parse_milli(text))), rho_int_to_str(widget_now()), db))
    sql_close(db)
    return text
}

fn widget_chart(values: WidgetValues[100], count: u32) string {
    if count < 2 {
        return "<p><small>Not enough values for a chart yet.</small></p>"
    }
    var low: i64 = values[0].valueMilli
    var high: i64 = values[0].valueMilli
    var i: u32 = 0
    while i < count {
        if values[i].valueMilli < low {
            low = values[i].valueMilli
        }
        if values[i].valueMilli > high {
            high = values[i].valueMilli
        }
        i = i + 1
    }
    if low == high {
        high = low + 1
    }
    var points: string = ""
    i = 0
    while i < count {
        let index: u32 = count - 1 - i
        let x: u32 = (i * 100) / (count - 1)
        let y: u32 = 27 - u32(((values[index].valueMilli - low) * 22) / (high - low + 1))
        points = points + rho_int_to_str(x) + "," + rho_int_to_str(y) + " "
        i = i + 1
    }
    return "<svg class=\"spark\" viewBox=\"0 0 100 30\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><polyline fill=\"none\" stroke=\"#e4b866\" stroke-width=\"1.5\" points=\"" +
        points + "\"/></svg>"
}

fn widget_setting(key: string) string {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/widgets"
    }
    let dir: string = workspace + "/data"
    ignore_u32(rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt"))
    return widget_trim(rho_read_text(dir + "/" + key))
}

fn widget_field(line: string, index: u32) string {
    var rest: string = line
    var i: u32 = 0
    while i < index {
        let at: i32 = rho_str_index_of(rest, "|")
        if at < 0 {
            return ""
        }
        rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        i = i + 1
    }
    let at: i32 = rho_str_index_of(rest, "|")
    if at < 0 {
        return rest
    }
    return rho_str_slice(rest, 0, u32(at))
}

fn widget_json_string_field(text: string, key: string) string {
    let at: i32 = rho_str_index_of(text, "\"" + key + "\":\"")
    if at < 0 {
        return ""
    }
    let start: u32 = u32(at) + u32(rho_strlen(key)) + 4
    let rest: string = rho_str_slice(text, start, u32(rho_strlen(text)) - start)
    let end: i32 = rho_str_index_of(rest, "\"")
    if end < 0 {
        return ""
    }
    return rho_str_slice(rest, 0, u32(end))
}

fn widget_json_number_field(text: string, key: string) string {
    let at: i32 = rho_str_index_of(text, "\"" + key + "\":")
    if at < 0 {
        return ""
    }
    let start: u32 = u32(at) + u32(rho_strlen(key)) + 3
    var rest: string = rho_str_slice(text, start, u32(rho_strlen(text)) - start)
    var out: string = ""
    var i: u32 = 0
    while i < u32(rho_strlen(rest)) {
        let ch: string = rho_str_slice(rest, i, 1)
        if (ch >= "0" && ch <= "9") {
            out = out + ch
            i = i + 1
        } else if out == "" && (rho_str_eq(ch, " ") || rho_str_eq(ch, "\t")) {
            i = i + 1
        } else {
            break
        }
    }
    return out
}

fn widget_write_setting(key: string, value: string) void {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/widgets"
    }
    let dir: string = workspace + "/data"
    ignore_u32(rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt"))
    ignore_bool(rho_write_text(dir + "/" + key, value))
}

// The host's gateway contract supplies the sources. The widgets module knows
// only the fields of a source, not which provider produced them.
fn widget_gateway_sources() string {
    return gateway_sources()
}

fn widget_gateway_source_options(selected: string) string {
    let text: string = widget_gateway_sources()
    var out: string = "<option value=\"\">Choose a gateway source</option>"
    if text == "" {
        return out
    }
    var rest: string = text
    while rho_strlen(rest) > 0 {
        let at: i32 = rho_str_index_of(rest, "},{")
        var object: string = ""
        if at < 0 {
            object = rest
            rest = ""
        } else {
            object = rho_str_slice(rest, 0, u32(at) + 1)
            rest = rho_str_slice(rest, u32(at) + 3, u32(rho_strlen(rest)) - u32(at) - 3)
        }
        let id: string = widget_json_string_field(object, "id")
        let owner: string = widget_json_string_field(object, "owner")
        let label: string = widget_json_string_field(object, "label")
        let direction: string = widget_json_string_field(object, "direction")
        let unit: string = widget_json_string_field(object, "unit")
        let kinds: string = widget_json_string_field(object, "kinds")
        let value_url: string = widget_json_string_field(object, "value_url")
        let action_url: string = widget_json_string_field(object, "action_url")
        if id == "" || direction == "" || value_url == "" {
            continue
        }
        var mark: string = ""
        if (selected != "" && rho_str_eq(value_url, selected)) ||
            (selected != "" && rho_str_eq(action_url, selected)) {
            mark = " selected"
        }
        var text_label: string = owner
        if label != "" {
            text_label = text_label + " · " + label
        }
        if unit != "" {
            text_label = text_label + " (" + unit + ")"
        }
        if rho_str_eq(direction, "output") {
            text_label = text_label + " — output"
        }
        out = out + "<option value=\"" + escape_html(id) + "\"" +
            " data-direction=\"" + escape_html(direction) + "\"" +
            " data-kinds=\"" + escape_html(kinds) + "\"" +
            " data-unit=\"" + escape_html(unit) + "\"" +
            " data-value=\"" + escape_html(value_url) + "\"" +
            " data-action=\"" + escape_html(action_url) + "\"" + mark + ">" +
            escape_html(text_label) + "</option>"
    }
    return out
}

fn widget_kind_options(selected: string) string {
    var out: string = ""
    let kinds: string = "numeric|Number\nchart|Chart\ntable|Table\nbutton|Button\ntoggle|Switch"
    var rest: string = kinds
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        var mark: string = ""
        if rho_str_eq(widget_field(line, 0), selected) {
            mark = " selected"
        }
        out = out + "<option value=\"" + escape_html(widget_field(line, 0)) + "\"" + mark + ">" +
            escape_html(widget_field(line, 1)) + "</option>"
    }
    return out
}

fn widget_source_kind_options(selected: string) string {
    var out: string = ""
    let kinds: string = "manual|Manual\nurl|URL / hook"
    var rest: string = kinds
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        var mark: string = ""
        if rho_str_eq(widget_field(line, 0), selected) {
            mark = " selected"
        }
        out = out + "<option value=\"" + escape_html(widget_field(line, 0)) + "\"" + mark + ">" +
            escape_html(widget_field(line, 1)) + "</option>"
    }
    return out
}

fn widget_method_options(selected: string) string {
    var out: string = ""
    if !rho_str_eq(selected, "POST") {
        out = "<option value=\"GET\" selected>GET</option><option value=\"POST\">POST</option>"
    } else {
        out = "<option value=\"GET\">GET</option><option value=\"POST\" selected>POST</option>"
    }
    return out
}

fn widget_table(values: WidgetValues[100], count: u32, rows: u32, unit: string) string {
    var out: string = "<table class=\"widget-table\"><thead><tr><th>Time</th><th>Value</th></tr></thead><tbody>"
    var limit: u32 = rows
    if limit > count {
        limit = count
    }
    if limit == 0 {
        out = out + "<tr><td colspan=\"2\"><small>No values yet.</small></td></tr>"
    }
    var i: u32 = 0
    while i < limit {
        let value: WidgetValues = values[i]
        let epoch: u32 = u32(value.recordedEpoch)
        out = out + "<tr><td><span class=\"local-time\" data-s=\"" +
            rho_int_to_str(epoch) + "\">" + rho_int_to_str(epoch) + "</span></td><td>" +
            escape_html(value.valueText) + " " + escape_html(unit) + "</td></tr>"
        i = i + 1
    }
    return out + "</tbody></table>"
}

fn widget_card(db: SqlDb, widget: Widgets) string {
    let values: WidgetValues[100]
    let slice: Slice[WidgetValues] = Slice[WidgetValues]{
        Ptr[WidgetValues](&values[0]), VALUE_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgetValues(i64(u32(widget.id)), db, slice,
        VALUE_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    let latest: string = widget_latest_text(db, u32(widget.id))
    let unit: string = widget.unit
    if rho_str_eq(widget.kind, "button") {
        return "<div class=\"widget-card\" data-widget-id=\"" + rho_int_to_str(u32(widget.id)) +
            "\"><h3><a href=\"/widgets/edit?id=" +
            rho_int_to_str(u32(widget.id)) + "\">" + escape_html(widget.title) +
            "</a></h3><p><small>Button</small></p><form class=\"widget-press\" method=\"post\" action=\"/widgets/press\">" +
            "<input type=\"hidden\" name=\"id\" value=\"" + rho_int_to_str(u32(widget.id)) +
            "\"><input type=\"hidden\" name=\"return\" value=\"dashboard\">" +
            "<button type=\"submit\">Press</button></form></div>"
    }
    if rho_str_eq(widget.kind, "toggle") {
        let state: string = widget_toggle_state(db, u32(widget.id))
        var on_class: string = ""
        var label: string = "Off"
        if rho_str_eq(state, "on") {
            on_class = " on"
            label = "On"
        }
        return "<div class=\"widget-card toggle-card\" data-widget-id=\"" +
            rho_int_to_str(u32(widget.id)) + "\"><h3><a href=\"/widgets/edit?id=" +
            rho_int_to_str(u32(widget.id)) + "\">" + escape_html(widget.title) +
            "</a></h3><form class=\"widget-press\" method=\"post\" action=\"/widgets/press\">" +
            "<input type=\"hidden\" name=\"id\" value=\"" + rho_int_to_str(u32(widget.id)) +
            "\"><input type=\"hidden\" name=\"return\" value=\"dashboard\">" +
            "<button type=\"submit\" class=\"switch" + on_class + "\">" +
            "<span></span><span class=\"switch-text\">" + label + "</span></button></form></div>"
    }
    if rho_str_eq(widget.kind, "table") {
        return "<div class=\"widget-card\" data-widget-id=\"" + rho_int_to_str(u32(widget.id)) +
            "\"><h3><a href=\"/widgets/edit?id=" +
            rho_int_to_str(u32(widget.id)) + "\">" + escape_html(widget.title) + "</a></h3>" +
            widget_table(values, count, u32(widget.points), unit) +
            "<p><small>" + rho_int_to_str(count) + " values · " +
            escape_html(widget.sourceKind) + "</small></p></div>"
    }
    let chart: string = ""
    if rho_str_eq(widget.kind, "chart") {
        chart = widget_chart(values, count)
    }
    return "<div class=\"widget-card\" data-widget-id=\"" + rho_int_to_str(u32(widget.id)) +
        "\"><h3><a href=\"/widgets/edit?id=" +
        rho_int_to_str(u32(widget.id)) + "\">" + escape_html(widget.title) + "</a></h3>" +
        chart + "<div class=\"widget-value\">" + escape_html(latest) + " " +
        escape_html(unit) + "</div><p><small>" + rho_int_to_str(count) +
        " values · " + escape_html(widget.sourceKind) + "</small></p></div>"
}

fn widgets_dashboard_cards(refresh: bool) string {
    // A page load reads the gateway before it renders, so a plug switched in
    // another tab or application is already correct in the first paint. The
    // fragment route re-renders what is stored and does not fetch again, so a
    // client that follows an event does not start another fetch.
    if refresh {
        ignore_u32(widgets_sync_state())
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return ""
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var out: string = ""
    var i: u32 = 0
    while i < count {
        if refresh {
            widget_ignore_string(widget_refresh(widgets[i]))
        }
        out = out + widget_card(db, widgets[i])
        i = i + 1
    }
    sql_close(db)
    if out == "" {
        out = "<p><small>No widgets yet. <a href=\"/widgets\">Create one</a>.</small></p>"
    }
    return "<div class=\"widget-grid\">" + out + "</div>"
}

fn widget_rows(db: SqlDb, widgets: Widgets[128], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let widget: Widgets = widgets[i]
        let latest: string = widget_latest_text(db, u32(widget.id))
        out = out + template_fill(widget_template("widget-row"),
            vars("id", rho_int_to_str(u32(widget.id))) +
            vars("title", escape_html(widget.title)) +
            vars("kind", escape_html(widget.kind)) +
            vars("source", escape_html(widget.sourceKind) + " · " +
                escape_html(widget.source)) +
            vars("latest", escape_html(latest) + " " + escape_html(widget.unit)) +
            vars("method", escape_html(widget.method)))
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"5\">No widgets yet.</td></tr>"
    }
    return out
}

fn widgets_page_message(message: string) Response {
    ignore_u32(widgets_sync_state())
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return html(status_internal(), "<h1>Widgets</h1><p>The database could not be opened: " +
            escape_html(opened.err) + "</p>")
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    let rows_html: string = widget_rows(db, widgets, count)
    sql_close(db)
    let notice: string = ""
    if message != "" {
        notice = "<p class=\"notice\">" + escape_html(message) + "</p>"
    }
    let body: string = template_fill(widget_template("widgets"),
        vars("notice", notice) + vars("rows", rows_html) +
        vars("device_options", widget_gateway_source_options("")) +
        vars("kind_options", widget_kind_options("numeric")) +
        vars("source_kind_options", widget_source_kind_options("manual")) +
        vars("method_options", widget_method_options("GET")) +
        vars("preview", widgets_dashboard_cards(true)))
    let document: string = template_fill(widget_template("layout"),
        vars("title", "Widgets") + vars("body", body))
    return html(status_ok(), document)
}

fn widgets_page(req: Request) Response {
    return widgets_page_message("")
}

fn widgets_add(req: Request) Response {
    let body: string = request_body(req)
    let title: string = widget_trim(widget_form_value(body, "title"))
    if rho_strlen(title) == 0 {
        return widgets_page_message("A widget needs a title.")
    }
    var kind: string = widget_form_value(body, "kind")
    if rho_strlen(kind) == 0 {
        kind = "numeric"
    }
    var source_kind: string = widget_form_value(body, "source_kind")
    if rho_strlen(source_kind) == 0 {
        source_kind = "manual"
    }
    var source: string = widget_trim(widget_form_value(body, "source"))
    var method: string = widget_trim(widget_form_value(body, "method"))
    if rho_strlen(method) == 0 {
        method = "GET"
    }
    var device_url: string = widget_trim(widget_form_value(body, "device_url"))
    if device_url != "" {
        source = device_url
        method = "POST"
        source_kind = "url"
    }
    let unit: string = widget_trim(widget_form_value(body, "unit"))
    var points: u32 = rho_int_from_str(widget_trim(widget_form_value(body, "points")))
    if points == 0 {
        points = 24
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message("The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let added: Result[u32, SqlError] = InsertWidget(title, kind, source_kind, source,
        method, unit, rho_int_to_str(points), rho_int_to_str(widget_now()), db)
    sql_close(db)
    if !added.is_ok {
        return widgets_page_message("The widget could not be saved: " + added.err.message)
    }
    return widgets_page_message("Widget added.")
}

fn widget_edit_page(req: Request) Response {
    let id: u32 = rho_int_from_str(request_query_param(req, "id"))
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message("The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    sql_close(db)
    var i: u32 = 0
    var found: i32 = -1
    while i < count {
        if u32(widgets[i].id) == id {
            found = i32(i)
        }
        i = i + 1
    }
    if found < 0 {
        return widgets_page_message("That widget was not found.")
    }
    let index: u32 = u32(found)
    let widget: Widgets = widgets[index]
    let body: string = template_fill(widget_template("widget-edit"),
        vars("id", rho_int_to_str(u32(widget.id))) +
        vars("title", escape_html(widget.title)) +
        vars("kind", escape_html(widget.kind)) +
        vars("source_kind", escape_html(widget.sourceKind)) +
        vars("source", escape_html(widget.source)) +
        vars("method", escape_html(widget.method)) +
        vars("kind_options", widget_kind_options(widget.kind)) +
        vars("source_kind_options", widget_source_kind_options(widget.sourceKind)) +
        vars("method_options", widget_method_options(widget.method)) +
        vars("device_options", widget_gateway_source_options(widget.source)) +
        vars("unit", escape_html(widget.unit)) +
        vars("points", rho_int_to_str(u32(widget.points))))
    let document: string = template_fill(widget_template("layout"),
        vars("title", "Edit widget") + vars("body", body))
    return html(status_ok(), document)
}

fn widgets_edit_save(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = rho_int_from_str(widget_trim(widget_form_value(body, "id")))
    if id == 0 {
        return widgets_page_message("That widget was not found.")
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message("The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    var source: string = widget_trim(widget_form_value(body, "source"))
    var method: string = widget_trim(widget_form_value(body, "method"))
    var source_kind: string = widget_form_value(body, "source_kind")
    let device_url: string = widget_trim(widget_form_value(body, "device_url"))
    if device_url != "" {
        source = device_url
        method = "POST"
        source_kind = "url"
    }
    let points: u32 = rho_int_from_str(widget_trim(widget_form_value(body, "points")))
    let updated: Result[u32, SqlError] = UpdateWidget(
        widget_trim(widget_form_value(body, "title")),
        widget_form_value(body, "kind"),
        source_kind,
        source,
        method,
        widget_trim(widget_form_value(body, "unit")),
        i64(points), i64(id), db)
    sql_close(db)
    if !updated.is_ok {
        return widgets_page_message("The widget could not be saved: " + updated.err.message)
    }
    return widgets_page_message("Widget saved.")
}

fn widgets_delete(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = rho_int_from_str(widget_trim(widget_form_value(body, "id")))
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message("The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let removed: Result[u32, SqlError] = DeleteWidget(i64(id), db)
    sql_close(db)
    if !removed.is_ok {
        return widgets_page_message("The widget could not be removed: " + removed.err.message)
    }
    return widgets_page_message("Widget removed.")
}

fn widgets_value(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = rho_int_from_str(widget_trim(widget_form_value(body, "id")))
    let value: string = widget_trim(widget_form_value(body, "value"))
    if id == 0 || rho_strlen(value) == 0 {
        return widgets_page_message("A value needs a widget and a number.")
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message("The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    widget_ignore_result(InsertWidgetValue(rho_int_to_str(id), value,
        rho_int_to_str(u32(widget_parse_milli(value))), rho_int_to_str(widget_now()), db))
    sql_close(db)
    return widgets_page_message("Value recorded.")
}

fn widgets_press(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = rho_int_from_str(widget_trim(widget_form_value(body, "id")))
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return widgets_page_message("The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var i: u32 = 0
    var found: i32 = -1
    while i < count {
        if u32(widgets[i].id) == id {
            found = i32(i)
        }
        i = i + 1
    }
    if found < 0 {
        sql_close(db)
        return widgets_page_message("That widget was not found.")
    }
    let found_index: u32 = u32(found)
    let widget: Widgets = widgets[found_index]
    var hook: string = widget.source
    var new_state: string = ""
    if rho_str_eq(widget.kind, "toggle") {
        var state: string = widget_toggle_state(db, id)
        if rho_str_eq(state, "on") {
            new_state = "off"
        } else {
            new_state = "on"
        }
        hook = widget_hook(widget.source, new_state)
    }
    let method: string = widget.method
    let report: string = widget_report("press-" + rho_int_to_str(id))
    let code: u32 = rho_exec("curl",
        "-fsS -m 5 -X " + method + " " + widget_arg_quote(hook), report)
    if rho_str_eq(widget.kind, "toggle") && code == 0 {
        widget_ignore_result(InsertWidgetValue(rho_int_to_str(id), new_state,
            "0", rho_int_to_str(widget_now()), db))
        // A second dashboard is listening to the stream; the press itself is
        // the event, not only the difference a poll would find later.
        widget_event(id, new_state)
    }
    var event_message: string = "Button " + widget.title + " pressed"
    if code != 0 {
        event_message = event_message + " (hook failed)"
    }
    widget_ignore_result(InsertEvent("INFO", "widget", event_message,
        rho_int_to_str(widget_now()), db))
    sql_close(db)
    let back: string = widget_form_value(body, "return")
    if rho_str_eq(back, "dashboard") {
        var ok: string = "true"
        if code != 0 {
            ok = "false"
        }
        return json(status_ok(), "{\"ok\":" + ok + ",\"state\":" +
            json_string(new_state) + "}")
    }
    if code != 0 {
        return widgets_page_message("The hook for " + widget.title + " failed.")
    }
    return widgets_page_message(widget.title + " was pressed.")
}

extern fn sse_file(path: string, interval_ms: u32) Response

fn widgets_events_file() string {
    return widget_state_dir() + "/events.log"
}

fn widget_state_dir() string {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/widgets"
    }
    let dir: string = workspace + "/data"
    ignore_u32(rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt"))
    return dir
}

fn widget_event(widget_id: u32, state: string) void {
    let file: string = widgets_events_file()
    let line: string = "widget:" + rho_int_to_str(widget_id) + ":" + state + "\n"
    let old: string = rho_read_text(file)
    ignore_bool(rho_write_text(file, old + line))
}

fn widgets_snapshot() void {
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var out: string = ""
    var i: u32 = 0
    while i < count {
        if rho_str_eq(widgets[i].kind, "toggle") {
            out = out + "widget:" + rho_int_to_str(u32(widgets[i].id)) + ":" +
                widget_toggle_state(db, u32(widgets[i].id)) + "\n"
        }
        i = i + 1
    }
    sql_close(db)
    ignore_bool(rho_write_text(widgets_events_file(), out))
}

fn widgets_events(req: Request) Response {
    // A reconnect must show the current state, not replay every state the card
    // has ever had. The stream starts from a fresh snapshot.
    widgets_snapshot()
    return sse_file(widgets_events_file(), 1000)
}

fn widget_device_states() string {
    return gateway_device_states()
}

// widget_gateway_state reads the state behind a source URL. The provider knows
// how its own URL answers; the widget only passes the source it stored.
fn widget_gateway_state(widget: Widgets) string {
    return gateway_source_state(widget.source)
}

fn widgets_sync_state() u32 {
    let states: string = widget_device_states()
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return 0
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var updated: u32 = 0
    var i: u32 = 0
    while i < count {
        let widget: Widgets = widgets[i]
        if rho_str_eq(widget.kind, "toggle") {
            let marker: i32 = rho_str_index_of(widget.source, "/api/v1/devices/")
            if marker >= 0 {
                let tail: string = rho_str_slice(widget.source, u32(marker) + 16,
                    u32(rho_strlen(widget.source)) - u32(marker) - 16)
                let slash: i32 = rho_str_index_of(tail, "/")
                if slash > 0 {
                    let device_id: string = rho_str_slice(tail, 0, u32(slash))
                    var rest: string = states
                    var state: string = ""
                    while rest != "" {
                        let at: i32 = rho_str_index_of(rest, "\n")
                        let line: string = ""
                        if at < 0 {
                            line = rest
                            rest = ""
                        } else {
                            line = rho_str_slice(rest, 0, u32(at))
                            rest = rho_str_slice(rest, u32(at) + 1,
                                u32(rho_strlen(rest)) - u32(at) - 1)
                        }
                        let colon: i32 = rho_str_index_of(line, ":")
                        if colon > 0 && rho_str_eq(rho_str_slice(line, 0, u32(colon)), device_id) {
                            state = rho_str_slice(line, u32(colon) + 1,
                                u32(rho_strlen(line)) - u32(colon) - 1)
                        }
                    }
                    if state != "" && !rho_str_eq(widget_toggle_state(db, u32(widget.id)), state) {
                        widget_ignore_result(InsertWidgetValue(rho_int_to_str(u32(widget.id)), state,
                            "0", rho_int_to_str(widget_now()), db))
                        widget_event(u32(widget.id), state)
                        updated = updated + 1
                    }
                }
            }
            let gateway_state: string = widget_gateway_state(widget)
            if gateway_state != "" && !rho_str_eq(widget_toggle_state(db, u32(widget.id)), gateway_state) {
                widget_ignore_result(InsertWidgetValue(rho_int_to_str(u32(widget.id)), gateway_state,
                    "0", rho_int_to_str(widget_now()), db))
                widget_event(u32(widget.id), gateway_state)
                updated = updated + 1
            }
        }
        i = i + 1
    }
    sql_close(db)
    return updated
}

fn widgets_refresh_values() u32 {
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return 0
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var changed: u32 = 0
    var i: u32 = 0
    while i < count {
        if widget_refresh(widgets[i]) != "" {
            changed = changed + 1
        }
        i = i + 1
    }
    sql_close(db)
    return changed
}

fn widget_event_cards() void {
    let file: string = widgets_events_file()
    ignore_bool(rho_write_text(file, rho_read_text(file) + "cards:changed\n"))
}

fn widgets_refresh(req: Request) Response {
    let updated: u32 = widgets_sync_state()
    let changed: u32 = widgets_refresh_values()
    if changed > 0 {
        widget_event_cards()
    }
    return json(status_ok(), "{\"updated\":" + rho_int_to_str(updated) +
        ",\"changed\":" + rho_int_to_str(changed) + "}")
}

fn widgets_cards(req: Request) Response {
    return html(status_ok(), widgets_dashboard_cards(false))
}

/* -------------------------------------------------------------------------- */
/*  API                                                                       */
/* -------------------------------------------------------------------------- */

fn widget_json(db: SqlDb, widget: Widgets) string {
    let latest: string = widget_latest_text(db, u32(widget.id))
    return "{\"id\":" + rho_int_to_str(u32(widget.id)) +
        ",\"title\":" + json_string(widget.title) +
        ",\"kind\":" + json_string(widget.kind) +
        ",\"source_kind\":" + json_string(widget.sourceKind) +
        ",\"latest\":" + json_string(latest) +
        ",\"unit\":" + json_string(widget.unit) + "}"
}

fn widgets_api_list(req: Request) Response {
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return json(status_internal(), "{\"error\":" + json_string(opened.err) + "}")
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var out: string = "["
    var i: u32 = 0
    while i < count {
        if i > 0 {
            out = out + ","
        }
        out = out + widget_json(db, widgets[i])
        i = i + 1
    }
    sql_close(db)
    return json(status_ok(), out + "]")
}

fn widgets_api_value(req: Request) Response {
    let id: string = param(req, "id")
    let body: string = request_body(req)
    let value: string = widget_trim(widget_form_value(body, "value"))
    if rho_strlen(id) == 0 || rho_strlen(value) == 0 {
        return json(status_bad_request(), "{\"ok\":false}")
    }
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return json(status_internal(), "{\"ok\":false}")
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    widget_ignore_result(InsertWidgetValue(id, value,
        rho_int_to_str(u32(widget_parse_milli(value))), rho_int_to_str(widget_now()), db))
    sql_close(db)
    return json(status_ok(), "{\"ok\":true}")
}

fn widgets_api_press(req: Request) Response {
    let id: string = param(req, "id")
    let opened: Result[SqlDb, string] = sql_open(widget_db_path())
    if !opened.is_ok {
        return json(status_internal(), "{\"ok\":false}")
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let widgets: Widgets[128]
    let slice: Slice[Widgets] = Slice[Widgets]{ Ptr[Widgets](&widgets[0]), WIDGET_CAPACITY }
    let listed: Result[u32, SqlError] = ListWidgets(db, slice, WIDGET_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var i: u32 = 0
    var found: i32 = -1
    while i < count {
        if rho_str_eq(rho_int_to_str(u32(widgets[i].id)), id) {
            found = i32(i)
        }
        i = i + 1
    }
    if found < 0 {
        sql_close(db)
        return json(status_bad_request(), "{\"ok\":false}")
    }
    let found_id: u32 = u32(found)
    let widget: Widgets = widgets[found_id]
    var hook: string = widget.source
    var new_state: string = ""
    if rho_str_eq(widget.kind, "toggle") {
        var state: string = widget_toggle_state(db, u32(found_id))
        if rho_str_eq(state, "on") {
            new_state = "off"
        } else {
            new_state = "on"
        }
        hook = widget_hook(widget.source, new_state)
    }
    let report: string = widget_report("api-press-" + id)
    let code: u32 = rho_exec("curl",
        "-fsS -m 5 -X " + widget.method + " " + widget_arg_quote(hook), report)
    if rho_str_eq(widget.kind, "toggle") && code == 0 {
        widget_ignore_result(InsertWidgetValue(id, new_state, "0",
            rho_int_to_str(widget_now()), db))
        widget_event(found_id, new_state)
    }
    widget_ignore_result(InsertEvent("INFO", "widget",
        "Button " + widget.title + " pressed", rho_int_to_str(widget_now()), db))
    sql_close(db)
    var ok: string = "true"
    if code != 0 {
        ok = "false"
    }
    var state_json: string = ""
    if new_state != "" {
        state_json = ",\"state\":" + json_string(new_state)
    }
    return json(status_ok(), "{\"ok\":" + ok + state_json + "}")
}
