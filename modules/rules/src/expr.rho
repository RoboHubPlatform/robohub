module rules

// A condition is one of these, combined with `and`, `or`, `not` and brackets:
//
//   heater.temperature < 24.5        an inventory item's reading, by handle
//   filter-main.switch == on          on/off and true/false are 1 and 0
//   aquarium.nitrate >= 25            a value the host application answers
//   mode == feeding                   the mode in force (or `mode != feeding`)
//   time between 10:00 and 20:00      the machine's clock; a window may cross midnight
//
// Numbers are compared as numbers, in thousandths, so 24.5 and 24.50 are equal;
// anything else is compared as text, for == and != only. A reading that is not
// there makes the condition false and says which one was missing: a rule never
// acts on a value it could not read.

/// The context a condition is read in: its tokens, where the reading is, the
/// mode in force and the clock, and the first problem met.
struct RulesCursor {
    tokens: string
    count: u32
    pos: u32
    mode: string
    minutes: u32
    problem: string
}

/* -------------------------------------------------------------------------- */
/*  Tokens                                                                    */
/* -------------------------------------------------------------------------- */

fn rules_is_space(ch: string) bool {
    return str_eq(ch, " ") || str_eq(ch, "\t") || str_eq(ch, "\n") || str_eq(ch, "\r")
}

fn rules_is_operator(ch: string) bool {
    return str_eq(ch, "<") || str_eq(ch, ">") || str_eq(ch, "=") || str_eq(ch, "!") ||
        str_eq(ch, "(") || str_eq(ch, ")")
}

// rules_tokens splits a condition into its tokens, one per line: words and
// numbers, quoted text (kept with its quotes), brackets and the comparisons.
fn rules_tokens(text: string) string {
    var out: string = ""
    var i: u32 = 0
    let n: u32 = u32(strlen(text))
    while i < n {
        let ch: string = str_slice(text, i, 1)
        if rules_is_space(ch) {
            i = i + 1
        } else if str_eq(ch, "\"") {
            var j: u32 = i + 1
            while j < n && !str_eq(str_slice(text, j, 1), "\"") {
                j = j + 1
            }
            out = out + str_slice(text, i, j - i + 1) + "\n"
            i = j + 1
        } else if str_eq(ch, "(") || str_eq(ch, ")") {
            out = out + ch + "\n"
            i = i + 1
        } else if rules_is_operator(ch) {
            if i + 1 < n && str_eq(str_slice(text, i + 1, 1), "=") {
                out = out + str_slice(text, i, 2) + "\n"
                i = i + 2
            } else {
                out = out + ch + "\n"
                i = i + 1
            }
        } else {
            var j: u32 = i
            while j < n && !rules_is_space(str_slice(text, j, 1)) &&
                !rules_is_operator(str_slice(text, j, 1)) && !str_eq(str_slice(text, j, 1), "\"") {
                j = j + 1
            }
            out = out + str_slice(text, i, j - i) + "\n"
            i = j
        }
    }
    return out
}

fn rules_token_count(tokens: string) u32 {
    var count: u32 = 0
    var i: u32 = 0
    while i < u32(strlen(tokens)) {
        if str_eq(str_slice(tokens, i, 1), "\n") {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// rules_token is the token at an index, or "" past the end.
fn rules_token(tokens: string, index: u32) string {
    var rest: string = tokens
    var i: u32 = 0
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        if at < 0 {
            return ""
        }
        if i == index {
            return str_slice(rest, 0, u32(at))
        }
        rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        i = i + 1
    }
    return ""
}

fn rules_peek(c: RulesCursor) string {
    return rules_token(c.tokens, c.pos)
}

fn rules_lower(text: string) string {
    let lower: string = "abcdefghijklmnopqrstuvwxyz"
    let upper: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var out: string = ""
    var i: u32 = 0
    while i < u32(strlen(text)) {
        let ch: string = str_slice(text, i, 1)
        let at: i32 = str_index_of(upper, ch)
        if at >= 0 {
            out = out + str_slice(lower, u32(at), 1)
        } else {
            out = out + ch
        }
        i = i + 1
    }
    return out
}

/* -------------------------------------------------------------------------- */
/*  Values                                                                    */
/* -------------------------------------------------------------------------- */

// rules_milli reads a decimal number in thousandths; ok is false for anything
// that is not one.
struct RulesNumber {
    ok: bool
    milli: i64
}

fn rules_number(text: string) RulesNumber {
    return RulesNumber{ milli_valid(text), milli_parse(text) }
}

// rules_normal is a value as a condition compares it: on/true are 1, off/false 0.
fn rules_normal(value: string) string {
    let lower: string = rules_lower(str_trim(value))
    if str_eq(lower, "on") || str_eq(lower, "true") {
        return "1"
    }
    if str_eq(lower, "off") || str_eq(lower, "false") {
        return "0"
    }
    return str_trim(value)
}

// rules_value is what an operand stands for: a literal, or a reading — the
// host's own values first, then an inventory item's capability by handle.
fn rules_value(token: string) string {
    let n: u32 = u32(strlen(token))
    if n >= 2 && str_eq(str_slice(token, 0, 1), "\"") {
        return str_slice(token, 1, n - 2)
    }
    let literal: RulesNumber = rules_number(token)
    if literal.ok {
        return token
    }
    let lower: string = rules_lower(token)
    if str_eq(lower, "on") || str_eq(lower, "off") || str_eq(lower, "true") || str_eq(lower, "false") {
        return rules_normal(token)
    }
    let from_host: string = rules_host_value(token)
    if from_host != "" {
        return rules_normal(from_host)
    }
    let dot: i32 = str_index_of(token, ".")
    if dot > 0 {
        let handle: string = str_slice(token, 0, u32(dot))
        let capability: string = str_slice(token, u32(dot) + 1, n - u32(dot) - 1)
        return rules_normal(inventory_read(handle, capability))
    }
    return ""
}

fn rules_compare(left: string, operator: string, right: string) bool {
    let a: RulesNumber = rules_number(left)
    let b: RulesNumber = rules_number(right)
    if a.ok && b.ok {
        if str_eq(operator, "<") { return a.milli < b.milli }
        if str_eq(operator, "<=") { return a.milli <= b.milli }
        if str_eq(operator, ">") { return a.milli > b.milli }
        if str_eq(operator, ">=") { return a.milli >= b.milli }
        if str_eq(operator, "==") { return a.milli == b.milli }
        if str_eq(operator, "!=") { return a.milli != b.milli }
        return false
    }
    if str_eq(operator, "==") { return str_eq(left, right) }
    if str_eq(operator, "!=") { return !str_eq(left, right) }
    return false
}

fn rules_is_comparison(token: string) bool {
    return str_eq(token, "<") || str_eq(token, "<=") || str_eq(token, ">") ||
        str_eq(token, ">=") || str_eq(token, "==") || str_eq(token, "!=")
}

// rules_minutes is `HH:MM` as minutes since midnight, or 9999 when it is not one.
fn rules_minutes(text: string) u32 {
    let colon: i32 = str_index_of(text, ":")
    if colon <= 0 {
        return 9999
    }
    let hours: u32 = int_from_str(str_slice(text, 0, u32(colon)))
    let minutes: u32 = int_from_str(str_slice(text, u32(colon) + 1, u32(strlen(text)) - u32(colon) - 1))
    if hours > 23 || minutes > 59 {
        return 9999
    }
    return hours * 60 + minutes
}

// rules_seconds is a duration as a rule's `for` and `cooldown` write it, in
// seconds; 0 when it is not one.
fn rules_seconds(text: string) u32 {
    let value: string = rules_lower(str_trim(text))
    if value == "" {
        return 0
    }
    // A number of seconds, minutes, hours or days, with a decimal part if it has
    // one: `90s`, `10m`, `1.5h`, `1d`. Plain digits are seconds.
    let last: string = str_slice(value, u32(strlen(value)) - 1, 1)
    var unit: i64 = 0
    if str_eq(last, "s") { unit = 1 }
    if str_eq(last, "m") { unit = 60 }
    if str_eq(last, "h") { unit = 3600 }
    if str_eq(last, "d") { unit = 86400 }
    var number: string = value
    if unit > 0 {
        number = str_slice(value, 0, u32(strlen(value)) - 1)
    } else {
        unit = 1
    }
    let parsed: RulesNumber = rules_number(number)
    if !parsed.ok || parsed.milli < 0 {
        return 0
    }
    return u32((parsed.milli * unit) / 1000)
}

/* -------------------------------------------------------------------------- */
/*  Reading and evaluating                                                    */
/* -------------------------------------------------------------------------- */

/// The answer of one part of a condition, and where the reading stopped.
struct RulesTruth {
    cursor: RulesCursor
    truth: bool
}

fn rules_fail(c: RulesCursor, problem: string) RulesTruth {
    var next: RulesCursor = c
    if next.problem == "" {
        next.problem = problem
    }
    return RulesTruth{ next, false }
}

fn rules_atom(c: RulesCursor) RulesTruth {
    var cur: RulesCursor = c
    let first: string = rules_peek(cur)
    let lower: string = rules_lower(first)
    if first == "" {
        return rules_fail(cur, "the condition ends where a value was expected")
    }
    if str_eq(lower, "time") && str_eq(rules_lower(rules_token(cur.tokens, cur.pos + 1)), "between") {
        let from: u32 = rules_minutes(rules_token(cur.tokens, cur.pos + 2))
        let joiner: string = rules_lower(rules_token(cur.tokens, cur.pos + 3))
        let to: u32 = rules_minutes(rules_token(cur.tokens, cur.pos + 4))
        if from == 9999 || to == 9999 || !str_eq(joiner, "and") {
            return rules_fail(cur, "a time window is written `time between 10:00 and 20:00`")
        }
        cur.pos = cur.pos + 5
        var inside: bool = cur.minutes >= from && cur.minutes < to
        if from > to {
            inside = cur.minutes >= from || cur.minutes < to
        }
        return RulesTruth{ cur, inside }
    }
    if str_eq(lower, "mode") {
        let operator: string = rules_token(cur.tokens, cur.pos + 1)
        let name: string = rules_token(cur.tokens, cur.pos + 2)
        if (!str_eq(operator, "==") && !str_eq(operator, "!=")) || name == "" {
            return rules_fail(cur, "a mode is compared with == or !=: `mode == feeding`")
        }
        cur.pos = cur.pos + 3
        let same: bool = str_eq(rules_lower(cur.mode), rules_lower(name))
        if str_eq(operator, "==") {
            return RulesTruth{ cur, same }
        }
        return RulesTruth{ cur, !same }
    }
    let operator: string = rules_token(cur.tokens, cur.pos + 1)
    let second: string = rules_token(cur.tokens, cur.pos + 2)
    if !rules_is_comparison(operator) || second == "" {
        return rules_fail(cur, "expected a comparison after " + first)
    }
    cur.pos = cur.pos + 3
    let left: string = rules_value(first)
    let right: string = rules_value(second)
    if left == "" {
        return rules_fail(cur, "no reading for " + first)
    }
    if right == "" {
        return rules_fail(cur, "no reading for " + second)
    }
    // An order needs two numbers. A reading such as "unavailable" is no answer
    // either way: were it false, `not t > 30` would hold and the rule would act
    // on a sensor that said nothing.
    if !str_eq(operator, "==") && !str_eq(operator, "!=") {
        if !rules_number(left).ok {
            return rules_fail(cur, first + " is not a number: " + left)
        }
        if !rules_number(right).ok {
            return rules_fail(cur, second + " is not a number: " + right)
        }
    }
    return RulesTruth{ cur, rules_compare(left, operator, right) }
}

fn rules_unary(c: RulesCursor) RulesTruth {
    var cur: RulesCursor = c
    let token: string = rules_peek(cur)
    if str_eq(rules_lower(token), "not") {
        cur.pos = cur.pos + 1
        let inner: RulesTruth = rules_unary(cur)
        return RulesTruth{ inner.cursor, !inner.truth }
    }
    if str_eq(token, "(") {
        cur.pos = cur.pos + 1
        let inner: RulesTruth = rules_or(cur)
        var after: RulesCursor = inner.cursor
        if !str_eq(rules_peek(after), ")") {
            return rules_fail(after, "a bracket is not closed")
        }
        after.pos = after.pos + 1
        return RulesTruth{ after, inner.truth }
    }
    return rules_atom(cur)
}

fn rules_and(c: RulesCursor) RulesTruth {
    var result: RulesTruth = rules_unary(c)
    while str_eq(rules_lower(rules_peek(result.cursor)), "and") {
        var cur: RulesCursor = result.cursor
        cur.pos = cur.pos + 1
        let decided: bool = !result.truth && cur.problem == ""
        let right: RulesTruth = rules_unary(cur)
        var after: RulesCursor = right.cursor
        if decided {
            // false and anything is false: a reading missing on the right
            // does not matter.
            after.problem = ""
        }
        result = RulesTruth{ after, result.truth && right.truth }
    }
    return result
}

fn rules_or(c: RulesCursor) RulesTruth {
    var result: RulesTruth = rules_and(c)
    while str_eq(rules_lower(rules_peek(result.cursor)), "or") {
        var cur: RulesCursor = result.cursor
        cur.pos = cur.pos + 1
        let decided: bool = result.truth && cur.problem == ""
        let right: RulesTruth = rules_and(cur)
        var after: RulesCursor = right.cursor
        if decided {
            // true or anything is true.
            after.problem = ""
        }
        result = RulesTruth{ after, result.truth || right.truth }
    }
    return result
}

/// What a whole condition came to: whether it holds, and why it could not be
/// read when it could not.
struct RulesVerdict {
    holds: bool
    problem: string
}

// rules_evaluate reads a condition in a mode and at a time of day (minutes since
// midnight). A condition that cannot be read, or reads a value that is not
// there, does not hold.
fn rules_evaluate(condition: string, mode: string, minutes: u32) RulesVerdict {
    let tokens: string = rules_tokens(condition)
    let count: u32 = rules_token_count(tokens)
    if count == 0 {
        return RulesVerdict{ false, "the condition is empty" }
    }
    let start: RulesCursor = RulesCursor{ tokens, count, 0, mode, minutes, "" }
    let result: RulesTruth = rules_or(start)
    if result.cursor.problem != "" {
        return RulesVerdict{ false, result.cursor.problem }
    }
    if result.cursor.pos < count {
        return RulesVerdict{ false, "unexpected " + rules_token(tokens, result.cursor.pos) }
    }
    return RulesVerdict{ result.truth, "" }
}

// rules_check reads a condition without any reading, for a form: "" when it is
// written in the grammar, what is wrong otherwise.
fn rules_check(condition: string) string {
    let tokens: string = rules_tokens(condition)
    let count: u32 = rules_token_count(tokens)
    if count == 0 {
        return "the condition is empty"
    }
    var i: u32 = 0
    var depth: i32 = 0
    while i < count {
        let token: string = rules_token(tokens, i)
        if str_eq(token, "(") {
            depth = depth + 1
        } else if str_eq(token, ")") {
            depth = depth - 1
        }
        if depth < 0 {
            return "a bracket is closed that was not opened"
        }
        i = i + 1
    }
    if depth != 0 {
        return "a bracket is not closed"
    }
    return ""
}
