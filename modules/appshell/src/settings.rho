//
// @file settings.rho
// @brief Settings for an application on the gateway: where readings come from, the modules' own settings, logging, about.
//
// @module appshell
// @project robohub
// @author Aurel Miron
// @date 2026-11-13
//
// SPDX-License-Identifier: MIT
//

module appshell

// The gateway's settings are its providers' own (robohub.gateway): which one
// answers, Mesh's project and how its live feed arrives. Mesh's address and the
// token it is read with come from the keeper, never from this page. The page is
// the same in every application that includes the module; the application's
// name is its host_app().

const APPSHELL_SETTINGS_TABS: string = "gateway|settings.tab.gateway,inventory|settings.tab.inventory,scheduler|settings.tab.scheduler,widgets|settings.tab.widgets,logging|settings.tab.logging,about|settings.tab.about"

fn appshell_settings_tab(req: Request) string {
    let tab: string = request_query_param(req, "tab")
    if rho_str_eq(tab, "inventory") || rho_str_eq(tab, "scheduler") || rho_str_eq(tab, "widgets") ||
        rho_str_eq(tab, "logging") || rho_str_eq(tab, "about") {
        return tab
    }
    return "gateway"
}

fn appshell_gateway_form(req: Request) string {
    var choice: string = gateway.provider()
    if choice == "" {
        choice = "robohub-provider-mesh"
    }
    let mesh: string = "robohub-provider-mesh"
    var transport: string = gateway.provider_config(mesh, "transport")
    if transport == "" {
        transport = "auto"
    }
    let project: string = gateway.provider_config(mesh, "project")
    var projects: string = ""
    if rho_str_eq(choice, mesh) {
        // The projects Mesh lists at the address the keeper gave the application.
        var rest: string = gateway.projects()
        while rest != "" {
            let at: i32 = rho_str_index_of(rest, "\"id\":\"")
            if at < 0 {
                rest = ""
            } else {
                rest = rho_str_slice(rest, u32(at) + 6, u32(rho_strlen(rest)) - u32(at) - 6)
                let end: i32 = rho_str_index_of(rest, "\"")
                if end > 0 {
                    let id: string = rho_str_slice(rest, 0, u32(end))
                    if projects != "" {
                        projects = projects + ","
                    }
                    projects = projects + id + "|" + id
                }
            }
        }
    }
    if projects == "" && project != "" {
        projects = project + "|" + project
    }
    var fields: FormField[3]
    fields[0] = FormField{ "provider", "select", i18n_t(req, "settings.source"), i18n_t(req, "settings.source_hint"),
        "", true, "", mesh + "|Mesh,simulator|" + i18n_t(req, "top.simulator"), choice, "", "" }
    fields[1] = FormField{ "project", "select", i18n_t(req, "settings.project"), i18n_t(req, "settings.project_hint"),
        i18n_t(req, "settings.project_prompt"), false, "", projects, project, "", "" }
    fields[2] = FormField{ "transport", "select", i18n_t(req, "settings.transport"), i18n_t(req, "settings.transport_hint"),
        "", false, "", "auto|" + i18n_t(req, "settings.transport.auto") + ",bus|" + i18n_t(req, "settings.transport.bus") +
        ",http|" + i18n_t(req, "settings.transport.http"), transport, "", "" }
    var now: string = i18n_t(req, "settings.not_connected")
    if rho_str_eq(gateway.provider(), "simulator") {
        now = i18n_t(req, "top.simulator")
    } else if gateway.provider() != "" {
        now = "Mesh · " + gateway.transport()
    }
    return "<p>" + i18n_t(req, "settings.now") + " <b>" + escape_html(now) + "</b></p>" +
        forms_open(fields, 3, "/settings?tab=gateway", i18n_t(req, "settings.save"), i18n_locale(req))
}

fn appshell_settings_form(req: Request, tab: string) string {
    if rho_str_eq(tab, "logging") {
        return log_settings_form(host_app(), "/settings?tab=logging", i18n_locale(req))
    }
    if rho_str_eq(tab, "inventory") {
        var fields: FormField[3]
        fields[0] = FormField{ "currency", "select", i18n_t(req, "settings.inventory.currency"), "",
            "", false, "", "RON|RON,EUR|EUR,USD|USD", settings_get("inventory.currency", "RON"), "", "" }
        fields[1] = FormField{ "default_unit", "text", i18n_t(req, "settings.inventory.unit"), "",
            "unit, kg, L", false, "", "", settings_get("inventory.default_unit", ""), "", "" }
        fields[2] = FormField{ "reorder", "text", i18n_t(req, "settings.inventory.reorder"), "",
            "0", false, "", "", settings_get("inventory.reorder", "0"), "", "decimal" }
        return forms_open(fields, 3, "/settings?tab=inventory", i18n_t(req, "settings.save"), i18n_locale(req))
    }
    if rho_str_eq(tab, "scheduler") {
        var fields: FormField[2]
        fields[0] = FormField{ "priority", "text", i18n_t(req, "settings.scheduler.priority"), "",
            "normal", false, "", "", settings_get("scheduler.priority", "normal"), "", "" }
        fields[1] = FormField{ "grace_hours", "text", i18n_t(req, "settings.scheduler.grace"), "",
            "12", false, "", "", settings_get("scheduler.grace_hours", "12"), "", "numeric" }
        return forms_open(fields, 2, "/settings?tab=scheduler", i18n_t(req, "settings.save"), i18n_locale(req))
    }
    if rho_str_eq(tab, "widgets") {
        var fields: FormField[2]
        fields[0] = FormField{ "refresh_seconds", "text", i18n_t(req, "settings.widgets.refresh"), "",
            "10", false, "", "", settings_get("widgets.refresh_seconds", "10"), "", "numeric" }
        fields[1] = FormField{ "points", "text", i18n_t(req, "settings.widgets.points"), "",
            "24", false, "", "", settings_get("widgets.points", "24"), "", "numeric" }
        return forms_open(fields, 2, "/settings?tab=widgets", i18n_t(req, "settings.save"), i18n_locale(req))
    }
    if rho_str_eq(tab, "about") {
        return "<dl class=\"settings\"><dt>" + i18n_t(req, "settings.application") + "</dt><dd>" + escape_html(host_app()) + "</dd>" +
            "<dt>" + i18n_t(req, "settings.gateway") + "</dt><dd>" + escape_html(gateway.provider()) + " · " +
            escape_html(gateway.transport()) + "</dd><dt>" + i18n_t(req, "settings.api") +
            "</dt><dd><code>/api/v1/values</code>, <code>/api/v1/events</code></dd><dt>" + i18n_t(req, "settings.modules") +
            "</dt><dd>inventory, scheduler, widgets, journal, rules, appapi, simulator</dd></dl>"
    }
    return appshell_gateway_form(req)
}

fn appshell_settings_page_message(req: Request, message: string) Response {
    let tab: string = appshell_settings_tab(req)
    var nav: string = "<nav class=\"rh-tabs\">"
    var rest: string = APPSHELL_SETTINGS_TABS
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, ",")
        var one: string = rest
        if at < 0 {
            rest = ""
        } else {
            one = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        var css: string = ""
        if rho_str_eq(appshell_field(one, 0), tab) {
            css = " class=\"on\""
        }
        nav = nav + "<a" + css + " href=\"/settings?tab=" + appshell_field(one, 0) + "\">" + i18n_t(req, appshell_field(one, 1)) + "</a>"
    }
    nav = nav + "</nav>"
    let body: string = "<div class=\"ph\"><h1>" + i18n_t(req, "settings.title") + "</h1></div>" + nav +
        "<section class=\"rh-card wide\">" + appshell_settings_form(req, tab) + "</section>"
    return host_shell(req, i18n_t(req, "settings.title"), body, appshell_toast(message))
}

fn appshell_settings_page(req: Request) Response {
    var message: string = ""
    if rho_str_eq(request_query_param(req, "msg"), "saved") {
        message = i18n_t(req, "settings.saved")
    }
    return appshell_settings_page_message(req, message)
}

fn appshell_settings_save(req: Request) Response {
    let body: string = request_body(req)
    let tab: string = appshell_settings_tab(req)
    if !forms_csrf_ok(body) {
        return appshell_settings_page_message(req, i18n_t(req, "form.expired"))
    }
    if rho_str_eq(tab, "inventory") {
        settings_set("inventory.currency", appshell_form(body, "currency"))
        settings_set("inventory.default_unit", appshell_form(body, "default_unit"))
        settings_set("inventory.reorder", appshell_form(body, "reorder"))
    } else if rho_str_eq(tab, "scheduler") {
        settings_set("scheduler.priority", appshell_form(body, "priority"))
        settings_set("scheduler.grace_hours", appshell_form(body, "grace_hours"))
    } else if rho_str_eq(tab, "widgets") {
        settings_set("widgets.refresh_seconds", appshell_form(body, "refresh_seconds"))
        settings_set("widgets.points", appshell_form(body, "points"))
    } else if rho_str_eq(tab, "logging") {
        if log_settings_save(host_app(), body) {
            info(host_app(), "logging settings updated")
        }
    } else {
        let mesh: string = "robohub-provider-mesh"
        let provider: string = appshell_form(body, "provider")
        let project: string = appshell_form(body, "project")
        let transport: string = appshell_form(body, "transport")
        if project != "" {
            ignore_bool(gateway.configure_provider(mesh, "project", project))
        }
        if rho_str_eq(transport, "auto") || rho_str_eq(transport, "bus") || rho_str_eq(transport, "http") {
            ignore_bool(gateway.configure_provider(mesh, "transport", transport))
        }
        let before: string = gateway.provider()
        if provider != "" && gateway.choose(provider) && !rho_str_eq(before, provider) {
            journal_info("system", "gateway", "person", "readings now come from " + provider)
        }
    }
    return redirect("/settings?tab=" + tab + "&msg=saved")
}
