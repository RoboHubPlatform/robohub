module appshell

include "shell.rho"
include "settings.rho"

import std.web.http
import robohub.gateway

extern fn rho_asset(module: string, path: string) string

route GET  "/settings" => appshell_settings_page
route POST "/settings" => appshell_settings_save
route GET  "/docs"     => appshell_docs
