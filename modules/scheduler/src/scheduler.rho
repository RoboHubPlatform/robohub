module scheduler

import rho.log

// The scheduler's pages and API. Timestamps are Unix seconds so due and
// overdue are integer comparisons; the text forms are produced only for the
// page and the API.

import std.core.ptr
import std.core.result
import std.core.slice
import std.sql
import std.web.http
import std.web.template

// A module's own files, embedded in the program that includes it.
extern fn rho_asset(module: string, path: string) string

const SCHEDULER_CHORE_CAPACITY: u32 = 256

fn scheduler_ignore_result(value: Result[u32, SqlError]) void {
}

fn scheduler_ignore_string(value: string) void {
}

fn scheduler_ignore_response(value: Response) void {
}
const SCHEDULER_COMPLETION_CAPACITY: u32 = 64

fn scheduler_workspace() string {
    let workspace: string = app_workspace()
    return workspace
}

fn scheduler_db_path() string {
    let override: string = getenv("RHO_SCHEDULER_DB")
    if override != "" {
        return override
    }
    let dir: string = scheduler_workspace() + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    return dir + "/app.db"
}

fn scheduler_schema() string {
    return rho_asset("scheduler", "db/schema.sql")
}

fn scheduler_template(name: string) string {
    return rho_asset("scheduler", "templates/" + name + ".html")
}

fn scheduler_now() u32 {
    return rho_now_s()
}

fn scheduler_date(epoch: u32) string {
    if epoch == 0 {
        return ""
    }
    return str_trim(rho_exec_capture("date", "-d\n@" + int_to_str(epoch) + "\n+%Y-%m-%d %H:%M\n"))
}

fn scheduler_epoch(text: string) u32 {
    // The text is one argument of date, whatever it holds: a person typed it.
    if str_index_of(text, "\n") >= 0 || str_starts_with(text, "-") {
        return 0
    }
    return int_from_str(str_trim(rho_exec_capture("date", "-d\n" + text + "\n+%s\n")))
}

fn scheduler_next_due(kind: string, value: string, interval_hours: u32, now: u32) u32 {
    if str_eq(kind, "interval") {
        if interval_hours == 0 {
            return now + 86400
        }
        return now + interval_hours * 3600
    }
    if str_eq(kind, "cron") {
        return scheduler_cron_next(value, now)
    }
    if str_eq(kind, "one_time") {
        return scheduler_epoch(value)
    }
    return 0
}

fn scheduler_status(chore: Chores, now: u32) string {
    if chore.enabled == 0 {
        return "disabled"
    }
    if chore.snoozedUntilEpoch > i64(now) {
        return "pending"
    }
    if str_eq(chore.scheduleKind, "usage") {
        if chore.usageIntervalHours > 0 &&
            chore.usageAccumSeconds >= chore.usageIntervalHours * 3600 {
            return "due"
        }
        return "pending"
    }
    if str_eq(chore.scheduleKind, "one_time") && chore.nextDueEpoch == 0 {
        if chore.lastCompletedEpoch > 0 {
            return "completed"
        }
        return "pending"
    }
    if chore.nextDueEpoch == 0 {
        return "pending"
    }
    if i64(now) >= chore.nextDueEpoch + chore.graceHours * 3600 {
        return "overdue"
    }
    if i64(now) >= chore.nextDueEpoch {
        return "due"
    }
    return "pending"
}

fn scheduler_status_badge(status: string) string {
    if str_eq(status, "overdue") {
        return "<span class=\"badge overdue\">overdue</span>"
    }
    if str_eq(status, "due") {
        return "<span class=\"badge due\">due</span>"
    }
    if str_eq(status, "completed") {
        return "<span class=\"badge done\">completed</span>"
    }
    if str_eq(status, "disabled") {
        return "<span class=\"badge\">disabled</span>"
    }
    return "<span class=\"badge pending\">pending</span>"
}

fn scheduler_due_text(chore: Chores) string {
    if str_eq(chore.scheduleKind, "usage") {
        let interval: u32 = u32(chore.usageIntervalHours)
        if interval == 0 {
            return "no usage target"
        }
        return scheduler_hours_text(chore.usageAccumSeconds) + " / " +
            int_to_str(interval) + " h of use"
    }
    if chore.nextDueEpoch == 0 {
        return ""
    }
    return scheduler_date(u32(chore.nextDueEpoch))
}

fn scheduler_hours_text(seconds: i64) string {
    return int_to_str(u32(seconds / 3600)) + " h"
}

// scheduler_links_text is a chore's description and what it is tied to in the
// inventory: whose runtime drives it, and what completing it uses.
fn scheduler_links_text(chore: Chores) string {
    var out: string = chore.description
    if chore.runtimeOf != "" {
        if out != "" {
            out = out + " · "
        }
        out = out + "runtime of " + chore.runtimeOf
    }
    if chore.consumes != "" {
        if out != "" {
            out = out + " · "
        }
        out = out + "uses " + scheduler_quantity(chore.consumesMilli) + " × " + chore.consumes
    }
    return out
}

fn scheduler_quantity(milli: i64) string {
    let whole: u32 = u32(milli / 1000)
    let fraction: u32 = u32(milli - (milli / 1000) * 1000)
    if fraction == 0 {
        return int_to_str(whole)
    }
    var digits: string = int_to_str(fraction)
    while strlen(digits) < 3 {
        digits = "0" + digits
    }
    while str_eq(str_slice(digits, u32(strlen(digits)) - 1, 1), "0") {
        digits = str_slice(digits, 0, u32(strlen(digits)) - 1)
    }
    return int_to_str(whole) + "." + digits
}

// scheduler_milli reads a quantity like 1 or 0.5 in thousandths.
fn scheduler_milli(text: string) u32 {
    let milli: i64 = milli_parse(text)
    if milli < 0 {
        return 0
    }
    return u32(milli)
}

fn scheduler_rows(req: Request, chores: Chores[256], count: u32, now: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let chore: Chores = chores[i]
        let status: string = scheduler_status(chore, now)
        let id: string = int_to_str(u32(chore.id))
        let html: string = template_fill(scheduler_template("rows/chore-row"),
            i18n_vars(req) +
            vars("csrf", forms_csrf_field()) +
            vars("confirm", json_string(i18n_t(req, "scheduler.delete_confirm"))) +
            vars("id", id) +
            vars("title", chore.title) +
            vars("description", scheduler_links_text(chore)) +
            vars("kind", chore.scheduleKind) +
            vars("due", scheduler_due_text(chore)) +
            vars("priority", chore.priority) +
            vars("status", scheduler_status_badge(status)))
        out = out + html + "\n"
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"5\">No chores scheduled.</td></tr>"
    }
    return out
}

fn scheduler_completion_rows(rows: ListCompletionsRow[64], count: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i < count {
        let row: ListCompletionsRow = rows[i]
        let html: string = template_fill(scheduler_template("rows/completion-row"),
            vars("title", row.title) +
            vars("when", scheduler_date(u32(row.completedEpoch))) +
            vars("note", row.note))
        out = out + html + "\n"
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"3\">No completions recorded yet.</td></tr>"
    }
    return out
}

fn scheduler_docs() string {
    let text: string = rho_asset("scheduler", "docs/index.md")
    if text == "" {
        return "No documentation found."
    }
    return text
}

fn scheduler_page_message(req: Request, message: string) Response {
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok {
        return html(status_internal(), "<h1>Scheduler</h1><p>The database could not be opened: " +
            escape_html(opened.err) + "</p>")
    }
    let db: SqlDb = opened.ok
    sql_apply(db, scheduler_schema())
    let chores: Chores[256]
    let chore_slice: Slice[Chores] = Slice[Chores]{
        Ptr[Chores](&chores[0]), SCHEDULER_CHORE_CAPACITY }
    let listed: Result[u32, SqlError] = ListChores(db, chore_slice, SCHEDULER_CHORE_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    let completions: ListCompletionsRow[64]
    let completion_slice: Slice[ListCompletionsRow] = Slice[ListCompletionsRow]{
        Ptr[ListCompletionsRow](&completions[0]), SCHEDULER_COMPLETION_CAPACITY }
    let listed_completions: Result[u32, SqlError] = ListCompletions(
        db, completion_slice, SCHEDULER_COMPLETION_CAPACITY)
    var completion_count: u32 = 0
    if listed_completions.is_ok {
        completion_count = listed_completions.ok
    }
    sql_close(db)
    let now: u32 = scheduler_now()
    let notice: string = ""
    if message != "" {
        notice = template_fill(scheduler_template("parts/notice"), vars("message", message))
    }
    let kinds: string = "interval|" + i18n_t(req, "scheduler.every_hours") +
        ",cron|" + i18n_t(req, "scheduler.cron") +
        ",one_time|" + i18n_t(req, "scheduler.one_time") +
        ",usage|" + i18n_t(req, "scheduler.after_use")
    var add_fields: FormField[11]
    add_fields[0] = FormField{ "title", "text", i18n_t(req, "scheduler.title_field"), "",
        "Change filter sock", true, "", "", "", "", "" }
    add_fields[1] = FormField{ "kind", "select", i18n_t(req, "scheduler.schedule"), "",
        "", false, "", kinds, "interval", "", "" }
    add_fields[2] = FormField{ "value", "text", i18n_t(req, "scheduler.cron_date"), "",
        "0 9 * * 1 or 2026-11-03T09:00", false, "", "", "", "", "" }
    add_fields[3] = FormField{ "interval_hours", "text", i18n_t(req, "scheduler.interval_hours"), "",
        "72", false, "", "", "", "", "numeric" }
    add_fields[4] = FormField{ "usage_hours", "text", i18n_t(req, "scheduler.usage_hours"), "",
        "4000", false, "", "", "", "", "numeric" }
    add_fields[5] = FormField{ "grace_hours", "text", i18n_t(req, "scheduler.grace_hours"), "",
        "12", false, "", "", scheduler_setting("grace_hours", "12"), "", "numeric" }
    add_fields[6] = FormField{ "priority", "text", i18n_t(req, "scheduler.priority"), "",
        "normal", false, "", "", scheduler_setting("priority", "normal"), "", "" }
    add_fields[7] = FormField{ "description", "text", i18n_t(req, "scheduler.description"), "",
        "", false, "", "", "", "", "" }
    add_fields[8] = FormField{ "runtime_of", "text", i18n_t(req, "scheduler.runtime_of"), "",
        "filter-main", false, "", "", "", "", "" }
    add_fields[9] = FormField{ "consumes", "text", i18n_t(req, "scheduler.consumes"), "",
        "filter-media", false, "", "", "", "", "" }
    add_fields[10] = FormField{ "consumes_qty", "text", i18n_t(req, "scheduler.consumes_qty"), "",
        "1", false, "", "", "", "", "decimal" }
    let add_form: string = forms_open(add_fields, 11, "/scheduler/chores/add",
        i18n_t(req, "scheduler.add_chore"), i18n_locale(req))
    let body: string = template_fill(scheduler_template("pages/scheduler"),
        i18n_vars(req) +
        vars("scheduler_style", scheduler_template("parts/style")) +
        vars("tabs_class", settings_get("ui.tabs", "vertical")) +
        vars("add_form", add_form) +
        vars("notice", notice) +
        vars("rows", scheduler_rows(req, chores, count, now)) +
        vars("completions", scheduler_completion_rows(completions, completion_count)) +
        vars("docs", scheduler_docs()) +
        vars("notifications", notification_embed()))
    return host_shell(req, i18n_t(req, "scheduler.title"), body, "")
}

fn scheduler_page(req: Request) Response {
    return scheduler_page_message(req, request_query_param(req, "msg"))
}

fn scheduler_keeper_link() string {
    let port: string = getenv("RHO_KEEPER_PORT")
    if port == "" {
        return ""
    }
    return "<a class=\"keeper\" href=\"#\" data-keeper-port=\"" + escape_html(port) +
        "\">← Keeper</a>"
}

fn scheduler_find(chores: Chores[256], count: u32, id: u32) i32 {
    var i: u32 = 0
    while i < count {
        if u32(chores[i].id) == id {
            return i32(i)
        }
        i = i + 1
    }
    return -1
}

/* -------------------------------------------------------------------------- */
/*  Actions                                                                   */
/* -------------------------------------------------------------------------- */

fn scheduler_setting(key: string, fallback: string) string {
    return settings_get("scheduler." + key, fallback)
}

// scheduler_add_chore keeps a chore from a form's fields and answers "" when it
// was kept, what is wrong otherwise. The page and the API both add through it,
// so each says what happened.
fn scheduler_add_chore(req: Request, body: string) string {
    let title: string = str_trim(form_field(body, "title"))
    if strlen(title) == 0 {
        return "A chore needs a title."
    }
    let kind: string = form_field(body, "kind")
    let value: string = str_trim(form_field(body, "value"))
    let interval_hours: u32 = int_from_str(str_trim(form_field(body, "interval_hours")))
    let usage_hours: u32 = int_from_str(str_trim(form_field(body, "usage_hours")))
    let grace: u32 = int_from_str(str_trim(form_field(body, "grace_hours")))
    var priority: string = str_trim(form_field(body, "priority"))
    if strlen(priority) == 0 {
        priority = "normal"
    }
    let now: u32 = scheduler_now()
    let next: u32 = scheduler_next_due(kind, value, interval_hours, now)
    // A schedule that names no time is refused rather than kept as a chore that
    // is never due.
    if str_eq(kind, "cron") && next == 0 {
        return i18n_t(req, "scheduler.bad_cron")
    }
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok {
        return "The database could not be opened: " + opened.err
    }
    let db: SqlDb = opened.ok
    sql_apply(db, scheduler_schema())
    let added: Result[u32, SqlError] = InsertChore(
        title,
        str_trim(form_field(body, "description")),
        kind,
        value,
        int_to_str(interval_hours),
        int_to_str(usage_hours),
        int_to_str(grace),
        priority,
        int_to_str(next),
        "1",
        db)
    let runtime_of: string = inventory_handle(form_field(body, "runtime_of"))
    let consumes: string = inventory_handle(form_field(body, "consumes"))
    if added.is_ok && (runtime_of != "" || consumes != "") {
        var quantity: u32 = scheduler_milli(form_field(body, "consumes_qty"))
        if consumes != "" && quantity == 0 {
            quantity = 1000
        }
        scheduler_ignore_result(SetChoreLinks(runtime_of, consumes, i64(quantity), title, db))
    }
    sql_close(db)
    if !added.is_ok {
        return "The chore could not be saved: " + added.err.message
    }
    info("scheduler", "chore added")
    return ""
}

fn scheduler_chores_add(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return scheduler_page_message(req, i18n_t(req, "scheduler.csrf_refused"))
    }
    let problem: string = scheduler_add_chore(req, body)
    if problem != "" {
        notification_push_level_locale(i18n_t(req, "toast.chore_failed") + ": " + problem, "error", 10, i18n_locale(req))
        return scheduler_page_message(req, problem)
    }
    notification_push_level_locale(i18n_t(req, "toast.chore_added"), "info", 10, i18n_locale(req))
    return scheduler_page_message(req, "Chore added.")
}

// scheduler_back is the scheduler page again, by GET, with what happened.
fn scheduler_back(message: string) Response {
    return redirect("/scheduler?msg=" + str_url_encode(message))
}

// scheduler_chore_edit_page is one chore's form, filled with what it is.
fn scheduler_chore_edit_page(req: Request) Response {
    let id: u32 = int_from_str(request_query_param(req, "id"))
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok || id == 0 {
        return scheduler_back(i18n_t(req, "scheduler.not_found"))
    }
    sql_apply(opened.ok, scheduler_schema())
    let chores: Chores[256]
    let slice: Slice[Chores] = Slice[Chores]{ Ptr[Chores](&chores[0]), SCHEDULER_CHORE_CAPACITY }
    let listed: Result[u32, SqlError] = ListChores(opened.ok, slice, SCHEDULER_CHORE_CAPACITY)
    sql_close(opened.ok)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    let at: i32 = scheduler_find(chores, count, id)
    if at < 0 {
        return scheduler_back(i18n_t(req, "scheduler.not_found"))
    }
    let index: u32 = u32(at)
    let c: Chores = chores[index]
    let kinds: string = "interval|" + i18n_t(req, "scheduler.every_hours") +
        ",cron|" + i18n_t(req, "scheduler.cron") +
        ",one_time|" + i18n_t(req, "scheduler.one_time") +
        ",usage|" + i18n_t(req, "scheduler.after_use")
    var qty: string = ""
    if c.consumesMilli > 0 {
        qty = milli_format(c.consumesMilli)
    }
    var fields: FormField[11]
    fields[0] = FormField{ "title", "text", i18n_t(req, "scheduler.title_field"), "", "", true, "", "", c.title, "", "" }
    fields[1] = FormField{ "kind", "select", i18n_t(req, "scheduler.schedule"), "", "", false, "", kinds, c.scheduleKind, "", "" }
    fields[2] = FormField{ "value", "text", i18n_t(req, "scheduler.cron_date"), "", "0 9 * * 1 or 2026-11-03T09:00", false, "", "", c.scheduleValue, "", "" }
    fields[3] = FormField{ "interval_hours", "text", i18n_t(req, "scheduler.interval_hours"), "", "", false, "", "", i64_to_str(c.intervalHours), "", "numeric" }
    fields[4] = FormField{ "usage_hours", "text", i18n_t(req, "scheduler.usage_hours"), "", "", false, "", "", i64_to_str(c.usageIntervalHours), "", "numeric" }
    fields[5] = FormField{ "grace_hours", "text", i18n_t(req, "scheduler.grace_hours"), "", "", false, "", "", i64_to_str(c.graceHours), "", "numeric" }
    fields[6] = FormField{ "priority", "text", i18n_t(req, "scheduler.priority"), "", "", false, "", "", c.priority, "", "" }
    fields[7] = FormField{ "description", "text", i18n_t(req, "scheduler.description"), "", "", false, "", "", c.description, "", "" }
    fields[8] = FormField{ "runtime_of", "text", i18n_t(req, "scheduler.runtime_of"), "", "filter-main", false, "", "", c.runtimeOf, "", "" }
    fields[9] = FormField{ "consumes", "text", i18n_t(req, "scheduler.consumes"), "", "filter-media", false, "", "", c.consumes, "", "" }
    fields[10] = FormField{ "consumes_qty", "text", i18n_t(req, "scheduler.consumes_qty"), "", "1", false, "", "", qty, "", "decimal" }
    let form: string = forms_open(fields, 11, "/scheduler/chores/edit?id=" + int_to_str(id),
        i18n_t(req, "scheduler.save"), i18n_locale(req))
    let body: string = "<h1>" + escape_html(i18n_t(req, "scheduler.edit_title")) + " <code>" + escape_html(c.title) + "</code></h1>" +
        form + "<p><a class=\"quiet\" href=\"/scheduler\">" + escape_html(i18n_t(req, "scheduler.cancel")) + "</a></p>"
    return host_shell(req, i18n_t(req, "scheduler.edit_title"), body, "")
}

// scheduler_chore_edit_save changes a chore. Its next due time is worked out
// again only when its schedule changed: renaming a chore does not move it.
fn scheduler_chore_edit_save(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return scheduler_back(i18n_t(req, "scheduler.csrf_refused"))
    }
    let id: u32 = int_from_str(request_query_param(req, "id"))
    let title: string = str_trim(form_field(body, "title"))
    if id == 0 || title == "" {
        return scheduler_back(i18n_t(req, "scheduler.not_found"))
    }
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok {
        return scheduler_back(opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, scheduler_schema())
    let chores: Chores[256]
    let slice: Slice[Chores] = Slice[Chores]{ Ptr[Chores](&chores[0]), SCHEDULER_CHORE_CAPACITY }
    let listed: Result[u32, SqlError] = ListChores(db, slice, SCHEDULER_CHORE_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    let at: i32 = scheduler_find(chores, count, id)
    if at < 0 {
        sql_close(db)
        return scheduler_back(i18n_t(req, "scheduler.not_found"))
    }
    let index: u32 = u32(at)
    let c: Chores = chores[index]
    let kind: string = form_field(body, "kind")
    let value: string = str_trim(form_field(body, "value"))
    let interval_hours: u32 = int_from_str(str_trim(form_field(body, "interval_hours")))
    var next: u32 = u32(c.nextDueEpoch)
    if !str_eq(kind, c.scheduleKind) || !str_eq(value, c.scheduleValue) || i64(interval_hours) != c.intervalHours {
        next = scheduler_next_due(kind, value, interval_hours, scheduler_now())
        if str_eq(kind, "cron") && next == 0 {
            sql_close(db)
            return scheduler_back(i18n_t(req, "scheduler.bad_cron"))
        }
    }
    var priority: string = str_trim(form_field(body, "priority"))
    if priority == "" {
        priority = "normal"
    }
    let consumes: string = inventory_handle(form_field(body, "consumes"))
    var quantity: u32 = scheduler_milli(form_field(body, "consumes_qty"))
    if consumes != "" && quantity == 0 {
        quantity = 1000
    }
    let saved: Result[u32, SqlError] = UpdateChore(title, str_trim(form_field(body, "description")), kind, value,
        i64(interval_hours), i64(int_from_str(str_trim(form_field(body, "usage_hours")))),
        i64(int_from_str(str_trim(form_field(body, "grace_hours")))), priority, i64(next),
        inventory_handle(form_field(body, "runtime_of")), consumes, i64(quantity), i64(id), db)
    sql_close(db)
    if !saved.is_ok {
        return scheduler_back(saved.err.message)
    }
    journal_info("chore", title, "person", "chore changed")
    return scheduler_back(title + ": " + i18n_t(req, "scheduler.saved"))
}

fn scheduler_chore_delete(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return scheduler_back(i18n_t(req, "scheduler.csrf_refused"))
    }
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok || id == 0 {
        return scheduler_back(i18n_t(req, "scheduler.not_found"))
    }
    sql_apply(opened.ok, scheduler_schema())
    scheduler_ignore_result(DeleteChoreCompletions(i64(id), opened.ok))
    let removed: Result[u32, SqlError] = DeleteChore(i64(id), opened.ok)
    sql_close(opened.ok)
    if !removed.is_ok || removed.ok == 0 {
        return scheduler_back(i18n_t(req, "scheduler.not_found"))
    }
    return scheduler_back(i18n_t(req, "scheduler.deleted"))
}

fn scheduler_chores_complete(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return scheduler_page_message(req, i18n_t(req, "scheduler.csrf_refused"))
    }
    return scheduler_complete_body(req, body)
}

fn scheduler_complete_body(req: Request, body: string) Response {
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    if id == 0 {
        return scheduler_page_message(req, "That chore was not found.")
    }
    let problem: string = scheduler_complete(id, str_trim(form_field(body, "note")))
    if problem != "" {
        return scheduler_page_message(req, problem)
    }
    return scheduler_page_message(req, "Chore completed.")
}

// scheduler_complete completes one chore: its next due time moves on, its usage
// starts again, the completion is kept with its note, and what it uses is taken
// off the inventory. It answers "" when done, what went wrong otherwise.
fn scheduler_complete(id: u32, note: string) string {
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok {
        return "The database could not be opened: " + opened.err
    }
    let db: SqlDb = opened.ok
    sql_apply(db, scheduler_schema())
    let chores: Chores[256]
    let slice: Slice[Chores] = Slice[Chores]{ Ptr[Chores](&chores[0]), SCHEDULER_CHORE_CAPACITY }
    let listed: Result[u32, SqlError] = ListChores(db, slice, SCHEDULER_CHORE_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    let at: i32 = scheduler_find(chores, count, id)
    if at < 0 {
        sql_close(db)
        return "That chore was not found."
    }
    let index: u32 = u32(at)
    let chore: Chores = chores[index]
    let now: u32 = scheduler_now()
    var next: u32 = 0
    if str_eq(chore.scheduleKind, "interval") {
        next = now + u32(chore.intervalHours) * 3600
    } else if str_eq(chore.scheduleKind, "cron") {
        next = scheduler_cron_next(chore.scheduleValue, now)
    }
    let updated: Result[u32, SqlError] = CompleteChore(i64(next), i64(now), i64(0),
        i64(id), db)
    if updated.is_ok {
        scheduler_ignore_result(InsertCompletion(int_to_str(id), int_to_str(now), note, db))
    }
    sql_close(db)
    if !updated.is_ok {
        return "The chore could not be completed: " + updated.err.message
    }
    // A chore that uses something takes it off the inventory as it is done.
    if chore.consumes != "" && chore.consumesMilli > 0 {
        if !inventory_consume(chore.consumes, u32(chore.consumesMilli), "chore: " + chore.title,
            "chore#" + int_to_str(id)) {
            warn("scheduler", chore.title + ": " + chore.consumes + " could not be taken off the inventory")
        }
    }
    info("scheduler", "chore completed")
    return ""
}

fn scheduler_chores_snooze(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return scheduler_page_message(req, i18n_t(req, "scheduler.csrf_refused"))
    }
    return scheduler_snooze_body(req, body)
}

fn scheduler_snooze_body(req: Request, body: string) Response {
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    var hours: u32 = int_from_str(str_trim(form_field(body, "hours")))
    if hours == 0 {
        hours = 24
    }
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok {
        return scheduler_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, scheduler_schema())
    let updated: Result[u32, SqlError] = SnoozeChore(
        i64(scheduler_now() + hours * 3600), i64(id), db)
    sql_close(db)
    if !updated.is_ok {
        return scheduler_page_message(req, "The chore could not be snoozed: " + updated.err.message)
    }
    return scheduler_page_message(req, "Chore snoozed.")
}

fn scheduler_chores_usage(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return scheduler_page_message(req, i18n_t(req, "scheduler.csrf_refused"))
    }
    return scheduler_usage_body(req, body)
}

fn scheduler_usage_body(req: Request, body: string) Response {
    let id: u32 = int_from_str(str_trim(form_field(body, "id")))
    let hours: u32 = int_from_str(str_trim(form_field(body, "hours")))
    if id == 0 || hours == 0 {
        return scheduler_page_message(req, "A usage update needs a chore and hours.")
    }
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok {
        return scheduler_page_message(req, "The database could not be opened: " + opened.err)
    }
    let db: SqlDb = opened.ok
    sql_apply(db, scheduler_schema())
    let updated: Result[u32, SqlError] = AddUsage(int_to_str(hours * 3600),
        i64(id), db)
    sql_close(db)
    if !updated.is_ok {
        return scheduler_page_message(req, "The usage could not be added: " + updated.err.message)
    }
    return scheduler_page_message(req, "Runtime added.")
}

/* -------------------------------------------------------------------------- */
/*  API                                                                       */
/* -------------------------------------------------------------------------- */

fn scheduler_json_chore(chore: Chores, now: u32) string {
    return "{\"id\":" + int_to_str(u32(chore.id)) +
        ",\"title\":" + json_string(chore.title) +
        ",\"kind\":" + json_string(chore.scheduleKind) +
        ",\"status\":" + json_string(scheduler_status(chore, now)) +
        ",\"priority\":" + json_string(chore.priority) +
        ",\"next_due\":" + json_string(scheduler_date(u32(chore.nextDueEpoch))) +
        ",\"last_completed\":" + json_string(scheduler_date(u32(chore.lastCompletedEpoch))) +
        "}"
}

fn scheduler_api_list(req: Request) Response {
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok {
        return json(status_internal(), "{\"error\":" + json_string(opened.err) + "}")
    }
    let db: SqlDb = opened.ok
    sql_apply(db, scheduler_schema())
    let chores: Chores[256]
    let slice: Slice[Chores] = Slice[Chores]{ Ptr[Chores](&chores[0]), SCHEDULER_CHORE_CAPACITY }
    let listed: Result[u32, SqlError] = ListChores(db, slice, SCHEDULER_CHORE_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    sql_close(db)
    let now: u32 = scheduler_now()
    var out: string = "["
    var i: u32 = 0
    while i < count {
        if i > 0 {
            out = out + ","
        }
        out = out + scheduler_json_chore(chores[i], now)
        i = i + 1
    }
    return json(status_ok(), out + "]")
}

fn scheduler_api_add(req: Request) Response {
    let body: string = request_body(req)
    if strlen(str_trim(form_field(body, "title"))) == 0 {
        return json(status_bad_request(), "{\"ok\":false}")
    }
    // A program that adds a chore carries a token, not the page's form token;
    // the answer says whether the chore was kept and, if not, why.
    let problem: string = scheduler_add_chore(req, body)
    if problem != "" {
        return json(status_bad_request(), "{\"ok\":false,\"error\":" + json_string(problem) + "}")
    }
    return json(status_created(), "{\"ok\":true}")
}

fn scheduler_api_complete(req: Request) Response {
    let id: string = param(req, "id")
    if strlen(id) == 0 {
        return json(status_bad_request(), "{\"ok\":false}")
    }
    scheduler_ignore_response(scheduler_complete_body(req, request_body(req) + "&id=" + id))
    return json(status_ok(), "{\"ok\":true}")
}

fn scheduler_api_snooze(req: Request) Response {
    let id: string = param(req, "id")
    if strlen(id) == 0 {
        return json(status_bad_request(), "{\"ok\":false}")
    }
    scheduler_ignore_response(scheduler_snooze_body(req, request_body(req) + "&id=" + id))
    return json(status_ok(), "{\"ok\":true}")
}

fn scheduler_api_usage(req: Request) Response {
    let id: string = param(req, "id")
    if strlen(id) == 0 {
        return json(status_bad_request(), "{\"ok\":false}")
    }
    scheduler_ignore_response(scheduler_usage_body(req, request_body(req) + "&id=" + id))
    return json(status_ok(), "{\"ok\":true}")
}

/* -------------------------------------------------------------------------- */
/*  Runtime and presets                                                       */
/* -------------------------------------------------------------------------- */

// scheduler_usage_tick adds to every usage chore tied to an inventory item the
// runtime the item has gained since it was last looked at: a filter's hours on
// become its maintenance chore's hours. Runtime from before a chore was tied to
// the item is not counted. A host calls it from its background work, after the
// inventory has counted runtime.
fn scheduler_usage_tick() u32 {
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok {
        return 0
    }
    let db: SqlDb = opened.ok
    sql_apply(db, scheduler_schema())
    let chores: Chores[256]
    let slice: Slice[Chores] = Slice[Chores]{ Ptr[Chores](&chores[0]), SCHEDULER_CHORE_CAPACITY }
    let listed: Result[u32, SqlError] = ListChores(db, slice, SCHEDULER_CHORE_CAPACITY)
    var added: u32 = 0
    if listed.is_ok {
        var i: u32 = 0
        while i < listed.ok {
            let chore: Chores = chores[i]
            if chore.runtimeOf != "" {
                let seconds: u32 = inventory_runtime_seconds(chore.runtimeOf)
                let seen: u32 = u32(chore.runtimeSeen)
                if seen > 0 && seconds > seen {
                    scheduler_ignore_result(AddUsage(int_to_str(seconds - seen), chore.id, db))
                    added = added + 1
                }
                if seconds != seen {
                    scheduler_ignore_result(SetChoreRuntimeSeen(i64(seconds), chore.id, db))
                }
            }
            i = i + 1
        }
    }
    sql_close(db)
    return added
}

// scheduler_presets seeds the application's chores from the text of its
// presets/schedule.yml: under `chores:`, each by a name, with its `title`,
// `kind` (interval, cron, date, usage), `value`, `interval_hours`,
// `usage_hours`, `grace_hours`, `priority`, `runtime_of`, `consumes` and
// `consumes_qty`. A chore is added once, by its title; after that it is the
// person's. It answers how many chores the presets named.
fn scheduler_presets(text: string) u32 {
    if str_trim(text) == "" {
        return 0
    }
    let path: string = scheduler_db_path() + ".presets.yml"
    if !rho_write_text(path, text) {
        return 0
    }
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok {
        return 0
    }
    let db: SqlDb = opened.ok
    sql_apply(db, scheduler_schema())
    let now: u32 = scheduler_now()
    var count: u32 = 0
    var rest: string = yaml.keys(path, "chores")
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        var key: string = rest
        if at < 0 {
            rest = ""
        } else {
            key = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        if key == "" {
            continue
        }
        let base: string = "chores." + key + "."
        var title: string = scheduler_unquote(yaml.value(path, base + "title"))
        if title == "" {
            title = key
        }
        var kind: string = scheduler_unquote(yaml.value(path, base + "kind"))
        if kind == "" {
            kind = "interval"
        }
        let value: string = scheduler_unquote(yaml.value(path, base + "value"))
        let interval_hours: u32 = int_from_str(scheduler_unquote(yaml.value(path, base + "interval_hours")))
        var priority: string = scheduler_unquote(yaml.value(path, base + "priority"))
        if priority == "" {
            priority = "normal"
        }
        let seeded: Result[u32, SqlError] = SeedChore(title,
            scheduler_unquote(yaml.value(path, base + "description")), kind, value,
            int_to_str(interval_hours),
            scheduler_unquote(yaml.value(path, base + "usage_hours")),
            scheduler_unquote(yaml.value(path, base + "grace_hours")), priority,
            int_to_str(scheduler_next_due(kind, value, interval_hours, now)), db)
        if seeded.is_ok && seeded.ok > 0 {
            let consumes: string = scheduler_unquote(yaml.value(path, base + "consumes"))
            var quantity: u32 = scheduler_milli(scheduler_unquote(yaml.value(path, base + "consumes_qty")))
            if consumes != "" && quantity == 0 {
                quantity = 1000
            }
            scheduler_ignore_result(SetChoreLinks(scheduler_unquote(yaml.value(path, base + "runtime_of")),
                consumes, i64(quantity), title, db))
        }
        count = count + 1
    }
    sql_close(db)
    return count
}

fn scheduler_unquote(text: string) string {
    let value: string = str_trim(text)
    let n: u32 = u32(strlen(value))
    if n >= 2 && (str_eq(str_slice(value, 0, 1), "\"") || str_eq(str_slice(value, 0, 1), "'")) {
        return str_slice(value, 1, n - 2)
    }
    return value
}

// scheduler_complete_title completes the newest enabled chore with a title, as
// a person completing it would (its next due time moves on, its usage starts
// again, what it uses is taken off the inventory), and answers whether there was
// one. An application calls it when what it records is the chore itself: a water
// change logged is the water-change chore done.
fn scheduler_complete_title(title: string, note: string) bool {
    let opened: Result[SqlDb, string] = sql_open(scheduler_db_path())
    if !opened.is_ok {
        return false
    }
    let db: SqlDb = opened.ok
    sql_apply(db, scheduler_schema())
    let chores: Chores[256]
    let slice: Slice[Chores] = Slice[Chores]{ Ptr[Chores](&chores[0]), SCHEDULER_CHORE_CAPACITY }
    let listed: Result[u32, SqlError] = ListChores(db, slice, SCHEDULER_CHORE_CAPACITY)
    var best: i64 = 0
    if listed.is_ok {
        var i: u32 = 0
        while i < listed.ok {
            if chores[i].enabled != 0 && str_eq(chores[i].title, title) && chores[i].id > best {
                best = chores[i].id
            }
            i = i + 1
        }
    }
    sql_close(db)
    if best == 0 {
        return false
    }
    return scheduler_complete(u32(best), note) == ""
}

// scheduler_settings_form is this module's own settings, as a form posted to action:
// an application's settings page shows it as one of its tabs.
fn scheduler_settings_form(req: Request, action: string) string {
    var fields: FormField[2]
    fields[0] = FormField{ "priority", "text", i18n_t(req, "scheduler.settings.priority"), "",
        "normal", false, "", "", settings_get("scheduler.priority", "normal"), "", "" }
    fields[1] = FormField{ "grace_hours", "text", i18n_t(req, "scheduler.settings.grace"), "",
        "12", false, "", "", settings_get("scheduler.grace_hours", "12"), "", "numeric" }
    return forms_open(fields, 2, action, i18n_t(req, "settings.save"), i18n_locale(req))
}

// scheduler_settings_save keeps what that form posted.
fn scheduler_settings_save(body: string) void {
    settings_set("scheduler.priority", str_trim(form_field(body, "priority")))
    settings_set("scheduler.grace_hours", str_trim(form_field(body, "grace_hours")))
}
