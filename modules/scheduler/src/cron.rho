//
// @file cron.rho
// @brief Five-field cron expressions: which values a field allows, and the next time an expression names.
//
// @module scheduler
// @project robohub
// @author Aurel Miron
// @date 2026-11-14
//
// SPDX-License-Identifier: MIT
//

module scheduler

// Pure apart from the clock's offset: a chore's `cron` schedule is read here,
// and the tests read it the same way without a database.

fn scheduler_field(expression: string, wanted: u32) string {
    var rest: string = expression
    var index: u32 = 0
    while rest != "" {
        let at: i32 = str_index_of(rest, " ")
        var field_text: string = ""
        if at < 0 {
            field_text = rest
            rest = ""
        } else {
            field_text = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        if index == wanted {
            return field_text
        }
        index = index + 1
    }
    return ""
}

// scheduler_cron_set is which values a cron field allows, from low to high, as
// a string with "x" at each allowed place: `*`, `5`, `1-5`, `1,3,5`, `*/15`,
// `10-50/20`, and lists of them. A field that cannot be read allows nothing.
fn scheduler_cron_set(field: string, low: u32, high: u32) string {
    var out: string = ""
    var i: u32 = 0
    while i <= high {
        out = out + "."
        i = i + 1
    }
    var rest: string = field
    while rest != "" {
        let comma: i32 = str_index_of(rest, ",")
        var item: string = rest
        if comma < 0 {
            rest = ""
        } else {
            item = str_slice(rest, 0, u32(comma))
            rest = str_slice(rest, u32(comma) + 1, u32(strlen(rest)) - u32(comma) - 1)
        }
        var stride: u32 = 1
        let slash: i32 = str_index_of(item, "/")
        if slash >= 0 {
            stride = int_from_str(str_slice(item, u32(slash) + 1, u32(strlen(item)) - u32(slash) - 1))
            item = str_slice(item, 0, u32(slash))
        }
        if stride == 0 {
            return ""
        }
        var from: u32 = low
        var to: u32 = high
        if !str_eq(item, "*") {
            let dash: i32 = str_index_of(item, "-")
            if dash > 0 {
                from = int_from_str(str_slice(item, 0, u32(dash)))
                to = int_from_str(str_slice(item, u32(dash) + 1, u32(strlen(item)) - u32(dash) - 1))
            } else {
                from = int_from_str(item)
                to = from
                if slash >= 0 {
                    to = high
                }
            }
        }
        if from < low || to > high || from > to {
            return ""
        }
        var v: u32 = from
        while v <= to {
            out = str_slice(out, 0, v) + "x" + str_slice(out, v + 1, u32(strlen(out)) - v - 1)
            v = v + stride
        }
    }
    return out
}

fn scheduler_allows(set: string, value: u32) bool {
    return value < u32(strlen(set)) && str_eq(str_slice(set, value, 1), "x")
}

// scheduler_cron_next is the first time after now a five-field cron expression
// (minute hour day-of-month month day-of-week) names, in the machine's local
// time; 0 when the expression cannot be read or names no time in a year. As in
// cron, when both the day of the month and the day of the week are restricted,
// a day matching either is taken; day of week 7 is Sunday, as 0 is.
fn scheduler_cron_next(expression: string, now: u32) u32 {
    let minutes: string = scheduler_cron_set(scheduler_field(expression, 0), 0, 59)
    let hours: string = scheduler_cron_set(scheduler_field(expression, 1), 0, 23)
    let dom_field: string = scheduler_field(expression, 2)
    let days: string = scheduler_cron_set(dom_field, 1, 31)
    let months: string = scheduler_cron_set(scheduler_field(expression, 3), 1, 12)
    let dow_field: string = scheduler_field(expression, 4)
    let weekdays: string = scheduler_cron_set(dow_field, 0, 7)
    if minutes == "" || hours == "" || days == "" || months == "" || weekdays == "" || scheduler_field(expression, 5) != "" {
        return 0
    }
    let dom_any: bool = str_eq(dom_field, "*")
    let dow_any: bool = str_eq(dow_field, "*")
    let offset: i64 = rho_utc_offset_at(i64(now))
    let local_now: i64 = i64(now) + offset
    var day: i64 = local_now / 86400
    let last: i64 = day + 400
    while day <= last {
        // The civil date of a day since 1970 (Howard Hinnant's algorithm).
        let z: i64 = day + 719468
        let era: i64 = z / 146097
        let doe: i64 = z - era * 146097
        let yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
        let doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100)
        let mp: i64 = (5 * doy + 2) / 153
        let date: u32 = u32(doy - (153 * mp + 2) / 5 + 1)
        var month: u32 = u32(mp + 3)
        if mp >= 10 {
            month = u32(mp - 9)
        }
        let weekday: u32 = u32((day + 4) % 7)
        let dom_ok: bool = scheduler_allows(days, date)
        let dow_ok: bool = scheduler_allows(weekdays, weekday) || (weekday == 0 && scheduler_allows(weekdays, 7))
        var day_ok: bool = dom_ok && dow_ok
        if !dom_any && !dow_any {
            day_ok = dom_ok || dow_ok
        }
        if scheduler_allows(months, month) && day_ok {
            var hour: u32 = 0
            while hour < 24 {
                if scheduler_allows(hours, hour) {
                    var minute: u32 = 0
                    while minute < 60 {
                        if scheduler_allows(minutes, minute) {
                            let local: i64 = day * 86400 + i64(hour) * 3600 + i64(minute) * 60
                            if local > local_now {
                                // Back to UTC with the offset in force then: a
                                // schedule crossing a change of summer time keeps
                                // its wall-clock hour.
                                let at: i64 = local - rho_utc_offset_at(local - offset)
                                return u32(at)
                            }
                        }
                        minute = minute + 1
                    }
                }
                hour = hour + 1
            }
        }
        day = day + 1
    }
    return 0
}
