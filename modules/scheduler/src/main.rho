module scheduler

// scheduler — recurring chores and deferred tasks.
//
// The module registers its routes on the host application's router. It has no
// port and no database of its own: its tables are applied to the host's main
// SQL database, and its settings come from the host's app_modules entry.

include "text.rho"
include "scheduler.rho"
include "notifications"
include "forms"
include "settings"

import std.sql
import std.web.http
import std.web.template

extern fn rho_write_text(path: string, text: string) bool

// The runtime functions this module calls.
extern fn rho_exec(program: string, arguments: string, output_path: string) u32
// The clock and a program's output, from the runtime rather than through a file.
extern fn rho_now_s() u32
extern fn rho_utc_offset_at(epoch: i64) i64
extern fn rho_exec_capture(program: string, arguments: string) string
extern fn rho_read_text(path: string) string

route GET  "/scheduler"                          => scheduler_page
route POST "/scheduler/chores/add"               => chores_add
route POST "/scheduler/chores/complete"          => chores_complete
route POST "/scheduler/chores/snooze"            => chores_snooze
route POST "/scheduler/chores/usage"             => chores_usage
route GET  "/api/scheduler/chores"               => scheduler_api_list
route POST "/api/scheduler/chores"               => scheduler_api_add
route POST "/api/scheduler/chores/{id}/complete" => scheduler_api_complete
route POST "/api/scheduler/chores/{id}/snooze"   => scheduler_api_snooze
route POST "/api/scheduler/chores/{id}/usage"    => scheduler_api_usage
