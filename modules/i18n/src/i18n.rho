module i18n

import std.web.http
import std.web.template

// A module's own files, embedded in the program that includes it.
extern fn rho_asset(module: string, path: string) string
extern fn rho_read_text(path: string) string


fn i18n_template(name: string) string {
    return rho_asset("i18n", "templates/" + name + ".html")
}

// The languages this module knows. A new catalog is one entry here and one
// file in the module's `locales:`.
fn i18n_supported(code: string) bool {
    if str_eq(code, "en") { return true }
    if str_eq(code, "ro") { return true }
    return false
}

fn i18n_trim(value: string) string {
    var start: u32 = 0
    var end: u32 = u32(strlen(value))
    while start < end {
        let ch: string = str_slice(value, start, 1)
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
            start = start + 1
        } else {
            break
        }
    }
    while end > start {
        let ch: string = str_slice(value, end - 1, 1)
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
            end = end - 1
        } else {
            break
        }
    }
    return str_slice(value, start, end - start)
}

fn i18n_lower(value: string) string {
    let upper: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let lower: string = "abcdefghijklmnopqrstuvwxyz"
    var out: string = ""
    var i: u32 = 0
    let length: u32 = u32(strlen(value))
    while i < length {
        let ch: string = str_slice(value, i, 1)
        let at: i32 = str_index_of(upper, ch)
        if at >= 0 {
            ch = str_slice(lower, u32(at), 1)
        }
        out = out + ch
        i = i + 1
    }
    return out
}

fn i18n_starts(value: string, prefix: string) bool {
    return str_index_of(value, prefix) == 0
}

// i18n_cookie reads one cookie without a session: the language choice is a
// functional preference, not an identity.
fn i18n_cookie(req: Request, name: string) string {
    if !has_header(req, "Cookie") {
        return ""
    }
    var rest: string = header_str(req, "Cookie")
    while rest != "" {
        let semi: i32 = str_index_of(rest, ";")
        var part: string = rest
        if semi < 0 {
            rest = ""
        } else {
            part = str_slice(rest, 0, u32(semi))
            rest = str_slice(rest, u32(semi) + 1, u32(strlen(rest)) - u32(semi) - 1)
        }
        part = i18n_trim(part)
        let equals: i32 = str_index_of(part, "=")
        if equals >= 0 {
            let key: string = i18n_trim(str_slice(part, 0, u32(equals)))
            if str_eq(key, name) {
                return i18n_trim(str_slice(part, u32(equals) + 1,
                    u32(strlen(part)) - u32(equals) - 1))
            }
        }
    }
    return ""
}

// i18n_accept picks the first supported tag from Accept-Language. A regional
// tag falls back to its primary language: ro-RO is ro.
fn i18n_accept(req: Request) string {
    if !has_header(req, "Accept-Language") {
        return ""
    }
    var rest: string = header_str(req, "Accept-Language")
    if rest == "" {
        return ""
    }
    let comma: i32 = str_index_of(rest, ",")
    if comma >= 0 {
        rest = str_slice(rest, 0, u32(comma))
    }
    let semi: i32 = str_index_of(rest, ";")
    if semi >= 0 {
        rest = str_slice(rest, 0, u32(semi))
    }
    rest = i18n_lower(i18n_trim(rest))
    if i18n_supported(rest) {
        return rest
    }
    let dash: i32 = str_index_of(rest, "-")
    if dash >= 0 {
        let primary: string = str_slice(rest, 0, u32(dash))
        if i18n_supported(primary) {
            return primary
        }
    }
    return ""
}

fn i18n_locale(req: Request) string {
    let cookie: string = i18n_lower(i18n_cookie(req, "locale"))
    if i18n_supported(cookie) {
        return cookie
    }
    let accepted: string = i18n_accept(req)
    if accepted != "" {
        return accepted
    }
    return "en"
}

fn i18n_flag(locale: string, code: string) string {
    if str_eq(locale, code) {
        return "true"
    }
    return ""
}

fn i18n_switcher(req: Request) string {
    let locale: string = i18n_locale(req)
    return template_fill(i18n_template("parts/switcher"),
        vars("__locale", locale) +
        vars("next", request_path(req)) +
        vars("en", i18n_flag(locale, "en")) +
        vars("ro", i18n_flag(locale, "ro")))
}

// i18n_vars is what a page helper adds to a template fill. It carries the
// chosen language and the switcher, so every full page and fragment agrees.
fn i18n_vars(req: Request) string {
    let locale: string = i18n_locale(req)
    return vars("__locale", locale) +
        vars("locale", locale) +
        vars("locale_switch", i18n_switcher(req))
}

// i18n_t translates a key outside a template, for a notice or an error. The
// key is internal, so it is quoted rather than pasted into the template.
fn i18n_t(req: Request, key: string) string {
    return template_fill("{{t " + json_string(key) + "}}", i18n_vars(req))
}

fn i18n_safe_next(value: string) string {
    if value == "" { return "/" }
    if !i18n_starts(value, "/") { return "/" }
    if i18n_starts(value, "//") { return "/" }
    if str_index_of(value, "://") >= 0 { return "/" }
    return value
}

fn i18n_switch(req: Request) Response {
    let body: string = request_body(req)
    var code: string = i18n_lower(i18n_trim(forms_parse(body, "locale")))
    if !i18n_supported(code) {
        code = "en"
    }
    let next: string = i18n_safe_next(i18n_trim(forms_parse(body, "next")))
    let headers: string = "Set-Cookie: locale=" + code +
        "; Path=/; Max-Age=31536000; SameSite=Lax\nHX-Redirect: " + next
    return with_headers(redirect(next), headers)
}

/* -------------------------------------------------------------------------- */
/*  Whole labels                                                              */
/* -------------------------------------------------------------------------- */

// An application that writes its labels in English carries a catalog of whole
// labels per language — `phrases.<locale>.txt` in a folder of its own, English and
// the translation separated by a tab, one per line — and i18n_phrases turns a page
// into the language the request asks for. A label is replaced only where it is a
// whole text between tags, a placeholder or a title, so a word inside a sentence
// or a name is never touched; a label not in the catalog stays English. What a
// page receives later (htmx, a live stream) is translated in the browser with the
// same catalog.

fn i18n_replace_all(text: string, from: string, to: string) string {
    if from == "" || str_index_of(text, from) < 0 {
        return text
    }
    var out: string = ""
    var rest: string = text
    while rest != "" {
        let at: i32 = str_index_of(rest, from)
        if at < 0 {
            out = out + rest
            rest = ""
        } else {
            out = out + str_slice(rest, 0, u32(at)) + to
            rest = str_slice(rest, u32(at) + u32(strlen(from)), u32(strlen(rest)) - u32(at) - u32(strlen(from)))
        }
    }
    return out
}

// i18n_phrases_script is the catalog for the browser.
fn i18n_phrases_script(catalog: string) string {
    var pairs: string = ""
    var rest: string = catalog
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        let tab: i32 = str_index_of(line, "\t")
        if tab <= 0 || str_index_of(line, "#") == 0 {
            continue
        }
        if pairs != "" {
            pairs = pairs + ","
        }
        pairs = pairs + json_string(str_slice(line, 0, u32(tab))) + ":" +
            json_string(str_slice(line, u32(tab) + 1, u32(strlen(line)) - u32(tab) - 1))
    }
    return "<script>(function(){var P={" + pairs + "};function tr(root){if(!root||!root.nodeType)return;" +
        "if(root.nodeType===3){var t=root.nodeValue.trim();if(t&&P[t])root.nodeValue=root.nodeValue.replace(t,P[t]);return}" +
        "if(root.nodeType!==1)return;var w=document.createTreeWalker(root,4);var n;while((n=w.nextNode())){var v=n.nodeValue.trim();if(v&&P[v])n.nodeValue=n.nodeValue.replace(v,P[v])}" +
        "[root].concat(Array.prototype.slice.call(root.querySelectorAll('[placeholder],[title]'))).forEach(function(e){['placeholder','title'].forEach(function(a){var x=e.getAttribute&&e.getAttribute(a);if(x&&P[x])e.setAttribute(a,P[x])})})}" +
        "new MutationObserver(function(list){list.forEach(function(m){m.addedNodes.forEach(tr)})}).observe(document.body,{childList:true,subtree:true})})();</script>"
}

// i18n_phrases is a page — whole or a fragment — in the request's language, from
// the catalog in `folder` (phrases.<locale>.txt). A whole page also carries the
// catalog for what it receives later.
fn i18n_phrases(req: Request, html_text: string, folder: string) string {
    let locale: string = i18n_locale(req)
    if locale == "" || locale == "en" || str_index_of(locale, "/") >= 0 || str_index_of(locale, ".") >= 0 {
        return html_text
    }
    let catalog: string = rho_read_text(folder + "/phrases." + locale + ".txt")
    if catalog == "" {
        return html_text
    }
    // Each label is first replaced by a placeholder and only then by its
    // translation, so a translation that is itself an English label (Modules is
    // Module, Module is Modul) is not translated a second time.
    var out: string = html_text
    var finals: string = ""
    var rest: string = catalog
    var count: u32 = 0
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        let tab: i32 = str_index_of(line, "\t")
        if tab <= 0 || str_index_of(line, "#") == 0 {
            continue
        }
        let english: string = escape_html(str_slice(line, 0, u32(tab)))
        let mark: string = "⟦" + int_to_str(count) + "⟧"
        out = i18n_replace_all(out, ">" + english + "<", ">" + mark + "<")
        out = i18n_replace_all(out, "placeholder=\"" + english + "\"", "placeholder=\"" + mark + "\"")
        out = i18n_replace_all(out, "title=\"" + english + "\"", "title=\"" + mark + "\"")
        finals = finals + mark + "\t" + escape_html(str_slice(line, u32(tab) + 1, u32(strlen(line)) - u32(tab) - 1)) + "\n"
        count = count + 1
    }
    rest = finals
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        let tab: i32 = str_index_of(line, "\t")
        if tab > 0 {
            out = i18n_replace_all(out, str_slice(line, 0, u32(tab)), str_slice(line, u32(tab) + 1, u32(strlen(line)) - u32(tab) - 1))
        }
    }
    let body_end: i32 = str_index_of(out, "</body>")
    if body_end > 0 {
        out = str_slice(out, 0, u32(body_end)) + i18n_phrases_script(catalog) + str_slice(out, u32(body_end), u32(strlen(out)) - u32(body_end))
    }
    return out
}
