module i18n

import std.web.http
import std.web.template

// A module's own files, embedded in the program that includes it.
extern fn rho_asset(module: string, path: string) string


fn i18n_template(name: string) string {
    return rho_asset("i18n", "templates/" + name + ".html")
}

// The languages this module knows. A new catalog is one entry here and one
// file in the module's `locales:`.
fn i18n_supported(code: string) bool {
    if rho_str_eq(code, "en") { return true }
    if rho_str_eq(code, "ro") { return true }
    return false
}

fn i18n_trim(value: string) string {
    var start: u32 = 0
    var end: u32 = u32(rho_strlen(value))
    while start < end {
        let ch: string = rho_str_slice(value, start, 1)
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
            start = start + 1
        } else {
            break
        }
    }
    while end > start {
        let ch: string = rho_str_slice(value, end - 1, 1)
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
            end = end - 1
        } else {
            break
        }
    }
    return rho_str_slice(value, start, end - start)
}

fn i18n_lower(value: string) string {
    let upper: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let lower: string = "abcdefghijklmnopqrstuvwxyz"
    var out: string = ""
    var i: u32 = 0
    let length: u32 = u32(rho_strlen(value))
    while i < length {
        let ch: string = rho_str_slice(value, i, 1)
        let at: i32 = rho_str_index_of(upper, ch)
        if at >= 0 {
            ch = rho_str_slice(lower, u32(at), 1)
        }
        out = out + ch
        i = i + 1
    }
    return out
}

fn i18n_starts(value: string, prefix: string) bool {
    return rho_str_index_of(value, prefix) == 0
}

// i18n_cookie reads one cookie without a session: the language choice is a
// functional preference, not an identity.
fn i18n_cookie(req: Request, name: string) string {
    if !has_header(req, "Cookie") {
        return ""
    }
    var rest: string = header_str(req, "Cookie")
    while rest != "" {
        let semi: i32 = rho_str_index_of(rest, ";")
        var part: string = rest
        if semi < 0 {
            rest = ""
        } else {
            part = rho_str_slice(rest, 0, u32(semi))
            rest = rho_str_slice(rest, u32(semi) + 1, u32(rho_strlen(rest)) - u32(semi) - 1)
        }
        part = i18n_trim(part)
        let equals: i32 = rho_str_index_of(part, "=")
        if equals >= 0 {
            let key: string = i18n_trim(rho_str_slice(part, 0, u32(equals)))
            if rho_str_eq(key, name) {
                return i18n_trim(rho_str_slice(part, u32(equals) + 1,
                    u32(rho_strlen(part)) - u32(equals) - 1))
            }
        }
    }
    return ""
}

// i18n_accept picks the first supported tag from Accept-Language. A regional
// tag falls back to its primary language: ro-RO is ro.
fn i18n_accept(req: Request) string {
    if !has_header(req, "Accept-Language") {
        return ""
    }
    var rest: string = header_str(req, "Accept-Language")
    if rest == "" {
        return ""
    }
    let comma: i32 = rho_str_index_of(rest, ",")
    if comma >= 0 {
        rest = rho_str_slice(rest, 0, u32(comma))
    }
    let semi: i32 = rho_str_index_of(rest, ";")
    if semi >= 0 {
        rest = rho_str_slice(rest, 0, u32(semi))
    }
    rest = i18n_lower(i18n_trim(rest))
    if i18n_supported(rest) {
        return rest
    }
    let dash: i32 = rho_str_index_of(rest, "-")
    if dash >= 0 {
        let primary: string = rho_str_slice(rest, 0, u32(dash))
        if i18n_supported(primary) {
            return primary
        }
    }
    return ""
}

fn i18n_locale(req: Request) string {
    let cookie: string = i18n_lower(i18n_cookie(req, "locale"))
    if i18n_supported(cookie) {
        return cookie
    }
    let accepted: string = i18n_accept(req)
    if accepted != "" {
        return accepted
    }
    return "en"
}

fn i18n_flag(locale: string, code: string) string {
    if rho_str_eq(locale, code) {
        return "true"
    }
    return ""
}

fn i18n_switcher(req: Request) string {
    let locale: string = i18n_locale(req)
    return template_fill(i18n_template("parts/switcher"),
        vars("__locale", locale) +
        vars("next", request_path(req)) +
        vars("en", i18n_flag(locale, "en")) +
        vars("ro", i18n_flag(locale, "ro")))
}

// i18n_vars is what a page helper adds to a template fill. It carries the
// chosen language and the switcher, so every full page and fragment agrees.
fn i18n_vars(req: Request) string {
    let locale: string = i18n_locale(req)
    return vars("__locale", locale) +
        vars("locale", locale) +
        vars("locale_switch", i18n_switcher(req))
}

// i18n_t translates a key outside a template, for a notice or an error. The
// key is internal, so it is quoted rather than pasted into the template.
fn i18n_t(req: Request, key: string) string {
    return template_fill("{{t " + json_string(key) + "}}", i18n_vars(req))
}

fn i18n_safe_next(value: string) string {
    if value == "" { return "/" }
    if !i18n_starts(value, "/") { return "/" }
    if i18n_starts(value, "//") { return "/" }
    if rho_str_index_of(value, "://") >= 0 { return "/" }
    return value
}

fn i18n_switch(req: Request) Response {
    let body: string = request_body(req)
    var code: string = i18n_lower(i18n_trim(form_value(body, "locale")))
    if !i18n_supported(code) {
        code = "en"
    }
    let next: string = i18n_safe_next(i18n_trim(form_value(body, "next")))
    let headers: string = "Set-Cookie: locale=" + code +
        "; Path=/; Max-Age=31536000; SameSite=Lax\nHX-Redirect: " + next
    return with_headers(redirect(next), headers)
}
