module notifications

// notifications — transient toast notifications included by a host application.
//
// The module registers its API on the host router. Its table lives in the
// host's main SQL database, and its settings are the host's modules entry.

include "text.rho"
include "notifications.rho"

import std.sql
import std.web.http
import std.web.template

// The runtime functions this module calls.
extern fn rho_exec(program: string, arguments: string, output_path: string) u32
// The clock and a program's output, from the runtime rather than through a file.
extern fn rho_now_s() u32
extern fn rho_read_text(path: string) string
extern fn rho_append_text(path: string, text: string) bool

route POST "/notifications/push"         => notifications_push
route GET  "/notifications/list"         => notifications_list
route POST "/notifications/dismiss"      => notifications_dismiss
route GET  "/notifications/render"       => notifications_render
route GET  "/api/notifications"          => notifications_api_list
route GET  "/notifications/stream"       => notification_events
