module notifications

fn notification_escape(text: string) string {
    var out: string = ""
    var i: u32 = 0
    while i < u32(strlen(text)) {
        let ch: string = str_slice(text, i, 1)
        if str_eq(ch, "<") {
            out = out + "&lt;"
        } else if str_eq(ch, ">") {
            out = out + "&gt;"
        } else if str_eq(ch, "&") {
            out = out + "&amp;"
        } else if str_eq(ch, "\"") {
            out = out + "&quot;"
        } else {
            out = out + ch
        }
        i = i + 1
    }
    return out
}

fn notification_workspace() string {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/notifications"
    }
    return workspace
}

fn notification_db_path() string {
    let override: string = getenv("RHO_NOTIFICATIONS_DB")
    if override != "" {
        return override
    }
    let dir: string = notification_workspace() + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    return dir + "/app.db"
}

fn notification_schema() string {
    return rho_asset("notifications", "db/schema.sql")
}

fn notification_now() u32 {
    return rho_now_s()
}
