module notifications

fn notification_workspace() string {
    let workspace: string = app_workspace()
    return workspace
}

fn notification_db_path() string {
    let override: string = getenv("RHO_NOTIFICATIONS_DB")
    if override != "" {
        return override
    }
    let dir: string = notification_workspace() + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    return dir + "/app.db"
}

fn notification_schema() string {
    return rho_asset("notifications", "db/schema.sql")
}

fn notification_now() u32 {
    return rho_now_s()
}
