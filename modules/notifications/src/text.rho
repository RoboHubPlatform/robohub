module notifications

fn notification_space(ch: string) bool {
    return str_eq(ch, " ") || str_eq(ch, "\n") ||
        str_eq(ch, "\r") || str_eq(ch, "\t")
}

fn notification_trim(text: string) string {
    var out: string = text
    while strlen(out) > 0 && notification_space(str_slice(out, 0, 1)) {
        out = str_slice(out, 1, u32(strlen(out)) - 1)
    }
    while strlen(out) > 0 &&
        notification_space(str_slice(out, u32(strlen(out)) - 1, 1)) {
        out = str_slice(out, 0, u32(strlen(out)) - 1)
    }
    return out
}

fn notification_form_value(body: string, name: string) string {
    var rest: string = body + "&"
    while strlen(rest) > 0 {
        let amp: i32 = str_index_of(rest, "&")
        if amp < 0 {
            break
        }
        let pair: string = str_slice(rest, 0, u32(amp))
        rest = str_slice(rest, u32(amp) + 1, u32(strlen(rest)) - u32(amp) - 1)
        let equals: i32 = str_index_of(pair, "=")
        if equals < 0 {
            continue
        }
        if str_eq(notification_trim(str_slice(pair, 0, u32(equals))), name) {
            return notification_trim(str_slice(pair, u32(equals) + 1,
                u32(strlen(pair)) - u32(equals) - 1))
        }
    }
    return ""
}

fn notification_escape(text: string) string {
    var out: string = ""
    var i: u32 = 0
    while i < u32(strlen(text)) {
        let ch: string = str_slice(text, i, 1)
        if str_eq(ch, "<") {
            out = out + "&lt;"
        } else if str_eq(ch, ">") {
            out = out + "&gt;"
        } else if str_eq(ch, "&") {
            out = out + "&amp;"
        } else if str_eq(ch, "\"") {
            out = out + "&quot;"
        } else {
            out = out + ch
        }
        i = i + 1
    }
    return out
}


fn notification_workspace() string {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/modules/notifications"
    }
    return workspace
}

fn notification_db_path() string {
    let override: string = getenv("RHO_NOTIFICATIONS_DB")
    if override != "" {
        return override
    }
    let dir: string = notification_workspace() + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    return dir + "/app.db"
}

fn notification_schema() string {
    return rho_asset("notifications", "db/schema.sql")
}

fn notification_now() u32 {
    let dir: string = notification_workspace() + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    let report: string = dir + "/now.txt"
    if rho_exec("date", "+%s", report) == 0 {
        return int_from_str(notification_trim(rho_read_text(report)))
    }
    return 0
}
