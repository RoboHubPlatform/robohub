//
// @file settings.rho
// @brief Settings kept in the application's workspace: read, written and defaulted.
//
// @module settings
// @project robohub
// @author Aurel Miron
// @date 2026-11-08
//
// SPDX-License-Identifier: MIT
//

module settings

fn settings_file() string {
    // The application's own workspace, under either name the launcher gives it.
    // An application started with neither shares the fallback store.
    var workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("RHO_APP_WORKSPACE")
    }
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/robohub"
    }
    let dir: string = workspace + "/data"
    rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt")
    return dir + "/settings.conf"
}

fn settings_get(key: string, fallback: string) string {
    var rest: string = rho_read_text(settings_file())
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        let equals: i32 = str_index_of(line, "=")
        if equals > 0 {
            let name: string = str_slice(line, 0, u32(equals))
            if str_eq(name, key) {
                return str_slice(line, u32(equals) + 1,
                    u32(strlen(line)) - u32(equals) - 1)
            }
        }
    }
    return fallback
}

fn settings_set(key: string, value: string) void {
    let path: string = settings_file()
    let prefix: string = key + "="
    let text: string = rho_read_text(path)
    var out: string = ""
    var found: bool = false
    var rest: string = text
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        if str_index_of(line, prefix) == 0 {
            line = prefix + value
            found = true
        }
        if line != "" {
            out = out + line + "\n"
        }
    }
    if !found {
        out = out + prefix + value + "\n"
    }
    rho_write_text(path, out)
}

// settings_list returns the `key=value` lines under a namespace, so a host can
// render a generic editor for a module that has no parent settings page.
fn settings_list(prefix: string) string {
    var out: string = ""
    var rest: string = rho_read_text(settings_file())
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = str_slice(rest, 0, u32(at))
            rest = str_slice(rest, u32(at) + 1, u32(strlen(rest)) - u32(at) - 1)
        }
        if line != "" && str_index_of(line, prefix) == 0 {
            out = out + line + "\n"
        }
    }
    return out
}
