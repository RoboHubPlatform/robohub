module robohub.providers.mesh

import rho.log

// The Mesh gateway provider.
//
// Every request in the Mesh API that another application needs is here, not in
// the application. Aquarium and a future dashboard ask the gateway contract
// for projects, a gateway, sources, device states and a source state; this
// provider is the one that knows those paths are under /mesh/api.
//
// It talks to Mesh and to nothing else. Every request carries a short-lived
// service token for Mesh, scoped to the project, which the runtime gets from the
// issuer with the credential the application was started with; no token is
// stored in a setting, put on a command line, or sent to an address that is not
// Mesh's.

extern fn rho_http_request(method: string, url: string, body: string, content_type: string,
    audience: string, scopes: string, output_path: string) u32

fn provider_mesh_base(config: string) string {
    // The supervisor that started the application says where Mesh is; a
    // setting is the fallback for an application started by hand.
    var url: string = getenv("RHO_SERVICE_MESH_URL")
    if url == "" {
        url = gateway_config_value(config, "url")
    }
    while rho_strlen(url) > 0 &&
        rho_str_eq(rho_str_slice(url, u32(rho_strlen(url)) - 1, 1), "/") {
        url = rho_str_slice(url, 0, u32(rho_strlen(url)) - 1)
    }
    return url
}

fn provider_mesh_project(config: string) string {
    return gateway_config_value(config, "project")
}

// provider_mesh_audience is the audience a request to `url` carries a token
// for: Mesh's, when the address is Mesh's, and none otherwise. A source a user
// stored can name any address, and a token is only ever sent to its audience.
fn provider_mesh_audience(config: string, url: string) string {
    let base: string = provider_mesh_base(config)
    if base != "" && (rho_str_eq(url, base) || rho_str_starts_with(url, base + "/")) {
        return "mesh"
    }
    return ""
}

fn provider_mesh_scope(config: string) string {
    return "mesh:" + provider_mesh_project(config)
}

fn provider_mesh_fetch(config: string, url: string, name: string) string {
    let report: string = gateway_report(name)
    let status: u32 = rho_http_request("GET", url, "", "", provider_mesh_audience(config, url),
        provider_mesh_scope(config), report)
    if status != 200 {
        warn("mesh-gateway", "fetch failed (" + rho_int_to_str(status) + "): " + url)
        return ""
    }
    return rho_read_text(report)
}

fn provider_mesh_projects(config: string) string {
    let base: string = provider_mesh_base(config)
    if base == "" {
        return ""
    }
    return provider_mesh_fetch(config, base + "/mesh/api/projects", "mesh-projects")
}

fn provider_mesh_gateway(config: string) string {
    let base: string = provider_mesh_base(config)
    let project: string = provider_mesh_project(config)
    if base == "" || project == "" {
        return ""
    }
    let text: string = provider_mesh_fetch(config, base + "/mesh/api/projects/" + project + "/gateway",
        "mesh-gateway")
    if rho_str_index_of(text, "\"available\":true") < 0 {
        return ""
    }
    return gateway_json_string_field(text, "url")
}

fn provider_mesh_sources(config: string) string {
    let base: string = provider_mesh_base(config)
    let project: string = provider_mesh_project(config)
    if base == "" || project == "" {
        return ""
    }
    return provider_mesh_fetch(config, base + "/mesh/api/projects/" + project +
        "/sources?base=" + gateway_urlencode(base), "mesh-sources")
}

// provider_mesh_device_states used to ask the project's gateway directly, which
// is a second way to a device beside Mesh, with no token and no scope. A device's
// state is a source's value, which gateway_source_state reads through Mesh, so
// this answers nothing and a caller falls back to that.
fn provider_mesh_device_states(config: string) string {
    return ""
}

fn provider_mesh_source_state(config: string, source: string) string {
    let action: i32 = rho_str_index_of(source, "/action")
    if rho_str_index_of(source, "/mesh/api/") < 0 || action < 0 {
        return ""
    }
    let value_url: string = rho_str_slice(source, 0, u32(action)) + "/value"
    let state: string = gateway_trim(provider_mesh_fetch(config, value_url, "mesh-state"))
    if rho_str_eq(state, "on") || rho_str_eq(state, "off") {
        return state
    }
    return ""
}

// provider_mesh_source_id accepts the forms a caller may have stored: the
// source ID gateway_sources returned, a value or action URL, or a URL with a
// `source=` query. All three name the same series.
fn provider_mesh_source_id(source: string) string {
    let marker: i32 = rho_str_index_of(source, "source=")
    if marker >= 0 {
        return rho_str_slice(source, u32(marker) + 7,
            u32(rho_strlen(source)) - u32(marker) - 7)
    }
    let sources: i32 = rho_str_index_of(source, "/sources/")
    if sources >= 0 {
        let start: u32 = u32(sources) + 9
        let rest: string = rho_str_slice(source, start, u32(rho_strlen(source)) - start)
        let slash: i32 = rho_str_index_of(rest, "/")
        if slash < 0 {
            return rest
        }
        return rho_str_slice(rest, 0, u32(slash))
    }
    return source
}

// provider_mesh_source_history asks Mesh for a source's series. The source ID
// is the one gateway_sources returned, so an application never has to know
// which area, node or field the reading was stored under.
fn provider_mesh_source_history(config: string, source: string, from_ms: string, to_ms: string, step_ms: string) string {
    let base: string = provider_mesh_base(config)
    let project: string = provider_mesh_project(config)
    if base == "" || project == "" || source == "" {
        return ""
    }
    let id: string = provider_mesh_source_id(source)
    var url: string = base + "/mesh/api/projects/" + project +
        "/telemetry/series?source=" + gateway_urlencode(id)
    if from_ms != "" {
        url = url + "&from=" + gateway_urlencode(from_ms)
    }
    if to_ms != "" {
        url = url + "&to=" + gateway_urlencode(to_ms)
    }
    if step_ms != "" {
        url = url + "&step=" + gateway_urlencode(step_ms)
    }
    return provider_mesh_fetch(config, url, "mesh-source-history")
}

fn provider_mesh_telemetry_status(config: string) string {
    let base: string = provider_mesh_base(config)
    let project: string = provider_mesh_project(config)
    if base == "" || project == "" {
        return ""
    }
    return provider_mesh_fetch(config, base + "/mesh/api/projects/" + project +
        "/telemetry/status", "mesh-telemetry-status")
}

fn provider_mesh_source_latest(config: string, source: string) string {
    let action: i32 = rho_str_index_of(source, "/action")
    var value_url: string = ""
    if rho_str_index_of(source, "/mesh/api/") >= 0 && action >= 0 {
        value_url = rho_str_slice(source, 0, u32(action)) + "/value"
    } else if rho_str_index_of(source, "/mesh/api/") >= 0 &&
        rho_str_index_of(source, "/value") >= 0 {
        // A widget may store the value URL itself; it is already the endpoint.
        value_url = source
    } else if source != "" {
        value_url = provider_mesh_base(config) + "/mesh/api/projects/" +
            provider_mesh_project(config) + "/sources/" + source + "/value"
    }
    if value_url == "" {
        return ""
    }
    return gateway_trim(provider_mesh_fetch(config, value_url, "mesh-source-latest"))
}

// The mutating side of the gateway: registration, heartbeat and publish, each a
// JSON body sent to Mesh with its service token.
fn provider_mesh_post(config: string, path: string, body: string, name: string) string {
    let base: string = provider_mesh_base(config)
    if base == "" {
        return ""
    }
    let report: string = gateway_report(name)
    let status: u32 = rho_http_request("POST", base + path, body, "application/json", "mesh",
        provider_mesh_scope(config), report)
    if status < 200 || status >= 300 {
        return ""
    }
    return rho_read_text(report)
}

fn provider_mesh_register_client(config: string, app_name: string,
    instance_id: string, callback_url: string, topics: string) string {
    let body: string = "{\"app_name\":" + json_string(app_name) +
        ",\"project\":" + json_string(provider_mesh_project(config)) +
        ",\"instance_id\":" + json_string(instance_id) +
        ",\"callback_url\":" + json_string(callback_url) +
        ",\"topics\":" + json_string(topics) + "}"
    return provider_mesh_post(config, "/mesh/api/clients/register", body,
        "mesh-register")
}

fn provider_mesh_client_heartbeat(config: string, client_id: string) string {
    let body: string = "{\"client_id\":" + json_string(client_id) + "}"
    return provider_mesh_post(config, "/mesh/api/clients/heartbeat", body,
        "mesh-heartbeat")
}

fn provider_mesh_publish(config: string, project: string, topic: string,
    payload: string) string {
    let body: string = "{\"project\":" + json_string(project) +
        ",\"topic\":" + json_string(topic) +
        ",\"payload\":" + json_string(payload) + "}"
    return provider_mesh_post(config, "/mesh/api/clients/publish", body,
        "mesh-publish")
}
