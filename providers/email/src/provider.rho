module robohub.providers.email

// E-mail through a provider rather than through one transport.
//
// `local` writes the rendered message beside the plugin state, so a development
// machine with no mail server still sees exactly what would have been sent.
// `smtp` uploads the same message with curl, which is already how the rest of
// the toolchain reaches the network and needs no mail daemon on the host. A
// provider that speaks an HTTP API is another branch in provider_email_send;
// the caller passes the same from, to, subject and body.

fn provider_email_send(provider: string, config: string, from: string, to: string,
    subject: string, body: string) u32 {
    if rho_str_eq(provider, "local") {
        let file: string = plugin_state_dir() + "/email-outbox.eml"
        let mail: string = "From: " + from + "\n" +
            "To: " + to + "\n" +
            "Subject: " + subject + "\n" +
            "MIME-Version: 1.0\n" +
            "Content-Type: text/plain; charset=utf-8\n\n" + body + "\n"
        let old: string = rho_read_text(file)
        if rho_write_text(file, old + "--- message ---\n" + mail) {
            return 1
        }
        return 0
    }
    if rho_str_eq(provider, "smtp") {
        return provider_email_smtp(config, from, to, subject, body)
    }
    // An unknown provider is a configuration error, not a silent success.
    return 0
}

fn provider_email_smtp(config: string, from: string, to: string, subject: string,
    body: string) u32 {
    let host: string = plugin_config_value(config, "smtp_host")
    if host == "" || to == "" {
        return 0
    }
    var port: string = plugin_config_value(config, "smtp_port")
    if port == "" {
        port = "587"
    }
    let security: string = plugin_config_value(config, "smtp_security")
    var url: string = "smtp://" + host + ":" + port
    var args: string = ""
    if rho_str_eq(security, "ssl") || rho_str_eq(security, "smtps") {
        url = "smtps://" + host + ":" + port
    }
    let file: string = plugin_state_dir() + "/email-message.eml"
    let mail: string = "From: " + from + "\n" +
        "To: " + to + "\n" +
        "Subject: " + subject + "\n" +
        "MIME-Version: 1.0\n" +
        "Content-Type: text/plain; charset=utf-8\n\n" + body + "\n"
    ignore_bool(rho_write_text(file, mail))
    args = "-sS --url " + plugin_arg_quote(url) +
        " --mail-from " + plugin_arg_quote(from) +
        " --mail-rcpt " + plugin_arg_quote(to) +
        " --upload-file " + plugin_arg_quote(file)
    let user: string = plugin_config_value(config, "smtp_user")
    if user != "" {
        args = args + " --user " + plugin_arg_quote(user + ":" +
            plugin_config_value(config, "smtp_pass"))
    }
    if rho_str_eq(security, "starttls") || rho_str_eq(security, "tls") {
        args = args + " --ssl-reqd"
    }
    let code: u32 = rho_exec("curl", args, plugin_report("email-provider"))
    if code == 0 {
        return 1
    }
    return 0
}
