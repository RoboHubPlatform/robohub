module robohub.alert_email

// An alert channel that sends an e-mail, through SMTP or to a local outbox.

// The runtime primitives this provider uses. Each command is run with its
// arguments one per line, never through a shell, so a message or a password
// is one argument whatever characters it holds.
extern fn rho_exec_args(program: string, arguments: string, output_path: string) u32
extern fn rho_read_text(path: string) string
extern fn rho_write_text(path: string, text: string) bool
extern fn rho_write_secret(path: string, text: string) bool
extern fn rho_append_text(path: string, text: string) bool
extern fn rho_bind_config(provider: string, key: string) string
extern fn rho_random_hex(bytes: u32) string

// state_dir is where this provider keeps what it writes on the way out: the
// application's workspace when it has one.
fn state_dir() string {
    var dir: string = app_workspace()
    dir = dir + "/alerts"
    let made: u32 = rho_exec_args("mkdir", "-p\n" + dir + "\n", dir + ".mkdir.log")
    return dir
}

fn report(name: string) string {
    return state_dir() + "/" + name + ".log"
}

fn setting(key: string, fallback: string) string {
    let value: string = rho_bind_config("robohub-provider-email", key)
    if value == "" {
        return fallback
    }
    return value
}

// one_line is a header's value with its line breaks taken out: a message or a
// rule name with a line break in it would otherwise start a header of its own
// (`Bcc: …`) in the mail it is written into.
// @req EMAIL-0004
fn one_line(text: string) string {
    var out: string = ""
    var i: u32 = 0
    while i < u32(strlen(text)) {
        let ch: string = str_slice(text, i, 1)
        if ch == "\n" || ch == "\r" {
            out = out + " "
        } else {
            out = out + ch
        }
        i = i + 1
    }
    return out
}

// metadata_rule is the rule an alert's metadata names (`{"rule":"too-warm"}`),
// or the metadata itself when it names none.
fn metadata_rule(metadata: string) string {
    let at: i32 = str_index_of(metadata, "\"rule\":\"")
    if at < 0 {
        return metadata
    }
    let rest: string = str_slice(metadata, u32(at) + 8, u32(strlen(metadata)) - u32(at) - 8)
    let end: i32 = str_index_of(rest, "\"")
    if end < 0 {
        return metadata
    }
    return str_slice(rest, 0, u32(end))
}

// @req EMAIL-0003
fn render(template: string, level: string, message: string, metadata: string, app: string) string {
    var rule: string = metadata_rule(metadata)
    if rule == "" {
        rule = "alert"
    }
    var out: string = str_replace(template, "{level}", level)
    out = str_replace(out, "{message}", message)
    out = str_replace(out, "{metadata}", metadata)
    out = str_replace(out, "{app}", app)
    return str_replace(out, "{rule}", rule)
}

// has_break is whether a value holds a line break: in curl's configuration a
// line break ends one option and starts another.
fn has_break(value: string) bool {
    return str_index_of(value, "\n") >= 0 || str_index_of(value, "\r") >= 0
}

// curl_quoted is a value as a quoted string of curl's configuration file, with
// its backslashes and double quotes escaped, so it is read back exactly and
// never ends early. The caller has refused a value with a line break.
// @req EMAIL-0006
fn curl_quoted(value: string) string {
    return "\"" + str_replace(str_replace(value, "\\", "\\\\"), "\"", "\\\"") + "\""
}

// digits is whether a value is a number written in decimal digits only.
fn digits(value: string) bool {
    if value == "" {
        return false
    }
    var i: u32 = 0
    while i < u32(strlen(value)) {
        if str_index_of("0123456789", str_slice(value, i, 1)) < 0 {
            return false
        }
        i = i + 1
    }
    return true
}

// host_ok is whether an SMTP server setting is a host name or an address and
// nothing else: letters, digits, dots, dashes, and the brackets and colons of an
// IPv6 address. A slash, an `@` or a space would make the URL name another
// server, a path or a login.
// @req EMAIL-0006
fn host_ok(host: string) bool {
    if host == "" {
        return false
    }
    var i: u32 = 0
    while i < u32(strlen(host)) {
        if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-[]:", str_slice(host, i, 1)) < 0 {
            return false
        }
        i = i + 1
    }
    return true
}

// forget removes what a delivery wrote on the way out, once curl has read it.
fn forget(first: string, second: string) void {
    let removed: u32 = rho_exec_args("rm", "-f\n--\n" + first + "\n" + second + "\n", report("email-cleanup"))
}

// send writes the message to a local outbox (`mode: local`, the default), so a
// machine with no mail server still shows what would have gone out, or uploads
// it to an SMTP server (`mode: smtp`).
// @req EMAIL-0001, EMAIL-0002, EMAIL-0005, EMAIL-0006
fn send(level: string, message: string, metadata: string) u32 {
    let to: string = one_line(setting("to_address", ""))
    if to == "" {
        return 0
    }
    let from: string = one_line(setting("from_address", "alerts@robohub.internal"))
    let app: string = setting("app", "RoboHub")
    let subject: string = one_line(render(setting("subject_template", "[RoboHub {app}] {level}: {rule}"), level, message, metadata, app))
    let body: string = render(setting("body_template", "{message} ({app})"), level, message, metadata, app)
    let mail: string = "From: " + from + "\nTo: " + to + "\nSubject: " + subject + "\n" +
        "MIME-Version: 1.0\nContent-Type: text/plain; charset=utf-8\n\n" + body + "\n"
    let mode: string = setting("mode", "local")
    if mode == "local" {
        if rho_append_text(state_dir() + "/email-outbox.eml", "--- message ---\n" + mail) {
            return 1
        }
        return 0
    }
    if mode != "smtp" {
        return 0
    }
    let host: string = setting("smtp_host", "")
    let port: string = setting("smtp_port", "587")
    if !host_ok(host) || !digits(port) || has_break(from) || has_break(to) {
        return 0
    }
    let security: string = setting("smtp_security", "")
    var url: string = "smtp://" + host + ":" + port
    if security == "ssl" || security == "smtps" {
        url = "smtps://" + host + ":" + port
    }
    // The server, the addresses and the login are read by curl from a
    // configuration file only this user can read (-K), never from its command
    // line, which any user of the machine can list. The message and that file
    // are named afresh for each delivery and removed after it.
    var config_text: string = "url = " + curl_quoted(url) + "\n" +
        "mail-from = " + curl_quoted(from) + "\n" +
        "mail-rcpt = " + curl_quoted(to) + "\n"
    let user: string = setting("smtp_user", "")
    if user != "" {
        let password: string = setting("smtp_pass", "")
        if has_break(user) || has_break(password) {
            return 0
        }
        config_text = config_text + "user = " + curl_quoted(user + ":" + password) + "\n"
    }
    let id: string = rho_random_hex(8)
    if id == "" {
        return 0
    }
    let dir: string = state_dir()
    let file: string = dir + "/email-" + id + ".eml"
    let config: string = dir + "/email-" + id + ".curl"
    if !rho_write_secret(file, mail) || !rho_write_secret(config, config_text) {
        forget(config, file)
        return 0
    }
    var args: string = "-fsS\n--upload-file\n" + file + "\n-K\n" + config + "\n"
    if security == "starttls" || security == "tls" {
        args = args + "--ssl-reqd\n"
    }
    let code: u32 = rho_exec_args("curl", args, report("email"))
    forget(config, file)
    if code == 0 {
        return 1
    }
    return 0
}
