module robohub.alert_log

// An alert channel that appends a line to a file on the machine.

// The runtime primitives this provider uses. Each command is run with its
// arguments one per line, never through a shell, so a message or a password
// is one argument whatever characters it holds.
extern fn rho_exec_args(program: string, arguments: string, output_path: string) u32
extern fn rho_read_text(path: string) string
extern fn rho_write_text(path: string, text: string) bool
extern fn rho_append_text(path: string, text: string) bool
extern fn rho_bind_config(provider: string, key: string) string

// state_dir is where this provider keeps what it writes on the way out: the
// application's workspace when it has one.
fn state_dir() string {
    var dir: string = getenv("RHO_APP_WORKSPACE")
    if dir == "" {
        dir = getenv("HOME") + "/.rho"
    }
    dir = dir + "/alerts"
    let made: u32 = rho_exec_args("mkdir", "-p\n" + dir + "\n", dir + ".mkdir.log")
    return dir
}

fn report(name: string) string {
    return state_dir() + "/" + name + ".log"
}

fn log_path() string {
    let home: string = getenv("HOME")
    var path: string = rho_bind_config("robohub-provider-log", "path")
    if path == "" {
        path = home + "/.rho/alerts.log"
    }
    if str_index_of(path, "~/") == 0 {
        path = home + str_slice(path, 1, strlen(path) - 1)
    }
    return path
}

fn parent_dir(path: string) string {
    var last: i32 = -1
    var i: u32 = 0
    while i < strlen(path) {
        if str_slice(path, i, 1) == "/" {
            last = i32(i)
        }
        i = i + 1
    }
    if last <= 0 {
        return ""
    }
    return str_slice(path, 0, u32(last))
}

// send appends one line. The log is rotated at 1 MB, keeping three old files,
// and appended to rather than rewritten, which is kinder to flash.
fn send(level: string, message: string, metadata: string) u32 {
    let path: string = log_path()
    let dir: string = parent_dir(path)
    if dir != "" {
        let made: u32 = rho_exec_args("mkdir", "-p\n" + dir + "\n", report("alert-log-mkdir"))
    }
    var size: u32 = 0
    if rho_exec_args("stat", "-c\n%s\n" + path + "\n", report("alert-log-size")) == 0 {
        size = int_from_str(rho_read_text(report("alert-log-size")))
    }
    if size > 1048576 {
        let third: u32 = rho_exec_args("mv", "-f\n" + path + ".2\n" + path + ".3\n", report("alert-log-rotate"))
        let second: u32 = rho_exec_args("mv", "-f\n" + path + ".1\n" + path + ".2\n", report("alert-log-rotate"))
        let first: u32 = rho_exec_args("mv", "-f\n" + path + "\n" + path + ".1\n", report("alert-log-rotate"))
    }
    var line: string = "[" + level + "] " + message
    if metadata != "" {
        line = line + " " + metadata
    }
    if rho_append_text(path, line + "\n") {
        return 1
    }
    return 0
}
