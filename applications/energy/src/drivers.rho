module energy

// The driver seam. The application talks to a reading shape, never to a
// register, a Modbus address, a CAN frame or an HTTP endpoint. `driver_mode`
// selects the simulator or real-time Mesh telemetry; the same setting is read on
// every background tick, so switching does not need a restart.

const ENERGY_DRIVER_MOCK: string = "mock"

const ENERGY_DRIVER_HARDWARE: string = "hardware"

struct EnergyDriver {
    name: string
    kind: string
    mode: string
    address: string
    protocol: string
}

fn energy_driver_mode() string {
    let stored: string = settings_get("energy.driver_mode", "")
    if rho_str_eq(stored, ENERGY_DRIVER_HARDWARE) ||
        rho_str_eq(stored, ENERGY_DRIVER_MOCK) {
        return stored
    }
    let mode: string = getenv("ROBOHUB_DRIVER_MODE")
    if rho_str_eq(mode, ENERGY_DRIVER_HARDWARE) {
        return ENERGY_DRIVER_HARDWARE
    }
    return ENERGY_DRIVER_MOCK
}

fn energy_simulation_label() string {
    if energy_driver_is_mock() {
        return "Simulation"
    }
    return "Real-time (Mesh)"
}

fn energy_simulation_action() string {
    if energy_driver_is_mock() {
        return ENERGY_DRIVER_HARDWARE
    }
    return ENERGY_DRIVER_MOCK
}

fn energy_simulation_off() bool {
    return !energy_driver_is_mock()
}

fn energy_driver_is_mock() bool {
    return rho_str_eq(energy_driver_mode(), ENERGY_DRIVER_MOCK)
}

fn energy_driver_label(mode: string) string {
    if rho_str_eq(mode, ENERGY_DRIVER_HARDWARE) {
        return "Hardware"
    }
    return "Simulator"
}

fn energy_driver_reading_fields() string {
    return "pv_power_w, load_power_w, grid_power_w, battery_power_w, " + "battery_soc_milli, energy_today_wh, energy_total_wh"
}

fn energy_driver_accepts(driver: EnergyDriver) bool {
    if rho_str_eq(driver.mode, ENERGY_DRIVER_HARDWARE) {
        return driver.address != "" || driver.protocol != ""
    }
    return true
}
