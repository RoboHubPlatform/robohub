fn energy_load_rows(db: SqlDb, req: Request) string {
    var loads: EnergyLoads[32]
    var slice: Slice[EnergyLoads] = Slice[EnergyLoads]{ Ptr[EnergyLoads](&loads[0]), 128 }
    var rows: Result[u32, SqlError] = ListLoads(db, slice, ENERGY_CAPACITY)
    var count: u32 = 0
    if rows.is_ok {
        count = rows.ok
    }
    var out: string = ""
    var i: u32 = 0
    while i < count {
        var critical_text: string = "no"
        if loads[i].critical != 0 {
            critical_text = "critical"
        }
        var shed_text: string = "connected"
        if loads[i].shed != 0 {
            shed_text = "shed"
        }
        var state_css: string = "ok"
        if loads[i].shed != 0 || rho_str_eq(loads[i].state, "off") {
            state_css = "warn"
        }
        out = out + template_fill(template_get("load-row"), vars("id", energy_i64_to_str(loads[i].id)) + vars("name", escape_html(loads[i].name)) + vars("zone", escape_html(loads[i].zone)) + vars("priority", energy_i64_to_str(loads[i].priority)) + vars("power", energy_format_watts(loads[i].powerW)) + vars("critical", critical_text) + vars("shed", shed_text) + vars("state", escape_html(loads[i].state)) + vars("state_css", state_css) + vars("updated", energy_date(u32(loads[i].updatedEpoch))) + vars("csrf", forms_csrf_field()) + i18n_vars(req))
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"7\">No loads registered.</td></tr>"
    }
    return out
}

