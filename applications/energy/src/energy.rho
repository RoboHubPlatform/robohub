fn energy_storage_add(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return energy_storage_page_message(req, "Refused: the form token did not match.")
    }
    var fields: FormField[6]
    energy_storage_field_defs(fields)
    forms_read(fields, 6, body)
    if !forms_validate(fields, 6) {
        return energy_storage_page_fields(req, fields, 6, "")
    }
    var name: string = energy_trim(forms_parse(body, "name"))
    var capacity_wh: i64 = energy_parse_milli(forms_parse(body, "capacity_kwh"))
    var now: u32 = energy_now()
    var opened: Result[SqlDb, string] = energy_open_db()
    if opened.is_ok {
        var db: SqlDb = opened.ok
        energy_ignore_result(InsertBattery(name, energy_trim(forms_parse(body, "chemistry")), energy_i64_to_str(capacity_wh), energy_trim(forms_parse(body, "can_profile")), energy_trim(forms_parse(body, "bms_host")), energy_trim(forms_parse(body, "mesh_source")), db))
        energy_ignore_result(InsertEvent("INFO", "battery", "Battery bank " + name + " registered", rho_int_to_str(now), db))
        energy_evaluate_safety(db, now)
        energy_publish_live(db)
        sql_close(db)
    }
    return redirect("/storage")
}

fn energy_storage_reading(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return energy_storage_page_message(req, "Refused: the form token did not match.")
    }
    var id: i64 = energy_parse_int(energy_form_field(body, "id"))
    var now: u32 = energy_now()
    var opened: Result[SqlDb, string] = energy_open_db()
    if opened.is_ok {
        var db: SqlDb = opened.ok
        var rows: EnergyBatteries[1]
        var slice: Slice[EnergyBatteries] = Slice[EnergyBatteries]{ Ptr[EnergyBatteries](&rows[0]), 1 }
        var got: Result[u32, SqlError] = GetBattery(id, db, slice, 1)
        if got.is_ok {
            var soc: i64 = energy_parse_milli(energy_form_field(body, "soc_pct"))
            var soh_text: string = energy_form_field(body, "soh_pct")
            var soh: i64 = rows[0].sohMilli
            if soh_text != "" {
                soh = energy_parse_milli(soh_text)
            }
            var voltage_text: string = energy_form_field(body, "voltage_v")
            var voltage: i64 = rows[0].voltageMv
            if voltage_text != "" {
                voltage = energy_parse_milli(voltage_text)
            }
            var current: i64 = energy_parse_milli(energy_form_field(body, "current_a"))
            var temperature_text: string = energy_form_field(body, "temperature_c")
            var temperature: i64 = rows[0].temperatureMc
            if temperature_text != "" {
                temperature = energy_parse_milli(temperature_text)
            }
            var cell_min_text: string = energy_form_field(body, "cell_min_v")
            var cell_min: i64 = rows[0].cellMinMv
            if cell_min_text != "" {
                cell_min = energy_parse_milli(cell_min_text)
            }
            var cell_max_text: string = energy_form_field(body, "cell_max_v")
            var cell_max: i64 = rows[0].cellMaxMv
            if cell_max_text != "" {
                cell_max = energy_parse_milli(cell_max_text)
            }
            var status: string = energy_form_field(body, "status")
            var state: string = rows[0].status
            if status != "" {
                state = status
            }
            energy_ignore_result(UpdateBatteryReading(soc, soh, voltage, current, temperature, cell_min, cell_max, state, i64(now), id, db))
            ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(id), "soc_pct", energy_format_milli(soc, 3), 0))
            ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(id), "voltage_v", energy_format_milli(voltage, 3), 0))
            ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(id), "current_a", energy_format_milli(current, 3), 0))
            ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(id), "temperature_c", energy_format_milli(temperature, 3), 0))
            energy_evaluate_safety(db, now)
            energy_publish_live(db)
        }
        sql_close(db)
    }
    return redirect("/storage")
}

fn energy_storage_delete(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
