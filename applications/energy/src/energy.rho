fn energy_modes_page_message(req: Request, notice: string) Response {
    var opened: Result[SqlDb, string] = energy_open_db()
    if !opened.is_ok {
        return energy_page(req, "Modes", "<p>The energy store is not available.</p>")
    }
    var db: SqlDb = opened.ok
    var config: EnergyConfig = energy_config_get(db)
    sql_close(db)
    var grid_forming_text: string = "disabled"
    if config.gridForming != 0 {
        grid_forming_text = "enabled"
    }
    var zero_export_text: string = "allowed"
    if config.zeroExport != 0 {
        zero_export_text = "enforced"
    }
    var generator_text: string = "standby"
    var generator_action: string = "start"
    if config.generator != 0 {
        generator_text = "running"
        generator_action = "stop"
    }
    var shed_text: string = "none"
    var shed_action: string = "shed"
    if config.loadShed != 0 {
        shed_text = "active"
        shed_action = "release"
    }
    var tariff_text: string = "off-peak"
    var tariff_action: string = "peak"
    if config.tariffPeak != 0 {
        tariff_text = "peak"
        tariff_action = "off_peak"
    }
    var off_grid_selected: string = ""
    var on_grid_selected: string = ""
    var hybrid_selected: string = ""
    if rho_str_eq(config.mode, "off_grid") {
        off_grid_selected = "1"
    } else {
        if rho_str_eq(config.mode, "on_grid") {
            on_grid_selected = "1"
        } else {
            hybrid_selected = "1"
        }
    }
    var body: string = template_fill(template_get("modes"), vars("notice", energy_notice(notice)) + vars("csrf", forms_csrf_field()) + vars("mode", escape_html(config.mode)) + vars("mode_label", energy_mode_label(config.mode)) + vars("mode_class", energy_mode_class(config.mode)) + vars("grid_forming", grid_forming_text) + vars("zero_export", zero_export_text) + vars("generator", generator_text) + vars("generator_action", generator_action) + vars("shed", shed_text) + vars("shed_action", shed_action) + vars("tariff", tariff_text) + vars("tariff_action", tariff_action) + vars("off_grid", off_grid_selected) + vars("on_grid", on_grid_selected) + vars("hybrid", hybrid_selected) + vars("reserve", energy_format_soc(config.reserveSocMilli)) + vars("updated", energy_date(u32(config.updatedEpoch))))
    return energy_page(req, "Operating modes", body)
}

fn energy_modes_page(req: Request) Response {
    return energy_modes_page_message(req, "")
}

fn energy_modes_set(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return energy_modes_page_message(req, "Refused: the form token did not match.")
    }
    var mode: string = energy_trim(energy_form_field(body, "mode"))
    if !energy_sim_mode_name(mode) {
        return energy_modes_page_message(req, "Unknown operating mode.")
    }
    var now: u32 = energy_now()
    var opened: Result[SqlDb, string] = energy_open_db()
    if opened.is_ok {
        var db: SqlDb = opened.ok
        var grid_forming: i64 = 0
        if rho_str_eq(mode, "off_grid") {
            grid_forming = 1
        }
        energy_ignore_result(SetConfigMode(mode, grid_forming, 1, i64(now), db))
        if rho_str_eq(mode, "off_grid") {
            energy_ignore_result(SetLoadShed(0, i64(now), "2", db))
        }
        energy_ignore_result(InsertEvent("INFO", "mode", "Operating mode set to " + energy_mode_label(mode), rho_int_to_str(now), db))
        energy_publish("energy.mode", mode)
        energy_evaluate_safety(db, now)
        energy_publish_live(db)
        sql_close(db)
    }
    return redirect("/modes")
}

fn energy_modes_generator(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return energy_modes_page_message(req, "Refused: the form token did not match.")
    }
    var action: string = energy_trim(energy_form_field(body, "action"))
    var now: u32 = energy_now()
    var opened: Result[SqlDb, string] = energy_open_db()
    if opened.is_ok {
        var db: SqlDb = opened.ok
        var value: i64 = 0
        if rho_str_eq(action, "start") {
            value = 1
        }
        energy_ignore_result(SetConfigGenerator(value, i64(now), db))
        if value != 0 {
            energy_ignore_result(InsertEvent("WARNING", "generator", "Emergency generator started by the operator", rho_int_to_str(now), db))
        } else {
            energy_ignore_result(InsertEvent("INFO", "generator", "Emergency generator stopped by the operator", rho_int_to_str(now), db))
        }
        energy_publish_live(db)
        sql_close(db)
    }
    return redirect("/modes")
}

fn energy_modes_shed(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return energy_modes_page_message(req, "Refused: the form token did not match.")
    }
    var action: string = energy_trim(energy_form_field(body, "action"))
    var now: u32 = energy_now()
    var opened: Result[SqlDb, string] = energy_open_db()
    if opened.is_ok {
        var db: SqlDb = opened.ok
        var value: i64 = 0
        if rho_str_eq(action, "shed") {
            value = 1
        }
        energy_ignore_result(SetConfigShed(value, i64(now), db))
        energy_ignore_result(SetLoadShed(value, i64(now), "2", db))
        if value != 0 {
            energy_ignore_result(InsertEvent("WARNING", "load", "Operator shed the discretionary loads", rho_int_to_str(now), db))
        } else {
            energy_ignore_result(InsertEvent("INFO", "load", "Operator released the shed loads", rho_int_to_str(now), db))
        }
        energy_publish_live(db)
        sql_close(db)
    }
    return redirect("/modes")
}

fn energy_modes_tariff(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return energy_modes_page_message(req, "Refused: the form token did not match.")
    }
    var action: string = energy_trim(energy_form_field(body, "action"))
    var now: u32 = energy_now()
    var opened: Result[SqlDb, string] = energy_open_db()
    if opened.is_ok {
        var db: SqlDb = opened.ok
        var value: i64 = 0
        if rho_str_eq(action, "peak") {
            value = 1
        }
        energy_ignore_result(SetConfigTariff(value, i64(now), db))
        energy_ignore_result(InsertEvent("INFO", "tariff", "Tariff window set to " + action, rho_int_to_str(now), db))
        energy_publish_live(db)
        sql_close(db)
    }
    return redirect("/modes")
}

fn energy_safety_field_defs(fields: [FormField], config: EnergyConfig) void {
    fields[0] = energy_field("mode", "select", "Operating mode", "Island, utility-connected or hybrid.", "", true, "", "off_grid|Off-grid (island),on_grid|On-grid,hybrid|Hybrid", config.mode, "")
    fields[1] = energy_field("grid_forming", "select", "Grid-forming", "The site forms its own voltage reference when islanded.", "", true, "", "1|Enabled,0|Disabled", energy_i64_to_str(config.gridForming), "")
    fields[2] = energy_field("zero_export", "select", "Zero export", "Refuse all back-feed when the utility restricts it.", "", true, "", "1|Enforced,0|Allowed", energy_i64_to_str(config.zeroExport), "")
    fields[3] = energy_field("peak_shaving", "select", "Peak shaving", "Discharge the battery against the tariff peak.", "", true, "", "1|Enabled,0|Disabled", energy_i64_to_str(config.peakShaving), "")
    fields[4] = energy_field("tariff_optimization", "select", "Tariff optimisation", "Charge off peak and discharge on peak.", "", true, "", "1|Enabled,0|Disabled", energy_i64_to_str(config.tariffOptimization), "")
    fields[5] = energy_field("reserve_soc_pct", "text", "Reserve SoC (%)", "The battery level the controller protects for emergencies.", "25.0", true, "number", "", energy_format_milli(config.reserveSocMilli, 1), "decimal")
    fields[6] = energy_field("load_shed_soc_pct", "text", "Load-shed SoC (%)", "Discretionary loads are shed at or below this.", "15.0", true, "number", "", energy_format_milli(config.loadShedSocMilli, 1), "decimal")
    fields[7] = energy_field("generator_start_soc_pct", "text", "Generator start SoC (%)", "Start the emergency generator at or below this.", "10.0", true, "number", "", energy_format_milli(config.generatorStartSocMilli, 1), "decimal")
    fields[8] = energy_field("generator_stop_soc_pct", "text", "Generator stop SoC (%)", "Stop the generator at or above this.", "40.0", true, "number", "", energy_format_milli(config.generatorStopSocMilli, 1), "decimal")
    fields[9] = energy_field("charge_limit_a", "text", "Charge current (A)", "The BMS charge current limit the controller may request.", "60.0", true, "number", "", energy_format_milli(config.chargeLimitMa, 1), "decimal")
    fields[10] = energy_field("discharge_limit_a", "text", "Discharge current (A)", "The BMS discharge current limit.", "120.0", true, "number", "", energy_format_milli(config.dischargeLimitMa, 1), "decimal")
    fields[11] = energy_field("charge_voltage_v", "text", "Charge voltage (V)", "The pack charge voltage the BMS accepts.", "57.6", true, "number", "", energy_format_milli(config.chargeVoltageMv, 1), "decimal")
    fields[12] = energy_field("discharge_cutoff_v", "text", "Discharge cutoff (V)", "The pack voltage that must not be crossed.", "44.0", true, "number", "", energy_format_milli(config.dischargeCutoffMv, 1), "decimal")
    fields[13] = energy_field("export_limit_w", "text", "Export limit (W)", "The strict back-feed limit; zero is zero export.", "0", true, "number", "", energy_i64_to_str(config.exportLimitW), "decimal")
    fields[14] = energy_field("solar_temp_limit_c", "text", "Solar temperature limit (°C)", "The back-sheet temperature limit.", "75.0", true, "number", "", energy_format_milli(config.solarTempLimitMc, 1), "decimal")
    fields[15] = energy_field("battery_temp_limit_c", "text", "Battery temperature limit (°C)", "The pack temperature limit.", "45.0", true, "number", "", energy_format_milli(config.batteryTempLimitMc, 1), "decimal")
    fields[16] = energy_field("source_over_voltage_v", "text", "Source overvoltage (V)", "A generation line above this trips.", "600.0", true, "number", "", energy_format_milli(config.sourceOverVoltageMv, 1), "decimal")
    fields[17] = energy_field("source_over_current_a", "text", "Source overcurrent (A)", "A generation line above this trips.", "20.0", true, "number", "", energy_format_milli(config.sourceOverCurrentMa, 1), "decimal")
    fields[18] = energy_field("battery_cell_delta_mv", "text", "Cell delta limit (mV)", "The largest spread allowed between cells.", "200", true, "number", "", energy_i64_to_str(config.batteryCellDeltaMv), "numeric")
    fields[19] = energy_field("grid_min_voltage_v", "text", "Grid minimum voltage (V)", "The lower utility voltage boundary.", "207.0", true, "number", "", energy_format_milli(config.gridMinVoltageMv, 1), "decimal")
    fields[20] = energy_field("grid_max_voltage_v", "text", "Grid maximum voltage (V)", "The upper utility voltage boundary.", "253.0", true, "number", "", energy_format_milli(config.gridMaxVoltageMv, 1), "decimal")
    fields[21] = energy_field("grid_min_frequency_hz", "text", "Grid minimum frequency (Hz)", "The lower frequency boundary.", "49.50", true, "number", "", energy_format_milli(config.gridMinFrequencyMhz, 2), "decimal")
    fields[22] = energy_field("grid_max_frequency_hz", "text", "Grid maximum frequency (Hz)", "The upper frequency boundary.", "50.50", true, "number", "", energy_format_milli(config.gridMaxFrequencyMhz, 2), "decimal")
}

fn energy_safety_page_fields(req: Request, fields: [FormField], count: u32, notice: string) Response {
    var form: string = forms_open(fields, count, "/safety", "Save safety policy", i18n_locale(req))
    var body: string = template_fill(template_get("safety"), vars("form", form) + vars("notice", energy_notice(notice)))
    return energy_page(req, "Safety and thresholds", body)
}

fn energy_safety_page(req: Request) Response {
    var opened: Result[SqlDb, string] = energy_open_db()
    if !opened.is_ok {
        return energy_page(req, "Safety", "<p>The energy store is not available.</p>")
    }
    var config: EnergyConfig = energy_config_get(opened.ok)
    sql_close(opened.ok)
    var fields: FormField[23]
    energy_safety_field_defs(fields, config)
    return energy_safety_page_fields(req, fields, 23, "")
}

fn energy_safety_save(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return energy_page(req, "Safety", "<p>Refused: the form token did not match.</p>")
    }
    var opened: Result[SqlDb, string] = energy_open_db()
    if !opened.is_ok {
        return energy_page(req, "Safety", "<p>The energy store is not available.</p>")
    }
    var db: SqlDb = opened.ok
    var config: EnergyConfig = energy_config_get(db)
    var fields: FormField[23]
    energy_safety_field_defs(fields, config)
    forms_read(fields, 23, body)
    if !forms_validate(fields, 23) {
        sql_close(db)
        return energy_safety_page_fields(req, fields, 23, "")
    }
    var mode: string = energy_trim(forms_parse(body, "mode"))
    if !energy_sim_mode_name(mode) {
        mode = config.mode
    }
    var now: u32 = energy_now()
    energy_ignore_result(UpdateConfigPolicy(mode, energy_bool_int(forms_parse(body, "grid_forming")), energy_bool_int(forms_parse(body, "zero_export")), energy_bool_int(forms_parse(body, "peak_shaving")), energy_bool_int(forms_parse(body, "tariff_optimization")), energy_parse_milli(forms_parse(body, "reserve_soc_pct")), energy_parse_milli(forms_parse(body, "load_shed_soc_pct")), energy_parse_milli(forms_parse(body, "generator_start_soc_pct")), energy_parse_milli(forms_parse(body, "generator_stop_soc_pct")), energy_parse_watts(forms_parse(body, "export_limit_w")), i64(now), db))
    energy_ignore_result(UpdateConfigLimits(energy_parse_milli(forms_parse(body, "charge_limit_a")), energy_parse_milli(forms_parse(body, "discharge_limit_a")), energy_parse_milli(forms_parse(body, "charge_voltage_v")), energy_parse_milli(forms_parse(body, "discharge_cutoff_v")), energy_parse_milli(forms_parse(body, "solar_temp_limit_c")), energy_parse_milli(forms_parse(body, "battery_temp_limit_c")), energy_parse_milli(forms_parse(body, "source_over_voltage_v")), energy_parse_milli(forms_parse(body, "source_over_current_a")), energy_parse_int(forms_parse(body, "battery_cell_delta_mv")), energy_parse_milli(forms_parse(body, "grid_min_voltage_v")), energy_parse_milli(forms_parse(body, "grid_max_voltage_v")), energy_parse_milli(forms_parse(body, "grid_min_frequency_hz")), energy_parse_milli(forms_parse(body, "grid_max_frequency_hz")), i64(now), db))
    energy_ignore_result(InsertEvent("INFO", "safety", "Safety policy updated", rho_int_to_str(now), db))
    energy_evaluate_safety(db, now)
    energy_publish_live(db)
    sql_close(db)
    var fresh: Result[SqlDb, string] = energy_open_db()
    if fresh.is_ok {
        var updated: EnergyConfig = energy_config_get(fresh.ok)
        var shown: FormField[23]
        energy_safety_field_defs(shown, updated)
        sql_close(fresh.ok)
        return energy_safety_page_fields(req, shown, 23, "The safety policy was saved.")
    }
    return redirect("/safety")
}

fn energy_faults_page(req: Request) Response {
    var body: string = template_fill(template_get("faults"), vars("rows", energy_live_rows()) + vars("project", escape_html(energy_project())))
    return energy_page(req, "Power faults", body)
}

fn energy_fault_clear(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return energy_faults_page(req)
    }
    var id: u32 = u32(energy_parse_int(energy_form_field(body, "id")))
    var now: u32 = energy_now()
    ignore_string(telemetry_fault_clear(energy_project(), id))
    var opened: Result[SqlDb, string] = energy_open_db()
    if opened.is_ok {
        energy_ignore_result(InsertEvent("INFO", "fault", "Fault " + rho_int_to_str(id) + " acknowledged", rho_int_to_str(now), opened.ok))
        energy_publish_live(opened.ok)
        sql_close(opened.ok)
    }
    return redirect("/faults")
}

fn energy_event_rows(db: SqlDb, req: Request) string {
    var events: EnergyEvents[32]
    var slice: Slice[EnergyEvents] = Slice[EnergyEvents]{ Ptr[EnergyEvents](&events[0]), 32 }
    var rows: Result[u32, SqlError] = ListEvents(db, slice, 32)
    var count: u32 = 0
    if rows.is_ok {
        count = rows.ok
    }
    var out: string = ""
    var i: u32 = 0
    while i < count {
        var severity_css: string = "info"
        if rho_str_eq(events[i].severity, "ERROR") {
            severity_css = "bad"
        }
        if rho_str_eq(events[i].severity, "WARNING") {
            severity_css = "warn"
        }
        out = out + template_fill(template_get("events-row"), vars("date", energy_date(u32(events[i].createdEpoch))) + vars("severity", escape_html(events[i].severity)) + vars("severity_css", severity_css) + vars("kind", escape_html(events[i].kind)) + vars("message", escape_html(events[i].message)))
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"4\">No events recorded.</td></tr>"
    }
    return out
}

fn energy_events_page(req: Request) Response {
    var opened: Result[SqlDb, string] = energy_open_db()
    if !opened.is_ok {
        return energy_page(req, "Events", "<p>The energy store is not available.</p>")
    }
    var body: string = template_fill(template_get("events"), vars("rows", energy_event_rows(opened.ok, req)))
    sql_close(opened.ok)
    return energy_page(req, "Events", body)
}

// The port this service listens on, as the widget fetcher reaches it. The
// application is local to the Mesh gateway in the normal deployment, so the
// loopback address is the right host for a widget URL.
fn energy_port() string {
    var addr: string = getenv("RHO_HTTP_ADDR")
    if addr == "" {
        return "8482"
    }
    var last: i32 = -1
    var i: u32 = 0
    while i < u32(rho_strlen(addr)) {
        if rho_str_eq(rho_str_slice(addr, i, 1), ":") {
            last = i32(i)
        }
        i = i + 1
    }
    if last >= 0 {
        return rho_str_slice(addr, u32(last) + 1,
            u32(rho_strlen(addr)) - u32(last) - 1)
    }
    return addr
}

fn energy_base_url() string {
    return "http://127.0.0.1:" + energy_port()
}

fn energy_instance_id() string {
    let id: string = settings_get("energy.instance_id", "")
    if id == "" {
        return "energy-" + energy_port()
    }
    return id
}

fn energy_publish(topic: string, payload: string) void {
    if energy_driver_is_mock() {
        return
    }
    ignore_string(gateway_publish(energy_project(), topic, payload))
}

// energy_register_mesh_client performs the handshake: Mesh learns the app, the
// project, the callback and the topics. The returned secret authenticates the
// callbacks Mesh sends back, so the application endpoint is not open to any
// local process.
fn energy_register_mesh_client() void {
    if energy_driver_is_mock() {
        return
    }
    let response: string = gateway_register_client("robohub-energy",
        energy_instance_id(), energy_base_url() + "/api/energy/mesh/events",
        "energy.commands,grid.status.*")
    let client_id: string = energy_json_field(response, "client_id")
    let secret: string = energy_json_field(response, "secret")
    if client_id != "" {
        settings_set("energy.mesh_client_id", client_id)
        settings_set("energy.mesh_secret", secret)
    }
}

fn energy_mesh_heartbeat() void {
    if energy_driver_is_mock() {
        return
    }
    let client_id: string = settings_get("energy.mesh_client_id", "")
    if client_id == "" {
        energy_register_mesh_client()
        return
    }
    ignore_string(gateway_client_heartbeat(client_id))
}

fn energy_mesh_heartbeat_due() bool {
    let path: string = energy_state_dir() + "/mesh-heartbeat.last"
    let now: u32 = energy_now()
    if now == 0 {
        return false
    }
    var last: u32 = 0
    if rho_path_exists(path) {
        last = rho_int_from_str(rho_read_text(path))
    }
    if now >= last + 30 {
        ignore_bool(rho_write_text(path, rho_int_to_str(now)))
        return true
    }
    return false
}

fn energy_mesh_callback(req: Request) Response {
    let secret: string = settings_get("energy.mesh_secret", "")
    let auth: string = header_str(req, "Authorization")
    if secret == "" || !rho_str_eq(auth, "Bearer " + secret) {
        return json(401, "{\"ok\":false,\"error\":\"unauthorized\"}")
    }
    let body: string = request_body(req)
    let topic: string = energy_json_field(body, "topic")
    let payload: string = energy_json_field(body, "payload")
    if topic == "" {
        return json(400, "{\"ok\":false,\"error\":\"topic is required\"}")
    }
    let now: u32 = energy_now()
    let opened: Result[SqlDb, string] = energy_open_db()
    if opened.is_ok {
        var db: SqlDb = opened.ok
        energy_ignore_result(InsertEvent("INFO", "mesh",
            "Mesh " + topic + ": " + payload, rho_int_to_str(now), db))
        energy_publish_live(db)
        sql_close(db)
    }
    notification_live_event("info", "Mesh " + topic + ": " + payload)
    return json(status_ok(), "{\"ok\":true}")
}

fn energy_gateway_conf_path() string {
    return energy_state_dir() + "/gateway.conf"
}

// The gateway.conf is the same file the gateway contract reads. Writing it here
// means the provider's settings and the application's settings are one fact,
// not two.
fn energy_write_gateway_conf() void {
    if energy_driver_is_mock() {
        // In simulation mode the gateway contract answers from the energy
        // application's own simulated sources, so the widget source picker has
        // the same shape it has in real-time mode.
        var simulated: string = "provider=mesh-gateway;transport=sim;base=" +
            energy_base_url()
        ignore_bool(rho_write_text(energy_gateway_conf_path(), simulated))
        return
    }
    var conf: string = "provider=mesh-gateway;transport=mesh"
    var url: string = settings_get("energy.mesh_url", "")
    var project: string = settings_get("energy.mesh_project", "default")
    var token: string = settings_get("energy.mesh_token", "")
    if url != "" {
        conf = gateway_config_set(conf, "url", url)
    }
    if project != "" {
        conf = gateway_config_set(conf, "project", project)
    }
    if token != "" {
        conf = gateway_config_set(conf, "token", token)
    }
    ignore_bool(rho_write_text(energy_gateway_conf_path(), conf))
}

fn energy_ensure_gateway_conf() void {
    if !rho_path_exists(energy_gateway_conf_path()) {
        energy_write_gateway_conf()
    }
}

fn energy_gateway_url() string {
    energy_ensure_gateway_conf()
    return gateway_gateway()
}

fn energy_gateway_display_url() string {
    var url: string = settings_get("energy.mesh_url", "")
    if url == "" {
        return "(not set)"
    }
    return url
}

fn energy_gateway_status() string {
    energy_ensure_gateway_conf()
    return gateway_telemetry_status()
}

fn energy_gateway_project_choices() string {
    if energy_driver_is_mock() || settings_get("energy.mesh_url", "") == "" {
        return ""
    }
    energy_ensure_gateway_conf()
    var text: string = gateway_projects()
    var out: string = ""
    var pos: u32 = 0
    while pos < u32(rho_strlen(text)) {
        let open_rel: i32 = rho_str_index_of(rho_str_slice(text, pos,
            u32(rho_strlen(text)) - pos), "{")
        if open_rel < 0 {
            break
        }
        let open_at: u32 = pos + u32(open_rel)
        let close_rel: i32 = rho_str_index_of(rho_str_slice(text, open_at + 1,
            u32(rho_strlen(text)) - open_at - 1), "}")
        if close_rel < 0 {
            break
        }
        let close_at: u32 = open_at + 1 + u32(close_rel)
        let object: string = rho_str_slice(text, open_at, close_at - open_at + 1)
        var id: string = energy_json_field(object, "id")
        var name: string = energy_json_field(object, "name")
        if id != "" {
            if name == "" {
                name = id
            }
            if out != "" {
                out = out + ","
            }
            out = out + id + "|" + name
        }
        pos = close_at + 1
    }
    return out
}

fn energy_gateway_sources_text() string {
    energy_ensure_gateway_conf()
    return gateway_sources()
}

// In real-time mode the Mesh source behind a node is its primary reading:
// power for a generation line, state of charge for a bank, signed watts for a
// grid meter. The rest of the node's facts remain the last ones the operator
// or the device supplied.
fn energy_sync_from_gateway(db: SqlDb, now: u32) {
    if energy_driver_is_mock() {
        return
    }
    if settings_get("energy.mesh_url", "") == "" {
        return
    }
    energy_ensure_gateway_conf()

    var sources: EnergySources[32]
    var source_slice: Slice[EnergySources] = Slice[EnergySources]{
        Ptr[EnergySources](&sources[0]), 128 }
    var source_rows: Result[u32, SqlError] = ListSources(db, source_slice, 128)
    if source_rows.is_ok {
        var i: u32 = 0
        while i < source_rows.ok {
            if sources[i].meshSource != "" {
                var latest: string = gateway_source_latest(sources[i].meshSource)
                if latest != "" {
                    var power: i64 = energy_parse_watts(latest)
                    var voltage: i64 = sources[i].voltageMv
                    if voltage == 0 {
                        voltage = 380000
                    }
                    var current: i64 = power * 1000000 / voltage
                    energy_ignore_result(UpdateSourceReading(power, voltage,
                        current, sources[i].temperatureMc, "online", i64(now),
                        sources[i].id, db))
                    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA,
                        u32(sources[i].id), "power_w",
                        energy_i64_to_str(power), 0))
                }
            }
            i = i + 1
        }
    }

    var batteries: EnergyBatteries[32]
    var battery_slice: Slice[EnergyBatteries] = Slice[EnergyBatteries]{
        Ptr[EnergyBatteries](&batteries[0]), 128 }
    var battery_rows: Result[u32, SqlError] = ListBatteries(db, battery_slice, 128)
    if battery_rows.is_ok {
        var j: u32 = 0
        while j < battery_rows.ok {
            if batteries[j].meshSource != "" {
                var latest: string = gateway_source_latest(batteries[j].meshSource)
                if latest != "" {
                    var soc: i64 = energy_parse_milli(latest)
                    energy_ignore_result(UpdateBatteryReading(soc,
                        batteries[j].sohMilli, batteries[j].voltageMv,
                        batteries[j].currentMa, batteries[j].temperatureMc,
                        batteries[j].cellMinMv, batteries[j].cellMaxMv,
                        "online", i64(now), batteries[j].id, db))
                    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA,
                        u32(batteries[j].id), "soc_pct",
                        energy_format_milli(soc, 3), 0))
                }
            }
            j = j + 1
        }
    }

    var grids: EnergyGrids[32]
    var grid_slice: Slice[EnergyGrids] = Slice[EnergyGrids]{
        Ptr[EnergyGrids](&grids[0]), 128 }
    var grid_rows: Result[u32, SqlError] = ListGrids(db, grid_slice, 128)
    if grid_rows.is_ok {
        var k: u32 = 0
        while k < grid_rows.ok {
            if grids[k].meshSource != "" {
                var latest: string = gateway_source_latest(grids[k].meshSource)
                if latest != "" {
                    var net: i64 = energy_parse_watts(latest)
                    var import_w: i64 = 0
                    var export_w: i64 = 0
                    if net >= 0 {
                        import_w = net
                    } else {
                        export_w = 0 - net
                    }
                    energy_ignore_result(UpdateGridReading(grids[k].voltageMv,
                        grids[k].frequencyMhz, import_w, export_w, 1, "online",
                        i64(now), grids[k].id, db))
                    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA,
                        u32(grids[k].id), "grid_import_w",
                        energy_i64_to_str(import_w), 0))
                    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA,
                        u32(grids[k].id), "grid_export_w",
                        energy_i64_to_str(export_w), 0))
                }
            }
            k = k + 1
        }
    }
}

fn energy_widget_refresh_due() bool {
    var path: string = energy_state_dir() + "/widget-refresh.last"
    var now: u32 = energy_now()
    if now == 0 {
        return false
    }
    var last: u32 = 0
    if rho_path_exists(path) {
        last = rho_int_from_str(rho_read_text(path))
    }
    if now >= last + 10 {
        ignore_bool(rho_write_text(path, rho_int_to_str(now)))
        return true
    }
    return false
}

// The widget definitions are seeded once. From then on the widgets module owns
// their rendering, storage and SSE; the application only supplies the values
// through the URLs below.
fn energy_seed_widgets(db: SqlDb, now: u32) {
    var existing: Widgets[1]
    var existing_slice: Slice[Widgets] = Slice[Widgets]{
        Ptr[Widgets](&existing[0]), 1 }
    var listed: Result[u32, SqlError] = ListWidgets(db, existing_slice, 1)
    if listed.is_ok {
        return
    }
    var created: string = rho_int_to_str(now)
    energy_ignore_result(InsertWidget("Generation", "numeric", "mesh",
        "energy.generation", "GET", "W", "24", "0", "small", "0", created, db))
    energy_ignore_result(InsertWidget("Load", "numeric", "mesh",
        "energy.load", "GET", "W", "24", "1", "small", "0", created, db))
    energy_ignore_result(InsertWidget("Battery SoC", "numeric", "mesh",
        "energy.soc", "GET", "%", "24", "2", "small", "1", created, db))
    energy_ignore_result(InsertWidget("Grid", "numeric", "mesh",
        "energy.grid", "GET", "W", "24", "3", "small", "0", created, db))
    energy_ignore_result(InsertWidget("Battery temperature", "numeric", "mesh",
        "energy.battery_temp", "GET", "°C", "24", "4", "small", "1", created,
        db))
    energy_ignore_result(InsertWidget("Site mode", "status", "mesh",
        "energy.mode", "GET", "", "24", "5", "small", "0", created, db))
    energy_ignore_result(InsertWidget("Power faults", "status", "mesh",
        "energy.faults", "GET", "", "24", "6", "small", "0", created, db))
    energy_ignore_result(InsertWidget("Generation history", "chart", "mesh",
        "energy.generation", "GET", "W", "24", "7", "medium", "0", created, db))
}

fn energy_widget_sim_source(title: string) string {
    if rho_str_eq(title, "Generation") {
        return "energy.generation"
    }
    if rho_str_eq(title, "Load") {
        return "energy.load"
    }
    if rho_str_eq(title, "Battery SoC") {
        return "energy.soc"
    }
    if rho_str_eq(title, "Grid") {
        return "energy.grid"
    }
    if rho_str_eq(title, "Battery temperature") {
        return "energy.battery_temp"
    }
    if rho_str_eq(title, "Site mode") {
        return "energy.mode"
    }
    if rho_str_eq(title, "Power faults") {
        return "energy.faults"
    }
    if rho_str_eq(title, "Generation history") {
        return "energy.generation"
    }
    return ""
}

// energy_apply_widget_sources keeps the seeded dashboard cards pointed at the
// provider that is live. In simulation mode the simulated source is selected;
// in real-time mode an energy simulation selection is cleared so the operator
// picks a real Mesh source in the widget manager.
fn energy_apply_widget_sources(db: SqlDb, mode: string) {
    var widgets: Widgets[32]
    var slice: Slice[Widgets] = Slice[Widgets]{
        Ptr[Widgets](&widgets[0]), 32 }
    var listed: Result[u32, SqlError] = ListWidgets(db, slice, 32)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var i: u32 = 0
    while i < count {
        var sim_source: string = energy_widget_sim_source(widgets[i].title)
        if sim_source != "" {
            var current: string = widgets[i].source
            var is_sim: bool = rho_str_index_of(current, "energy.") == 0
            var is_energy_url: bool = rho_str_index_of(current,
                "/api/energy/widgets/") >= 0
            if rho_str_eq(mode, ENERGY_DRIVER_MOCK) {
                if current == "" || is_sim || is_energy_url {
                    energy_ignore_result(UpdateWidgetSource("mesh", sim_source,
                        "GET", widgets[i].id, db))
                }
            } else {
                if is_sim || is_energy_url {
                    energy_ignore_result(UpdateWidgetSource("manual", "",
                        "GET", widgets[i].id, db))
                }
            }
        }
        i = i + 1
    }
}

fn energy_widget_value(field: string) string {
    var opened: Result[SqlDb, string] = energy_open_db()
    if !opened.is_ok {
        if rho_str_eq(field, "mode") {
            return "info:unknown"
        }
        if rho_str_eq(field, "faults") {
            return "bad:store unavailable"
        }
        return "0"
    }
    var totals: EnergyTotals = energy_totals(opened.ok)
    var config: EnergyConfig = energy_config_get(opened.ok)
    var faults: u32 = energy_active_fault_count(opened.ok)
    sql_close(opened.ok)
    if rho_str_eq(field, "generation") {
        return energy_i64_to_str(totals.generation_w)
    }
    if rho_str_eq(field, "load") {
        return energy_i64_to_str(totals.load_w)
    }
    if rho_str_eq(field, "soc") {
        return energy_format_milli(totals.battery_soc_milli, 1)
    }
    if rho_str_eq(field, "grid") {
        return energy_i64_to_str(totals.grid_import_w - totals.grid_export_w)
    }
    if rho_str_eq(field, "battery_temp") {
        return energy_format_milli(totals.battery_temperature_mc, 1)
    }
    if rho_str_eq(field, "mode") {
        return "info:" + energy_mode_label(config.mode)
    }
    if rho_str_eq(field, "faults") {
        if faults == 0 {
            return "ok:No power faults"
        }
        var plural: string = "s"
        if faults == 1 {
            plural = ""
        }
        return "bad:" + rho_int_to_str(faults) + " power fault" + plural
    }
    return "0"
}

