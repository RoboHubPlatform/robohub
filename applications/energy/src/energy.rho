            if voltage_text != "" {
                voltage = energy_parse_milli(voltage_text)
            }
            var frequency_text: string = energy_form_field(body, "frequency_hz")
            var frequency: i64 = rows[0].frequencyMhz
            if frequency_text != "" {
                frequency = energy_parse_milli(frequency_text)
            }
            var import_text: string = energy_form_field(body, "import_w")
            var import_w: i64 = rows[0].importW
            if import_text != "" {
                import_w = energy_parse_watts(import_text)
            }
            var export_text: string = energy_form_field(body, "export_w")
            var export_w: i64 = rows[0].exportW
            if export_text != "" {
                export_w = energy_parse_watts(export_text)
            }
            var status: string = energy_form_field(body, "status")
            var state: string = rows[0].status
            if status != "" {
                state = status
            }
            var synchronized: i64 = rows[0].synchronized
            var sync_text: string = energy_form_field(body, "synchronized")
            if sync_text != "" {
                synchronized = energy_bool_int(sync_text)
            }
            energy_ignore_result(UpdateGridReading(voltage, frequency, import_w, export_w, synchronized, state, i64(now), id, db))
            ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(id), "grid_import_w", energy_i64_to_str(import_w), 0))
            ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(id), "grid_export_w", energy_i64_to_str(export_w), 0))
            ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(id), "voltage_v", energy_format_milli(voltage, 3), 0))
            ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(id), "frequency_hz", energy_format_milli(frequency, 3), 0))
            energy_evaluate_safety(db, now)
            energy_publish_live(db)
        }
        sql_close(db)
    }
    return redirect("/grid")
}

