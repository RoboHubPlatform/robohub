}

fn energy_grid_field_defs(fields: [FormField]) void {
    fields[0] = energy_field("name", "text", "Link name", "The meter or utility connection name.", "Utility feed", true, "", "", "", "")
    fields[1] = energy_field("utility", "text", "Utility", "The utility or the account this line belongs to.", "Local utility", false, "", "", "", "")
    fields[2] = energy_field("phases", "select", "Phases", "A single-phase or a three-phase connection.", "", true, "", "1|Single-phase,3|Three-phase", "1", "")
    fields[3] = energy_field("import_limit_kw", "text", "Import limit (kW)", "The most the site may draw; zero means no limit.", "12", false, "number", "", "", "decimal")
    fields[4] = energy_field("export_limit_kw", "text", "Export limit (kW)", "The most the site may back-feed; zero with zero-export enforced.", "0", false, "number", "", "", "decimal")
    fields[5] = energy_field("zero_export", "select", "Zero export", "Strict zero-export refuses all back-feed.", "", true, "", "1|Enforced,0|Allowed", "1", "")
    fields[6] = energy_field("mesh_source", "text", "Mesh source", "The Mesh source ID or URL for the grid meter in real-time mode.", "31", false, "", "", "", "")
}

fn energy_grid_rows(db: SqlDb, req: Request) string {
    var grids: EnergyGrids[32]
    var slice: Slice[EnergyGrids] = Slice[EnergyGrids]{ Ptr[EnergyGrids](&grids[0]), 128 }
    var rows: Result[u32, SqlError] = ListGrids(db, slice, ENERGY_CAPACITY)
    var count: u32 = 0
    if rows.is_ok {
        count = rows.ok
    }
    var out: string = ""
    var i: u32 = 0
    while i < count {
        var export_text: string = "allowed"
        if grids[i].zeroExport != 0 {
            export_text = "zero export"
        }
        var sync_text: string = "not synchronized"
        if grids[i].synchronized != 0 {
            sync_text = "synchronized"
        }
        out = out + template_fill(template_get("grid-row"), vars("id", energy_i64_to_str(grids[i].id)) + vars("name", escape_html(grids[i].name)) + vars("utility", escape_html(grids[i].utility)) + vars("phases", energy_i64_to_str(grids[i].phases)) + vars("voltage", energy_format_volts(grids[i].voltageMv)) + vars("frequency", energy_format_freq(grids[i].frequencyMhz)) + vars("import", energy_format_watts(grids[i].importW)) + vars("export", energy_format_watts(grids[i].exportW)) + vars("import_limit", energy_format_watts(grids[i].importLimitW)) + vars("export_limit", energy_format_watts(grids[i].exportLimitW)) + vars("zero_export", export_text) + vars("synchronized", sync_text) + vars("status", escape_html(grids[i].status)) + vars("status_css", energy_status_class(grids[i].status)) + vars("updated", energy_date(u32(grids[i].updatedEpoch))) + vars("csrf", forms_csrf_field()) + i18n_vars(req))
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"8\">No grid links registered.</td></tr>"
    }
    return out
}

fn energy_grid_page_fields(req: Request, fields: [FormField], count: u32, notice: string) Response {
    var opened: Result[SqlDb, string] = energy_open_db()
    if !opened.is_ok {
        return energy_page(req, "Grid", "<p>The energy store is not available.</p>")
    }
    var db: SqlDb = opened.ok
    var form: string = forms_open(fields, count, "/grid/add", "Add grid link", i18n_locale(req))
    var body: string = template_fill(template_get("grid"), vars("rows", energy_grid_rows(db, req)) + vars("form", form) + vars("notice", energy_notice(notice)))
    sql_close(db)
    return energy_page(req, "Grid interface", body)
}

