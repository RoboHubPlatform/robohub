fn energy_sim_source_object(id: string, label: string, unit: string,
    kinds: string) string {
    let field: string = energy_sim_source_field(id)
    return "{\"id\":" + json_string(id) +
        ",\"owner\":\"Energy\",\"label\":" + json_string(label) +
        ",\"direction\":\"input\",\"unit\":" + json_string(unit) +
        ",\"kinds\":" + json_string(kinds) +
        ",\"value_url\":" + json_string(energy_base_url() +
            "/api/energy/widgets/" + field) +
        ",\"action_url\":\"\"}"
}

fn energy_sim_gateway_sources(req: Request) Response {
    if !energy_driver_is_mock() {
        return json(status_ok(), "[]")
    }
    var body: string = "[" +
        energy_sim_source_object("energy.generation", "Generation", "W",
            "numeric chart") + "," +
        energy_sim_source_object("energy.load", "Load", "W",
            "numeric chart") + "," +
        energy_sim_source_object("energy.soc", "Battery SoC", "%",
            "numeric chart") + "," +
        energy_sim_source_object("energy.grid", "Grid", "W",
            "numeric chart") + "," +
        energy_sim_source_object("energy.battery_temp", "Battery temperature",
            "°C", "numeric chart") + "," +
        energy_sim_source_object("energy.mode", "Site mode", "", "status") +
        "," +
        energy_sim_source_object("energy.faults", "Power faults", "", "status") +
        "]"
    return json(status_ok(), body)
}

fn energy_sim_gateway_latest(req: Request) Response {
    let source: string = request_query_param(req, "source")
    let field: string = energy_sim_source_field(source)
    if field == "" {
        return text(404, "")
    }
    return text(status_ok(), energy_widget_value(field))
}

fn energy_sim_gateway_history(req: Request) Response {
    if !energy_driver_is_mock() {
        return json(status_ok(), "{\"points\":[]}")
    }
    let source: string = request_query_param(req, "source")
    let field: string = energy_sim_history_field(source)
    if field == "" {
        return json(status_ok(), "{\"points\":[]}")
    }
    var opened: Result[SqlDb, string] = sql_open(energy_telemetry_path())
    if !opened.is_ok {
        return json(status_ok(), "{\"points\":[]}")
    }
    ignore_u32(sql_apply(opened.ok, ""))
    var rows: ListTelemetryRecentRow[60]
    var slice: Slice[ListTelemetryRecentRow] = Slice[ListTelemetryRecentRow]{
        Ptr[ListTelemetryRecentRow](&rows[0]), 60 }
    var listed: Result[u32, SqlError] = ListTelemetryRecent(energy_project(),
        field, opened.ok, slice, 60)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    sql_close(opened.ok)
    var body: string = "{\"points\":["
    var i: u32 = count
    while i > 0 {
        i = i - 1
        if i < count - 1 {
            body = body + ","
        }
        body = body + "{\"t\":" + energy_i64_to_str(rows[i].receivedMs) +
            ",\"v\":" + json_string(rows[i].valueText) + "}"
    }
    body = body + "]}"
    return json(status_ok(), body)
}

fn energy_heartbeat(req: Request) Response {
    return text(status_ok(), energy_simulation_label() + " · " +
        energy_clock_now())
}

fn energy_sim_gateway_status(req: Request) Response {
    if !energy_driver_is_mock() {
        return text(403, "real-time")
    }
    return text(status_ok(), "simulation")
}

fn energy_widgets_refresh(req: Request) Response {
    var updated: u32 = widgets_refresh_all()
    return json(status_ok(), "{\"ok\":true,\"updated\":" +
        rho_int_to_str(updated) + "}")
}

fn energy_sim_toggle(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return redirect("/")
    }
    var mode: string = energy_trim(energy_form_field(body, "mode"))
    if !rho_str_eq(mode, ENERGY_DRIVER_MOCK) &&
        !rho_str_eq(mode, ENERGY_DRIVER_HARDWARE) {
        return redirect("/")
    }
    settings_set("energy.driver_mode", mode)
    var now: u32 = energy_now()
    energy_write_gateway_conf()
    ignore_bool(rho_write_text(energy_state_dir() + "/widget-refresh.last", "0"))
    var opened: Result[SqlDb, string] = energy_open_db()
    if opened.is_ok {
        var db: SqlDb = opened.ok
        var message: string = "Switched to simulation"
        if rho_str_eq(mode, ENERGY_DRIVER_HARDWARE) {
            message = "Switched to real-time Mesh telemetry"
        }
        energy_apply_widget_sources(db, mode)
        energy_register_mesh_client()
        energy_ignore_result(InsertEvent("INFO", "mode", message,
            rho_int_to_str(now), db))
        energy_evaluate_safety(db, now)
        energy_publish_live(db)
        sql_close(db)
    }
    ignore_u32(widgets_refresh_all())
    return redirect("/")
}

fn energy_trim_url(url: string) string {
    var out: string = url
    while rho_strlen(out) > 0 && rho_str_eq(rho_str_slice(out,
            u32(rho_strlen(out)) - 1, 1), "/") {
        out = rho_str_slice(out, 0, u32(rho_strlen(out)) - 1)
    }
    return out
}

fn energy_mesh_project_link() string {
    let url: string = settings_get("energy.mesh_url",
        energy_gateway_conf_value("url"))
    let project: string = settings_get("energy.mesh_project",
        energy_gateway_conf_value("project"))
    if url == "" || project == "" {
        return ""
    }
    return energy_trim_url(url) + "/mesh/project/" + project + "/settings"
}

fn energy_settings_field_defs(fields: [FormField], config: EnergyConfig) void {
    fields[0] = energy_field("driver_mode", "select", "Driver mode",
        "Simulation runs the bench model; real-time reads the Mesh project through the gateway.",
        "", true, "", "mock|Simulation,hardware|Real-time (Mesh)",
        energy_driver_mode(), "")
    fields[1] = energy_field("site_name", "text", "Site name",
        "What this location is called.", "Dashboard", false, "", "",
        energy_site_name(), "")
    fields[2] = energy_field("refresh_seconds", "text", "Simulator tick (s)",
        "How often the background worker samples when the simulator is live.",
        "2", false, "number", "", energy_refresh_seconds(), "numeric")
    fields[3] = energy_field("mesh_url", "text", "Mesh gateway URL",
        "The Mesh API the gateway provider reads. Save the URL and token once to load that Mesh's projects.",
        "http://127.0.0.1:8478", false, "", "",
        settings_get("energy.mesh_url", energy_gateway_conf_value("url")), "")
    fields[4] = energy_field("mesh_project", "select", "Mesh project",
        "Choose one of the projects Mesh reports at the gateway URL.", "",
        false, "", energy_gateway_project_choices(),
        settings_get("energy.mesh_project", energy_gateway_conf_value("project")), "")
    fields[5] = energy_field("mesh_token", "password", "Mesh token",
        "The per-project Mesh service token. Generate or copy it in Mesh project settings; it is scoped to this project.",
        "", false, "", "", settings_get("energy.mesh_token", energy_gateway_conf_value("token")), "")
    var fault_value: string = config.simFault
    if fault_value == "" {
        fault_value = "none"
    }
    fields[6] = energy_field("sim_fault", "select", "Scripted fault",
        "The simulator presents this condition on every tick until cleared.",
        "", false, "",
        "none|None,pv_overvoltage|PV overvoltage,pv_overtemp|PV over-temperature,battery_overtemp|Battery over-temperature,battery_low|Battery low,cell_imbalance|Cell imbalance,grid_overvoltage|Grid overvoltage,grid_undervoltage|Grid undervoltage,grid_frequency|Grid frequency,zero_export|Zero-export violation,grid_offline|Grid offline",
        fault_value, "")
}

fn energy_settings_page_fields(req: Request, fields: [FormField], count: u32, notice: string) Response {
    energy_ensure_gateway_conf()
    var gateway_url: string = energy_gateway_display_url()
    var gateway_status: string = "Simulation mode; the gateway is idle."
    var gateway_sources: string = "Simulation mode; no Mesh sources are read."
    if !energy_driver_is_mock() {
        gateway_url = energy_gateway_url()
        gateway_status = energy_gateway_status()
        gateway_sources = energy_gateway_sources_text()
    }
    if !energy_driver_is_mock() &&
        settings_get("energy.mesh_token", energy_gateway_conf_value("token")) == "" {
        notice = "A Mesh token is required before the project list can load."
    }
    var form: string = forms_open(fields, count, "/settings", "Save settings",
        i18n_locale(req))
    var body: string = template_fill(template_get("settings"),
        vars("form", form) + vars("notice", energy_notice(notice)) +
        vars("driver_mode", energy_driver_mode()) +
        vars("driver_label", energy_driver_label(energy_driver_mode())) +
        vars("simulation", energy_simulation_label()) +
        vars("sim_off", if energy_simulation_off() { "1" } else { "" }) +
        vars("db_path", escape_html(energy_db_path())) +
        vars("telemetry_path", escape_html(energy_telemetry_path())) +
        vars("reading_fields", energy_driver_reading_fields()) +
        vars("site", escape_html(energy_site_name())) +
        vars("project", escape_html(energy_project())) +
        vars("mesh_project", escape_html(settings_get("energy.mesh_project", ""))) +
        vars("gateway_url", escape_html(gateway_url)) +
        vars("gateway_status", escape_html(gateway_status)) +
        vars("gateway_sources", escape_html(gateway_sources)) +
        vars("mesh_project_link", escape_html(energy_mesh_project_link())))
    return energy_page(req, "Settings", body)
}

fn energy_settings_page(req: Request) Response {
    var opened: Result[SqlDb, string] = energy_open_db()
    var config: EnergyConfig = energy_empty_config()
    if opened.is_ok {
        config = energy_config_get(opened.ok)
        sql_close(opened.ok)
    }
    var fields: FormField[7]
    energy_settings_field_defs(fields, config)
    return energy_settings_page_fields(req, fields, 7, "")
}

fn energy_settings_save(req: Request) Response {
    var body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return energy_page(req, "Settings",
            "<p>Refused: the form token did not match.</p>")
    }
    var opened: Result[SqlDb, string] = energy_open_db()
    var config: EnergyConfig = energy_empty_config()
    if opened.is_ok {
        config = energy_config_get(opened.ok)
    }
    var fields: FormField[7]
    energy_settings_field_defs(fields, config)
    forms_read(fields, 7, body)
    if !forms_validate(fields, 7) {
        if opened.is_ok {
            sql_close(opened.ok)
        }
        return energy_settings_page_fields(req, fields, 7, "")
    }
    var driver: string = energy_trim(forms_parse(body, "driver_mode"))
    if rho_str_eq(driver, ENERGY_DRIVER_MOCK) ||
        rho_str_eq(driver, ENERGY_DRIVER_HARDWARE) {
        settings_set("energy.driver_mode", driver)
    }
    var site_name: string = energy_trim(forms_parse(body, "site_name"))
    if site_name == "" {
        site_name = "Dashboard"
    }
    var refresh: string = energy_trim(forms_parse(body, "refresh_seconds"))
    if refresh == "" {
        refresh = "2"
    }
    settings_set("energy.site_name", site_name)
    settings_set("energy.refresh_seconds", refresh)
    if energy_body_has(body, "mesh_url") {
        settings_set("energy.mesh_url", energy_trim(forms_parse(body, "mesh_url")))
    }
    if energy_body_has(body, "mesh_project") {
        settings_set("energy.mesh_project",
            energy_trim(forms_parse(body, "mesh_project")))
    }
    if energy_body_has(body, "mesh_token") {
        var posted_token: string = energy_trim(forms_parse(body, "mesh_token"))
        if posted_token == "" {
            posted_token = settings_get("energy.mesh_token",
                energy_gateway_conf_value("token"))
        }
        if posted_token != "" {
            settings_set("energy.mesh_token", posted_token)
        }
    }
    energy_write_gateway_conf()
    var fault: string = config.simFault
    if energy_body_has(body, "sim_fault") {
        fault = energy_trim(forms_parse(body, "sim_fault"))
        if rho_str_eq(fault, "none") {
            fault = ""
        }
    }
    var notice: string = "The settings were saved."
    var mesh_url: string = settings_get("energy.mesh_url", "")
    if rho_str_eq(driver, ENERGY_DRIVER_HARDWARE) && mesh_url == "" {
        notice = "Real-time mode is selected; set the Mesh gateway URL and choose a project."
    }
    if opened.is_ok {
        var db: SqlDb = opened.ok
        var now: u32 = energy_now()
        energy_ignore_result(SetSimFault(fault, i64(now), db))
        if rho_str_eq(driver, ENERGY_DRIVER_HARDWARE) {
            energy_sync_from_gateway(db, now)
        }
        energy_apply_widget_sources(db, driver)
        energy_register_mesh_client()
        energy_ignore_result(InsertEvent("INFO", "settings",
            "Application settings updated; driver mode " + driver,
            rho_int_to_str(now), db))
        energy_evaluate_safety(db, now)
        energy_publish_live(db)
        sql_close(db)
    }
    ignore_u32(widgets_refresh_all())
    var shown: FormField[7]
    var fresh: Result[SqlDb, string] = energy_open_db()
    if fresh.is_ok {
        config = energy_config_get(fresh.ok)
        sql_close(fresh.ok)
    }
    energy_settings_field_defs(shown, config)
    return energy_settings_page_fields(req, shown, 7, notice)
}

fn energy_docs(req: Request) Response {
    var root: string = getenv("ROBOHUB_WORKSPACE")
    var path: string = "applications/energy/docs/index.md"
    if root != "" {
        path = root + "/applications/energy/docs/index.md"
    }
    var content: string = "No documentation found."
    if rho_path_exists(path) {
        content = rho_read_text(path)
    }
    var body: string = template_fill(template_get("docs"), vars("content", escape_html(content)))
    return energy_page(req, "Documentation", body)
}

fn energy_active_fault_count(db: SqlDb) u32 {
    var faults: EnergyFaultState[32]
    var slice: Slice[EnergyFaultState] = Slice[EnergyFaultState]{ Ptr[EnergyFaultState](&faults[0]), 128 }
    var rows: Result[u32, SqlError] = ListActiveFaultStates(db, slice, 128)
    if rows.is_ok {
        return rows.ok
    }
    return 0
}

fn energy_api_events(req: Request) Response {
    var opened: Result[SqlDb, string] = energy_open_db()
    if !opened.is_ok {
        return json(500, "{\"ok\":false}")
    }
    var db: SqlDb = opened.ok
    var events: EnergyEvents[32]
    var slice: Slice[EnergyEvents] = Slice[EnergyEvents]{ Ptr[EnergyEvents](&events[0]), 32 }
    var rows: Result[u32, SqlError] = ListEvents(db, slice, 32)
    var count: u32 = 0
    if rows.is_ok {
        count = rows.ok
    }
    var body: string = "{\"ok\":true,\"rows\":["
    var i: u32 = 0
    while i < count {
        if i > 0 {
            body = body + ","
        }
        body = body + "{\"id\":" + energy_i64_to_str(events[i].id) + ",\"severity\":" + json_string(events[i].severity) + ",\"kind\":" + json_string(events[i].kind) + ",\"message\":" + json_string(events[i].message) + "}"
        i = i + 1
    }
    body = body + "]}"
    sql_close(db)
    return json(status_ok(), body)
}

fn energy_api_state(req: Request) Response {
    var opened: Result[SqlDb, string] = energy_open_db()
    if !opened.is_ok {
        return json(500, "{\"ok\":false,\"error\":\"store unavailable\"}")
    }
    var db: SqlDb = opened.ok
    var config: EnergyConfig = energy_config_get(db)
    var totals: EnergyTotals = energy_totals(db)
    var active_faults: u32 = energy_active_fault_count(db)
    sql_close(db)
    var simulation: string = "false"
    if energy_driver_is_mock() {
        simulation = "true"
    }
    var body: string = "{\"ok\":true" + ",\"site\":" + json_string(energy_site_name()) + ",\"project\":" + json_string(energy_project()) + ",\"driver\":" + json_string(energy_driver_mode()) + ",\"simulation\":" + simulation + ",\"mesh_project\":" + json_string(settings_get("energy.mesh_project", "default")) + ",\"gateway_url\":" + json_string(settings_get("energy.mesh_url", "")) + ",\"mode\":" + json_string(config.mode) + ",\"generation_w\":" + energy_i64_to_str(totals.generation_w) + ",\"load_w\":" + energy_i64_to_str(totals.load_w) + ",\"soc_pct\":" + energy_format_milli(totals.battery_soc_milli, 3) + ",\"battery_voltage_v\":" + energy_format_milli(totals.battery_voltage_mv, 3) + ",\"battery_current_a\":" + energy_format_milli(totals.battery_current_ma, 3) + ",\"battery_temperature_c\":" + energy_format_milli(totals.battery_temperature_mc, 3) + ",\"grid_import_w\":" + energy_i64_to_str(totals.grid_import_w) + ",\"grid_export_w\":" + energy_i64_to_str(totals.grid_export_w) + ",\"grid_voltage_v\":" + energy_format_milli(totals.grid_voltage_mv, 3) + ",\"grid_frequency_hz\":" + energy_format_milli(totals.grid_frequency_mhz, 3) + ",\"generator\":" + (if config.generator != 0 { "true" } else { "false" }) + ",\"load_shed\":" + (if config.loadShed != 0 { "true" } else { "false" }) + ",\"sim_fault\":" + json_string(config.simFault) + ",\"reserve_soc_pct\":" + energy_format_milli(config.reserveSocMilli, 3) + ",\"load_shed_soc_pct\":" + energy_format_milli(config.loadShedSocMilli, 3) + ",\"battery_temp_limit_c\":" + energy_format_milli(config.batteryTempLimitMc, 3) + ",\"solar_temp_limit_c\":" + energy_format_milli(config.solarTempLimitMc, 3) + ",\"charge_voltage_v\":" + energy_format_milli(config.chargeVoltageMv, 3) + ",\"grid_min_voltage_v\":" + energy_format_milli(config.gridMinVoltageMv, 3) + ",\"grid_max_voltage_v\":" + energy_format_milli(config.gridMaxVoltageMv, 3) + ",\"grid_min_frequency_hz\":" + energy_format_milli(config.gridMinFrequencyMhz, 3) + ",\"grid_max_frequency_hz\":" + energy_format_milli(config.gridMaxFrequencyMhz, 3) + ",\"cell_delta_limit_mv\":" + energy_i64_to_str(config.batteryCellDeltaMv) + ",\"faults\":" + rho_int_to_str(active_faults) + "}"
    return json(status_ok(), body)
}

fn energy_api_source_ingest(db: SqlDb, body: string, now: u32) i64 {
    var name: string = energy_trim(energy_form_field(body, "name"))
    if name == "" {
        return 0
    }
    var source_id: i64 = 0
    var rows: EnergySources[1]
    var slice: Slice[EnergySources] = Slice[EnergySources]{ Ptr[EnergySources](&rows[0]), 1 }
    var found: Result[u32, SqlError] = FindSourceByName(name, db, slice, 1)
    if found.is_ok {
        source_id = rows[0].id
    } else {
        var kind: string = energy_trim(energy_form_field(body, "kind"))
        if kind == "" {
            kind = "solar_pv"
        }
        energy_ignore_result(InsertSource(name, kind, energy_trim(energy_form_field(body, "bus")), energy_trim(energy_form_field(body, "address")), energy_trim(energy_form_field(body, "mesh_source")), energy_i64_to_str(energy_parse_milli(energy_form_field(body, "rated_kw"))), energy_trim(energy_form_field(body, "protocol")), db))
        var again: Result[u32, SqlError] = FindSourceByName(name, db, slice, 1)
        if again.is_ok {
            source_id = rows[0].id
        }
    }
    if source_id == 0 {
        return 0
    }
    var current_rows: EnergySources[1]
    var current_slice: Slice[EnergySources] = Slice[EnergySources]{ Ptr[EnergySources](&current_rows[0]), 1 }
    var got: Result[u32, SqlError] = GetSource(source_id, db, current_slice, 1)
    if !got.is_ok {
        return 0
    }
    var power_text: string = energy_form_field(body, "power_w")
    var voltage_text: string = energy_form_field(body, "voltage_v")
    var current_text: string = energy_form_field(body, "current_a")
    var temperature_text: string = energy_form_field(body, "temperature_c")
    var power: i64 = energy_parse_watts(power_text)
    var voltage: i64 = current_rows[0].voltageMv
    if voltage_text != "" {
        voltage = energy_parse_milli(voltage_text)
    }
    var current: i64 = energy_parse_milli(current_text)
    var temperature: i64 = current_rows[0].temperatureMc
    if temperature_text != "" {
        temperature = energy_parse_milli(temperature_text)
    }
    if power_text == "" && current_text != "" && voltage != 0 {
        power = current * voltage / 1000000
    }
    if current_text == "" && power_text != "" && voltage > 0 {
        current = power * 1000000 / voltage
    }
    var status: string = energy_trim(energy_form_field(body, "status"))
    if status == "" {
        status = "online"
    }
    energy_ignore_result(UpdateSourceReading(power, voltage, current, temperature, status, i64(now), source_id, db))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(source_id), "power_w", energy_i64_to_str(power), 0))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(source_id), "voltage_v", energy_format_milli(voltage, 3), 0))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(source_id), "current_a", energy_format_milli(current, 3), 0))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(source_id), "temperature_c", energy_format_milli(temperature, 3), 0))
    return source_id
}

fn energy_api_battery_ingest(db: SqlDb, body: string, now: u32) i64 {
    var name: string = energy_trim(energy_form_field(body, "name"))
    if name == "" {
        return 0
    }
    var battery_id: i64 = 0
    var rows: EnergyBatteries[1]
    var slice: Slice[EnergyBatteries] = Slice[EnergyBatteries]{ Ptr[EnergyBatteries](&rows[0]), 1 }
    var found: Result[u32, SqlError] = FindBatteryByName(name, db, slice, 1)
    if found.is_ok {
        battery_id = rows[0].id
    } else {
        energy_ignore_result(InsertBattery(name, "LiFePO4", energy_i64_to_str(energy_parse_milli(energy_form_field(body, "capacity_kwh"))), "L51", energy_trim(energy_form_field(body, "bms_host")), energy_trim(energy_form_field(body, "mesh_source")), db))
        var again: Result[u32, SqlError] = FindBatteryByName(name, db, slice, 1)
        if again.is_ok {
            battery_id = rows[0].id
        }
    }
    if battery_id == 0 {
        return 0
    }
    var current_rows: EnergyBatteries[1]
    var current_slice: Slice[EnergyBatteries] = Slice[EnergyBatteries]{ Ptr[EnergyBatteries](&current_rows[0]), 1 }
    var got: Result[u32, SqlError] = GetBattery(battery_id, db, current_slice, 1)
    if !got.is_ok {
        return 0
    }
    var soc_text: string = energy_form_field(body, "soc_pct")
    var soc: i64 = current_rows[0].socMilli
    if soc_text != "" {
        soc = energy_parse_milli(soc_text)
    }
    var soh_text: string = energy_form_field(body, "soh_pct")
    var soh: i64 = current_rows[0].sohMilli
    if soh_text != "" {
        soh = energy_parse_milli(soh_text)
    }
    var voltage_text: string = energy_form_field(body, "voltage_v")
    var voltage: i64 = current_rows[0].voltageMv
    if voltage_text != "" {
        voltage = energy_parse_milli(voltage_text)
    }
    var current: i64 = energy_parse_milli(energy_form_field(body, "current_a"))
    var temperature_text: string = energy_form_field(body, "temperature_c")
    var temperature: i64 = current_rows[0].temperatureMc
    if temperature_text != "" {
        temperature = energy_parse_milli(temperature_text)
    }
    var cell_min_text: string = energy_form_field(body, "cell_min_v")
    var cell_min_mv_text: string = energy_form_field(body, "cell_min_mv")
    var cell_min: i64 = current_rows[0].cellMinMv
    if cell_min_text != "" {
        cell_min = energy_parse_milli(cell_min_text)
    } else if cell_min_mv_text != "" {
        cell_min = energy_parse_int(cell_min_mv_text)
    }
    var cell_max_text: string = energy_form_field(body, "cell_max_v")
    var cell_max_mv_text: string = energy_form_field(body, "cell_max_mv")
    var cell_max: i64 = current_rows[0].cellMaxMv
    if cell_max_text != "" {
        cell_max = energy_parse_milli(cell_max_text)
    } else if cell_max_mv_text != "" {
        cell_max = energy_parse_int(cell_max_mv_text)
    }
    var status: string = energy_trim(energy_form_field(body, "status"))
    if status == "" {
        status = "online"
    }
    energy_ignore_result(UpdateBatteryReading(soc, soh, voltage, current, temperature, cell_min, cell_max, status, i64(now), battery_id, db))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(battery_id), "soc_pct", energy_format_milli(soc, 3), 0))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(battery_id), "voltage_v", energy_format_milli(voltage, 3), 0))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(battery_id), "current_a", energy_format_milli(current, 3), 0))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(battery_id), "temperature_c", energy_format_milli(temperature, 3), 0))
    return battery_id
}

fn energy_api_grid_ingest(db: SqlDb, body: string, now: u32) i64 {
    var name: string = energy_trim(energy_form_field(body, "name"))
    if name == "" {
        return 0
    }
    var grid_id: i64 = 0
    var rows: EnergyGrids[1]
    var slice: Slice[EnergyGrids] = Slice[EnergyGrids]{ Ptr[EnergyGrids](&rows[0]), 1 }
    var found: Result[u32, SqlError] = FindGridByName(name, db, slice, 1)
    if found.is_ok {
        grid_id = rows[0].id
    } else {
        energy_ignore_result(InsertGrid(name, energy_trim(energy_form_field(body, "utility")), energy_trim(energy_form_field(body, "mesh_source")), "1", "0", "0", "1", db))
        var again: Result[u32, SqlError] = FindGridByName(name, db, slice, 1)
        if again.is_ok {
            grid_id = rows[0].id
        }
    }
    if grid_id == 0 {
        return 0
    }
    var current_rows: EnergyGrids[1]
    var current_slice: Slice[EnergyGrids] = Slice[EnergyGrids]{ Ptr[EnergyGrids](&current_rows[0]), 1 }
    var got: Result[u32, SqlError] = GetGrid(grid_id, db, current_slice, 1)
    if !got.is_ok {
        return 0
    }
    var voltage_text: string = energy_form_field(body, "voltage_v")
    var voltage: i64 = current_rows[0].voltageMv
    if voltage_text != "" {
        voltage = energy_parse_milli(voltage_text)
    }
    var frequency_text: string = energy_form_field(body, "frequency_hz")
    var frequency: i64 = current_rows[0].frequencyMhz
    if frequency_text != "" {
        frequency = energy_parse_milli(frequency_text)
    }
    var import_text: string = energy_form_field(body, "import_w")
    var import_w: i64 = current_rows[0].importW
    if import_text != "" {
        import_w = energy_parse_watts(import_text)
    }
    var export_text: string = energy_form_field(body, "export_w")
    var export_w: i64 = current_rows[0].exportW
    if export_text != "" {
        export_w = energy_parse_watts(export_text)
    }
    var status_text: string = energy_trim(energy_form_field(body, "status"))
    var status: string = current_rows[0].status
    if status_text != "" {
        status = status_text
    }
    var synchronized: i64 = current_rows[0].synchronized
    var sync_text: string = energy_form_field(body, "synchronized")
    if sync_text != "" {
        synchronized = energy_bool_int(sync_text)
    }
    energy_ignore_result(UpdateGridReading(voltage, frequency, import_w, export_w, synchronized, status, i64(now), grid_id, db))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(grid_id), "grid_import_w", energy_i64_to_str(import_w), 0))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(grid_id), "grid_export_w", energy_i64_to_str(export_w), 0))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(grid_id), "voltage_v", energy_format_milli(voltage, 3), 0))
    ignore_u32(telemetry_record(energy_project(), ENERGY_AREA, u32(grid_id), "frequency_hz", energy_format_milli(frequency, 3), 0))
    return grid_id
}

fn energy_api_load_ingest(db: SqlDb, body: string, now: u32) i64 {
    var name: string = energy_trim(energy_form_field(body, "name"))
    if name == "" {
        return 0
    }
    var load_id: i64 = 0
    var rows: EnergyLoads[1]
    var slice: Slice[EnergyLoads] = Slice[EnergyLoads]{ Ptr[EnergyLoads](&rows[0]), 1 }
    var found: Result[u32, SqlError] = FindLoadByName(name, db, slice, 1)
    if found.is_ok {
        load_id = rows[0].id
    } else {
        energy_ignore_result(InsertLoad(name, energy_trim(energy_form_field(body, "zone")), energy_trim(energy_form_field(body, "priority")), energy_i64_to_str(energy_parse_watts(energy_form_field(body, "power_w"))), energy_trim(energy_form_field(body, "critical")), db))
        var again: Result[u32, SqlError] = FindLoadByName(name, db, slice, 1)
        if again.is_ok {
            load_id = rows[0].id
        }
    }
    if load_id == 0 {
        return 0
    }
    var current_rows: EnergyLoads[1]
    var current_slice: Slice[EnergyLoads] = Slice[EnergyLoads]{ Ptr[EnergyLoads](&current_rows[0]), 1 }
    var got: Result[u32, SqlError] = GetLoad(load_id, db, current_slice, 1)
    if !got.is_ok {
        return 0
    }
    var power: i64 = energy_parse_watts(energy_form_field(body, "power_w"))
    if power == 0 {
        power = current_rows[0].powerW
    }
    var state: string = energy_trim(energy_form_field(body, "state"))
    if state == "" {
        state = current_rows[0].state
    }
    energy_ignore_result(UpdateLoadReading(power, state, i64(now), load_id, db))
    return load_id
}

fn energy_api_ingest(req: Request) Response {
    var body: string = request_body(req)
    var kind: string = energy_trim(energy_form_field(body, "type"))
    if kind == "" {
        if energy_form_field(body, "soc_pct") != "" {
            kind = "battery"
        } else {
            if energy_form_field(body, "import_w") != "" || energy_form_field(body, "export_w") != "" {
                kind = "grid"
            } else {
                if energy_form_field(body, "priority") != "" || energy_form_field(body, "critical") != "" {
                    kind = "load"
                } else {
                    kind = "source"
                }
            }
        }
    }
    var opened: Result[SqlDb, string] = energy_open_db()
    if !opened.is_ok {
        return json(500, "{\"ok\":false,\"error\":\"store unavailable\"}")
    }
    var db: SqlDb = opened.ok
    var now: u32 = energy_now()
    var id: i64 = 0
    if rho_str_eq(kind, "battery") {
        id = energy_api_battery_ingest(db, body, now)
    } else {
        if rho_str_eq(kind, "grid") {
            id = energy_api_grid_ingest(db, body, now)
        } else {
            if rho_str_eq(kind, "load") {
                id = energy_api_load_ingest(db, body, now)
            } else {
                id = energy_api_source_ingest(db, body, now)
            }
        }
    }
    if id == 0 {
        sql_close(db)
        return json(400, "{\"ok\":false,\"error\":\"name and at least one value are required\"}")
    }
    energy_control_tick(db, now)
    energy_evaluate_safety(db, now)
    energy_publish_live(db)
    sql_close(db)
    return json(status_ok(), "{\"ok\":true,\"type\":" + json_string(kind) + ",\"id\":" + energy_i64_to_str(id) + "}")
}

fn energy_sim_fault_valid(fault: string) bool {
    if fault == "" {
        return true
    }
    if rho_str_eq(fault, ENERGY_SIM_FAULT_PV_OVERVOLTAGE) {
        return true
    }
    if rho_str_eq(fault, ENERGY_SIM_FAULT_PV_OVERTEMP) {
        return true
    }
    if rho_str_eq(fault, ENERGY_SIM_FAULT_BATTERY_OVERTEMP) {
        return true
    }
    if rho_str_eq(fault, ENERGY_SIM_FAULT_BATTERY_LOW) {
        return true
    }
    if rho_str_eq(fault, ENERGY_SIM_FAULT_CELL_IMBALANCE) {
        return true
    }
    if rho_str_eq(fault, ENERGY_SIM_FAULT_GRID_OVERVOLTAGE) {
        return true
    }
    if rho_str_eq(fault, ENERGY_SIM_FAULT_GRID_UNDERVOLTAGE) {
        return true
    }
    if rho_str_eq(fault, ENERGY_SIM_FAULT_GRID_FREQUENCY) {
        return true
    }
    if rho_str_eq(fault, ENERGY_SIM_FAULT_ZERO_EXPORT) {
        return true
    }
    if rho_str_eq(fault, ENERGY_SIM_FAULT_GRID_OFFLINE) {
        return true
    }
    return false
}

fn energy_api_sim_fault(req: Request) Response {
    if !energy_driver_is_mock() {
        return json(403, "{\"ok\":false,\"error\":\"fault injection is available only in mock mode\"}")
    }
    var body: string = request_body(req)
    var fault: string = energy_trim(energy_form_field(body, "fault"))
    if rho_str_eq(fault, "none") {
        fault = ""
    }
    if !energy_sim_fault_valid(fault) {
        return json(400, "{\"ok\":false,\"error\":\"unknown fault\"}")
    }
    var opened: Result[SqlDb, string] = energy_open_db()
    if !opened.is_ok {
        return json(500, "{\"ok\":false,\"error\":\"store unavailable\"}")
    }
    var db: SqlDb = opened.ok
    var now: u32 = energy_now()
    energy_ignore_result(SetSimFault(fault, i64(now), db))
    if fault == "" {
        energy_ignore_result(InsertEvent("INFO", "simulator", "Scripted fault cleared", rho_int_to_str(now), db))
    } else {
        energy_ignore_result(InsertEvent("WARNING", "simulator", "Scripted fault presented: " + fault, rho_int_to_str(now), db))
    }
    energy_evaluate_safety(db, now)
    energy_publish_live(db)
    sql_close(db)
    return json(status_ok(), "{\"ok\":true,\"fault\":" + json_string(fault) + "}")
}
