        energy_ignore_result(InsertEvent("INFO", "grid", "Grid link " + name + " registered", rho_int_to_str(now), db))
        energy_evaluate_safety(db, now)
        energy_publish_live(db)
        sql_close(db)
    }
    return redirect("/grid")
}

