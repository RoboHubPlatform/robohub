    fields[4] = energy_field("bms_host", "text", "BMS address", "The BMS IPv4 address, or empty for a CAN-only bank.", "192.168.10.30", false, "ip", "", "", "")
    fields[5] = energy_field("mesh_source", "text", "Mesh source", "The Mesh source ID or URL for the bank's SoC in real-time mode.", "21", false, "", "", "", "")
