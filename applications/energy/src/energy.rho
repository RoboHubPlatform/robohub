    var now: u32 = energy_now()
    var opened: Result[SqlDb, string] = energy_open_db()
    if opened.is_ok {
        var db: SqlDb = opened.ok
        var rows: EnergyLoads[1]
        var slice: Slice[EnergyLoads] = Slice[EnergyLoads]{ Ptr[EnergyLoads](&rows[0]), 1 }
        var got: Result[u32, SqlError] = GetLoad(id, db, slice, 1)
        if got.is_ok {
            var state: string = rows[0].state
            var state_field: string = energy_form_field(body, "state")
            if state_field != "" {
                state = state_field
            }
            var shed: i64 = rows[0].shed
            var shed_field: string = energy_form_field(body, "shed")
            if shed_field != "" {
                shed = energy_bool_int(shed_field)
            }
            energy_ignore_result(UpdateLoadState(state, shed, i64(now), id, db))
            energy_ignore_result(InsertEvent("INFO", "load", rows[0].name + " set to " + state, rho_int_to_str(now), db))
            energy_publish_live(db)
        }
        sql_close(db)
    }
    return redirect("/loads")
}

