    fields[0] = energy_field("name", "text", "Load name", "What the circuit feeds.", "EV charger", true, "", "", "", "")
    fields[1] = energy_field("zone", "text", "Zone", "Where the load sits on the site.", "garage", false, "", "", "", "")
    fields[2] = energy_field("priority", "select", "Priority", "Priority 1 is never shed; priority 3 goes first.", "", true, "", "1|1 — life safety,2|2 — essential,3|3 — discretionary", "3", "")
    fields[3] = energy_field("power_w", "text", "Power (W)", "The load's running power.", "7000", true, "number", "", "", "decimal")
    fields[4] = energy_field("critical", "select", "Critical", "A critical load is never shed by the operator.", "", true, "", "0|No,1|Yes", "0", "")
