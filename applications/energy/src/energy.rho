fn energy_battery_rows(db: SqlDb, req: Request) string {
    var batteries: EnergyBatteries[32]
    var slice: Slice[EnergyBatteries] = Slice[EnergyBatteries]{ Ptr[EnergyBatteries](&batteries[0]), 128 }
    var rows: Result[u32, SqlError] = ListBatteries(db, slice, ENERGY_CAPACITY)
    var count: u32 = 0
    if rows.is_ok {
        count = rows.ok
    }
    var out: string = ""
    var i: u32 = 0
    while i < count {
        var cell_delta: i64 = batteries[i].cellMaxMv - batteries[i].cellMinMv
        out = out + template_fill(template_get("battery-row"), vars("id", energy_i64_to_str(batteries[i].id)) + vars("name", escape_html(batteries[i].name)) + vars("chemistry", escape_html(batteries[i].chemistry)) + vars("capacity", energy_format_wh(batteries[i].capacityWh)) + vars("soc", energy_format_soc(batteries[i].socMilli)) + vars("soh", energy_format_soc(batteries[i].sohMilli)) + vars("voltage", energy_format_volts(batteries[i].voltageMv)) + vars("current", energy_format_amps(batteries[i].currentMa)) + vars("temperature", energy_format_temp(batteries[i].temperatureMc)) + vars("cell_min", energy_i64_to_str(batteries[i].cellMinMv)) + vars("cell_max", energy_i64_to_str(batteries[i].cellMaxMv)) + vars("cell_delta", energy_i64_to_str(cell_delta)) + vars("can_profile", escape_html(batteries[i].canProfile)) + vars("bms_host", escape_html(batteries[i].bmsHost)) + vars("status", escape_html(batteries[i].status)) + vars("status_css", energy_status_class(batteries[i].status)) + vars("updated", energy_date(u32(batteries[i].updatedEpoch))) + vars("csrf", forms_csrf_field()) + i18n_vars(req))
        i = i + 1
    }
    if out == "" {
        out = "<tr><td colspan=\"9\">No battery banks registered.</td></tr>"
    }
    return out
}

