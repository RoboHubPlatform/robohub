module keeper.microapps

// The keeper's application module registry.
//
// A module under modules/ is a small application with a backend and pages of
// its own. modules/registry.yml is the installed set; this page confirms each
// path, links to the running module, starts and stops it, and installs or
// removes one. The inventory tracker is the first module.

import std.web.http
import std.web.template
import rho.log

fn micro_apps_root() string {
    return robohub_root() + "/modules"
}

fn micro_apps_file() string {
    return micro_apps_root() + "/registry.yml"
}

fn micro_app_manifest(name: string, location: string) string {
    return micro_apps_root() + "/" + location + "/module.yml"
}

fn micro_app_entries() string {
    let path: string = micro_apps_file()
    if !rho_path_exists(path) {
        return ""
    }
    let text: string = rho_read_text(path)
    var out: string = ""
    var name: string = ""
    var location: string = ""
    var enabled: string = "true"
    var i: u32 = 0
    while i < u32(rho_strlen(text)) {
        let at: i32 = rho_str_index_of(
            rho_str_slice(text, i, u32(rho_strlen(text)) - i), "\n")
        let end: u32 = u32(rho_strlen(text))
        if at >= 0 {
            end = i + u32(at)
        }
        let line: string = rho_str_slice(text, i, end - i)
        let trimmed: string = trim(line)
        if rho_str_index_of(trimmed, "- name:") == 0 {
            if name != "" {
                out = out + name + "|" + location + "|" + enabled + "\n"
            }
            name = unquote(rho_str_slice(trimmed, 7,
                u32(rho_strlen(trimmed)) - 7))
            location = name
            enabled = "true"
        } else if rho_str_index_of(trimmed, "path:") == 0 {
            location = unquote(rho_str_slice(trimmed, 5,
                u32(rho_strlen(trimmed)) - 5))
        } else if rho_str_index_of(trimmed, "enabled:") == 0 {
            enabled = unquote(rho_str_slice(trimmed, 8,
                u32(rho_strlen(trimmed)) - 8))
        }
        i = end + 1
    }
    if name != "" {
        out = out + name + "|" + location + "|" + enabled + "\n"
    }
    return out
}

fn micro_app_add(name: string) bool {
    let path: string = micro_apps_file()
    let text: string = rho_read_text(path)
    if rho_str_index_of(text, "  - name: " + name + "\n") >= 0 {
        return true
    }
    var out: string = text
    if rho_strlen(out) == 0 {
        out = "modules:\n"
    }
    out = out + "  - name: " + name + "\n    path: " + name + "\n    enabled: true\n"
    return rho_write_text(path, out)
}

fn micro_app_remove_entry(name: string) bool {
    let path: string = micro_apps_file()
    let text: string = rho_read_text(path)
    var out: string = ""
    var skip: bool = false
    var rest: string = text
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        let trimmed: string = trim(line)
        if rho_str_index_of(trimmed, "- name:") == 0 {
            let found: string = unquote(rho_str_slice(trimmed, 7,
                u32(rho_strlen(trimmed)) - 7))
            skip = rho_str_eq(found, name)
        }
        if !skip {
            out = out + line + "\n"
        }
    }
    return rho_write_text(path, out)
}

fn micro_app_title(manifest: string, name: string) string {
    let title: string = yaml.value(manifest, "module_app.title")
    if title == "" {
        title = yaml.value(manifest, "application.title")
    }
    if title == "" {
        title = name
    }
    return title
}

fn micro_app_description(manifest: string) string {
    let description: string = yaml.value(manifest, "module_app.description")
    if description == "" {
        description = yaml.value(manifest, "module.description")
    }
    if description == ">" {
        description = ""
    }
    return description
}

// micro_app_instance_entries reads an application's app_modules block:
//   name|route|enabled
fn micro_app_instance_entries(manifest: string) string {
    let text: string = rho_read_text(manifest)
    let start: i32 = rho_str_index_of(text, "\napp_modules:\n")
    if start < 0 {
        return ""
    }
    var out: string = ""
    var name: string = ""
    var prefix: string = ""
    var enabled: string = "true"
    var i: u32 = u32(start) + 13
    while i < u32(rho_strlen(text)) {
        let at: i32 = rho_str_index_of(
            rho_str_slice(text, i, u32(rho_strlen(text)) - i), "\n")
        let end: u32 = u32(rho_strlen(text))
        if at >= 0 {
            end = i + u32(at)
        }
        let line: string = rho_str_slice(text, i, end - i)
        let trimmed: string = trim(line)
        if plugin_indent(line) == 0 && !rho_str_eq(trimmed, "app_modules:") {
            break
        }
        if rho_str_index_of(trimmed, "- name:") == 0 {
            if name != "" {
                out = out + name + "|" + prefix + "|" + enabled + "\n"
            }
            name = unquote(rho_str_slice(trimmed, 7, u32(rho_strlen(trimmed)) - 7))
            prefix = ""
            enabled = "true"
        } else if rho_str_index_of(trimmed, "route:") == 0 {
            prefix = unquote(rho_str_slice(trimmed, 6,
                u32(rho_strlen(trimmed)) - 6))
        } else if rho_str_index_of(trimmed, "enabled:") == 0 {
            enabled = unquote(rho_str_slice(trimmed, 8,
                u32(rho_strlen(trimmed)) - 8))
        }
        i = end + 1
    }
    if name != "" {
        out = out + name + "|" + prefix + "|" + enabled + "\n"
    }
    return out
}

// find_micro_app_host answers the first application that includes the module:
//   application|port|route
fn find_micro_app_host(module_name: string) string {
    let dir: string = applications_dir()
    if !rho_path_exists(dir) {
        return ""
    }
    let report: string = apps_report("list-micro-app-hosts")
    ignore_u32(rho_exec("ls", dir, report))
    var rest: string = rho_read_text(report)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let app_name: string = ""
        if at < 0 {
            app_name = rest
            rest = ""
        } else {
            app_name = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if app_name == "" {
            continue
        }
        let manifest: string = dir + "/" + app_name + "/module.yml"
        if !rho_path_exists(manifest) {
            continue
        }
        let entries: string = micro_app_instance_entries(manifest)
        var members: string = entries
        while members != "" {
            let nl: i32 = rho_str_index_of(members, "\n")
            let line: string = ""
            if nl < 0 {
                line = members
                members = ""
            } else {
                line = rho_str_slice(members, 0, u32(nl))
                members = rho_str_slice(members, u32(nl) + 1,
                    u32(rho_strlen(members)) - u32(nl) - 1)
            }
            if line == "" || !rho_str_eq(field(line, 0), module_name) ||
                !rho_str_eq(field(line, 2), "true") {
                continue
            }
            let port: string = yaml.value(manifest, "application.port")
            if port == "" {
                continue
            }
            return app_name + "|" + port + "|" + field(line, 1)
        }
    }
    return ""
}

fn micro_app_actions(name: string, location: string, enabled: bool) string {
    let instance: string = find_micro_app_host(name)
    var out: string = ""
    if instance != "" {
        out = "<a class=\"button app-open\" href=\"#\" data-app-port=\"" +
            escape_html(field(instance, 1)) + "\" data-app-route=\"" +
            escape_html(field(instance, 2)) + "\">Open in " +
            escape_html(field(instance, 0)) + "</a>"
    }
    out = out + " <form method=\"post\" action=\"/app-modules/uninstall\" " +
        "onsubmit=\"return confirm('Remove this module and its folder?');\">" +
        "<input type=\"hidden\" name=\"name\" value=\"" + escape_html(name) + "\">" +
        "<button type=\"submit\" class=\"danger\">Uninstall</button></form>"
    return out
}

fn micro_app_rows() string {
    var out: string = ""
    var rest: string = micro_app_entries()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let name: string = field(line, 0)
        let location: string = field(line, 1)
        let enabled: bool = rho_str_eq(field(line, 2), "true")
        let manifest: string = micro_app_manifest(name, location)
        var present: bool = rho_path_exists(manifest)
        var status: string = "<span class=\"app-status status-running\">installed</span>"
        if !present {
            status = "<span class=\"app-status status-not-built\">missing</span>"
        }
        var title: string = name
        var description: string = "not found on disk"
        var category: string = ""
        var version: string = ""
        var host: string = ""
        if present {
            title = micro_app_title(manifest, name)
            description = micro_app_description(manifest)
            category = yaml.value(manifest, "module_app.category")
            version = yaml.value(manifest, "module.version")
            let instance: string = find_micro_app_host(name)
            if instance != "" {
                host = field(instance, 0)
            }
        }
        out = out + template_fill(template_get("microapp-row"),
            vars("name", escape_html(name)) +
            vars("title", escape_html(title)) +
            vars("category", escape_html(category)) +
            vars("description", escape_html(description)) +
            vars("version", escape_html(version)) +
            vars("host", escape_html(host)) +
            vars("status", status) +
            vars("actions", micro_app_actions(name, location, enabled)))
    }
    if out == "" {
        out = "<tr><td colspan=\"7\">No modules were found under modules/.</td></tr>"
    }
    return out
}

fn micro_apps_page_message(message: string) Response {
    let notice: string = ""
    if message != "" {
        notice = "<p class=\"notice\">" + escape_html(message) + "</p>"
    }
    let body: string = template_fill(template_get("microapps"),
        vars("notice", notice) + vars("rows", micro_app_rows()))
    return page("Modules", body)
}

fn micro_apps_page(req: Request) Response {
    return micro_apps_page_message("")
}

fn micro_apps_install(req: Request) Response {
    let body: string = request_body(req)
    var name: string = trim(form_value(body, "name"))
    let source: string = trim(form_value(body, "source"))
    if source == "" {
        return micro_apps_page_message("Name a module to install.")
    }
    if name == "" {
        name = plugin_source_name(source)
    }
    if !valid_name(name) {
        return micro_apps_page_message("The module name can use letters, digits, '-', '_' and '.' only.")
    }
    let target: string = micro_apps_root() + "/" + name
    if rho_path_exists(target) {
        return micro_apps_page_message(name + " is already installed.")
    }
    ignore_u32(rho_exec("mkdir", "-p " + micro_apps_root(), apps_report("mkdir-micro-apps")))
    var code: u32 = 0
    if source_is_git(source) {
        code = rho_exec("git", "clone " + arg_quote(source) + " " + arg_quote(target),
            apps_report("install-module-" + name))
    } else {
        let path: string = resolve_path(source)
        if !rho_path_exists(path + "/module.yml") {
            return micro_apps_page_message("No module.yml at " + path + ".")
        }
        code = rho_exec("cp", "-r " + arg_quote(path) + " " + arg_quote(target),
            apps_report("install-module-" + name))
    }
    if code != 0 {
        return micro_apps_page_message("Could not install " + source + ".")
    }
    if yaml.value(target + "/module.yml", "module_app.title") == "" {
        ignore_u32(rho_exec("rm", "-rf " + arg_quote(target),
            apps_report("remove-not-module")))
        return micro_apps_page_message(source + " is not a module.")
    }
    ignore_bool(micro_app_add(name))
    info("keeper", "installed module " + name)
    return micro_apps_page_message(name + " was installed.")
}

fn micro_apps_uninstall(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    if !valid_name(name) {
        return micro_apps_page_message("No such module: " + name)
    }
    let location: string = name
    var rest: string = micro_app_entries()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if rho_str_eq(field(line, 0), name) {
            location = field(line, 1)
        }
    }
    let target: string = micro_apps_root() + "/" + location
    ignore_string(app_stop(name))
    ignore_bool(micro_app_remove_entry(name))
    ignore_u32(rho_exec("rm", "-rf " + arg_quote(target),
        apps_report("uninstall-module-" + name)))
    info("keeper", "uninstalled module " + name)
    return micro_apps_page_message(name + " was uninstalled.")
}
