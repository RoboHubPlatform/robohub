module keeper.apps

// The applications registry.
//
// A module that declares an `application` block in its manifest is an
// application the keeper can list, open and — when it is `keeper-hosted` —
// start, stop and remove. The registry is read from the tree on every request,
// so an application that is built beside the keeper appears without a rebuild.
//
// An application that lives outside `applications/` is registered by path in
// the keeper's state directory. The same file records which applications were
// added to the keeper's own left menu.

import std.web.http
import std.web.template
import rho.log

const APPLICATIONS_DIR_NAME: string = "applications"

/* -------------------------------------------------------------------------- */
/*  State                                                                     */
/* -------------------------------------------------------------------------- */

fn applications_state_file() string {
    return keeper_state_dir() + "/applications.txt"
}

fn menu_state_file() string {
    return keeper_state_dir() + "/menu.txt"
}

fn applications_dir() string {
    return robohub_root() + "/" + APPLICATIONS_DIR_NAME
}

fn manifest_of(path: string) string {
    return path + "/module.yml"
}

fn record(name: string, path: string, origin: string) string {
    return name + "\t" + path + "\t" + origin + "\n"
}

fn modules_dir() string {
    return robohub_root() + "/modules"
}

fn records_in(dir: string, origin: string, report_name: string) string {
    if !rho_path_exists(dir) {
        return ""
    }
    let report: string = apps_report(report_name)
    ignore_u32(rho_exec("ls", dir, report))
    var out: string = ""
    var rest: string = rho_read_text(report)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let name: string = ""
        if at < 0 {
            name = rest
            rest = ""
        } else {
            name = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if name == "" {
            continue
        }
        let path: string = dir + "/" + name
        if rho_path_exists(manifest_of(path)) &&
            (yaml.value(manifest_of(path), "module.kind") != "" || yaml.value(manifest_of(path), "application.kind") != "") {
            out = out + record(name, path, origin)
        }
    }
    return out
}

fn bundled_records() string {
    return records_in(applications_dir(), "bundled", "list-applications")
}

fn external_records() string {
    var out: string = ""
    var rest: string = rho_read_text(applications_state_file())
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab < 0 {
            continue
        }
        let name: string = rho_str_slice(line, 0, u32(tab))
        let path: string = rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        if name == "" || path == "" {
            continue
        }
        if rho_path_exists(manifest_of(path)) &&
            (yaml.value(manifest_of(path), "module.kind") != "" || yaml.value(manifest_of(path), "application.kind") != "") {
            out = out + record(name, path, "external")
        }
    }
    return out
}

fn application_records() string {
    ensure_keeper_state()
    return bundled_records() + external_records()
}

fn record_path(records: string, wanted: string) string {
    var rest: string = records
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab < 0 {
            continue
        }
        let name: string = rho_str_slice(line, 0, u32(tab))
        if name != wanted {
            continue
        }
        let tail: string = rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        let tab2: i32 = rho_str_index_of(tail, "\t")
        if tab2 < 0 {
            return tail
        }
        return rho_str_slice(tail, 0, u32(tab2))
    }
    return ""
}

fn record_origin(records: string, wanted: string) string {
    var rest: string = records
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab < 0 {
            continue
        }
        let name: string = rho_str_slice(line, 0, u32(tab))
        if name != wanted {
            continue
        }
        let tail: string = rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        let tab2: i32 = rho_str_index_of(tail, "\t")
        if tab2 < 0 {
            return "bundled"
        }
        return rho_str_slice(tail, u32(tab2) + 1, u32(rho_strlen(tail)) - u32(tab2) - 1)
    }
    return ""
}

fn app_path(name: string) string {
    return record_path(application_records(), name)
}

fn app_kind(path: string) string {
    let k: string = yaml.value(manifest_of(path), "module.kind")
    if k == "" {
        k = yaml.value(manifest_of(path), "application.kind")
    }
    return k
}

fn app_title(name: string, path: string) string {
    let title: string = yaml.value(manifest_of(path), "module.title")
    if title == "" {
        title = yaml.value(manifest_of(path), "application.title")
    }
    if title == "" {
        return name
    }
    return title
}


// app_depends returns the list of applications this app requires to be running
// before it can start, as declared in its module.yml deploy block.
fn app_depends(name: string, path: string) string {
    let raw: string = yaml.value(path + "/module.yml", "deploy.depends")
    if raw == "" { return "" }
    var out: string = ""
    var rest: string = raw
    if rho_str_starts_with(rest, "[") {
        rest = rho_str_slice(rest, 1, u32(rho_strlen(rest)) - 2)
    }
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, ",")
        var token: string = rest
        if at < 0 { rest = "" } else { token = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
        token = trim(token)
        if rho_str_starts_with(token, "\"") && rho_str_slice(token, u32(rho_strlen(token)) - 1, 1) == "\"" {
            token = rho_str_slice(token, 1, u32(rho_strlen(token)) - 2)
        }
        if token == "" { continue }
        out = out + token + "\n"
    }
    return out
}

fn app_port(path: string) string {
    let port: string = yaml.value(manifest_of(path), "module.port")
    if port == "" {
        port = yaml.value(manifest_of(path), "application.port")
    }
    if port != "" { return port }
    return yaml.value(manifest_of(path), "deploy.port")
}

fn app_route(path: string) string {
    let address: string = yaml.value(manifest_of(path), "module.route")
    if address == "" {
        address = yaml.value(manifest_of(path), "application.route")
    }
    if address == "" {
        return "/"
    }
    return address
}

fn app_command(name: string, path: string) string {
    let command: string = yaml.value(manifest_of(path), "module.command")
    if command == "" {
        command = yaml.value(manifest_of(path), "application.command")
    }
    if command == "" {
        return name
    }
    return command
}

fn app_version(path: string) string {
    return yaml.value(manifest_of(path), "module.version")
}

/* -------------------------------------------------------------------------- */
/*  Running and menu state                                                    */
/* -------------------------------------------------------------------------- */

fn port_answers(port: string, path: string) bool {
    if port == "" {
        return false
    }
    let report: string = apps_report("probe-" + port)
    let code: u32 = rho_exec("curl",
        "-fsS -m 1 -o /dev/null http://127.0.0.1:" + port + path, report)
    return code == 0
}

fn app_binary(name: string, path: string) string {
    return path + "/build/" + app_command(name, path)
}

fn app_running(name: string, path: string) bool {
    if app_kind(path) == "keeper" {
        return true
    }
    return port_answers(app_port(path), app_route(path))
}

fn app_unit_path(name: string) string {
    let home: string = getenv("HOME")
    return home + "/.config/systemd/user/" + name + ".service"
}

fn app_has_unit(name: string) bool {
    return rho_path_exists(app_unit_path(name))
}

fn app_systemctl(verb: string, name: string) u32 {
    return rho_exec("systemctl", "--user " + verb + " " + name,
        apps_report("systemctl-" + verb + "-" + name))
}

fn app_remove_unit(name: string) void {
    if !app_has_unit(name) {
        return
    }
    ignore_u32(app_systemctl("disable", name))
    ignore_u32(app_systemctl("stop", name))
    ignore_u32(rho_exec("rm", "-f " + arg_quote(app_unit_path(name)),
        apps_report("remove-unit-" + name)))
    ignore_u32(rho_exec("systemctl", "--user daemon-reload",
        apps_report("daemon-reload-" + name)))
}

fn app_deploy_service(name: string, path: string) string {
    let script: string = robohub_root() + "/scripts/deploy-app.sh"
    if !rho_path_exists(script) {
        return "its deploy script is missing"
    }
    let log: string = apps_report("deploy-" + name)
    let code: u32 = rho_exec("bash", script + " " + arg_quote(name) + " " + arg_quote(path), log)
    if code != 0 {
        return "its service did not start; see " + log
    }
    return ""
}

fn pinned(name: string) bool {
    return line_in_list(rho_read_text(menu_state_file()), name)
}

fn pin(name: string) void {
    ignore_bool(rho_write_text(menu_state_file(),
        list_add(rho_read_text(menu_state_file()), name)))
}

fn unpin(name: string) void {
    ignore_bool(rho_write_text(menu_state_file(),
        list_remove(rho_read_text(menu_state_file()), name)))
}

fn register_external(name: string, path: string) void {
    let current: string = rho_read_text(applications_state_file())
    ignore_bool(rho_write_text(applications_state_file(),
        list_add(current, name + "\t" + path)))
}

fn unregister_external(name: string) void {
    var out: string = ""
    var rest: string = rho_read_text(applications_state_file()) + "\n"
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        if at < 0 {
            break
        }
        let line: string = rho_str_slice(rest, 0, u32(at))
        rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        if line == "" {
            continue
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab >= 0 && rho_str_slice(line, 0, u32(tab)) == name {
            continue
        }
        out = out + line + "\n"
    }
    ignore_bool(rho_write_text(applications_state_file(), out))
}

/* -------------------------------------------------------------------------- */
/*  Pages                                                                     */
/* -------------------------------------------------------------------------- */

fn page(req: Request, title: string, content: string) Response {
    return page_status(req, status_ok(), title, content)
}

fn page_status(req: Request, status: u32, title: string, content: string) Response {
    let document: string = template_fill(template_get("layout"),
        vars("title", title) + vars("htmx", htmx_head()) + i18n_vars(req) + vars("nav", keeper_nav(req)) + vars("body", content))
    return html(status, document)
}

fn keeper_nav(req: Request) string {
    var out: string = ""
    out = out + "<li><a href=\"/\" data-nav=\"home\"><span class=\"ico\">◱</span>" + i18n_t(req, "nav.home") + "</a></li>"
    out = out + "<li><a href=\"/modules\" data-nav=\"registry\"><span class=\"ico\">▤</span>" + i18n_t(req, "nav.registry") + "</a></li>"
    // Applications is the one place an application, its modules and its
    // plugins are found. The current application is the first sub-item; the
    // pinned applications follow it.
    out = out + "<li class=\"nav-group\"><a href=\"/applications\" data-nav=\"applications\">" +
        "<span class=\"ico\">▩</span>" + i18n_t(req, "nav.applications") + "</a><ul class=\"subnav\">" +
        "<li><a href=\"/\"><span class=\"ico\">▩</span>" + i18n_t(req, "nav.application") + "</a></li>" +
        pinned_nav() +
        "<li><a href=\"/app-modules\"><span class=\"ico\">▧</span>" + i18n_t(req, "nav.app_modules") + "</a></li>" +
        "<li><a href=\"/plugins\"><span class=\"ico\">⚙</span>" + i18n_t(req, "nav.plugins") + "</a></li>" +
        "<li><a href=\"/providers\"><span class=\"ico\">◇</span>" + i18n_t(req, "nav.providers") + "</a></li>" +
        "</ul></li>"
    out = out + "<li><a href=\"/auth/token\" data-nav=\"auth\"><span class=\"ico\">⚿</span>" + i18n_t(req, "nav.access_token") + "</a></li>"
    out = out + "<li><a href=\"/docs\" data-nav=\"docs\"><span class=\"ico\">▦</span>" + i18n_t(req, "nav.docs") + "</a></li>"
    out = out + "<li><a href=\"/settings\" data-nav=\"settings\"><span class=\"ico\">⚙</span>" + i18n_t(req, "nav.settings") + "</a></li>"
    out = out + "<li><a href=\"/system\" data-nav=\"system\"><span class=\"ico\">⌘</span>" + i18n_t(req, "nav.system") + "</a></li>"
    return out
}

fn pinned_nav() string {
    var out: string = ""
    var rest: string = rho_read_text(menu_state_file())
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let name: string = ""
        if at < 0 {
            name = rest
            rest = ""
        } else {
            name = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if name == "" {
            continue
        }
        let path: string = app_path(name)
        if path == "" {
            continue
        }
        let title: string = app_title(name, path)
        let icon: string = "<span class=\"ico\">▸</span>"
        if app_kind(path) == "keeper" {
            out = out + "<li><a href=\"/\">" + icon +
                escape_html(title) + "</a></li>"
        } else {
            out = out + "<li><a href=\"#\" class=\"app-open\" data-app-port=\"" +
                escape_html(app_port(path)) + "\" data-app-route=\"" +
                escape_html(app_route(path)) + "\">" + icon +
                escape_html(title) + "</a></li>"
        }
    }
    return out
}

fn open_link(path: string) string {
    if app_kind(path) == "keeper" {
        return "<a class=\"button quiet\" href=\"/\">Open</a>"
    }
    return "<a class=\"button app-open\" href=\"#\" data-app-port=\"" +
        escape_html(app_port(path)) + "\" data-app-route=\"" +
        escape_html(app_route(path)) + "\">Open</a>"
}

fn app_actions(name: string, path: string, origin: string) string {
    let hint: string = ""
    if origin == "bundled" {
        hint = "Delete this application's folder; a module you clone again is installed again."
    } else if origin == "external" {
        hint = "Remove it from the registry; the folder it lives in is left alone."
    }
    let running: string = ""
    if app_running(name, path) {
        running = "true"
    }
    let pinned_flag: string = ""
    if pinned(name) {
        pinned_flag = "true"
    }
    let is_keeper: string = ""
    if app_kind(path) == "keeper" {
        is_keeper = "true"
    }
    return template_fill(template_get("app-actions"),
        vars("open", open_link(path)) +
        vars("name", name) +
        vars("origin", origin) +
        vars("hint", hint) +
        vars("running", running) +
        vars("pinned", pinned_flag) +
        vars("is_keeper", is_keeper))
}

fn app_status(tone: string, label: string) string {
    return template_fill(template_get("status"), vars("tone", tone) + vars("label", label))
}

fn application_status(name: string, path: string) string {
    if app_kind(path) == "keeper" {
        return app_status("running", "this keeper")
    }
    if !rho_path_exists(app_binary(name, path)) {
        return app_status("not-built", "not built")
    }
    if app_running(name, path) {
        return app_status("running", "running")
    }
    return app_status("stopped", "stopped")
}

fn application_row_html(name: string, path: string, origin: string) string {
    return template_fill(template_get("application-row"),
        vars("name", name) +
        vars("title", app_title(name, path)) +
        vars("kind", app_kind(path)) +
        vars("version", app_version(path)) +
        vars("path", path) +
        vars("status", application_status(name, path)) +
        vars("actions", app_actions(name, path, origin)))
}

fn applications_rows() string {
    let records: string = application_records()
    var out: string = ""
    var rest: string = records
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab < 0 {
            continue
        }
        let name: string = rho_str_slice(line, 0, u32(tab))
        let tail: string = rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        let tab2: i32 = rho_str_index_of(tail, "\t")
        if tab2 < 0 {
            continue
        }
        let path: string = rho_str_slice(tail, 0, u32(tab2))
        let origin: string = rho_str_slice(tail, u32(tab2) + 1, u32(rho_strlen(tail)) - u32(tab2) - 1)
        out = out + application_row_html(name, path, origin) + "\n"
    }
    if out == "" {
        out = "<tr><td colspan=\"6\">No applications declare an <code>application</code> block yet.</td></tr>"
    }
    return out
}

fn applications_rows_endpoint(req: Request) Response {
    return html(status_ok(), applications_rows())
}

fn applications_page_message(req: Request, message: string) Response {
    let notice: string = ""
    if message != "" {
        notice = template_fill(template_get("notice"), vars("message", message))
    }
    let body: string = template_fill(template_get("applications"),
        vars("notice", notice) + vars("rows", applications_rows()))
    return page(req, i18n_t(req, "page.applications"), body)
}

fn applications_page(req: Request) Response {
    return applications_page_message(req, "")
}

/* -------------------------------------------------------------------------- */
/*  Actions                                                                   */
/* -------------------------------------------------------------------------- */




fn applications_menu(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    let wanted: string = form_value(body, "pinned")
    if name == "" || app_path(name) == "" {
        return applications_page_message(req, "No such application: " + name)
    }
    if wanted == "0" {
        unpin(name)
        info("keeper", "removed " + name + " from the keeper menu")
        if htmx_is_request(req) {
            return application_row_response(name)
        }
        return applications_page_message(req, name + " is no longer in the keeper menu.")
    }
    pin(name)
    info("keeper", "added " + name + " to the keeper menu")
    if htmx_is_request(req) {
        return application_row_response(name)
    }
    return applications_page_message(req, name + " was added to the keeper menu.")
}

// The port this keeper listens on, said to a hosted application so it can
// offer a way back. RHO_HTTP_ADDR is `:8080`, `127.0.0.1:19090` or a bare port.
fn keeper_listen_port() string {
    let address: string = getenv("RHO_HTTP_ADDR")
    if address == "" {
        // Fall back to the keeper's own deploy.port; the deploy script sets
        // RHO_HTTP_ADDR, so this only matters for a keeper started by hand.
        return "19090"
    }
    var port: string = ""
    var rest: string = address
    while rho_strlen(rest) > 0 {
        let at: i32 = rho_str_index_of(rest, ":")
        if at < 0 {
            if port == "" {
                port = rest
            }
            break
        }
        port = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
    }
    if port == "" {
        return "8080"
    }
    return port
}

fn app_start(name: string) string {
    let path: string = app_path(name)
    if path == "" {
        return "No such application: " + name
    }
    if app_kind(path) == "keeper" {
        return "The keeper cannot start itself."
    }
    let binary: string = app_binary(name, path)
    if !rho_path_exists(binary) {
        return name + " is not built yet. Build it with: rho build " + path
    }
    let port: string = app_port(path)
    if port == "" {
        return name + " does not declare an application.port."
    }
    // Deploy dependencies first.
    let plan: string = app_depends(name, path)
    var plan_rest: string = plan
    while plan_rest != "" {
        let plan_at: i32 = rho_str_index_of(plan_rest, "\n")
        var dep_name: string = plan_rest
        if plan_at < 0 { plan_rest = "" } else { dep_name = rho_str_slice(plan_rest, 0, u32(plan_at)); plan_rest = rho_str_slice(plan_rest, u32(plan_at) + 1, u32(rho_strlen(plan_rest)) - u32(plan_at) - 1) }
        if dep_name == "" || dep_name == name { continue }
        let dep_path: string = app_path(dep_name)
        if dep_path == "" { continue }
        if !app_running(dep_name, dep_path) {
            let dep_msg: string = app_start(dep_name)
            if rho_str_index_of(dep_msg, "already on") < 0 && rho_str_index_of(dep_msg, "started") < 0 {
                return "dependency " + dep_name + " did not start: " + dep_msg
            }
        }
    }
    if port_answers(port, app_route(path)) {
        return name + " is already running on port " + port + "."
    }
    if app_has_unit(name) {
        let code: u32 = app_systemctl("start", name)
        if code != 0 {
            ignore_u32(keeper_alert("ERROR", "Application " + name + " could not start",
                "app=" + name))
            return "Could not start " + name + ". See " + apps_report("systemctl-start-" + name) + "."
        }
        info("keeper", "started application " + name + " through systemd")
        return name + " is starting on port " + port + "."
    }
    ignore_u32(rho_exec("mkdir", "-p " + path + "/build", apps_report("mkdir-app")))
    // The paths after `cd` are relative to the application folder, not to the
    // keeper's own working directory. The workspace is captured before the
    // move, so a hosted application reads the same registry the keeper does.
    // The value of an assignment is not field-split, so a path with spaces is
    // still one workspace. The subshell execs the application, so the pid the
    // keeper records is the application's, not a short-lived wrapper's, and the
    // stop action can end it.
    let pid_file: string = path + "/build/app.pid"
    let app_workspace: string = keeper_state_dir() + "/workspaces/" + name
    let app_manifest: string = path + "/module.yml"
    let script: string = "workspace=$(pwd); (cd " + shell_quote(path) +
        " && ROBOHUB_WORKSPACE=$workspace ROBOHUB_APP_WORKSPACE=" +
        shell_quote(app_workspace) + " ROBOHUB_APP_MANIFEST=" +
        shell_quote(app_manifest) + " RHO_KEEPER_PORT=" + keeper_listen_port() +
        " RHO_HTTP_ADDR=:" + port +
        " exec nohup ./build/" + app_command(name, path) +
        " > build/app.log 2>&1 < /dev/null) & echo $! > " + shell_quote(pid_file)
    let code: u32 = rho_exec("sh", "-c \"" + script + "\"", apps_report("start-" + name))
    if code != 0 {
        ignore_u32(keeper_alert("ERROR", "Application " + name + " could not start",
            "app=" + name))
        return "Could not start " + name + ". See " + apps_report("start-" + name) + "."
    }
    info("keeper", "started application " + name + " on port " + port)
    return name + " is starting on port " + port + "."
}

fn app_stop(name: string) string {
    let path: string = app_path(name)
    if path == "" {
        return "No such application: " + name
    }
    if app_kind(path) == "keeper" {
        return "The keeper cannot stop itself."
    }
    if app_has_unit(name) {
        let code: u32 = app_systemctl("stop", name)
        if code != 0 {
            return "Could not stop " + name + ". See " + apps_report("systemctl-stop-" + name) + "."
        }
        info("keeper", "stopped application " + name + " through systemd")
        return name + " was stopped."
    }
    let pid: string = first_line(rho_read_text(path + "/build/app.pid"))
    if pid == "" {
        return name + " has no pid; start it from this page so the keeper can stop it."
    }
    let code: u32 = rho_exec("kill", pid, apps_report("stop-" + name))
    ignore_bool(rho_write_text(path + "/build/app.pid", ""))
    if code != 0 {
        ignore_u32(keeper_alert("ERROR", "Application " + name + " could not stop",
            "app=" + name))
        return "Could not stop " + name + " (pid " + pid + "). See " + apps_report("stop-" + name) + "."
    }
    info("keeper", "stopped application " + name)
    return name + " was stopped."
}

// app_build runs "rho build ." in the application directory and returns the
// build log so the Update handler can check whether it succeeded.
fn app_build(name: string, path: string) string {
    let report: string = apps_report("build-" + name)
    ignore_u32(rho_exec("rm", "-rf " + arg_quote(path + "/build/generated"), report))
    ignore_u32(rho_exec("rho", "build " + path, report))
    return rho_read_text(report)
}

fn app_artifact_ends_with(value: string, suffix: string) bool {
    let length: u32 = u32(rho_strlen(suffix))
    if length == 0 { return true }
    if u32(rho_strlen(value)) < length { return false }
    return rho_str_eq(rho_str_slice(value, u32(rho_strlen(value)) - length, length), suffix)
}

fn app_artifact_dir(name: string) string {
    return keeper_state_dir() + "/artifacts/" + name
}

fn app_artifact_incoming_dir() string {
    return keeper_state_dir() + "/incoming"
}

fn app_artifact_value(text: string, key: string) string {
    let prefix: string = key + "="
    var rest: string = text
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 { rest = "" } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if rho_str_index_of(line, prefix) == 0 {
            return rho_str_slice(line, u32(rho_strlen(prefix)),
                u32(rho_strlen(line)) - u32(rho_strlen(prefix)))
        }
    }
    return ""
}

// app_artifact_incoming finds the newest staged archive for an application.
fn app_artifact_incoming(name: string) string {
    let report: string = apps_report("incoming-" + name)
    ignore_u32(rho_exec("ls", "-t " + app_artifact_incoming_dir(), report))
    var rest: string = rho_read_text(report)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 { rest = "" } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if rho_str_index_of(line, name + "-") == 0 || rho_str_eq(line, name + ".tar.gz") {
            return app_artifact_incoming_dir() + "/" + line
        }
    }
    return ""
}

fn app_artifact_verify(archive: string) u32 {
    let report: string = apps_report("artifact-verify")
    let key: string = getenv("ROBOHUB_ARTIFACT_PUBKEY")
    if key != "" {
        return rho_exec("rho", "artifact verify -pub " + arg_quote(key) + " " + arg_quote(archive), report)
    }
    // Checksum verification is always performed. Signature verification needs
    // the build key a deployment trusts; without it an unsigned artifact is
    // accepted only when the operator explicitly allows it.
    if rho_str_eq(getenv("ROBOHUB_ARTIFACT_ALLOW_UNSIGNED"), "1") {
        return rho_exec("rho", "artifact verify -allow-unsigned " + arg_quote(archive), report)
    }
    return rho_exec("rho", "artifact verify " + arg_quote(archive), report)
}

fn app_artifact_link(binary: string, target: string) void {
    let next: string = binary + ".next"
    ignore_u32(rho_exec("ln", "-sfn " + arg_quote(target) + " " + arg_quote(next),
        apps_report("artifact-link")))
    ignore_u32(rho_exec("mv", "-Tf " + arg_quote(next) + " " + arg_quote(binary),
        apps_report("artifact-swap")))
}

// app_update_artifact stages and swaps a signed artifact. "ok" means installed,
// "" means no artifact was staged, and anything else is the failure message.
fn app_update_artifact(name: string, path: string) string {
    let archive: string = app_artifact_incoming(name)
    if archive == "" {
        return ""
    }
    if app_artifact_verify(archive) != 0 {
        return "artifact verification failed; see " + apps_report("artifact-verify")
    }
    let inspectReport: string = apps_report("artifact-inspect")
    ignore_u32(rho_exec("rho", "artifact inspect " + arg_quote(archive), inspectReport))
    let inspected: string = rho_read_text(inspectReport)
    let version: string = app_artifact_value(inspected, "version")
    let entrypoint: string = app_artifact_value(inspected, "entrypoint")
    let service: string = app_artifact_value(inspected, "service")
    let health: string = app_artifact_value(inspected, "health")
    if version == "" || entrypoint == "" {
        return "artifact has no version or entrypoint"
    }
    if service != "" && !rho_str_eq(service, name) {
        return "artifact is for service " + service + ", not " + name
    }
    let destination: string = app_artifact_dir(name) + "/" + version
    ignore_u32(rho_exec("mkdir", "-p " + arg_quote(destination), apps_report("artifact-mkdir")))
    let extractReport: string = apps_report("artifact-extract")
    let extractArgs: string = "artifact verify -extract " + arg_quote(destination) + " "
    let pub: string = getenv("ROBOHUB_ARTIFACT_PUBKEY")
    if pub != "" {
        extractArgs = extractArgs + "-pub " + arg_quote(pub) + " "
    } else if rho_str_eq(getenv("ROBOHUB_ARTIFACT_ALLOW_UNSIGNED"), "1") {
        extractArgs = extractArgs + "-allow-unsigned "
    }
    if rho_exec("rho", extractArgs + arg_quote(archive), extractReport) != 0 {
        return "artifact could not be extracted; see " + extractReport
    }
    let binary: string = app_binary(name, path)
    var previous: string = ""
    if rho_path_exists(binary) {
        let linkReport: string = apps_report("artifact-readlink")
        ignore_u32(rho_exec("readlink", "-f " + arg_quote(binary), linkReport))
        previous = first_line(rho_read_text(linkReport))
        if previous == "" {
            previous = binary + ".pre-artifact"
            ignore_u32(rho_exec("mv", "-f " + arg_quote(binary) + " " + arg_quote(previous),
                apps_report("artifact-previous")))
        }
    }
    let target: string = destination + "/" + entrypoint
    if !rho_path_exists(target) {
        return "artifact entrypoint " + entrypoint + " is missing"
    }
    app_artifact_link(binary, target)
    if previous != "" {
        ignore_bool(rho_write_text(app_artifact_dir(name) + "/previous", previous + "\n"))
    }
    ignore_string(app_restart(name, path))
    let timeout: u32 = u32(rho_int_from_str(app_artifact_value(inspected, "health_timeout")))
    if timeout == 0 { timeout = 20 }
    let port: string = app_port(path)
    if health != "" && port != "" {
        var waited: u32 = 0
        var healthy: bool = false
        while waited < timeout {
            if rho_exec("curl", "-fsS --max-time 2 http://127.0.0.1:" + port + health,
                apps_report("artifact-health")) == 0 {
                healthy = true
                break
            }
            ignore_u32(rho_exec("sleep", "1", apps_report("artifact-wait")))
            waited = waited + 1
        }
        if !healthy {
            if previous != "" {
                app_artifact_link(binary, previous)
                ignore_string(app_restart(name, path))
                return "health check failed; " + name + " was rolled back"
            }
            return "health check failed; no previous artifact to restore"
        }
    }
    ignore_u32(rho_exec("mv", "-f " + arg_quote(archive) + " " +
        arg_quote(app_artifact_dir(name) + "/" + version + ".tar.gz"),
        apps_report("artifact-archive")))
    info("keeper", "deployed artifact " + name + " " + version)
    return "ok"
}

// app_update rebuilds, stops and restarts the application.
fn app_update(name: string, path: string) string {
    let artifact: string = app_update_artifact(name, path)
    if rho_str_eq(artifact, "ok") {
        return name + " was updated from a staged artifact."
    }
    if artifact != "" {
        return "artifact update failed: " + artifact
    }
    let build: string = app_build(name, path)
    if rho_str_index_of(build, "Generated project:") < 0 {
        return "build failed: " + build
    }
    ignore_string(app_stop(name))
    return app_start(name)
}

// app_restart stops and starts the application without rebuilding.
fn app_restart(name: string, path: string) string {
    if app_has_unit(name) {
        let code: u32 = app_systemctl("restart", name)
        if code != 0 {
            return "Could not restart " + name + ". See " + apps_report("systemctl-restart-" + name) + "."
        }
        info("keeper", "restarted application " + name + " through systemd")
        return name + " was restarted."
    }
    ignore_string(app_stop(name))
    return app_start(name)
}

fn application_row_response(name: string) Response {
    let path: string = app_path(name)
    if path == "" {
        return html(status_ok(), "")
    }
    let origin: string = record_origin(application_records(), name)
    return html(status_ok(), application_row_html(name, path, origin))
}

fn applications_start(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    let message: string = app_start(name)
    if htmx_is_request(req) {
        return application_row_response(name)
    }
    return applications_page_message(req, message)
}

fn applications_stop(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    let message: string = app_stop(name)
    if htmx_is_request(req) {
        return application_row_response(name)
    }
    return applications_page_message(req, message)
}

fn applications_update(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    if name == "" { return applications_page_message(req, "No name given") }
    let path: string = app_path(name)
    if path == "" { return applications_page_message(req, "Unknown application") }
    let result: string = app_update(name, path)
    if htmx_is_request(req) {
        return application_row_response(name)
    }
    if rho_str_index_of(result, "build failed:") >= 0 {
        return applications_page_message(req, escape_html(result))
    }
    return applications_page_message(req, "Updated " + escape_html(name))
}

fn applications_restart(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    if name == "" { return applications_page_message(req, "No name given") }
    let path: string = app_path(name)
    if path == "" { return applications_page_message(req, "Unknown application") }
    let result: string = app_restart(name, path)
    if htmx_is_request(req) {
        return application_row_response(name)
    }
    return applications_page_message(req, "Restarted " + escape_html(name))
}

fn applications_uninstall(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    let path: string = app_path(name)
    if path == "" {
        return applications_page_message(req, "No such application: " + name)
    }
    if app_kind(path) == "keeper" {
        return applications_page_message(req, "The keeper cannot uninstall itself.")
    }
    let origin: string = record_origin(application_records(), name)
    ignore_string(app_stop(name))
    app_remove_unit(name)
    unpin(name)
    if origin == "external" {
        unregister_external(name)
        info("keeper", "unregistered application " + name)
        if htmx_is_request(req) {
            return html(status_ok(), "")
        }
        return applications_page_message(req, name + " was removed from the registry.")
    }
    let dir: string = applications_dir()
    if rho_str_index_of(path, dir + "/") != 0 {
        unregister_external(name)
        if htmx_is_request(req) {
            return html(status_ok(), "")
        }
        return applications_page_message(req, name + " was removed from the registry.")
    }
    ignore_u32(rho_exec("rm", "-rf " + arg_quote(path), apps_report("uninstall-" + name)))
    info("keeper", "uninstalled application " + name)
    if htmx_is_request(req) {
        return html(status_ok(), "")
    }
    return applications_page_message(req, name + " was uninstalled.")
}

fn applications_install(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    let source: string = trim(form_value(body, "source"))
    let add_to_menu: string = form_value(body, "menu")
    if source == "" {
        return applications_page_message(req, "Name a location to install from.")
    }
    let is_git: bool = source_is_git(source)
    var path: string = ""
    if is_git {
        if name == "" {
            name = source_name(source)
        }
        if !valid_name(name) {
            return applications_page_message(req, "The application name can use letters, digits, '-', '_' and '.' only.")
        }
        path = applications_dir() + "/" + name
        if rho_path_exists(path) || app_path(name) != "" {
            return applications_page_message(req, name + " is already installed at " + path + ".")
        }
        ignore_u32(rho_exec("mkdir", "-p " + applications_dir(), apps_report("mkdir-apps")))
        let log: string = apps_report("install-" + name)
        let code: u32 = rho_exec("git", "clone " + arg_quote(source) + " " + arg_quote(path), log)
        if code != 0 {
            ignore_u32(keeper_alert("ERROR", "Application " + name + " could not be installed",
                "app=" + name))
            return applications_page_message(req, "Could not clone " + source + ". See " + log + ".")
        }
    } else {
        path = resolve_path(source)
        if !rho_path_exists(manifest_of(path)) {
            return applications_page_message(req, "No module.yml at " + path + ".")
        }
        if name == "" {
            name = yaml.value(manifest_of(path), "module.name")
        }
        if !valid_name(name) {
            return applications_page_message(req, "The application name can use letters, digits, '-', '_' and '.' only.")
        }
        let existing: string = app_path(name)
        if existing != "" && existing != path {
            return applications_page_message(req, name + " is already registered at " + existing + ".")
        }
        register_external(name, path)
    }
    let kind: string = app_kind(path)
    if kind != "keeper-hosted" {
        if is_git {
            ignore_u32(rho_exec("rm", "-rf " + arg_quote(path), apps_report("remove-not-hosted")))
        } else {
            unregister_external(name)
        }
        return applications_page_message(req, path + " is not a keeper-hosted application.")
    }
    if add_to_menu == "1" {
        pin(name)
    }
    let deploy_error: string = app_deploy_service(name, path)
    if deploy_error != "" {
        return applications_page_message(req, name + " was installed, but " + deploy_error + ".")
    }
    info("keeper", "installed application " + name + " from " + source)
    return applications_page_message(req, name + " was installed and its service started.")
}
