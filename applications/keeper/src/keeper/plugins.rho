module keeper.plugins

// The keeper's plugin registry.
//
// Two lists. The alert channels are the providers of the alert interface the
// keeper's module.yml binds: this page switches one on or off and sends a test
// through it, both through the interface. The plugins are Rho modules under the
// ecosystem's plugins/ directory: this page lists what is installed and what the
// keeper has enabled, and installs or removes one. Either change is this
// installation's only, so a source-controlled default is not edited by a
// dashboard.

import std.web.http
import std.web.template
import rho.log

fn plugin_state_set(name: string, enabled: string) void {
    let file: string = keeper_plugin_state_file()
    let text: string = rho_read_text(file)
    var out: string = ""
    var rest: string = text
    while rho_strlen(rest) > 0 {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let equals: i32 = rho_str_index_of(line, "=")
        if equals >= 0 && rho_str_eq(rho_str_slice(line, 0, u32(equals)), name) {
            continue
        }
        out = out + line + "\n"
    }
    out = out + name + "=" + enabled + "\n"
    ignore_bool(rho_write_text(file, out))
}

fn plugin_action_forms(name: string, enabled: bool) string {
    var enabled_flag: string = ""
    if enabled {
        enabled_flag = "true"
    }
    return template_fill(template_get("plugin-actions"),
        vars("name", name) +
        vars("enabled", enabled_flag))
}

fn plugin_row_line(line: string) string {
    let name: string = field(line, 0)
    let enabled: bool = keeper_plugin_enabled(name)
    var status: string = plugin_status("stopped", "disabled")
    if enabled {
        status = plugin_status("running", "enabled")
    }
    if field(line, 5) == "false" {
        status = plugin_status("not-built", "missing")
    }
    return template_fill(template_get("plugin-row"),
        vars("name", name) +
        vars("kind", field(line, 1)) +
        vars("transport", field(line, 2)) +
        vars("summary", field(line, 3)) +
        vars("status", status) +
        vars("actions", plugin_action_forms(name, enabled)))
}

fn plugin_row_html(name: string) string {
    var rest: string = plugin_rows(plugin_root())
    while rho_strlen(rest) > 0 {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if field(line, 0) == name {
            return plugin_row_line(line)
        }
    }
    return ""
}

fn plugin_rows_html() string {
    var out: string = ""
    var rest: string = plugin_rows(plugin_root())
    while rho_strlen(rest) > 0 {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line != "" {
            out = out + plugin_row_line(line)
        }
    }
    if out == "" {
        out = "<tr><td colspan=\"6\">No plugins were found under plugins/.</td></tr>"
    }
    return out
}

fn channel_row_html(name: string) string {
    let enabled: bool = alert.enabled(name)
    var enabled_flag: string = ""
    var status: string = plugin_status("stopped", "disabled")
    if enabled {
        enabled_flag = "true"
        status = plugin_status("running", "enabled")
    }
    var threshold: string = alert.config(name, "severity_threshold")
    if threshold == "" {
        threshold = "INFO"
    }
    return template_fill(template_get("channel-row"),
        vars("name", name) +
        vars("threshold", threshold) +
        vars("status", status) +
        vars("actions", template_fill(template_get("channel-actions"),
            vars("name", name) + vars("enabled", enabled_flag))))
}

fn channel_rows_html() string {
    var out: string = ""
    var rest: string = alert.providers()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var name: string = rest
        if at < 0 {
            rest = ""
        } else {
            name = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if name != "" {
            out = out + channel_row_html(name)
        }
    }
    if out == "" {
        out = "<tr><td colspan=\"4\">The keeper binds no alert channel.</td></tr>"
    }
    return out
}

fn plugin_status(tone: string, label: string) string {
    return template_fill(template_get("status"), vars("tone", tone) + vars("label", label))
}

fn plugins_page_message(req: Request, message: string) Response {
    let notice: string = ""
    if message != "" {
        notice = template_fill(template_get("notice"), vars("message", message))
    }
    let body: string = template_fill(template_get("plugins"),
        vars("notice", notice) + vars("channels", channel_rows_html()) +
        vars("rows", plugin_rows_html()) +
        vars("root", plugin_root()))
    return page(req, i18n_t(req, "page.plugins"), body)
}

fn plugins_page(req: Request) Response {
    return plugins_page_message(req, "")
}

fn plugins_toggle(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    let enabled: string = form_value(body, "enabled")
    if keeper_alert_bound(name) {
        var value: string = "true"
        if enabled == "0" {
            value = "false"
        }
        if !alert.configure(name, "enabled", value) {
            return plugins_page_message(req, "The setting for " + name + " could not be saved.")
        }
        info("keeper", "alert channel " + name + " enabled=" + value)
        if htmx_is_request(req) {
            return html(status_ok(), channel_row_html(name))
        }
        return plugins_page_message(req, name + " is " + value_word(value) + " for the keeper.")
    }
    if !valid_name(name) || !rho_path_exists(plugin_manifest(plugin_root(), name)) {
        return plugins_page_message(req, "No such plugin: " + name)
    }
    plugin_state_set(name, enabled)
    if enabled == "0" {
        info("keeper", "disabled plugin " + name)
        if htmx_is_request(req) {
            return html(status_ok(), plugin_row_html(name))
        }
        return plugins_page_message(req, name + " is disabled for the keeper.")
    }
    info("keeper", "enabled plugin " + name)
    if htmx_is_request(req) {
        return html(status_ok(), plugin_row_html(name))
    }
    return plugins_page_message(req, name + " is enabled for the keeper.")
}

fn plugins_test(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    if !keeper_alert_bound(name) {
        return plugins_page_message(req, "No such alert channel: " + name)
    }
    let sent: u32 = alert.test(name, "Test alert from the RoboHub keeper")
    if sent == 0 {
        return plugins_page_message(req, "The test alert through " + name +
            " was not delivered. Its settings are incomplete or its program failed.")
    }
    info("keeper", "sent a test alert through " + name)
    if htmx_is_request(req) {
        return html(status_ok(), channel_row_html(name))
    }
    return plugins_page_message(req, "The test alert was handed to " + name + ".")
}

fn value_word(value: string) string {
    if value == "false" {
        return "disabled"
    }
    return "enabled"
}

fn plugin_source_name(source: string) string {
    var tail: string = source
    let slash: i32 = rho_str_index_of(tail, "/")
    if slash >= 0 {
        var rest: string = tail
        var last: string = ""
        while rest != "" {
            let at: i32 = rho_str_index_of(rest, "/")
            if at < 0 {
                last = rest
                rest = ""
            } else {
                last = rho_str_slice(rest, 0, u32(at))
                rest = rho_str_slice(rest, u32(at) + 1,
                    u32(rho_strlen(rest)) - u32(at) - 1)
            }
        }
        tail = last
    }
    let suffix: i32 = rho_str_index_of(tail, ".git")
    if suffix >= 0 && u32(suffix) + 4 == u32(rho_strlen(tail)) {
        tail = rho_str_slice(tail, 0, u32(suffix))
    }
    return slug(tail)
}

fn plugins_install(req: Request) Response {
    let body: string = request_body(req)
    var name: string = trim(form_value(body, "name"))
    let source: string = trim(form_value(body, "source"))
    if source == "" {
        return plugins_page_message(req, "Name a plugin to install.")
    }
    if name == "" {
        name = plugin_source_name(source)
    }
    if !valid_name(name) {
        return plugins_page_message(req, "The plugin name can use letters, digits, '-', '_' and '.' only.")
    }
    let target: string = plugin_root() + "/" + name
    if rho_path_exists(target) {
        return plugins_page_message(req, name + " is already installed.")
    }
    ignore_u32(rho_exec("mkdir", "-p " + plugin_root(), apps_report("mkdir-plugins")))
    var code: u32 = 0
    if source_is_git(source) {
        code = rho_exec("git", "clone " + arg_quote(source) + " " + arg_quote(target),
            apps_report("install-plugin-" + name))
    } else {
        let path: string = resolve_path(source)
        if !rho_path_exists(path + "/module.yml") {
            return plugins_page_message(req, "No plugin module.yml at " + path + ".")
        }
        code = rho_exec("cp", "-r " + arg_quote(path) + " " + arg_quote(target),
            apps_report("install-plugin-" + name))
    }
    if code != 0 {
        return plugins_page_message(req, "Could not install " + source + ".")
    }
    // A plugin says what kind it is: `module.plugin_kind`, as every plugin here
    // is written, or a `plugin:` block.
    if plugin_field(target + "/module.yml", "kind") == "" {
        ignore_u32(rho_exec("rm", "-rf " + arg_quote(target), apps_report("remove-not-plugin")))
        return plugins_page_message(req, source + " is not a plugin module.")
    }
    ignore_bool(plugin_db_add(plugin_root(), name))
    info("keeper", "installed plugin " + name)
    return plugins_page_message(req, name + " was installed. It is disabled until enabled.")
}

fn plugins_uninstall(req: Request) Response {
    let body: string = request_body(req)
    let name: string = trim(form_value(body, "name"))
    if !valid_name(name) || !rho_path_exists(plugin_manifest(plugin_root(), name)) {
        return plugins_page_message(req, "No such plugin: " + name)
    }
    let target: string = plugin_root() + "/" + name
    ignore_bool(plugin_db_remove(plugin_root(), name))
    ignore_u32(rho_exec("rm", "-rf " + arg_quote(target), apps_report("uninstall-plugin-" + name)))
    info("keeper", "uninstalled plugin " + name)
    if htmx_is_request(req) {
        return html(status_ok(), "")
    }
    return plugins_page_message(req, name + " was uninstalled.")
}
