module keeper.alerts

// Where the keeper's plugins are, and how the keeper raises an alert. It lives
// apart from the plugins page so the application registry can raise an alert
// without depending on a page.

fn plugin_root() string {
    return robohub_root() + "/plugins"
}

fn keeper_manifest_path() string {
    if rho_path_exists("module.yml") &&
        yaml.value("module.yml", "module.name") == "keeper" {
        return "module.yml"
    }
    // The manifest the application was built from travels with it.
    let path: string = rho_asset_dir("keeper") + "/module.yml"
    if rho_path_exists(path) {
        return path
    }
    return ""
}

fn keeper_plugin_state_file() string {
    ensure_keeper_state()
    return keeper_state_dir() + "/plugins.txt"
}

// keeper_alert raises an alert through the alert interface: every channel the
// keeper binds in its module.yml, as configured on the Settings page.
fn keeper_alert(level: string, message: string, metadata: string) u32 {
    return alert.raise(level, message, metadata)
}

// keeper_alert_list is the bound channels as a comma-separated list.
fn keeper_alert_list() string {
    var out: string = ""
    var rest: string = alert.providers()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var name: string = rest
        if at < 0 {
            rest = ""
        } else {
            name = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if name != "" {
            if out != "" {
                out = out + ", "
            }
            out = out + name
        }
    }
    return out
}

// keeper_alert_bound is whether a channel is one the keeper binds.
fn keeper_alert_bound(name: string) bool {
    return name != "" && rho_str_index_of("\n" + alert.providers(), "\n" + name + "\n") >= 0
}
