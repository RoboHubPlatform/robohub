module keeper.settings

// The keeper's own runtime settings: the display preference and its alert
// channels' settings, which are the alert binding's. Build and deployment facts stay in module.yml and are only
// shown read-only on the Configuration tab.

fn keeper_settings_tab(req: Request) string {
    let tab: string = request_query_param(req, "tab")
    if tab == "" { return "general" }
    if rho_str_eq(tab, "alerts") || rho_str_eq(tab, "auth") ||
        rho_str_eq(tab, "logging") || rho_str_eq(tab, "configuration") {
        return tab
    }
    return "general"
}

fn keeper_settings_nav(req: Request, active: string) string {
    var out: string = "<nav class=\"vtabnav settings-tabs\">"
    let ids: string = "general,alerts,auth,logging,configuration"
    let keys: string = "settings.tab.general,settings.tab.alerts,settings.tab.auth,settings.tab.logging,settings.tab.configuration"
    while ids != "" {
        let id_at: i32 = rho_str_index_of(ids, ",")
        let key_at: i32 = rho_str_index_of(keys, ",")
        var id: string = ids
        var key: string = keys
        if id_at < 0 { ids = "" } else {
            id = rho_str_slice(ids, 0, u32(id_at))
            ids = rho_str_slice(ids, u32(id_at) + 1, u32(rho_strlen(ids)) - u32(id_at) - 1)
        }
        if key_at < 0 { keys = "" } else {
            key = rho_str_slice(keys, 0, u32(key_at))
            keys = rho_str_slice(keys, u32(key_at) + 1, u32(rho_strlen(keys)) - u32(key_at) - 1)
        }
        var css: string = ""
        if rho_str_eq(id, active) { css = " class=\"active\"" }
        out = out + "<a href=\"/settings?tab=" + id + "\"" + css + ">" + i18n_t(req, key) + "</a>"
    }
    return out + "</nav>"
}

// keeper_alert_enabled is a channel's on/off setting as the form shows it.
fn keeper_alert_enabled(provider: string) string {
    if alert.enabled(provider) {
        return "true"
    }
    return "false"
}

// keeper_alert_set records one field of the Alerts form as a channel's setting.
fn keeper_alert_set(body: string, provider: string, key: string, field: string) void {
    if !alert.configure(provider, key, trim(form_value(body, field))) {
        warn("keeper", "the alert setting " + provider + "." + key + " could not be saved")
    }
}

fn keeper_settings_form(req: Request, tab: string) string {
    if rho_str_eq(tab, "logging") {
        return log_settings_form("keeper", "/settings?tab=logging",
            i18n_locale(req))
    }
    if rho_str_eq(tab, "alerts") {
        // Each channel's settings are the binding's: the defaults in module.yml,
        // changed here for this installation.
        let on_off: string = "true|" + i18n_t(req, "settings.alerts.on") + ",false|" + i18n_t(req, "settings.alerts.off")
        let levels: string = "INFO|INFO,WARNING|WARNING,ERROR|ERROR,CRITICAL|CRITICAL"
        var fields: FormField[9]
        fields[0] = FormField{ "log_path", "text", i18n_t(req, "settings.alerts.log_path"), "",
            "~/.rho/keeper/alerts.log", false, "", "", alert.config("robohub-provider-log", "path"), "", "" }
        fields[1] = FormField{ "log_threshold", "select", i18n_t(req, "settings.alerts.threshold"), "",
            "", false, "", levels, alert.config("robohub-provider-log", "severity_threshold"), "", "" }
        fields[2] = FormField{ "email_enabled", "select", i18n_t(req, "settings.alerts.email_enabled"), "",
            "", false, "", on_off, keeper_alert_enabled("robohub-provider-email"), "", "" }
        fields[3] = FormField{ "email_to", "text", i18n_t(req, "settings.alerts.email_to"), "",
            "ops@example.com", false, "", "", alert.config("robohub-provider-email", "to_address"), "", "" }
        fields[4] = FormField{ "email_threshold", "select", i18n_t(req, "settings.alerts.email_threshold"), "",
            "", false, "", levels, alert.config("robohub-provider-email", "severity_threshold"), "", "" }
        fields[5] = FormField{ "telegram_enabled", "select", i18n_t(req, "settings.alerts.telegram_enabled"), "",
            "", false, "", on_off, keeper_alert_enabled("robohub-provider-telegram"), "", "" }
        fields[6] = FormField{ "telegram_chat", "text", i18n_t(req, "settings.alerts.telegram_chat"), "",
            "", false, "", "", alert.config("robohub-provider-telegram", "chat_id"), "", "" }
        fields[7] = FormField{ "telegram_token", "password", i18n_t(req, "settings.alerts.telegram_token"), "",
            "", false, "", "", alert.config("robohub-provider-telegram", "bot_token"), "", "" }
        fields[8] = FormField{ "telegram_threshold", "select", i18n_t(req, "settings.alerts.telegram_threshold"), "",
            "", false, "", levels, alert.config("robohub-provider-telegram", "severity_threshold"), "", "" }
        return forms_open(fields, 9, "/settings?tab=alerts",
            i18n_t(req, "settings.save"), i18n_locale(req))
    }
    if rho_str_eq(tab, "auth") {
        return "<h2>" + i18n_t(req, "settings.auth.heading") + "</h2>" +
            "<p>" + i18n_t(req, "settings.auth.body") + "</p>" +
            "<p><a href=\"/auth/token\">" + i18n_t(req, "settings.auth.token_link") + "</a></p>"
    }
    if rho_str_eq(tab, "configuration") {
        return "<dl class=\"settings\"><dt>Application</dt><dd>keeper</dd>" +
            "<dt>Route</dt><dd>/</dd><dt>Port</dt><dd>19090</dd>" +
            "<dt>Workspace</dt><dd><code>" + escape_html(robohub_root()) + "</code></dd>" +
            "<dt>Alert channels</dt><dd>" + escape_html(keeper_alert_list()) + "</dd>" +
            "<dt>Version</dt><dd>" + escape_html(yaml.value("module.yml", "module.version")) + "</dd></dl>"
    }
    var fields: FormField[1]
    fields[0] = FormField{ "tabs", "select", i18n_t(req, "settings.orientation"), "",
        "", false, "", "vertical|" + i18n_t(req, "settings.orientation.vertical") +
        ",horizontal|" + i18n_t(req, "settings.orientation.horizontal"),
        settings_get("ui.tabs", "vertical"), "", "" }
    return forms_open(fields, 1, "/settings?tab=general",
        i18n_t(req, "settings.save"), i18n_locale(req))
}

fn keeper_settings_page_message(req: Request, message: string) Response {
    let tab: string = keeper_settings_tab(req)
    var notice: string = ""
    if message != "" {
        notice = "<p class=\"notice\">" + escape_html(message) + "</p>"
    }
    let body: string = template_fill(template_get("settings"),
        i18n_vars(req) +
        vars("notice", notice) +
        vars("nav", keeper_settings_nav(req, tab)) +
        vars("tab_content", keeper_settings_form(req, tab)))
    return page(req, i18n_t(req, "page.settings"), body)
}

fn keeper_settings_page(req: Request) Response {
    return keeper_settings_page_message(req, "")
}

fn keeper_settings_save(req: Request) Response {
    let body: string = request_body(req)
    let tab: string = keeper_settings_tab(req)
    if !forms_csrf_ok(body) {
        return keeper_settings_page_message(req, i18n_t(req, "settings.csrf_refused"))
    }
    if rho_str_eq(tab, "logging") {
        if log_settings_save("keeper", body) {
            info("keeper", "logging settings updated")
        }
        return redirect("/settings?tab=logging")
    }
    if rho_str_eq(tab, "alerts") {
        keeper_alert_set(body, "robohub-provider-log", "path", "log_path")
        keeper_alert_set(body, "robohub-provider-log", "severity_threshold", "log_threshold")
        keeper_alert_set(body, "robohub-provider-email", "enabled", "email_enabled")
        keeper_alert_set(body, "robohub-provider-email", "to_address", "email_to")
        keeper_alert_set(body, "robohub-provider-email", "severity_threshold", "email_threshold")
        keeper_alert_set(body, "robohub-provider-telegram", "enabled", "telegram_enabled")
        keeper_alert_set(body, "robohub-provider-telegram", "chat_id", "telegram_chat")
        keeper_alert_set(body, "robohub-provider-telegram", "bot_token", "telegram_token")
        keeper_alert_set(body, "robohub-provider-telegram", "severity_threshold", "telegram_threshold")
        return redirect("/settings?tab=alerts")
    }
    settings_set("ui.tabs", trim(form_value(body, "tabs")))
    return redirect("/settings?tab=general")
}
