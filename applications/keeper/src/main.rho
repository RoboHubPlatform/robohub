module keeper

// The RoboHub keeper: a local dashboard for the ecosystem.

include "keeper/storage.rho"

import std.web.http
import std.web.template

/// The documentation tree the site is built from.
const DOCS_TREE: string = "build/doctree"

/// Where the built site is, which is what a page is served from when the store
/// has not built one of its own.
const DOCS_SITE: string = "build/site"

route GET "/" => home
route GET "/modules" => modules_page
route GET "/module/{name}" => module_page
route GET "/install" => install_page
route GET "/uninstall" => uninstall_page
route GET "/system" => system_page
route GET "/docs" => docs_page
route GET "/docs/{path...}" => doc_page

fn home(req: Request) Response {
    let body: string = template_fill(template_get("home"), vars("", ""))
    let page: string = template_fill(template_get("layout"), vars("title", "Home") + vars("body", body))
    return html(status_ok(), page)
}

fn modules_page(req: Request) Response {
    let rows: string = module_rows()
    let body: string = template_fill(template_get("modules"), vars("rows", rows))
    let page: string = template_fill(template_get("layout"), vars("title", "Modules") + vars("body", body))
    return html(status_ok(), page)
}

fn module_page(req: Request) Response {
    let name: string = param(req, "name")
    let entry: string = robohub_root() + "/registry/modules/" + name + ".yml"
    if !rho_path_exists(entry) {
        let body: string = template_fill(template_get("layout"), vars("title", "Not found") + vars("body", "<p>Unknown module: " + name + "</p><p><a href='/modules'>Back</a></p>"))
        return html(status_not_found(), body)
    }
    let role: string = yaml.value(entry, "role")
    let path: string = resolve_path(yaml.value(entry, "path"))
    let git: string = yaml.value(entry, "git")
    let summary: string = yaml.value(entry, "summary")
    let installed: string = "no"
    let version: string = ""
    if rho_path_exists(path + "/module.yml") {
        installed = "yes"
        version = yaml.value(path + "/module.yml", "module.version")
    }
    let info: string = template_fill(template_get("module-detail"), vars("name", name) + vars("version", version) + vars("role", role) + vars("path", path) + vars("git", git) + vars("summary", summary) + vars("installed", installed) + vars("docs_link", "<a href='/docs/" + name + "'>Documentation</a>"))
    let body: string = template_fill(template_get("layout"), vars("title", name) + vars("body", info))
    return html(status_ok(), body)
}

fn install_page(req: Request) Response {
    let name: string = param(req, "module")
    if name == "" {
        let body: string = template_fill(template_get("layout"), vars("title", "Install") + vars("body", "<p>No module specified.</p><p><a href='/modules'>Back</a></p>"))
        return html(status_bad_request(), body)
    }
    let entry: string = robohub_root() + "/registry/modules/" + name + ".yml"
    if !rho_path_exists(entry) {
        let body: string = template_fill(template_get("layout"), vars("title", "Install") + vars("body", "<p>Unknown module: " + name + "</p><p><a href='/modules'>Back</a></p>"))
        return html(status_not_found(), body)
    }
    let git_url: string = yaml.value(entry, "git")
    let path: string = resolve_path(yaml.value(entry, "path"))
    if rho_path_exists(path + "/module.yml") {
        let body: string = template_fill(template_get("layout"), vars("title", "Install") + vars("body", "<p>" + name + " is already installed.</p><p><a href='/modules'>Back</a></p>"))
        return html(status_ok(), body)
    }
    let output: string = "build/reports/clone-" + name + ".txt"
    let code: u32 = rho_exec("git", "clone " + git_url + " " + path, output)
    if code != 0 {
        let body: string = template_fill(template_get("layout"), vars("title", "Install") + vars("body", "<p>Failed to clone " + name + ".</p><p><a href='/modules'>Back</a></p>"))
        return html(status_internal(), body)
    }
    let body: string = template_fill(template_get("layout"), vars("title", "Install") + vars("body", "<p>Installed " + name + ".</p><p><a href='/modules'>Back</a></p>"))
    return html(status_created(), body)
}

fn uninstall_page(req: Request) Response {
    let name: string = param(req, "module")
    if name == "" {
        let body: string = template_fill(template_get("layout"), vars("title", "Uninstall") + vars("body", "<p>No module specified.</p><p><a href='/modules'>Back</a></p>"))
        return html(status_bad_request(), body)
    }
    let entry: string = robohub_root() + "/registry/modules/" + name + ".yml"
    if !rho_path_exists(entry) {
        let body: string = template_fill(template_get("layout"), vars("title", "Uninstall") + vars("body", "<p>Unknown module: " + name + "</p><p><a href='/modules'>Back</a></p>"))
        return html(status_not_found(), body)
    }
    let path: string = resolve_path(yaml.value(entry, "path"))
    if !rho_path_exists(path + "/module.yml") {
        let body: string = template_fill(template_get("layout"), vars("title", "Uninstall") + vars("body", "<p>" + name + " is not installed.</p><p><a href='/modules'>Back</a></p>"))
        return html(status_ok(), body)
    }
    let output: string = "build/reports/uninstall-" + name + ".txt"
    let code: u32 = rho_exec("rm", "-rf " + path, output)
    if code != 0 {
        let body: string = template_fill(template_get("layout"), vars("title", "Uninstall") + vars("body", "<p>Failed to uninstall " + name + ".</p><p><a href='/modules'>Back</a></p>"))
        return html(status_internal(), body)
    }
    let body: string = template_fill(template_get("layout"), vars("title", "Uninstall") + vars("body", "<p>Uninstalled " + name + ".</p><p><a href='/modules'>Back</a></p>"))
    return html(status_ok(), body)
}

fn system_page(req: Request) Response {
    let tools: string = "avr-gcc avr-objcopy avr-size avrdude ssh rsync"
    let body: string = template_fill(template_get("layout"), vars("title", "System") + vars("body", "<h2>System dependencies</h2><p>Tools the ecosystem needs.</p><p><a href='/'>Home</a></p>"))
    return html(status_ok(), body)
}

fn docs_page(req: Request) Response {
    let rows: string = docs_rows()
    let body: string = template_fill(template_get("docs"), vars("rows", rows))
    let page: string = template_fill(template_get("layout"), vars("title", "Docs") + vars("body", body))
    return html(status_ok(), page)
}

fn doc_page(req: Request) Response {
    let path: string = param(req, "path")
    // The path from the URL may or may not have the docs/ prefix.
    var full_path: string = path
    if rho_str_index_of(path, "docs/") != 0 {
        full_path = "docs/" + path
    }
    // The page is the one the generator wrote, so a page served here and a page
    // a build writes are the same page.
    let content: string = docs_render_source(robohub_root() + "/" + DOCS_TREE + "/" + full_path + ".md")
    if content == "" {
        content = docs_render_source(robohub_root() + "/" + DOCS_TREE + "/" + full_path + "/index.md")
    }
    if content == "" {
        content = docs_render_source(DOCS_TREE + "/" + full_path + "/docs/index.md")
    }
    if content == "" {
        content = docs_render_source(robohub_root() + "/" + DOCS_TREE + "/" + path + "/docs/index.md")
    }
    if content == "" {
        let body: string = template_fill(template_get("layout"), vars("title", "Not found") + vars("body", "<p>No documentation has been built for " + path + ".</p><p><a href='/docs'>All docs</a></p>"))
        return html(status_not_found(), body)
    }
    let body: string = template_fill(template_get("layout"), vars("title", path) + vars("body", content))
    return html(status_ok(), body)
}

fn docs_rows() string {
    // The pages the store holds: path, title and section, one per line.
    let listing: string = docs_list(robohub_root() + "/" + DOCS_TREE)
    var result: string = ""
    var rest: string = listing
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        // path<TAB>title<TAB>section
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab < 0 {
            continue
        }
        let path: string = rho_str_slice(line, 0, u32(tab))
        let tail: string = rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        let tab2: i32 = rho_str_index_of(tail, "\t")
        var title: string = tail
        if tab2 >= 0 {
            title = rho_str_slice(tail, 0, u32(tab2))
        }
        // The link is the path without its extension and without the docs/
        // prefix: the store lists paths relative to the tree root, which
        // includes the docs/ directory, but the keeper serves them from /docs/.
        // Strip the docs/ directory from the path: the store lists paths
        // relative to the tree root, which includes docs/ as a directory, but
        // the keeper serves them from /docs/.
        // The store lists paths relative to the tree root, which includes
        // docs/ as a directory. Strip the docs/ segment, keeping what is
        // before and after it.
        let link: string = path
        // Strip docs/ from the beginning (orchestrator's own docs)
        if rho_str_index_of(link, "docs/") == 0 {
            link = rho_str_slice(link, 5, u32(rho_strlen(link)) - 5)
        } else {
            // Strip /docs/ from the middle (module docs)
            let docs_pos: i32 = rho_str_index_of(link, "/docs/")
            if docs_pos >= 0 {
                let before: string = rho_str_slice(link, 0, u32(docs_pos))
                let after: string = rho_str_slice(link, u32(docs_pos) + 6, u32(rho_strlen(link)) - u32(docs_pos) - 6)
                if before == "" {
                    link = after
                } else {
                    link = before + "/" + after
                }
            }
        }
        if rho_str_index_of(link, ".md") >= 0 {
            link = rho_str_slice(link, 0, u32(rho_str_index_of(link, ".md")))
        }
        let link_name: string = link
        let slash: i32 = rho_str_index_of(link_name, "/")
        if slash >= 0 {
            link_name = rho_str_slice(link_name, 0, u32(slash))
        }
        result = result + "<tr><td><a href='/docs/" + link_name + "'>" + title + "</a></td><td>" + path + "</td></tr>"
    }
    return result
}

// resolve_path turns a module's path into one that does not depend on where the
// keeper was started from. A path that is already absolute is taken as written;
// a relative path is taken relative to the workspace root.
// robohub_root is where the orchestrator lives. It is said by the
// environment, because a path into another repository belongs to the machine.
fn robohub_root() string {
    // The workspace is said by the environment, because a path into another
    // repository belongs to the machine, and a machine that says nothing has
    // the orchestrator where the keeper was started.
    let root: string = getenv("ROBOHUB_WORKSPACE")
    if root == "" {
        if rho_path_exists("registry/modules") {
            return "."
        }
        print("robohub keeper: set ROBOHUB_WORKSPACE to the directory holding the ecosystem\n")
        return "."
    }
    if rho_path_exists(root + "/robohub/registry/modules") {
        return root + "/robohub"
    }
    if rho_path_exists(root + "/registry/modules") {
        return root
    }
    return root + "/robohub"
}

fn resolve_path(path: string) string {
    if rho_str_index_of(path, "/") == 0 {
        return path
    }
    let root: string = robohub_root()
    return root + "/" + path
}

fn module_rows() string {
    // Discover modules from the registry directory
    let listing: string = ""
    let reg_dir: string = robohub_root() + "/registry/modules"
    let code: u32 = rho_exec("sh", "-c \"ls " + reg_dir + "/\"", "build/reports/ls-modules.txt")
    if code == 0 {
        listing = rho_read_text("build/reports/ls-modules.txt")
    }
    var result: string = ""
    var rest: string = listing
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let filename: string = ""
        if at < 0 {
            filename = rest
            rest = ""
        } else {
            filename = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if filename == "" {
            continue
        }
        // Extract module name from filename (remove .yml extension)
        if rho_str_index_of(filename, ".yml") < 0 {
            continue
        }
        let name: string = rho_str_slice(filename, 0, u32(rho_str_index_of(filename, ".yml")))
        let entry: string = robohub_root() + "/registry/modules/" + name + ".yml"
        let role: string = yaml.value(entry, "role")
        let path: string = resolve_path(yaml.value(entry, "path"))
        let installed: string = "no"
        let version: string = ""
        let badge: string = "<a href='/install?module=" + name + "'>install</a>"
        if rho_path_exists(path + "/module.yml") {
            installed = "yes"
            version = yaml.value(path + "/module.yml", "module.version")
            badge = "<a href='/uninstall?module=" + name + "'>uninstall</a>"
        }
        let row: string = template_fill(template_get("module-row"), vars("name", name) + vars("role", role) + vars("version", version) + vars("installed", installed) + vars("badge", badge))
        result = result + row
    }
    return result
}
