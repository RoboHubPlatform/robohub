module docsite

// The RoboHub documentation, built.
//
// The documentation each module of the ecosystem ships — the pages in its
// `docs/` directory — is collected here into one tree, and the tree is built
// into one site. A module's pages are a section of the tree named for the
// module, so the site has a section per module and the keeper can serve them.
//
// The modules come from the registry, not from a list written here: a module
// that joins the ecosystem is in the registry, and a list written here would be
// a second copy of the ecosystem that drifts.
//
// The build is the toolchain's own: `rho doc`, and the pages are written where
// a reader can find them.

extern fn rho_arg(index: i32) string
extern fn rho_exec(program: string, arguments: string, output_path: string) u32
extern fn rho_path_exists(path: string) bool
extern fn rho_read_text(path: string) string
extern fn rho_strlen(s: string) u64
extern fn rho_str_index_of(s: string, needle: string) i32
extern fn rho_str_slice(s: string, start: u32, length: u32) string

/// Where the registry of the ecosystem lives.
const REGISTRY: string = "registry/modules"

/// Where the tree is assembled.
///
/// The tree is a `docs` directory beside a root, because that is where the
/// generator reads a project's documentation from, and the keeper's store reads
/// it from the same place.
const TREE: string = "build/docs"

/// Where the built site is written.
const SITE: string = "build/site"

/// The directory the tree sits in, which is where the generator reads a
/// project's documentation from.
const ROOT: string = "build"

fn main() void {
    let tree: string = rho_arg(1)
    if tree == "" {
        tree = TREE
    }
    print("assembling the RoboHub documentation in " + tree + "\n")
    assemble(tree)
    print("done\n")
}

// assemble collects every module's documentation into one tree and builds it.
fn assemble(tree: string) void {
    // The orchestrator's own documentation is the tree's index: a reader who
    // starts at the root of the documentation should read what the orchestrator
    // is before they read what it orchestrates.
    rho_exec("sh", "-c \"mkdir -p " + tree + " && cp -f docs/index.md " + tree + "/index.md\"", "build/reports/assemble.txt")

    // Every module's documentation is a section named for the module.
    let listing: string = ""
    rho_exec("sh", "-c \"ls " + REGISTRY + "/\"", "build/reports/ls-modules.txt")
    listing = rho_read_text("build/reports/ls-modules.txt")

    var rest: string = listing
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let filename: string = ""
        if at < 0 {
            filename = rest
            rest = ""
        } else {
            filename = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if filename == "" {
            continue
        }
        if rho_str_index_of(filename, ".yml") < 0 {
            continue
        }
        let name: string = rho_str_slice(filename, 0, u32(rho_str_index_of(filename, ".yml")))
        let path: string = "../" + name
        if !rho_path_exists(path + "/docs/index.md") {
            continue
        }
        rho_exec("sh", "-c \"mkdir -p " + tree + "/" + name + " && cp -f " + path + "/docs/index.md " + tree + "/" + name + "/index.md\"", "build/reports/assemble-" + name + ".txt")
    }

    // The site is the toolchain's own build of the tree.
    rho_exec("rho", "doc " + ROOT + " -out " + SITE, "build/reports/doc.txt")
}
