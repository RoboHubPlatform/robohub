module docsite

// The RoboHub documentation, built.
//
// The documentation each part of the ecosystem ships — the pages in its
// `docs/` directory, or its README when it has no such directory — is collected
// into one tree, and the tree is built into one site by the toolchain's own
// `rho doc`. The site's shape — its sections, their names and order — is
// `applications/docsite/site.yml`, copied into the tree as `docs/site.yml`;
// which section a part lands in is decided here, by where the part lives.
//
// The tree's root is not a module: the orchestrator's own pages, in docs/ and
// its subfolders, are the repository's pages, one section per subfolder.
//
// The tree and the site are emptied first, so a part that was renamed or
// removed is not left behind in the site.

extern fn rho_arg(index: i32) string
extern fn rho_exec(program: string, arguments: string, output_path: string) u32
extern fn rho_path_exists(path: string) bool
extern fn rho_read_text(path: string) string
extern fn rho_write_text(path: string, text: string) bool
extern fn rho_strlen(s: string) u64
extern fn rho_str_index_of(s: string, needle: string) i32
extern fn rho_str_slice(s: string, start: u32, length: u32) string

/// Where the registry of the ecosystem lives.
const REGISTRY: string = "registry/modules"

/// Where the tree is assembled.
const TREE: string = "build/doctree"

/// Where the built site is written.
const SITE: string = "build/site"

/// The applications a person installs and uses; every other repository in the
/// registry is a device, a board or the firmware under them.
const APPLICATIONS: string = "robohub-keeper robohub-mesh robohub-aquarium robohub-energy"

fn main() void {
    var tree: string = rho_arg(1)
    if tree == "" {
        tree = TREE
    }
    print("assembling the RoboHub documentation in " + tree + "\n")
    assemble(tree)
    print("done\n")
}

// sh runs one shell command line, its output kept under build/reports.
fn sh(command: string, report: string) void {
    rho_exec("sh", "-c \"" + command + "\"", "build/reports/" + report + ".txt")
}

// assemble collects every part's documentation into one tree and builds it.
fn assemble(tree: string) void {
    sh("mkdir -p build/reports && rm -rf " + tree + " " + SITE + " && mkdir -p " + tree + "/docs", "assemble-clean")
    // The orchestrator's own pages, its release history on the overview, and
    // the shape of the site.
    sh("cp -Rf docs/. " + tree + "/docs/ && cp -f applications/docsite/site.yml " + tree + "/docs/site.yml", "assemble-root")
    sh("if [ -f CHANGELOG.md ]; then printf '\\n\\n## Release history\\n\\n' >> " + tree +
        "/docs/index.md && awk -f applications/docsite/templates/scripts/normalize-changelog.awk CHANGELOG.md >> " +
        tree + "/docs/index.md; fi", "assemble-releases")

    assemble_registry(tree)
    assemble_folders(tree, "modules", "build")
    assemble_folders(tree, "providers", "integrations")
    assemble_folders(tree, "contracts", "integrations")
    // The gateway contract shares its name with the gateway repository.
    assemble_renamed(tree, "gateway", "contracts/gateway", "integrations", "robohub-gateway-contract")
    assemble_folders(tree, "plugins", "integrations")
    assemble_part(tree, "robohub-protocol", "protocol", "integrations")
    assemble_folders(tree, "../robohub-mesh/plugins", "integrations")
    assemble_renamed(tree, "robohub-devices-mqtt", "../robohub-devices/protocols/mqtt", "devices", "robohub-devices-mqtt")
    assemble_folders(tree, "../robohub-devices/devices/plug", "devices")
    assemble_folders(tree, "../robohub-devices/devices/inverter", "devices")
    assemble_folders(tree, "../robohub-devices/devices/actuator", "devices")
    assemble_folders(tree, "../robohub-devices/devices/sensor", "devices")

    // The site is the toolchain's own build of the tree.
    rho_exec("rho", "doc " + tree + " -out " + SITE, "build/reports/doc.txt")

    // The landing page: the ecosystem's entry points and its release history.
    sh("awk -f applications/docsite/templates/scripts/release-rows.awk CHANGELOG.md > build/reports/release-rows.html", "release-rows")
    let version: string = yaml.value("module.yml", "module.version")
    var landing: string = rho_read_text("applications/docsite/templates/pages/landing.html")
    landing = str_replace(landing, "{{VERSION}}", version)
    landing = replace_once(landing, "<!--RELEASES-->", rho_read_text("build/reports/release-rows.html"))
    rho_write_text(SITE + "/index.html", landing)
}

// assemble_part copies one part — its pages, or its README when it has no
// docs/index.md, its manifest with the site's section, and its release history
// — into the tree under name.
fn assemble_part(tree: string, name: string, path: string, section: string) void {
    assemble_renamed(tree, name, path, section, "")
}

// assemble_renamed is assemble_part with the module renamed in the copy, for a
// part whose name another part already has.
fn assemble_renamed(tree: string, name: string, path: string, section: string, rename: string) void {
    if !rho_path_exists(path + "/module.yml") {
        return
    }
    let has_docs: bool = rho_path_exists(path + "/docs/index.md")
    if !has_docs && !rho_path_exists(path + "/README.md") {
        return
    }
    let dest: string = tree + "/" + name
    sh("mkdir -p " + dest + "/docs", "part-" + name)
    if has_docs {
        sh("cp -Rf " + path + "/docs/. " + dest + "/docs/", "part-" + name + "-docs")
    } else {
        sh("cp -f " + path + "/README.md " + dest + "/docs/index.md", "part-" + name + "-readme")
    }
    sh("awk -v section=" + section + " -v name=" + rename + " -f applications/docsite/templates/scripts/set-section.awk " +
        path + "/module.yml > " + dest + "/module.yml", "part-" + name + "-manifest")
    // A shared module's page ends with what its manifest and sources declare:
    // exports, routes and the host hooks an application has to define.
    if section == "build" {
        sh("sh applications/docsite/templates/scripts/module-reference.sh " + path + " >> " + dest + "/docs/index.md",
            "part-" + name + "-reference")
    }
    sh("if [ -f " + path + "/CHANGELOG.md ]; then printf '\\n\\n## Release history\\n\\n' >> " + dest +
        "/docs/index.md && awk -f applications/docsite/templates/scripts/normalize-changelog.awk " +
        path + "/CHANGELOG.md >> " + dest + "/docs/index.md; fi", "part-" + name + "-releases")
}

// assemble_folders reads a folder of parts: each subfolder with a manifest is
// one, named for the subfolder.
fn assemble_folders(tree: string, group: string, section: string) void {
    if !rho_path_exists(group) {
        return
    }
    sh("ls " + group + "/", "ls-" + str_replace(str_replace(group, "/", "-"), ".", ""))
    var rest: string = rho_read_text("build/reports/ls-" + str_replace(str_replace(group, "/", "-"), ".", "") + ".txt")
    while rest != "" {
        let name: string = first_line(rest)
        rest = after_line(rest)
        if name != "" {
            assemble_part(tree, name, group + "/" + name, section)
        }
    }
}

// assemble_registry reads the ecosystem registry: each entry names a sibling
// repository, which is an application or part of the device side.
fn assemble_registry(tree: string) void {
    if !rho_path_exists(REGISTRY) {
        return
    }
    sh("ls " + REGISTRY + "/", "ls-registry")
    var rest: string = rho_read_text("build/reports/ls-registry.txt")
    while rest != "" {
        let filename: string = first_line(rest)
        rest = after_line(rest)
        let dot: i32 = rho_str_index_of(filename, ".yml")
        if dot > 0 {
            let name: string = rho_str_slice(filename, 0, u32(dot))
            var section: string = "devices"
            if rho_str_index_of(" " + APPLICATIONS + " ", " " + name + " ") >= 0 {
                section = "applications"
            }
            assemble_part(tree, name, "../" + name, section)
        }
    }
}

// first_line is the text up to the first line break; after_line is the rest.
fn first_line(text: string) string {
    let at: i32 = rho_str_index_of(text, "\n")
    if at < 0 {
        return text
    }
    return rho_str_slice(text, 0, u32(at))
}

fn after_line(text: string) string {
    let at: i32 = rho_str_index_of(text, "\n")
    if at < 0 {
        return ""
    }
    return rho_str_slice(text, u32(at) + 1, u32(rho_strlen(text)) - u32(at) - 1)
}

fn replace_once(text: string, needle: string, value: string) string {
    let at: i32 = rho_str_index_of(text, needle)
    if at < 0 {
        return text
    }
    return rho_str_slice(text, 0, u32(at)) + value +
        rho_str_slice(text, u32(at) + u32(rho_strlen(needle)),
            u32(rho_strlen(text)) - u32(at) - u32(rho_strlen(needle)))
}

