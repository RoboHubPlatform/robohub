module docsite

// The RoboHub documentation, built.
//
// The documentation each module of the ecosystem ships — the pages in its
// `docs/` directory — is collected here into one tree, and the tree is built
// into one site. A module's pages are a section of the tree named for the
// module, so the site has a section per module and the keeper can serve them.
//
// The modules come from the registry, not from a list written here: a module
// that joins the ecosystem is in the registry, and a list written here would be
// a second copy of the ecosystem that drifts.
//
// The build is the toolchain's own: `rho doc`, and the pages are written where
// a reader can find them.

extern fn rho_arg(index: i32) string
extern fn rho_exec(program: string, arguments: string, output_path: string) u32
extern fn rho_path_exists(path: string) bool
extern fn rho_read_text(path: string) string
extern fn rho_write_text(path: string, text: string) bool
extern fn rho_strlen(s: string) u64
extern fn rho_str_index_of(s: string, needle: string) i32
extern fn rho_str_slice(s: string, start: u32, length: u32) string

/// Where the registry of the ecosystem lives.
const REGISTRY: string = "registry/modules"

/// Where the tree is assembled.
///
/// The tree is a `docs` directory beside a root, because that is where the
/// generator reads a project's documentation from, and the keeper's store reads
/// it from the same place.
const TREE: string = "build/doctree"

/// Where the built site is written.
const SITE: string = "build/site"

fn main() void {
    let tree: string = rho_arg(1)
    if tree == "" {
        tree = TREE
    }
    print("assembling the RoboHub documentation in " + tree + "\n")
    assemble(tree)
    print("done\n")
}

// assemble collects every module's documentation into one tree and builds it.
fn assemble(tree: string) void {
    // The orchestrator's own documentation and manifest.
    rho_exec("sh", "-c \"mkdir -p " + tree + "/docs\"", "build/reports/assemble.txt")
    rho_exec("sh", "-c \"cp -f docs/index.md " + tree + "/docs/index.md && if [ -f CHANGELOG.md ]; then printf '\\n\\n## Release history\\n\\n' >> " + tree + "/docs/index.md && awk -f applications/docsite/templates/scripts/normalize-changelog.awk CHANGELOG.md >> " + tree + "/docs/index.md; fi\"", "build/reports/assemble2.txt")
    rho_exec("sh", "-c \"sed \'s/name: robohub/name: build/\' module.yml > " + tree + "/module.yml\"", "build/reports/assemble3.txt")
    rho_exec("sh", "-c \"mkdir -p " + tree + "/src && cp -f src/main.rho " + tree + "/src/main.rho\"", "build/reports/assemble4.txt")

    // Every module's documentation is a section named for the module.
    assemble_registry(tree)
    assemble_directories(tree, "applications")
    assemble_directories(tree, "modules")
    assemble_directories(tree, "plugins")

    // The site is the toolchain's own build of the tree.
    rho_exec("rho", "doc " + tree + " -title RoboHub -api /dev/null -out " + SITE, "build/reports/doc.txt")

    // A landing page in the same shape as the Rho docsite: the ecosystem's
    // entry points, its repository, and its release history.
    rho_exec("sh", "-c \"awk -f applications/docsite/templates/scripts/release-rows.awk CHANGELOG.md > build/reports/release-rows.html\"",
        "build/reports/release-rows.txt")
    let version: string = yaml.value("module.yml", "module.version")
    var landing: string = rho_read_text("applications/docsite/templates/pages/landing.html")
    landing = replace_all(landing, "{{VERSION}}", version)
    landing = replace_once(landing, "<!--RELEASES-->",
        rho_read_text("build/reports/release-rows.html"))
    rho_write_text(SITE + "/index.html", landing)
}

// assemble_module copies one module's page, manifest and release history into
// the tree. The manifest is what gives the page its section and order.
fn assemble_module(tree: string, name: string, path: string) void {
    if !rho_path_exists(path + "/docs/index.md") {
        return
    }
    rho_exec("sh", "-c \"mkdir -p " + tree + "/" + name + "/docs && cp -Rf " +
        path + "/docs/. " + tree + "/" + name + "/docs/ && cp -f " +
        path + "/module.yml " + tree + "/" + name + "/module.yml && if [ -f " +
        path + "/CHANGELOG.md ]; then printf '\\n\\n## Release history\\n\\n' >> " +
        tree + "/" + name + "/docs/index.md && awk -f applications/docsite/templates/scripts/normalize-changelog.awk " +
        path + "/CHANGELOG.md >> " + tree + "/" + name + "/docs/index.md; fi\"",
        "build/reports/assemble-" + name + ".txt")
}

// assemble_directories reads a directory of modules: applications, modules or
// plugins. Each folder with a docs/index.md becomes a page.
fn assemble_directories(tree: string, group: string) void {
    if !rho_path_exists(group) {
        return
    }
    rho_exec("sh", "-c \"ls " + group + "/\"", "build/reports/ls-" + group + ".txt")
    var rest: string = rho_read_text("build/reports/ls-" + group + ".txt")
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let name: string = ""
        if at < 0 {
            name = rest
            rest = ""
        } else {
            name = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1,
                u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if name == "" || !rho_path_exists(group + "/" + name + "/module.yml") {
            continue
        }
        assemble_module(tree, name, group + "/" + name)
    }
}

// assemble_registry reads the ecosystem registry, where each entry is a
// manifest beside the modules it names.
fn assemble_registry(tree: string) void {
    if !rho_path_exists(REGISTRY) {
        return
    }
    rho_exec("sh", "-c \"ls " + REGISTRY + "/\"", "build/reports/ls-modules.txt")
    var rest: string = rho_read_text("build/reports/ls-modules.txt")
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let filename: string = ""
        if at < 0 {
            filename = rest
            rest = ""
        } else {
            filename = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1,
                u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if filename == "" || rho_str_index_of(filename, ".yml") < 0 {
            continue
        }
        let name: string = rho_str_slice(filename, 0,
            u32(rho_str_index_of(filename, ".yml")))
        assemble_module(tree, name, "../" + name)
        // A repository is grouped by what its manifest says it is: a runtime,
        // middleware, interfaces, a platform or a collection. Only the
        // application modules under modules/ are "Modules"; the ecosystem
        // repositories are never mixed into that section.
        let kind: string = yaml.value("../" + name + "/module.yml", "module.type")
        if kind != "" && kind != "rho" {
            rho_exec("sh", "-c \"sed -i 's/^  section: .*/  section: " + kind +
                "/' " + tree + "/" + name + "/module.yml\"",
                "build/reports/section-" + name + ".txt")
        }
    }
}

fn replace_once(text: string, needle: string, value: string) string {
    let at: i32 = rho_str_index_of(text, needle)
    if at < 0 {
        return text
    }
    return rho_str_slice(text, 0, u32(at)) + value +
        rho_str_slice(text, u32(at) + u32(rho_strlen(needle)),
            u32(rho_strlen(text)) - u32(at) - u32(rho_strlen(needle)))
}

fn replace_all(text: string, needle: string, value: string) string {
    var out: string = text
    var at: i32 = rho_str_index_of(out, needle)
    while at >= 0 {
        out = rho_str_slice(out, 0, u32(at)) + value +
            rho_str_slice(out, u32(at) + u32(rho_strlen(needle)),
                u32(rho_strlen(out)) - u32(at) - u32(rho_strlen(needle)))
        at = rho_str_index_of(out, needle)
    }
    return out
}
