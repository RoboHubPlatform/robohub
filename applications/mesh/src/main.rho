module mesh

// The RoboHub Mesh application: projects, plans, connections, build and verify.
// It is standalone on its own port and can be launched by the keeper.

include "mesh/storage.rho"
include "forms"
include "settings"
include "alert"
include "mesh/wizard.rho"
include "mesh/mesh.rho"
include "mesh/telemetry.rho"
include "mesh/firmware.rho"
include "mesh/settings.rho"
include "htmx"
include "i18n"

import std.web.http
import std.web.template
import rho.log

// The orchestrator root. A hosted application is started with the workspace in
// the environment, and a standalone one from the repository root.
fn robohub_root() string {
    let root: string = getenv("ROBOHUB_WORKSPACE")
    if root == "" {
        if rho_path_exists("registry/modules") {
            return "."
        }
        warn("mesh", "set ROBOHUB_WORKSPACE to the directory holding the ecosystem")
        return "."
    }
    if rho_path_exists(root + "/robohub/registry/modules") {
        return root + "/robohub"
    }
    if rho_path_exists(root + "/registry/modules") {
        return root
    }
    return root + "/robohub"
}

fn resolve_path(path: string) string {
    if rho_str_index_of(path, "/") == 0 {
        return path
    }
    return robohub_root() + "/" + path
}

