    nodeId: i64
    field: string
    value: f64
    status: i64
    receivedMs: i64
    source: string
}

// The newest value of every signal, so a latest read does not scan the series.
struct TelemetryLatest {
    project: string
    source: string
    field: string
    value: f64
    status: i64
    receivedMs: i64
}

// One-minute rollups. They are written from raw readings once a bucket is complete, and they are what a series reads after the raw window has passed.
