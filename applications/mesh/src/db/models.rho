    source: string
    field: string
    bucketMs: i64
    valueMin: f64
    valueMax: f64
    valueAvg: f64
    samples: i64
}

// Actionable faults: a reading whose status says the signal is not healthy. These drive the live UI and safety loops; raw debug traces and audit text stay in files. A fault is kept long enough for an operator to act on it and is pruned separately from the readings.
