module mesh.telemetry

// The telemetry store Mesh offers other applications.
//
// The gateway is the edge recorder; Mesh is where a series lives. The worker
// polls every project's gateway for the readings after the sequence it last
// committed, writes the page in one transaction, and acks the gateway. A
// restart resumes from the stored sequence, and a repeated page is ignored by
// the reading's unique key.
//
// The host half is a port: fetching a page, writing a batch and reading a
// series are things Rho has no heap or file I/O for. The schema is still the
// project's; the port writes the tables the schema declares.

extern fn telemetry_open(path: string) bool
extern fn telemetry_poll(project: string, gateway_id: string, gateway_url: string, token: string, events_path: string) string
extern fn telemetry_feed_record(path: string, project: string, area_id: u32, node_id: u32, field_name: string, value: string, status: u32) bool
extern fn telemetry_latest_events(project: string) string
extern fn telemetry_status(project: string) string
extern fn telemetry_latest(project: string, area_id: u32, node_id: u32, field_name: string) string
extern fn telemetry_latest_text(project: string, area_id: u32, node_id: u32, field_name: string) string
extern fn telemetry_series(project: string, area_id: u32, node_id: u32, field_name: string, from_ms: string, to_ms: string, step_ms: string) string
extern fn telemetry_sleep(ms: u32) void
extern fn telemetry_prune(project: string, raw_days: u32, minute_days: u32, hour_days: u32) string
extern fn telemetry_rollup(project: string) string
extern fn telemetry_record(project: string, area_id: u32, node_id: u32, field_name: string, value: string, status: u32) u32
extern fn telemetry_json_number(document: string, path: string, scale: string) string
extern fn telemetry_json_bool(document: string, path: string) string
extern fn telemetry_checkpoint(mode: string) string
extern fn telemetry_vacuum(mode: string) string
extern fn telemetry_storage_status(project: string) string
extern fn telemetry_fault_record(project: string, gateway: string, field: string,
    severity: string, message: string, area: u32, node: u32, status: u32, created_ms: string) u32
extern fn telemetry_fault_list(project: string, since_ms: string, limit: u32) string
extern fn telemetry_fault_clear(project: string, id: u32) string
extern fn telemetry_fault_prune(project: string, days: u32) string
extern fn telemetry_fault_rows(project: string, limit: u32) string
extern fn telemetry_fault_max_id(project: string) u32
extern fn telemetry_fault_new(project: string, after_id: u32, limit: u32) string



// telemetry_path is where the store lives. A deployment names it; a workstation
// keeps it under the Mesh state directory.
fn telemetry_path() string {
    let override: string = getenv("ROBOHUB_MESH_TELEMETRY_DB")
    if override != "" {
        return override
    }
    let home: string = getenv("HOME")
    if home == "" {
        return "telemetry.db"
    }
    return home + "/.rho/mesh/telemetry.db"
}

fn telemetry_start() bool {
    return telemetry_open(telemetry_path())
}

// telemetry_project_ids lists the projects without running the migration the
// interactive pages run. The worker is a reader; a background task must not
// rewrite project state while a person is editing it.
fn mesh_scope_has(scopes: string, needle: string) bool {
    var rest: string = scopes
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, ",")
        var token: string = rest
        if at < 0 {
            rest = ""
        } else {
            token = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1,
                u32(rho_strlen(rest)) - u32(at) - 1)
        }
        token = device_trim(token)
        if token == needle {
            return true
        }
    }
    return false
}

// mesh_scoped accepts a request for one project. A browser session (no
// audience header) is an administrator behind the keeper and may look at any
// project. A service token must carry the project it is asking for, `mesh:*`,
// or the wildcard `*`.
// mesh_scoped is whether the caller may read or act on a project. The auth
// middleware sets the identity headers from a token or a session it verified,
// and removes any a client sent, so a request without an audience is one nobody
// vouched for and is refused.
fn mesh_scoped(req: Request, project: string) bool {
    let aud: string = header_str(req, "X-Rho-Aud")
    if aud == "" {
        return false
    }
    let subject: string = header_str(req, "X-Rho-Subject")
    if mesh_subject_revoked(project, subject) {
        return false
    }
    let scopes: string = header_str(req, "X-Rho-Scopes")
    if mesh_scope_has(scopes, "*") || mesh_scope_has(scopes, "mesh:*") {
        return true
    }
    return mesh_scope_has(scopes, "mesh:" + project)
}

fn mesh_scope_denied() Response {
    return json(403, "{\"ok\":false,\"error\":\"insufficient scope\"}")
}


// A project's live feed: the readings it stored, one named SSE event per line.
// Each project has its own, because a reader is allowed one project, and a feed
// shared by every project is every project's readings sent to whoever may read
// one. The SQLite store remains the source of truth; the feed is how a reader
// hears of a change.
fn telemetry_event_stream(project: string) string {
    return project_location(project) + "/telemetry-events.jsonl"
}

// telemetry_snapshot_file is where a stream's opening snapshot is written: the
// project's current values, sent before the live feed.
fn telemetry_snapshot_file(project: string) string {
    return project_location(project) + "/telemetry-snapshot.jsonl"
}

fn telemetry_record_event(project: string, area: u32, node: u32, field_name: string,
    value: string, status: u32) u32 {
    let code: u32 = telemetry_record(project, area, node, field_name, value, status)
    if code == 0 {
        ignore_bool(telemetry_feed_record(telemetry_event_stream(project), project, area, node,
            field_name, value, status))
    }
    return code
}

fn telemetry_project_ids() string {
    let report: string = wizard_report("telemetry-projects")
    if rho_exec("ls", projects_dir(), report) != 0 {
        return ""
    }
    return rho_read_text(report)
}

// mesh_retention_days is how long a project keeps raw readings. The minute and
// hour rollups have their own, longer windows; a project setting changes the
// raw window without making a chart of an older season disappear.
fn mesh_retention_days(project: string) u32 {
    var value: string = settings_get("telemetry.raw_days", "")
    if value == "" {
        value = state_value_in(project_file(project), "telemetry_retention_days")
    }
    if value == "" {
        value = getenv("ROBOHUB_MESH_TELEMETRY_RETENTION_DAYS")
    }
    if value == "" {
        return 14
    }
    let days: u32 = u32(rho_int_from_str(value))
    if days == 0 {
        return 14
    }
    return days
}

fn mesh_retention_setting(key: string, fallback: u32) u32 {
    let value: string = settings_get("telemetry." + key, "")
    if value == "" {
        return fallback
    }
    let number: u32 = u32(rho_int_from_str(value))
    if number == 0 {
        return fallback
    }
    return number
}

fn mesh_vacuum_mode() string {
    let mode: string = settings_get("telemetry.vacuum_mode", "")
    if mode == "" {
        return "incremental"
    }
    return mode
}

fn telemetry_prune_once() void {
    let ids: string = telemetry_project_ids()
    var rest: string = ids
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id == "" {
            continue
        }
        let pruned: string = telemetry_prune(id, mesh_retention_days(id),
            mesh_retention_setting("minute_days", 90),
            mesh_retention_setting("hour_days", 1825))
        if rho_str_index_of(pruned, "\"ok\":true") < 0 {
            warn("mesh", "telemetry retention " + id + ": " + pruned)
        }
        ignore_string(telemetry_fault_prune(id, mesh_retention_setting("fault_days", 365)))
    }
}

// mesh_gateway_token is the bearer token the gateway's outbox requires. A
// project may name its own; otherwise the deployment's shared token is used.
fn mesh_gateway_token(project: string) string {
    let token: string = mesh_active_token(project)
    if token != "" {
        return token
    }
    return getenv("ROBOHUB_GATEWAY_TOKEN")
}

fn mesh_now_seconds() u32 {
    let report: string = wizard_report("telemetry-now")
    ignore_u32(rho_exec("date", "+%s", report))
    return u32(rho_int_from_str(first_line(rho_read_text(report))))
}

// Gateway health is a sidecar, not a key in the plan.
//
// The telemetry worker writes it while a person may be editing the plan. The
// plan is a file of keys read, changed and written as a whole; a background
// writer that did the same could overwrite a save it had read before it began.
// One file per fact keeps the worker out of the plan entirely.
fn mesh_gateway_state_file(project: string, key: string) string {
    return project_location(project) + "/gateway-" + sanitize(key) + ".txt"
}

fn mesh_gateway_value(project: string, key: string) string {
    let path: string = mesh_gateway_state_file(project, key)
    if rho_path_exists(path) {
        return first_line(rho_read_text(path))
    }
    // A project written before the sidecar existed still has the value in the
    // plan. It is read there and moved the next time it is saved.
    return state_value_in(project_file(project), "gateway." + key)
}

fn mesh_gateway_save(project: string, key: string, value: string) void {
    ignore_bool(write_state_file(mesh_gateway_state_file(project, key), value + "\n"))
}

fn mesh_gateway_ready(project: string) bool {
    let next: string = mesh_gateway_value(project, "next_poll_s")
    if next == "" {
        return true
    }
    return mesh_now_seconds() >= u32(rho_int_from_str(next))
}

fn mesh_gateway_failed(project: string, message: string) void {
    let now: u32 = mesh_now_seconds()
    var backoff: u32 = u32(rho_int_from_str(mesh_gateway_value(project, "backoff_s")))
    if backoff == 0 {
        backoff = 2
    } else {
        backoff = backoff * 2
    }
    let maximum: u32 = mesh_retention_setting("backoff_max_s", 60)
    if backoff > maximum {
        backoff = maximum
    }
    mesh_gateway_save(project, "backoff_s", rho_int_to_str(backoff))
    mesh_gateway_save(project, "next_poll_s", rho_int_to_str(now + backoff))
    mesh_gateway_save(project, "last_error", message)
    if mesh_gateway_value(project, "fault_open") != "true" {
        ignore_u32(telemetry_fault_record(project, project + "@gateway", "gateway",
            "ERROR", "gateway unreachable: " + message, 0, 0, 2, ""))
        mesh_gateway_save(project, "fault_open", "true")
    }
}

fn mesh_gateway_ok(project: string) void {
    let now: u32 = mesh_now_seconds()
    mesh_gateway_save(project, "backoff_s", "0")
    mesh_gateway_save(project, "next_poll_s", "0")
    mesh_gateway_save(project, "fault_open", "")
    mesh_gateway_save(project, "last_error", "")
    mesh_gateway_save(project, "last_success_s", rho_int_to_str(now))
}

// telemetry_poll_once reads one page from every project's gateway. The key is
// the project and the gateway address together: a project pointed at another
// gateway starts from its new feed rather than from a sequence that belonged to
// the old one.
fn telemetry_poll_once() void {
    let ids: string = telemetry_project_ids()
    var rest: string = ids
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id == "" {
            continue
        }
        let url: string = mesh_project_gateway(id)
        if url == "" {
            continue
        }
        if !mesh_gateway_ready(id) {
            continue
        }
        let result: string = telemetry_poll(id, id + "@" + url, url,
            mesh_gateway_token(id), telemetry_event_stream(id))
        // A gateway that is simply down is expected while a project is being
        // built. It becomes a fault once and then backs off exponentially, so
        // the poll loop does not hammer a dead link or fill the log.
        if rho_str_index_of(result, "\"ok\":true") < 0 {
            mesh_gateway_failed(id, result)
            if rho_str_index_of(result, "the gateway did not answer") < 0 {
                warn("mesh", "telemetry " + id + ": " + result)
            }
        } else {
            mesh_gateway_ok(id)
        }
    }
}

// telemetry_poll_http_device reads one HTTP device and stores the fields its
// manifest describes. It returns how many readings were written, so a page can
// say whether the device answered.
fn telemetry_poll_http_device(project: string, file: string, index: u32) u32 {
    let name: string = project_node_value(file, index, "device", "")
    let transport: string = project_node_value(file, index, "transport", "http")
    let address: string = project_node_value(file, index, "address", "")
    if name == "" || transport != "http" || address == "" {
        return 0
    }
    let manifest: string = device_manifest(name)
    let path: string = yaml.value(manifest, "telemetry.http_path")
    let fields: string = manifest_list_items(manifest, "telemetry_http_fields")
    if path == "" || fields == "" {
        return 0
    }
    let device_token: string = yaml.value(manifest, "telemetry.http_token")
    let body: string = mesh_url_get_auth(address, path, device_token)
    if body == "" {
        return 0
    }
    let area: u32 = u32(rho_int_from_str(project_area_id(file)))
    var rest: string = fields
    var recorded: u32 = 0
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1,
                u32(rho_strlen(rest)) - u32(at) - 1)
        }
        line = device_trim(line)
        if rho_strlen(line) >= 2 && rho_str_starts_with(line, "\"") &&
            rho_str_slice(line, u32(rho_strlen(line)) - 1, 1) == "\"" {
            line = rho_str_slice(line, 1, u32(rho_strlen(line)) - 2)
        }
        let field_name: string = field(line, 1)
        let kind: string = field(line, 3)
        let json_path: string = field(line, 4)
        let scale: string = field(line, 5)
        if field_name == "" || json_path == "" {
            continue
        }
        if kind == "bool" {
            let value: string = telemetry_json_bool(body, json_path)
            if value == "true" {
                ignore_u32(telemetry_record_event(project, area, index, field_name, "1", 0))
                recorded = recorded + 1
            } else if value == "false" {
                ignore_u32(telemetry_record_event(project, area, index, field_name, "0", 0))
                recorded = recorded + 1
            }
        } else {
            let value: string = telemetry_json_number(body, json_path, scale)
            if value != "" {
                ignore_u32(telemetry_record_event(project, area, index, field_name, value, 0))
                recorded = recorded + 1
            }
        }
    }
    if recorded > 0 {
        ignore_string(telemetry_rollup(project))
    }
    return recorded
}

// telemetry_device_poll_once reads the HTTP devices in every project. A device
// that is not HTTP is carried by its parent node or a robohub-devices device
// node; its frame arrives through the gateway outbox and is stored by
// telemetry_poll_once.
fn telemetry_device_poll_once() void {
    let ids: string = telemetry_project_ids()
    var projects: string = ids
    while projects != "" {
        let at: i32 = rho_str_index_of(projects, "\n")
        var project: string = projects
        if at < 0 {
            projects = ""
        } else {
            project = rho_str_slice(projects, 0, u32(at))
            projects = rho_str_slice(projects, u32(at) + 1,
                u32(rho_strlen(projects)) - u32(at) - 1)
        }
        if project == "" {
            continue
        }
        let file: string = project_file(project)
        let count: u32 = u32(rho_int_from_str(state_value_in(file, "node.count")))
        var index: u32 = 1
        while index <= count {
            if project_node_value(file, index, "kind", "") == "device" {
                ignore_u32(telemetry_poll_http_device(project, file, index))
            }
            index = index + 1
        }
    }
}

fn telemetry_worker() void {
    if !telemetry_start() {
        warn("mesh", "telemetry store unavailable")
        return
    }
    // A store that was offline longer than its window should not wait an hour
    // for the first pass.
    telemetry_prune_once()
    mesh_fault_init()
    telemetry_device_poll_once()
    ignore_string(telemetry_checkpoint("PASSIVE"))
    var ticks: u32 = 0
    var device_ticks: u32 = 0
    var check_ticks: u32 = 0
    let checkpoint_every: u32 = mesh_retention_setting("checkpoint_minutes", 5) * 30
    let prune_every: u32 = mesh_retention_setting("prune_hours", 6) * 1800
    while true {
        telemetry_poll_once()
        device_ticks = device_ticks + 1
        if device_ticks >= 3 {
            device_ticks = 0
            telemetry_device_poll_once()
        }
        if device_ticks == 0 {
            mesh_fault_emit_once()
        }
        check_ticks = check_ticks + 1
        if check_ticks >= checkpoint_every {
            check_ticks = 0
            if rho_str_index_of(telemetry_checkpoint("PASSIVE"), "\"ok\":true") < 0 {
                warn("mesh", "telemetry WAL checkpoint failed")
            }
        }
        // Every six hours at the two-second poll cadence. The pass rolls each
        // project up before it prunes, so the old range a chart asks for is
        // still there after the raw rows are gone. Checkpoint with TRUNCATE
        // and vacuum only in this quieter maintenance window.
        ticks = ticks + 1
        if ticks >= prune_every {
            ticks = 0
            telemetry_prune_once()
            ignore_string(telemetry_checkpoint("TRUNCATE"))
            let vacuum_mode: string = mesh_vacuum_mode()
            if !rho_str_eq(vacuum_mode, "off") {
                ignore_string(telemetry_vacuum(vacuum_mode))
            }
        }
        telemetry_sleep(2000)
    }
}

// mesh_source_coordinates maps a source ID to the device key and field a
// reading was stored under. A module source belongs to the node it extends; a
// device source uses the device id the plan recorded, or the node index when it
// has none.
fn mesh_source_coordinates(project: string, source: string) string {
    let spec: string = mesh_source_spec(project, source)
    if spec == "" {
        return ""
    }
    let kind: string = field(spec, 0)
    let field_name: string = field(spec, 3)
    let area: string = project_area_id(project_file(project))
    if kind == "module" {
        let parent: string = field(spec, 9)
        if !rho_str_starts_with(parent, "node.") {
            return ""
        }
        let node: string = rho_str_slice(parent, 5, u32(rho_strlen(parent)) - 5)
        // The firmware prefixes a module's field with its plan index, so two
        // sensors measuring the same quantity on one node stay two series.
        // A node flashed before that prefix existed published the bare field;
        // when only the bare field has readings, serve that series.
        let prefixed: string = "m" + field(spec, 1) + "." + field_name
        if telemetry_latest_text(project, u32(rho_int_from_str(area)),
            u32(rho_int_from_str(node)), prefixed) == "" {
            return area + "|" + node + "|" + field_name
        }
        return area + "|" + node + "|" + prefixed
    }
    if kind == "device" {
        // A device is addressed by its node in the plan, which is also the
        // identity the generated device node publishes under and the one the
        // Mesh poller stores. The gateway's own device numbering is for its
        // control endpoint, not for a series.
        return area + "|" + field(spec, 1) + "|" + field_name
    }
    return ""
}

fn mesh_api_telemetry_status(req: Request) Response {
    let project: string = param(req, "project")
    if !mesh_scoped(req, project) {
        return mesh_scope_denied()
    }
    return Response{ 200, telemetry_status(project), "application/json", "" }
}

fn mesh_api_telemetry_latest(req: Request) Response {
    let project: string = param(req, "project")
    if !mesh_scoped(req, project) {
        return mesh_scope_denied()
    }
    let source: string = request_query_param(req, "source")
    let coords: string = mesh_source_coordinates(project, source)
    if coords == "" {
        return json(404, "{\"ok\":false,\"error\":\"unknown source\"}")
    }
    return Response{ 200, telemetry_latest(project,
        u32(rho_int_from_str(field(coords, 0))),
        u32(rho_int_from_str(field(coords, 1))),
        field(coords, 2)), "application/json", "" }
}

fn mesh_api_telemetry_series(req: Request) Response {
    let project: string = param(req, "project")
    if !mesh_scoped(req, project) {
        return mesh_scope_denied()
    }
    let source: string = request_query_param(req, "source")
    if source == "" {
        return json(400, "{\"ok\":false,\"error\":\"source is required\"}")
    }
    let coords: string = mesh_source_coordinates(project, source)
    if coords == "" {
        return json(404, "{\"ok\":false,\"error\":\"unknown source\"}")
    }
    return Response{ 200, telemetry_series(project,
        u32(rho_int_from_str(field(coords, 0))),
        u32(rho_int_from_str(field(coords, 1))),
        field(coords, 2),
        request_query_param(req, "from"),
        request_query_param(req, "to"),
        request_query_param(req, "step")), "application/json", "" }
}
fn mesh_api_telemetry_stream(req: Request) Response {
    let project: string = param(req, "project")
    if !mesh_scoped(req, project) {
        return mesh_scope_denied()
    }
    // The project's current values go first, so a page that connects (or
    // reconnects) starts from the present; then its live feed, and only its.
    let snapshot: string = telemetry_snapshot_file(project)
    ignore_bool(rho_write_secret(snapshot, telemetry_latest_events(project)))
    return sse_events(telemetry_event_stream(project), snapshot, 500)
}
fn mesh_fault_events_file() string {
    return wizard_dir() + "/fault-events.jsonl"
}

fn mesh_fault_snapshot_file() string {
    return wizard_dir() + "/fault-snapshot.jsonl"
}

// The fault watermark is a sidecar for the same reason: the telemetry worker
// advances it while the plan may be open for editing.
fn mesh_fault_state_file(project: string) string {
    return project_location(project) + "/fault.last_id"
}

fn mesh_fault_last_id(project: string) u32 {
    let path: string = mesh_fault_state_file(project)
    var value: string = ""
    if rho_path_exists(path) {
        value = first_line(rho_read_text(path))
    } else {
        value = state_value_in(project_file(project), "fault.last_id")
    }
    if value == "" {
        return 0
    }
    return u32(rho_int_from_str(value))
}

fn mesh_fault_save(project: string, value: u32) void {
    ignore_bool(write_state_file(mesh_fault_state_file(project), rho_int_to_str(value) + "\n"))
}

// mesh_fault_init starts each project's live feed at the current state, so a
// restart does not replay every fault the store has ever held.
fn mesh_fault_init() void {
    let ids: string = telemetry_project_ids()
    var rest: string = ids
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id == "" {
            continue
        }
        if mesh_fault_last_id(id) == 0 && !rho_path_exists(mesh_fault_state_file(id)) {
            mesh_fault_save(id, telemetry_fault_max_id(id))
        }
    }
}

fn mesh_fault_emit(project: string) void {
    let last: u32 = mesh_fault_last_id(project)
    let lines: string = telemetry_fault_new(project, last, 100)
    if lines == "" {
        return
    }
    var highest: u32 = last
    var rest: string = lines
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab > 0 {
            let id: u32 = u32(rho_int_from_str(rho_str_slice(line, 0, u32(tab))))
            if id > highest {
                highest = id
            }
        }
    }
    var rows: string = mesh_fault_rows(project)
    if rows == "" {
        rows = "<tr><td colspan=\"4\">" + "No faults recorded." + "</td></tr>"
    }
    let line: string = "{\"event\":\"faults\",\"data\":" + json_string(rows) + "}\n"
    let file: string = mesh_fault_events_file()
    ignore_bool(rho_write_text(file, rho_read_text(file) + line))
    mesh_fault_save(project, highest)
}

fn mesh_fault_emit_once() void {
    let ids: string = telemetry_project_ids()
    var rest: string = ids
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id != "" {
            mesh_fault_emit(id)
        }
    }
}

fn mesh_faults_events(req: Request) Response {
    let project: string = current_project()
    if project == "" {
        return text(status_bad_request(), "no project")
    }
    var rows: string = mesh_fault_rows(project)
    if rows == "" {
        rows = "<tr><td colspan=\"4\">" + i18n_t(req, "faults.empty") + "</td></tr>"
    }
    ignore_bool(rho_write_text(mesh_fault_snapshot_file(),
        "{\"event\":\"faults\",\"data\":" + json_string(rows) + "}\n"))
    return sse_events(mesh_fault_events_file(), mesh_fault_snapshot_file(), 1000)
}

fn json_number_or_zero(value: string) string {
    if value == "" { return "0" }
    return value
}

fn mesh_gateway_status_json(project: string) string {
    return "{\"ok\":true" +
        ",\"backoff_s\":" + json_number_or_zero(mesh_gateway_value(project, "backoff_s")) +
        ",\"next_poll_s\":" + json_number_or_zero(mesh_gateway_value(project, "next_poll_s")) +
        ",\"last_success_s\":" + json_number_or_zero(mesh_gateway_value(project, "last_success_s")) +
        ",\"fault_open\":" + json_string(mesh_gateway_value(project, "fault_open")) +
        ",\"last_error\":" + json_string(mesh_gateway_value(project, "last_error")) + "}"
}

fn mesh_api_gateway_status(req: Request) Response {
    let project: string = param(req, "project")
    if !mesh_scoped(req, project) {
        return mesh_scope_denied()
    }
    return Response{ 200, mesh_gateway_status_json(project), "application/json", "" }
}

fn mesh_fault_rows(project: string) string {
    var out: string = ""
    var rest: string = telemetry_fault_rows(project, 100)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let first: i32 = rho_str_index_of(line, "\t")
        if first < 0 { continue }
        let second_at: i32 = rho_str_index_of(rho_str_slice(line, u32(first) + 1,
            u32(rho_strlen(line)) - u32(first) - 1), "\t")
        if second_at < 0 { continue }
        let second: u32 = u32(first) + 1 + u32(second_at) + 1
        let third_at: i32 = rho_str_index_of(rho_str_slice(line, second,
            u32(rho_strlen(line)) - second), "\t")
        if third_at < 0 { continue }
        let third: u32 = second + u32(third_at) + 1
        let id: string = rho_str_slice(line, 0, u32(first))
        let severity: string = rho_str_slice(line, u32(first) + 1,
            u32(second_at))
        let created: string = rho_str_slice(line, second, u32(third_at))
        let message: string = rho_str_slice(line, third,
            u32(rho_strlen(line)) - third)
        var severity_css: string = "warn"
        if rho_str_eq(severity, "ERROR") {
            severity_css = "bad"
        }
        out = out + template_fill(template_get("fault-row"),
            vars("id", id) + vars("severity", severity) +
            vars("severity_css", severity_css) + vars("created", created) +
            vars("message", message) + vars("csrf", forms_csrf_field()))
    }
    return out
}

fn mesh_faults_page(req: Request) Response {
    let project: string = current_project()
    if project == "" {
        return page(req, i18n_t(req, "faults.title"),
            "<p>Choose a project first.</p>")
    }
    let rows: string = mesh_fault_rows(project)
    if rows == "" {
        rows = "<tr><td colspan=\"4\">" + i18n_t(req, "faults.empty") + "</td></tr>"
    }
    let body: string = template_fill(template_get("faults"),
        i18n_vars(req) + vars("rows", rows))
    return page(req, i18n_t(req, "faults.title"), body)
}

fn mesh_fault_clear(req: Request) Response {
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return page(req, i18n_t(req, "faults.title"),
            "<p class=\"notice\">" + i18n_t(req, "settings.csrf_refused") + "</p>")
    }
    let id: u32 = u32(rho_int_from_str(form_value(body, "id")))
    let project: string = current_project()
    if project != "" {
        ignore_string(telemetry_fault_clear(project, id))
    }
    if has_header(req, "HX-Request") && rho_str_eq(header_str(req, "HX-Request"), "true") {
        let rows: string = mesh_fault_rows(project)
        if rows == "" {
            rows = "<tr><td colspan=\"4\">" + i18n_t(req, "faults.empty") + "</td></tr>"
        }
        return html(status_ok(), rows)
    }
    return redirect("/faults")
}

fn mesh_api_telemetry_faults(req: Request) Response {
    let project: string = param(req, "project")
    if !mesh_scoped(req, project) {
        return mesh_scope_denied()
    }
    let since: string = request_query_param(req, "since")
    return Response{ 200, telemetry_fault_list(project, since, 100), "application/json", "" }
}
