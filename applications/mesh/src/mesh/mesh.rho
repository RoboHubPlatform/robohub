module mesh.mesh

// The RoboHub Mesh page.
//
// A mesh is a gateway and the nodes that report through it. The page draws that
// tree as cards; a card opens the node it represents, and the same tree is
// drawn read-only once the plan is accepted. The steps after the plan — network,
// build and verify — are the YAML steps, wrapped in the tree so a person always
// sees the thing being configured.

fn board_summary(name: string) string {
    return field(row_by_name(board_rows(), name), 2)
}

fn driver_label(name: string) string {
    if name == "" {
        return "no driver"
    }
    return field(row_by_name(driver_rows(), name), 1)
}

fn node_depth(index: u32) u32 {
    var depth: u32 = 0
    var parent: string = node_value(index, "parent", "gateway")
    var guard: u32 = 0
    while rho_str_index_of(parent, "node.") == 0 && guard < 16 {
        let rest: string = rho_str_slice(parent, 5, u32(rho_strlen(parent)) - 5)
        depth = depth + 1
        parent = node_value(u32(rho_int_from_str(rest)), "parent", "gateway")
        guard = guard + 1
    }
    return depth
}

fn gateway_reachable_for(gateway: string, host: string, rest: string) bool {
    var address: string = host
    if gateway == "native" {
        address = "127.0.0.1"
    }
    let report: string = wizard_report("gateway-health")
    let code: u32 = rho_exec("curl", "-fsS -m 1 http://" + address + ":" + rest + "/healthz", report)
    return code == 0
}

fn gateway_reachable() bool {
    return gateway_reachable_for(default_value("gateway", "native"),
        default_value("gateway_host", "127.0.0.1"),
        default_value("rest_port", WIZARD_DEFAULT_REST))
}

fn gateway_live_badge() string {
    if gateway_reachable() {
        return status_badge("running")
    }
    let state: string = gateway_status()
    if state == "running" || state == "programmed" {
        return "<span class=\"node-status status-failed\">not running</span>"
    }
    return status_badge(state)
}

fn gateway_status() string {
    return default_value("status.gateway", "pending")
}

fn node_status(index: u32) string {
    return default_value("status.node." + rho_int_to_str(index), "pending")
}

fn status_label(status: string) string {
    if status == "pending" {
        return "not built"
    }
    if status == "built" {
        return "built"
    }
    if status == "programmed" {
        return "programmed"
    }
    if status == "running" {
        return "running"
    }
    if status == "failed" {
        return "failed"
    }
    return status
}

fn status_badge(status: string) string {
    return "<span class=\"node-status status-" + status + "\">" +
        escape_html(status_label(status)) + "</span>"
}

fn all_nodes_programmed() bool {
    let count: u32 = node_count()
    if count < 1 {
        return false
    }
    var index: u32 = 1
    while index <= count {
        if node_status(index) != "programmed" {
            return false
        }
        index = index + 1
    }
    return true
}

fn build_complete() bool {
    let status: string = gateway_status()
    return (status == "running" || status == "programmed") && all_nodes_programmed()
}

fn update_build_step() void {
    if build_complete() {
        save_setting("step_build", "done")
        save_setting("build_message", "Gateway running and every node programmed.")
    } else {
        save_setting("step_build", "pending")
    }
    save_setting("step_verify", "pending")
}

fn link_label(link: string) string {
    if link == "wifi" {
        return "WiFi"
    }
    if link == "uart" {
        return "UART"
    }
    if link == "" {
        return "link"
    }
    return link
}

fn node_card_body(index: u32) string {
    let role: string = node_value(index, "role", "node")
    let board: string = node_value(index, "board", "")
    let sensors: string = node_sensors(index)
    let parent: string = node_value(index, "parent", "gateway")
    var name: string = node_value(index, "name", "Node " + rho_int_to_str(index))
    var description: string = node_value(index, "description", "")
    if description == "" {
        description = board_summary(board)
    }
    return "<span class=\"node-role\">" + escape_html(role) + "</span>" +
        "<strong>" + escape_html(name) + "</strong>" +
        "<small>" + escape_html(description) + "</small>" +
        "<span class=\"node-meta\">" + escape_html(label_for(board_rows(), board)) +
        " · " + escape_html(sensor_labels(sensors)) + " · parent " +
        escape_html(parent) + "</span>" + status_badge(node_status(index))
}

fn node_card(index: u32, readonly: bool) string {
    var open: string = "<a class=\"node-card " + node_value(index, "role", "node") + "\""
    var close: string = "</a>"
    if readonly {
        open = "<div class=\"node-card " + node_value(index, "role", "node") + " readonly\""
        close = "</div>"
    } else {
        open = open + " href=\"/mesh/node/" + rho_int_to_str(index) + "\""
    }
    return open + ">" + node_card_body(index) + close
}

fn build_node_card(index: u32) string {
    return "<a class=\"node-card " + node_value(index, "role", "node") +
        " build-link\" href=\"/mesh/build/node/" + rho_int_to_str(index) + "\">" +
        node_card_body(index) + "</a>"
}

fn gateway_card_body() string {
    let gateway: string = default_value("gateway", first_board("gateway"))
    var name: string = default_value("gateway_name", "")
    if name == "" {
        name = label_for(board_rows(), gateway)
    }
    var description: string = default_value("gateway_description", "")
    if description == "" {
        description = board_summary(gateway)
    }
    return "<span class=\"node-role\">gateway</span><strong>" +
        escape_html(name) + "</strong><small>" + escape_html(description) +
        "</small><span class=\"node-meta\">" + escape_html(label_for(board_rows(), gateway)) +
        " · " + escape_html(sensor_labels(gateway_sensors())) + "</span>" + gateway_live_badge()
}

fn gateway_card(readonly: bool) string {
    var open: string = "<a class=\"node-card gateway\" href=\"/mesh/gateway\">"
    var close: string = "</a>"
    if readonly {
        open = "<div class=\"node-card gateway readonly\">"
        close = "</div>"
    }
    return open + gateway_card_body() + close
}

fn build_gateway_card() string {
    return "<a class=\"node-card gateway build-link\" href=\"/mesh/build/gateway\">" +
        gateway_card_body() + "</a>"
}

fn node_attached(index: u32) bool {
    var current: u32 = index
    var guard: u32 = 0
    while guard < 32 {
        let parent: string = node_value(current, "parent", "gateway")
        if parent == "gateway" {
            return true
        }
        if rho_str_index_of(parent, "node.") != 0 {
            return false
        }
        let parent_index: u32 = rho_int_from_str(
            rho_str_slice(parent, 5, u32(rho_strlen(parent)) - 5))
        if parent_index < 1 || parent_index > node_count() {
            return false
        }
        if parent_index >= current {
            return false
        }
        current = parent_index
        guard = guard + 1
    }
    return false
}

// Every child is drawn under its parent, and the badge on the branch is the
// link the child reports over. That is what makes the drawing a tree of
// connections rather than a list of boards.
fn mesh_children(parent: string, readonly: bool) string {
    var out: string = ""
    var index: u32 = 1
    let count: u32 = node_count()
    while index <= count {
        if node_value(index, "parent", "gateway") == parent && node_attached(index) {
            let link: string = node_value(index, "link", "uart")
            out = out + "<li class=\"mesh-branch\"><span class=\"link-badge\">" +
                escape_html(link_label(link)) + "</span>" +
                node_card(index, readonly) +
                mesh_children("node." + rho_int_to_str(index), readonly) + "</li>"
        }
        index = index + 1
    }
    if out == "" {
        return ""
    }
    return "<ul class=\"mesh-children\">" + out + "</ul>"
}

fn mesh_tree(readonly: bool) string {
    var out: string = gateway_card(readonly) + mesh_children("gateway", readonly)
    var orphans: string = ""
    var index: u32 = 1
    let count: u32 = node_count()
    while index <= count {
        if !node_attached(index) {
            orphans = orphans + "<li class=\"mesh-branch\"><span class=\"link-badge\">" +
                escape_html(link_label(node_value(index, "link", "uart"))) + "</span>" +
                node_card(index, readonly) + "</li>"
        }
        index = index + 1
    }
    if orphans != "" {
        out = out + "<p class=\"notice bad\">These nodes are not attached to the gateway.</p>" +
            "<ul class=\"mesh-children\">" + orphans + "</ul>"
    }
    if count == 0 {
        out = out + "<div class=\"node-card empty\"><strong>No nodes yet</strong>" +
            "<small>Add the first node to the mesh.</small></div>"
    }
    return "<div class=\"mesh-tree\">" + out + "</div>"
}

fn mesh_build_children(parent: string) string {
    var out: string = ""
    var index: u32 = 1
    let count: u32 = node_count()
    while index <= count {
        if node_value(index, "parent", "gateway") == parent && node_attached(index) {
            let link: string = node_value(index, "link", "uart")
            out = out + "<li class=\"mesh-branch\"><span class=\"link-badge\">" +
                escape_html(link_label(link)) + "</span>" + build_node_card(index) +
                mesh_build_children("node." + rho_int_to_str(index)) + "</li>"
        }
        index = index + 1
    }
    if out == "" {
        return ""
    }
    return "<ul class=\"mesh-children\">" + out + "</ul>"
}

fn mesh_build_tree() string {
    var out: string = build_gateway_card() + mesh_build_children("gateway")
    var orphans: string = ""
    var index: u32 = 1
    let count: u32 = node_count()
    while index <= count {
        if !node_attached(index) {
            orphans = orphans + "<li class=\"mesh-branch\"><span class=\"link-badge\">" +
                escape_html(link_label(node_value(index, "link", "uart"))) + "</span>" +
                build_node_card(index) + "</li>"
        }
        index = index + 1
    }
    if orphans != "" {
        out = out + "<p class=\"notice bad\">These nodes are not attached to the gateway.</p>" +
            "<ul class=\"mesh-children\">" + orphans + "</ul>"
    }
    if count == 0 {
        out = out + "<div class=\"node-card empty\"><strong>No nodes yet</strong>" +
            "<small>Add the first node to the mesh.</small></div>"
    }
    return "<div class=\"mesh-tree\">" + out + "</div>"
}

/* -------------------------------------------------------------------------- */
/*  Network: the edges, not the nodes                                         */
/* -------------------------------------------------------------------------- */

fn board_cap(name: string, key: string) string {
    let row: string = row_by_name(board_rows(), name)
    if key == "wireless" {
        return field(row, 8)
    }
    if key == "ethernet" {
        return field(row, 9)
    }
    if key == "buses" {
        return field(row, 10)
    }
    if key == "host" {
        return field(row, 7)
    }
    if key == "links" {
        return field(row, 13)
    }
    return ""
}

fn endpoint_board(parent: string) string {
    if parent == "gateway" {
        return default_value("gateway", first_board("gateway"))
    }
    if rho_str_index_of(parent, "node.") == 0 {
        let index: u32 = rho_int_from_str(
            rho_str_slice(parent, 5, u32(rho_strlen(parent)) - 5))
        return node_value(index, "board", "")
    }
    return parent
}

fn transport_universe() string {
    let entry: string = registry_entry("robohub-transport")
    if rho_path_exists(entry) {
        // The registry entry points at the module; the capabilities are in the
        // module's own manifest, not in the entry that says where it lives.
        let root: string = resolve_path(yaml.value(entry, "path"))
        let transports: string = yaml.value(root + "/module.yml", "capabilities.transports")
        if transports != "" {
            return transports
        }
    }
    return "uart wifi"
}

fn transport_allowed(transport: string, parent_board: string, child_board: string) bool {
    let parent_links: string = board_cap(parent_board, "links")
    let child_links: string = board_cap(child_board, "links")
    if transport == "console" {
        // The console is a host's byte stream. A relay is a board with its own
        // links; a host/board that declares `console` in its links can still
        // serve it, which is why this is a capability and not a board name.
        if board_cap(parent_board, "host") != "true" {
            return false
        }
        if parent_links != "" && !words_contain(parent_links, "console") {
            return false
        }
        if child_links != "" && !words_contain(child_links, "console") {
            return false
        }
        return true
    }
    if parent_links != "" && child_links != "" {
        return words_contain(parent_links, transport) && words_contain(child_links, transport)
    }
    if transport == "wifi" {
        return board_cap(parent_board, "wireless") == "true" &&
            board_cap(child_board, "wireless") == "true"
    }
    if transport == "ethernet" {
        return board_cap(parent_board, "ethernet") == "true" &&
            board_cap(child_board, "ethernet") == "true"
    }
    if transport == "socket" {
        let parent_net: bool = board_cap(parent_board, "wireless") == "true" ||
            board_cap(parent_board, "ethernet") == "true" ||
            board_cap(parent_board, "host") == "true"
        let child_net: bool = board_cap(child_board, "wireless") == "true" ||
            board_cap(child_board, "ethernet") == "true" ||
            board_cap(child_board, "host") == "true"
        return parent_net && child_net
    }
    return words_contain(board_cap(parent_board, "buses"), transport) &&
        words_contain(board_cap(child_board, "buses"), transport)
}

fn transport_label(transport: string) string {
    if transport == "uart" { return "UART" }
    if transport == "usb" { return "USB" }
    if transport == "console" { return "Console" }
    if transport == "wifi" { return "WiFi" }
    if transport == "ethernet" { return "Ethernet" }
    if transport == "socket" { return "Socket" }
    if transport == "rs485" { return "RS-485" }
    if transport == "spi" { return "SPI" }
    if transport == "i2c" { return "I2C" }
    return transport
}

fn transport_options_for(index: u32) string {
    let parent: string = node_value(index, "parent", "gateway")
    let parent_board: string = endpoint_board(parent)
    let child_board: string = node_value(index, "board", "")
    let current: string = node_value(index, "link", "")
    var options: string = ""
    var universe: string = transport_universe()
    var found: bool = false
    while universe != "" {
        let at: i32 = rho_str_index_of(universe, " ")
        let transport: string = ""
        if at < 0 {
            transport = universe
            universe = ""
        } else {
            transport = rho_str_slice(universe, 0, u32(at))
            universe = rho_str_slice(universe, u32(at) + 1, u32(rho_strlen(universe)) - u32(at) - 1)
        }
        if transport == "" {
            continue
        }
        if transport_allowed(transport, parent_board, child_board) {
            options = options + option(transport, transport_label(transport), "", current)
            if transport == current {
                found = true
            }
        }
    }
    if current != "" && !found {
        options = options + option(current, transport_label(current) + " (not available on both ends)", "", current)
    }
    return options
}

fn network_nonempty(value: string) bool {
    return rho_strlen(value) > 0
}

fn network_ready(index: u32) bool {
    let link: string = node_value(index, "link", "")
    if link == "" {
        return false
    }
    let prefix: string = "node." + rho_int_to_str(index) + "."
    if link == "wifi" {
        let ssid: string = default_value(prefix + "ssid", default_value("ssid", ""))
        let host: string = default_value(prefix + "parent_host", default_value("gateway_host", ""))
        let port: string = default_value(prefix + "port", default_value("uplink_port", ""))
        return network_nonempty(ssid) && network_nonempty(host) && network_nonempty(port)
    }
    if link == "ethernet" || link == "socket" {
        let parent: string = default_value(prefix + "parent_endpoint", default_value("gateway_host", ""))
        let child: string = default_value(prefix + "child_endpoint", "")
        let port: string = default_value(prefix + "port", "")
        return network_nonempty(parent) && network_nonempty(child) && network_nonempty(port)
    }
    if link == "spi" || link == "i2c" || link == "rs485" {
        let parent: string = default_value(prefix + "parent_endpoint", "")
        let child: string = default_value(prefix + "child_endpoint", "")
        let address: string = default_value(prefix + "bus_address", "")
        return network_nonempty(parent) && network_nonempty(child) && network_nonempty(address)
    }
    let parent_port: string = default_value(prefix + "parent_endpoint", "")
    let child_port: string = default_value(prefix + "child_endpoint", "")
    return network_nonempty(parent_port) && network_nonempty(child_port)
}

fn network_all_ready() bool {
    let count: u32 = node_count()
    if count < 1 {
        return false
    }
    var index: u32 = 1
    while index <= count {
        if !network_ready(index) {
            return false
        }
        index = index + 1
    }
    return true
}

fn network_badge(ready: bool) string {
    if ready {
        return "<span class=\"node-status status-configured\">configured</span>"
    }
    return "<span class=\"node-status status-needs\">needs setup</span>"
}

fn network_link_badge(index: u32) string {
    let link: string = node_value(index, "link", "uart")
    var css: string = "link-badge network-link needs"
    if network_ready(index) {
        css = "link-badge network-link ready"
    }
    return "<a class=\"" + css + "\" href=\"/mesh/network/link/" +
        rho_int_to_str(index) + "\" title=\"Configure this connection\">" +
        escape_html(transport_label(link)) + "</a>"
}

fn node_network_body(index: u32) string {
    let role: string = node_value(index, "role", "node")
    let board: string = node_value(index, "board", "")
    let sensors: string = node_sensors(index)
    let parent: string = node_value(index, "parent", "gateway")
    var name: string = node_value(index, "name", "Node " + rho_int_to_str(index))
    var description: string = node_value(index, "description", "")
    if description == "" {
        description = board_summary(board)
    }
    return "<span class=\"node-role\">" + escape_html(role) + "</span>" +
        "<strong>" + escape_html(name) + "</strong>" +
        "<small>" + escape_html(description) + "</small>" +
        "<span class=\"node-meta\">" + escape_html(label_for(board_rows(), board)) +
        " · " + escape_html(sensor_labels(sensors)) + " · parent " +
        escape_html(parent) + "</span>" + network_badge(network_ready(index))
}

fn gateway_network_body() string {
    let gateway: string = default_value("gateway", first_board("gateway"))
    var name: string = default_value("gateway_name", "")
    if name == "" {
        name = label_for(board_rows(), gateway)
    }
    var description: string = default_value("gateway_description", "")
    if description == "" {
        description = board_summary(gateway)
    }
    return "<span class=\"node-role\">gateway</span><strong>" +
        escape_html(name) + "</strong><small>" + escape_html(description) +
        "</small><span class=\"node-meta\">" + escape_html(label_for(board_rows(), gateway)) +
        "</span>" + network_badge(network_all_ready())
}

fn mesh_network_children(parent: string) string {
    var out: string = ""
    var index: u32 = 1
    let count: u32 = node_count()
    while index <= count {
        if node_value(index, "parent", "gateway") == parent && node_attached(index) {
            out = out + "<li class=\"mesh-branch\">" + network_link_badge(index) +
                "<a class=\"node-card " + node_value(index, "role", "node") +
                " network-link-card\" href=\"/mesh/network/node/" + rho_int_to_str(index) +
                "\">" + node_network_body(index) + "</a>" +
                mesh_network_children("node." + rho_int_to_str(index)) + "</li>"
        }
        index = index + 1
    }
    if out == "" {
        return ""
    }
    return "<ul class=\"mesh-children\">" + out + "</ul>"
}

fn mesh_network_tree() string {
    var out: string = "<a class=\"node-card gateway network-link-card\" href=\"/mesh/network/gateway\">" +
        gateway_network_body() + "</a>" + mesh_network_children("gateway")
    var orphans: string = ""
    var index: u32 = 1
    let count: u32 = node_count()
    while index <= count {
        if !node_attached(index) {
            orphans = orphans + "<li class=\"mesh-branch\">" + network_link_badge(index) +
                "<a class=\"node-card " + node_value(index, "role", "node") +
                " network-link-card\" href=\"/mesh/network/node/" + rho_int_to_str(index) +
                "\">" + node_network_body(index) + "</a></li>"
        }
        index = index + 1
    }
    if orphans != "" {
        out = out + "<p class=\"notice bad\">These nodes are not attached to the gateway.</p>" +
            "<ul class=\"mesh-children\">" + orphans + "</ul>"
    }
    if count == 0 {
        out = out + "<div class=\"node-card empty\"><strong>No nodes yet</strong>" +
            "<small>Add a node on the plan step.</small></div>"
    }
    return "<div class=\"mesh-tree\">" + out + "</div>"
}

fn mesh_step(label: string, href: string, status: string, enabled: bool, current: bool) string {
    var css: string = "step " + status
    if !enabled {
        css = "step disabled"
    }
    if current {
        css = css + " current"
    }
    if enabled {
        return "<a class=\"" + css + "\" href=\"" + href + "\"><strong>" + escape_html(label) +
            "</strong><span>" + escape_html(status) + "</span></a>"
    }
    return "<span class=\"" + css + "\"><strong>" + escape_html(label) +
        "</strong><span>" + escape_html(status) + "</span></span>"
}

fn mesh_steps(current: string) string {
    let topology: string = default_value("step_topology", "pending")
    let network: string = default_value("step_network", "pending")
    let build: string = default_value("step_build", "pending")
    let verify: string = default_value("step_verify", "pending")
    let plan_enabled: bool = true
    let network_enabled: bool = topology == "done" || current == "network" || current == "build" || current == "verify"
    let build_enabled: bool = network == "done" || current == "build" || current == "verify"
    let verify_enabled: bool = build == "done" || current == "verify"
    return "<div class=\"steps\">" +
        mesh_step("1. Plan", "/mesh/plan", topology, plan_enabled, current == "plan") +
        mesh_step("2. Network", "/mesh/step/network", network, network_enabled, current == "network") +
        mesh_step("3. Build & program", "/mesh/step/build", build, build_enabled, current == "build") +
        mesh_step("4. Verify", "/mesh/step/verify", verify, verify_enabled, current == "verify") +
        "</div>"
}

fn mesh_nav(stage: string) string {
    if stage == "network" {
        return "<p class=\"mesh-nav\"><a href=\"/mesh/plan\">← Plan</a>" +
            " · <a href=\"/mesh/step/build\">Build & program →</a></p>"
    }
    if stage == "build" {
        return "<p class=\"mesh-nav\"><a href=\"/mesh/step/network\">← Network</a>" +
            " · <a href=\"/mesh/step/verify\">Verify →</a></p>"
    }
    if stage == "verify" {
        return "<p class=\"mesh-nav\"><a href=\"/mesh/step/build\">← Build & program</a></p>"
    }
    return "<p class=\"mesh-nav\"><a href=\"/mesh\">← Mesh</a></p>"
}

fn reset_build_statuses() void {
    save_setting("status.gateway", "pending")
    var index: u32 = 1
    let count: u32 = node_count()
    while index <= count {
        save_setting("status.node." + rho_int_to_str(index), "pending")
        index = index + 1
    }
}

fn mesh_reset_after(stage: string) void {
    if stage == "topology" {
        reset_build_statuses()
        save_setting("step_network", "pending")
        save_setting("step_build", "pending")
        save_setting("step_verify", "pending")
    } else if stage == "network" {
        reset_build_statuses()
        save_setting("step_build", "pending")
        save_setting("step_verify", "pending")
    } else if stage == "build" {
        save_setting("step_verify", "pending")
    }
}

/* -------------------------------------------------------------------------- */
/*  Projects                                                                  */
/* -------------------------------------------------------------------------- */

fn project_description(id: string) string {
    return state_value_in(project_file(id), "project.description")
}

fn project_status_badge(live: bool, gateway: string) string {
    if gateway == "" {
        return "<span class=\"node-status status-pending\">no gateway</span>"
    }
    if live {
        return "<span class=\"node-status status-running\">running</span>"
    }
    return "<span class=\"node-status status-failed\">not running</span>"
}

fn project_card(id: string) string {
    let file: string = project_file(id)
    let name: string = project_name(id)
    let location: string = project_location(id)
    let gateway: string = state_value_in(file, "gateway")
    let description: string = project_description(id)
    var host: string = state_value_in(file, "gateway_host")
    if host == "" {
        host = "127.0.0.1"
    }
    var rest: string = state_value_in(file, "rest_port")
    if rest == "" {
        rest = WIZARD_DEFAULT_REST
    }
    let live: bool = gateway != "" && gateway_reachable_for(gateway, host, rest)
    var address: string = ""
    if gateway != "" {
        if gateway == "native" {
            address = "http://127.0.0.1:" + rest
        } else {
            address = "http://" + host + ":" + rest
        }
    }
    var last: string = "—"
    if live {
        let nodes: string = gateway_http_for(gateway, host, rest, "/api/v1/nodes")
        last = json_number(nodes, "received_at_ms")
        if last == "" {
            last = json_number(nodes, "last_updated_ms")
        }
        if last == "" {
            last = "—"
        }
    }
    var gateway_label: string = "none"
    if gateway != "" {
        gateway_label = label_for(board_rows(), gateway)
    }
    var address_html: string = "—"
    if address != "" {
        address_html = "<a href=\"" + address + "\">" + escape_html(address) + "</a>"
    }
    var current_class: string = ""
    var active_badge: string = ""
    var active_action: string = ""
    if id == current_project() {
        current_class = " current"
        active_badge = " <span class=\"badge-active\">Active</span>"
        active_action = "<form method=\"post\" action=\"/mesh/project/active\">" +
            "<input type=\"hidden\" name=\"project\" value=\"" + escape_html(id) + "\">" +
            "<input type=\"hidden\" name=\"active\" value=\"0\">" +
            "<button type=\"submit\" class=\"quiet\">Make inactive</button></form>"
    } else {
        active_action = "<form method=\"post\" action=\"/mesh/project/active\">" +
            "<input type=\"hidden\" name=\"project\" value=\"" + escape_html(id) + "\">" +
            "<input type=\"hidden\" name=\"active\" value=\"1\">" +
            "<input type=\"hidden\" name=\"return\" value=\"dashboard\">" +
            "<button type=\"submit\">Set active</button></form>"
    }
    var description_html: string = ""
    if description != "" {
        description_html = "<p class=\"project-desc\">" + escape_html(description) + "</p>"
    }
    return "<div class=\"project-card" + current_class + "\">" +
        "<div class=\"project-head\"><div><h3><a href=\"/mesh/project/" +
        escape_html(id) + "\">" + escape_html(name) + "</a>" + active_badge + "</h3><code>" +
        escape_html(location) + "</code></div>" +
        project_status_badge(live, gateway) + "</div>" +
        "<dl class=\"settings\"><dt>Gateway</dt><dd>" + escape_html(gateway_label) +
        "</dd><dt>Address</dt><dd>" + address_html +
        "</dd><dt>Last update</dt><dd><span class=\"local-time\" data-ms=\"" + escape_html(last) + "\">" + escape_html(last) + " ms</span></dd></dl>" +
        description_html +
        "<p><a class=\"connection-edit\" href=\"/mesh/project/" + escape_html(id) +
        "/settings\">Project settings →</a></p>" +
        "<div class=\"actions\">" + active_action +
        "<form method=\"post\" action=\"/mesh/project/restart\">" +
        "<input type=\"hidden\" name=\"project\" value=\"" + escape_html(id) + "\">" +
        "<button type=\"submit\">Restart</button></form>" +
        "<form method=\"post\" action=\"/mesh/project/stop\">" +
        "<input type=\"hidden\" name=\"project\" value=\"" + escape_html(id) + "\">" +
        "<button type=\"submit\" class=\"danger\">Stop</button></form>" +
        "<form method=\"post\" action=\"/mesh/project/delete\" onsubmit=\"return confirm('Delete this project and its settings?');\">" +
        "<input type=\"hidden\" name=\"project\" value=\"" + escape_html(id) + "\">" +
        "<button type=\"submit\" class=\"danger\">Delete</button></form></div></div>"
}

fn mesh_projects() string {
    var cards: string = ""
    var ids: string = project_ids()
    while ids != "" {
        let at: i32 = rho_str_index_of(ids, "\n")
        let id: string = ""
        if at < 0 {
            id = ids
            ids = ""
        } else {
            id = rho_str_slice(ids, 0, u32(at))
            ids = rho_str_slice(ids, u32(at) + 1, u32(rho_strlen(ids)) - u32(at) - 1)
        }
        if id != "" {
            cards = cards + project_card(id)
        }
    }
    if cards == "" {
        cards = "<p>No projects yet.</p>"
    }
    return "<div class=\"project-grid\">" + cards + "</div>" +
        "<section class=\"mesh-sessions\" id=\"new-project\"><h2>Create a project</h2>" +
        "<p>A project is a folder in the projects workspace; its plan, network, build and verify settings live there.</p>" +
        "<form class=\"grid\" method=\"post\" action=\"/mesh/project/new\">" +
        "<label>Project name<input type=\"text\" name=\"name\" placeholder=\"Greenhouse gateway\"></label>" +
        "<button type=\"submit\">Create project</button></form></section>"
}

fn mesh_project_open_page(req: Request) Response {
    let id: string = param(req, "id")
    if !load_project(id) {
        return mesh_dashboard(req)
    }
    info("mesh", "opened project " + id + " at " + project_location(id))
    return mesh_page(req)
}

fn mesh_project_new(req: Request) Response {
    let name: string = form_value(request_body(req), "name")
    let id: string = new_project(name)
    info("mesh", "created project " + id + " at " + project_location(id))
    return mesh_page(req)
}

fn mesh_project_settings_page(req: Request) Response {
    return mesh_project_settings_for(req, param(req, "id"))
}

fn mesh_project_settings_for(req: Request, id: string) Response {
    let file: string = project_file(id)
    if !rho_path_exists(file) {
        return mesh_dashboard(req)
    }
    let name: string = project_name(id)
    let description: string = project_description(id)
    let form: string = "<form class=\"grid\" method=\"post\" action=\"/mesh/project/" +
        escape_html(id) + "/settings\">" +
        mesh_input("name", "Project name", name, "The name shown on the dashboard.") +
        mesh_input("description", "Short description", description,
            "One line about what this mesh is for.") +
        "<button type=\"submit\">Save project</button></form>"
    var active_form: string = ""
    if id == current_project() {
        active_form = "<p class=\"notice\">This project is the active one. The Operations menu and every step page act on it.</p>" +
            "<form method=\"post\" action=\"/mesh/project/active\">" +
            "<input type=\"hidden\" name=\"project\" value=\"" + escape_html(id) + "\">" +
            "<input type=\"hidden\" name=\"active\" value=\"0\">" +
            "<input type=\"hidden\" name=\"return\" value=\"settings\">" +
            "<button type=\"submit\" class=\"quiet\">Make inactive</button></form>"
    } else {
        active_form = "<p>No project is active, or another project is. Set this one active to work on its plan.</p>" +
            "<form method=\"post\" action=\"/mesh/project/active\">" +
            "<input type=\"hidden\" name=\"project\" value=\"" + escape_html(id) + "\">" +
            "<input type=\"hidden\" name=\"active\" value=\"1\">" +
            "<input type=\"hidden\" name=\"return\" value=\"settings\">" +
            "<button type=\"submit\">Set as active</button></form>"
    }
    let content: string = template_fill(template_get("mesh-project-settings"),
        vars("project", escape_html(id)) +
        vars("location", project_location(id)) +
        vars("notice", state_value_in(file, "message.project")) +
        vars("form", form) +
        vars("active", active_form) +
        vars("actions", "<form method=\"post\" action=\"/mesh/project/delete\" " +
            "onsubmit=\"return confirm('Delete this project and its settings?');\">" +
            "<input type=\"hidden\" name=\"project\" value=\"" + escape_html(id) + "\">" +
            "<button type=\"submit\" class=\"danger\">Delete project</button></form>"))
    return html(status_ok(), mesh_shell("Project settings", content))
}

fn mesh_project_active(req: Request) Response {
    let body: string = request_body(req)
    let id: string = sanitize(form_value(body, "project"))
    let active: string = form_value(body, "active")
    if active == "0" {
        ignore_bool(rho_write_text(current_project_file(), ""))
        info("mesh", "no project is active")
        return mesh_dashboard(req)
    }
    if id == "" || rho_str_index_of(id, "/") >= 0 || rho_str_index_of(id, "..") >= 0 ||
        !rho_path_exists(project_file(id)) {
        return mesh_dashboard(req)
    }
    ignore_bool(rho_write_text(current_project_file(), id + "\n"))
    info("mesh", "activated project " + id)
    if form_value(body, "return") == "settings" {
        return mesh_project_settings_for(req, id)
    }
    return mesh_dashboard(req)
}

fn mesh_project_settings_post(req: Request) Response {
    let id: string = param(req, "id")
    let file: string = project_file(id)
    if !rho_path_exists(file) {
        return mesh_dashboard(req)
    }
    let body: string = request_body(req)
    var name: string = form_value(body, "name")
    if name == "" {
        name = id
    }
    save_setting_at(file, "project.name", name)
    save_setting_at(file, "project.description", form_value(body, "description"))
    save_setting_at(file, "message.project", "Project settings saved.")
    info("mesh", "project " + id + " settings saved")
    return mesh_project_settings_page(req)
}

fn mesh_project_delete(req: Request) Response {
    let id: string = sanitize(form_value(request_body(req), "project"))
    if id == "" || rho_str_index_of(id, "/") >= 0 || rho_str_index_of(id, "..") >= 0 {
        return mesh_dashboard(req)
    }
    let file: string = project_file(id)
    if !rho_path_exists(file) {
        return mesh_dashboard(req)
    }
    let was_current: bool = id == current_project()
    if was_current && gateway_reachable() {
        ignore_u32(rho_exec("pkill", "-x robohub-gateway", wizard_report("delete-stop-gateway")))
    }
    ignore_u32(rho_exec("rm", "-rf " + project_location(id), wizard_report("delete-project")))
    if was_current {
        var next: string = ""
        var listing: string = project_listing()
        while listing != "" {
            let at: i32 = rho_str_index_of(listing, "\n")
            let candidate: string = ""
            if at < 0 {
                candidate = listing
                listing = ""
            } else {
                candidate = rho_str_slice(listing, 0, u32(at))
                listing = rho_str_slice(listing, u32(at) + 1, u32(rho_strlen(listing)) - u32(at) - 1)
            }
            if candidate != id && rho_path_exists(project_file(candidate)) {
                next = candidate
                break
            }
        }
        if next == "" {
            // Deleting the last project leaves the application with no active
            // project rather than creating one nobody asked for. The Operations
            // menu disappears; the dashboard still creates a new one.
            ignore_bool(rho_write_text(current_project_file(), ""))
        } else {
            ignore_bool(rho_write_text(current_project_file(), next + "\n"))
        }
    }
    info("mesh", "deleted project " + id)
    return mesh_dashboard(req)
}

fn mesh_project_actions(id: string) string {
    return "<p class=\"mesh-nav\"><a href=\"/mesh/project/" + escape_html(id) +
        "/settings\">Project settings</a> · <form style=\"display:inline\" method=\"post\" " +
        "action=\"/mesh/project/delete\" onsubmit=\"return confirm('Delete this project and its settings?');\">" +
        "<input type=\"hidden\" name=\"project\" value=\"" + escape_html(id) + "\">" +
        "<button type=\"submit\" class=\"danger\">Delete project</button></form></p>"
}

fn mesh_project_restart(req: Request) Response {
    let id: string = form_value(request_body(req), "project")
    if !load_project(id) {
        return mesh_dashboard(req)
    }
    return mesh_gateway_restart(req)
}

fn mesh_project_stop(req: Request) Response {
    let id: string = form_value(request_body(req), "project")
    if !load_project(id) {
        return mesh_dashboard(req)
    }
    return mesh_gateway_stop(req)
}

/* -------------------------------------------------------------------------- */
/*  Node and gateway forms                                                    */
/* -------------------------------------------------------------------------- */

fn mesh_input(name: string, label: string, value: string, help: string) string {
    var help_html: string = ""
    if help != "" {
        help_html = "<small>" + escape_html(help) + "</small>"
    }
    return "<label>" + escape_html(label) + "<input type=\"text\" name=\"" +
        escape_html(name) + "\" value=\"" + escape_html(value) + "\">" + help_html + "</label>"
}

fn mesh_textarea(name: string, label: string, value: string) string {
    return "<label>" + escape_html(label) + "<input type=\"text\" name=\"" +
        escape_html(name) + "\" value=\"" + escape_html(value) + "\"></label>"
}

fn mesh_select(name: string, label: string, options: string, help: string) string {
    var help_html: string = ""
    if help != "" {
        help_html = "<small>" + escape_html(help) + "</small>"
    }
    return "<label>" + escape_html(label) + "<select name=\"" + escape_html(name) +
        "\">" + options + "</select>" + help_html + "</label>"
}

fn parent_options(limit: u32, selected: string) string {
    var options: string = option("gateway", "Gateway", "", selected)
    var index: u32 = 1
    while index <= limit {
        options = options + option("node." + rho_int_to_str(index),
            "Node " + rho_int_to_str(index) + " (" +
            node_value(index, "name", "Node " + rho_int_to_str(index)) + ")", "", selected)
        index = index + 1
    }
    return options
}

fn mesh_node_page(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    ensure_wizard_dir()
    let raw: string = param(req, "index")
    let is_new: bool = raw == "new"
    var index: u32 = node_count() + 1
    if !is_new {
        index = rho_int_from_str(raw)
    }
    if index < 1 || index > node_count() + 1 {
        return mesh_page(req)
    }
    let role: string = node_value(index, "role", "node")
    let sensors: string = node_sensors(index)
    let board: string = node_value(index, "board", first_board(role))
    let parent: string = node_value(index, "parent", "gateway")
    let link: string = node_value(index, "link", "wifi")
    var name: string = node_value(index, "name", "Node " + rho_int_to_str(index))
    var description: string = node_value(index, "description", "")
    if description == "" {
        description = board_summary(board)
    }
    var title: string = "Edit node " + rho_int_to_str(index)
    if is_new {
        title = "Add a node"
    }
    var limit: u32 = index - 1
    if is_new {
        limit = node_count()
    }
    let role_options: string = option("node", "node", "", role) +
        option("relay", "relay", "", role) + option("gateway", "gateway", "", role)
    var plan_html: string = ""
    if !is_new {
        plan_html = "<h2>Bus plan</h2>" + node_bus_html(index)
        if node_bus_conflicts(index) {
            plan_html = plan_html + "<p class=\"notice bad\">A module's bus or address is already in use. " +
                "That module is left out of the image so the node still builds.</p>"
        }
    }
    let form: string = "<form class=\"node-form\" method=\"post\" action=\"/mesh/node/" +
        escape_html(raw) + "\">" +
        "<input type=\"hidden\" name=\"action\" value=\"save\">" +
        "<div class=\"grid\">" +
        mesh_input("name", "Name", name, "What this node is called in the mesh.") +
        mesh_textarea("description", "Description", description) +
        mesh_select("role", "Role", role_options, "node measures, relay also has children, gateway is another host.") +
        mesh_select("board", "Board", board_options_for(role, "", board), "The compute board this node is built for.") +
        mesh_select("parent", "Parent", parent_options(limit, parent), "Where this node reports through.") +
        mesh_select("link", "Link", option("uart", "UART", "", link) + option("wifi", "WiFi", "", link), "") +
        "</div>" +
        "<fieldset class=\"sensor-picker\"><legend>Attached modules</legend>" +
        "<p><small>Any number of sensor modules can be fitted to this node. They are carried by the node's image; only the node itself is built and programmed. The first module selects the example the image is built from.</small></p>" +
        sensor_checkboxes(sensors) + "</fieldset>" +
        "<div class=\"form-actions\"><button type=\"submit\">Save node</button></div></form>"
    var delete_form: string = ""
    if !is_new {
        delete_form = "<form method=\"post\" action=\"/mesh/node/" + escape_html(raw) +
            "\"><input type=\"hidden\" name=\"action\" value=\"delete\">" +
            "<button type=\"submit\" class=\"danger\">Delete node</button></form>"
    }
    let body: string = "<h1>" + escape_html(title) + "</h1><p>Choose the role and the board, " +
        "then attach the modules fitted to it. Modules are read from robohub-drivers at this " +
        "moment, so a new board appears here without a rebuild.</p>" + form + plan_html + delete_form +
        "<p class=\"mesh-nav\"><a href=\"/mesh\">← Mesh</a></p>"
    return page(title, body)
}

fn mesh_node_post(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    ensure_wizard_dir()
    let raw: string = param(req, "index")
    let body: string = request_body(req)
    let action: string = form_value(body, "action")
    if raw == "new" {
        if action != "save" {
            return mesh_page(req)
        }
        let index: u32 = node_count() + 1
        let role: string = form_value(body, "role")
        let board: string = form_value(body, "board")
        let sensors: string = form_values(body, "sensors")
        let parent: string = form_value(body, "parent")
        let link: string = form_value(body, "link")
        if role == "" || board == "" || parent == "" || link == "" {
            save_setting("mesh_message", "A node needs a role, a board, a parent and a link.")
            return mesh_page(req)
        }
        let prefix: string = "node." + rho_int_to_str(index) + "."
        save_setting("node.count", rho_int_to_str(index))
        save_setting(prefix + "name", form_value(body, "name"))
        save_setting(prefix + "description", form_value(body, "description"))
        save_setting(prefix + "role", role)
        save_setting(prefix + "board", board)
        save_setting(prefix + "sensors", sensors)
        save_setting(prefix + "driver", "")
        save_setting(prefix + "parent", parent)
        save_setting(prefix + "link", link)
        if index == 1 {
            save_setting("relay", board)
            save_setting("link", link)
        }
        save_setting("step_topology", "pending")
        mesh_reset_after("topology")
        save_setting("mesh_message", "Node " + rho_int_to_str(index) + " added.")
        return mesh_page(req)
    }

    let index: u32 = rho_int_from_str(raw)
    let count: u32 = node_count()
    if index < 1 || index > count {
        return mesh_page(req)
    }
    if action == "delete" {
        var j: u32 = index
        while j < count {
            let from: string = "node." + rho_int_to_str(j + 1) + "."
            let to: string = "node." + rho_int_to_str(j) + "."
            save_setting(to + "name", state_value(from + "name"))
            save_setting(to + "description", state_value(from + "description"))
            save_setting(to + "role", state_value(from + "role"))
            save_setting(to + "board", state_value(from + "board"))
            save_setting(to + "sensors", state_value(from + "sensors"))
            save_setting(to + "driver", state_value(from + "driver"))
            save_setting(to + "link", state_value(from + "link"))
            var parent: string = state_value(from + "parent")
            if parent == "node." + rho_int_to_str(index) {
                parent = "gateway"
            } else if rho_str_index_of(parent, "node.") == 0 {
                let parent_index: u32 = rho_int_from_str(
                    rho_str_slice(parent, 5, u32(rho_strlen(parent)) - 5))
                if parent_index > index {
                    parent = "node." + rho_int_to_str(parent_index - 1)
                }
            }
            save_setting(to + "parent", parent)
            j = j + 1
        }
        let last: string = "node." + rho_int_to_str(count) + "."
        save_setting(last + "name", "")
        save_setting(last + "description", "")
        save_setting(last + "role", "")
        save_setting(last + "board", "")
        save_setting(last + "sensors", "")
        save_setting(last + "driver", "")
        save_setting(last + "parent", "")
        save_setting(last + "link", "")
        save_setting("node.count", rho_int_to_str(count - 1))
        save_setting("relay", node_value(1, "board", ""))
        save_setting("link", node_value(1, "link", "uart"))
        save_setting("step_topology", "pending")
        mesh_reset_after("topology")
        save_setting("mesh_message", "Node " + rho_int_to_str(index) + " removed.")
        return mesh_page(req)
    }

    let role: string = form_value(body, "role")
    let board: string = form_value(body, "board")
    let sensors: string = form_values(body, "sensors")
    let parent: string = form_value(body, "parent")
    let link: string = form_value(body, "link")
    if role == "" || board == "" || parent == "" || link == "" {
        save_setting("mesh_message", "A node needs a role, a board, a parent and a link.")
        return mesh_node_page(req)
    }
    var name: string = form_value(body, "name")
    if name == "" {
        name = "Node " + rho_int_to_str(index)
    }
    let prefix: string = "node." + rho_int_to_str(index) + "."
    save_setting(prefix + "name", name)
    save_setting(prefix + "description", form_value(body, "description"))
    save_setting(prefix + "role", role)
    save_setting(prefix + "board", board)
    save_setting(prefix + "sensors", sensors)
    save_setting(prefix + "driver", "")
    save_setting(prefix + "parent", parent)
    save_setting(prefix + "link", link)
    if index == 1 {
        save_setting("relay", board)
        save_setting("link", link)
    }
    save_setting("step_topology", "pending")
    mesh_reset_after("topology")
    save_setting("mesh_message", "Node " + rho_int_to_str(index) + " saved.")
    return mesh_page(req)
}

fn mesh_gateway_page(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    ensure_wizard_dir()
    let gateway: string = default_value("gateway", first_board("gateway"))
    let sensors: string = gateway_sensors()
    var name: string = default_value("gateway_name", "")
    if name == "" {
        name = label_for(board_rows(), gateway)
    }
    var description: string = default_value("gateway_description", "")
    if description == "" {
        description = board_summary(gateway)
    }
    let form: string = "<form class=\"grid\" method=\"post\" action=\"/mesh/gateway\">" +
        mesh_input("name", "Name", name, "What the gateway is called in this mesh.") +
        mesh_textarea("description", "Description", description) +
        mesh_select("gateway", "Board", options_from_rows(board_rows(), "board", "gateway", gateway),
            "This host, or a board whose manifest says it can gateway.") +
        "<fieldset class=\"sensor-picker\"><legend>Attached modules</legend>" +
        "<p><small>Sensor modules fitted to the gateway itself. They are carried by the gateway, " +
        "not built as separate nodes.</small></p>" + sensor_checkboxes(sensors) + "</fieldset>" +
        "<div class=\"form-actions\"><button type=\"submit\">Save gateway</button></div></form>"
    return page("Gateway", "<h1>Gateway</h1><p>The root of the mesh.</p>" + form +
        "<p class=\"mesh-nav\"><a href=\"/mesh\">← Mesh</a></p>")
}

fn mesh_gateway_post(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    let body: string = request_body(req)
    let gateway: string = form_value(body, "gateway")
    if gateway == "" {
        save_setting("mesh_message", "Choose a gateway.")
        return mesh_gateway_page(req)
    }
    save_setting("gateway", gateway)
    save_setting("gateway_name", form_value(body, "name"))
    save_setting("gateway_description", form_value(body, "description"))
    save_setting("gateway_sensors", form_values(body, "sensors"))
    save_setting("gateway_driver", "")
    save_setting("step_topology", "pending")
    mesh_reset_after("topology")
    save_setting("mesh_message", "Gateway saved.")
    return mesh_page(req)
}

/* -------------------------------------------------------------------------- */
/*  The mesh page and the later steps                                         */
/* -------------------------------------------------------------------------- */

fn mesh_plan_panel(editing: bool) string {
    let count: u32 = node_count()
    var accept: string = ""
    if editing {
        accept = "<p><a class=\"button\" href=\"/mesh/node/new\">+ Add node</a></p>"
        if count >= 1 {
            accept = accept + "<form method=\"post\" action=\"/mesh/accept\">" +
                "<button type=\"submit\">Accept topology</button></form>" +
                "<p><small>Accepting locks the tree; the next step is the network.</small></p>"
        } else {
            accept = accept + "<p><small>Add at least one node, then accept the topology.</small></p>"
        }
    } else {
        accept = "<p class=\"notice\">Topology accepted. The tree is read-only; " +
            "edit it to change the plan.</p>" +
            "<form method=\"post\" action=\"/mesh/reopen\">" +
            "<button type=\"submit\">Edit topology</button></form>" +
            "<p><a class=\"button\" href=\"/mesh/step/network\">Next: network →</a></p>"
    }
    let message: string = state_value("mesh_message")
    var notice: string = ""
    if message != "" {
        notice = "<p class=\"notice\">" + escape_html(message) + "</p>"
    }
    return notice + "<h2>Plan</h2>" +
        "<p>The gateway is the root. Add nodes, and give each one a role, a board, " +
        "a driver, a parent and a link.</p>" + accept
}

/* -------------------------------------------------------------------------- */
/*  The mesh dashboard                                                        */
/* -------------------------------------------------------------------------- */

fn json_number(text: string, key: string) string {
    let needle: string = "\"" + key + "\":";
    let at: i32 = rho_str_index_of(text, needle)
    if at < 0 {
        return ""
    }
    var index: u32 = u32(at) + u32(rho_strlen(needle))
    let length: u32 = u32(rho_strlen(text))
    var out: string = ""
    while index < length {
        let ch: string = rho_str_slice(text, index, 1)
        if ch == "-" || (ch >= "0" && ch <= "9") || ch == "." {
            out = out + ch
            index = index + 1
        } else {
            break
        }
    }
    return out
}

fn gateway_address() string {
    let gateway: string = default_value("gateway", "native")
    let rest: string = default_value("rest_port", WIZARD_DEFAULT_REST)
    var host: string = default_value("gateway_host", "127.0.0.1")
    if gateway == "native" {
        host = "127.0.0.1"
    }
    return "http://" + host + ":" + rest
}

fn gateway_network_address() string {
    if default_value("gateway", "native") == "native" {
        return "http://" + host_address() + ":" +
            default_value("rest_port", WIZARD_DEFAULT_REST)
    }
    return gateway_address()
}

fn gateway_http_for(gateway: string, host: string, rest: string, path: string) string {
    var address: string = host
    if gateway == "native" {
        address = "127.0.0.1"
    }
    let report: string = wizard_report("dashboard-gateway")
    let code: u32 = rho_exec("curl", "-fsS -m 2 http://" + address + ":" + rest + path, report)
    if code != 0 {
        return ""
    }
    return rho_read_text(report)
}

fn gateway_http(path: string) string {
    return gateway_http_for(default_value("gateway", "native"),
        default_value("gateway_host", "127.0.0.1"),
        default_value("rest_port", WIZARD_DEFAULT_REST), path)
}

/* -------------------------------------------------------------------------- */
/*  The application's own menu                                                */
/* -------------------------------------------------------------------------- */

// The menu belongs to the application, not to the keeper that may have started
// it. It offers the operations a mesh is built through, the projects already in
// the workspace, and a way back to the keeper when the keeper is the one that
// opened this page.

fn mesh_menu_link(label: string, href: string, icon: string) string {
    return "<li><a href=\"" + href + "\"><span class=\"ico\">" + icon + "</span>" +
        escape_html(label) + "</a></li>"
}

fn mesh_project_menu() string {
    var items: string = ""
    var ids: string = project_ids()
    while ids != "" {
        let at: i32 = rho_str_index_of(ids, "\n")
        let id: string = ""
        if at < 0 {
            id = ids
            ids = ""
        } else {
            id = rho_str_slice(ids, 0, u32(at))
            ids = rho_str_slice(ids, u32(at) + 1, u32(rho_strlen(ids)) - u32(at) - 1)
        }
        if id == "" {
            continue
        }
        var current: string = ""
        var badge: string = ""
        if id == current_project() {
            current = " class=\"current\""
            badge = "<span class=\"nav-badge\">Active</span>"
        }
        items = items + "<li><a" + current + " href=\"/mesh/project/" + escape_html(id) +
            "\">" + escape_html(project_name(id)) + badge + "</a></li>"
    }
    if items == "" {
        items = "<li><span class=\"nav-empty\">No projects yet</span></li>"
    }
    return "<li class=\"nav-projects\"><ul class=\"subnav\">" + items + "</ul></li>"
}

fn mesh_menu() string {
    ensure_wizard_dir()
    var out: string = ""
    let keeper_port: string = getenv("RHO_KEEPER_PORT")
    if keeper_port != "" {
        out = out + "<li><a class=\"nav-up keeper-link\" href=\"#\" data-keeper-port=\"" +
            escape_html(keeper_port) + "\"><span class=\"ico\">↑</span>Go to Keeper</a></li>" +
            "<li class=\"nav-rule\"></li>"
    }
    out = out + mesh_menu_link("Dashboard", "/mesh", "⌁")
    let active: string = current_project()
    if active != "" {
        let active_name: string = project_name(active)
        out = out + "<li class=\"nav-title\">Operations</li>"
        out = out + "<li class=\"nav-context\">for <strong>" + escape_html(active_name) +
            "</strong></li>"
        out = out + mesh_menu_link("Plan", "/mesh/plan", "1")
        out = out + mesh_menu_link("Network", "/mesh/step/network", "2")
        out = out + mesh_menu_link("Build & program", "/mesh/step/build", "3")
        out = out + mesh_menu_link("Verify", "/mesh/step/verify", "4")
        out = out + mesh_menu_link("Gateway", "/mesh/gateway", "⌂")
        out = out + mesh_menu_link("Project settings",
            "/mesh/project/" + active + "/settings", "⚙")
    }
    out = out + "<li class=\"nav-title\">Projects</li>"
    out = out + "<li><a class=\"new-project\" href=\"/mesh#new-project\"><span class=\"ico\">+</span>New project</a></li>"
    out = out + mesh_project_menu()
    out = out + "<li class=\"nav-title\">Help</li>"
    out = out + mesh_menu_link("Documentation", "/mesh/docs", "▤")
    return out
}

fn mesh_shell(title: string, content: string) string {
    return template_fill(template_get("layout"),
        vars("title", title) + vars("menu", mesh_menu()) + vars("body", content))
}

fn mesh_docs_page(req: Request) Response {
    // The guide ships with the application. A hosted application runs from its
    // own folder, while one started from the repository root has the
    // orchestrator's module.yml in front of it; both reach the same file.
    var source: string = "docs/index.md"
    if !rho_path_exists("module.yml") || yaml.value("module.yml", "module.name") != "mesh" {
        let shipped: string = robohub_root() + "/applications/mesh/docs/index.md"
        if rho_path_exists(shipped) {
            source = shipped
        }
    }
    var content: string = docs_render_source(source)
    if content == "" {
        content = "<h1>Documentation</h1><p>No documentation was found for this application.</p>"
    }
    return html(status_ok(), mesh_shell("Documentation", content))
}

fn mesh_dashboard(req: Request) Response {
    ensure_wizard_dir()
    let content: string = template_fill(template_get("mesh-dashboard"),
        vars("location", projects_dir()) +
        vars("projects", mesh_projects()))
    return html(status_ok(), mesh_shell("RoboHub Mesh", content))
}

fn mesh_gateway_restart(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    let code: u32 = handler_program_gateway()
    if code == 0 {
        if default_value("gateway", "native") == "native" {
            save_setting("status.gateway", "running")
        } else {
            save_setting("status.gateway", "programmed")
        }
        update_build_step()
        save_setting("message.build", "Gateway restarted.")
        info("mesh", "gateway restarted")
    } else {
        save_setting("status.gateway", "failed")
        save_setting("message.build", "Gateway restart failed with status " + rho_int_to_str(code) + ".")
        error("mesh", "gateway restart failed with status " + rho_int_to_str(code))
    }
    return mesh_dashboard(req)
}

fn mesh_gateway_stop(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    let gateway: string = default_value("gateway", "native")
    if gateway == "native" {
        ignore_u32(rho_exec("pkill", "-x robohub-gateway", wizard_report("stop-gateway")))
    } else {
        let manifest: string = board_manifest(gateway)
        let method: string = yaml.value(manifest, "deployment.method")
        let host: string = default_value("gateway_host", "127.0.0.1")
        if method == "adb" {
            let command: string = "adb -t $(adb devices -l | awk 'NR==2 { sub(\"transport_id:\", \"\", $4); print $4 }') shell 'pkill -x robohub-gateway 2>/dev/null || true'"
            ignore_u32(run_shell(command, "stop-gateway"))
        } else if method == "ssh" {
            let user: string = yaml.value(manifest, "deployment.user")
            if user != "" {
                ignore_u32(run_shell("ssh " + shell_quote(user + "@" + host) +
                    " " + shell_quote("pkill -x robohub-gateway 2>/dev/null || true"), "stop-gateway"))
            }
        }
    }
    save_setting("status.gateway", "pending")
    save_setting("step_build", "pending")
    save_setting("step_verify", "pending")
    save_setting("message.build", "Gateway stopped.")
    info("mesh", "gateway stopped")
    return mesh_dashboard(req)
}

fn mesh_page(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    ensure_wizard_dir()
    let editing: bool = default_value("step_topology", "pending") != "done"
    var title: string = yaml.value(spec_main(), "title")
    if title == "" {
        title = "RoboHub Mesh"
    }
    var description: string = yaml.value(spec_main(), "description")
    if description == "" {
        description = "A gateway and the nodes that report through it."
    }
    let project_name_text: string = project_name(current_project())
    let project_path: string = project_location(current_project())
    let content: string = template_fill(template_get("mesh"),
        vars("title", title) +
        vars("description", "Project " + project_name_text + " · " + project_path +
            ". " + description) +
        vars("steps", mesh_steps("plan")) +
        vars("tree", mesh_tree(!editing)) +
        vars("project_actions", mesh_project_actions(current_project())) +
        vars("plan", mesh_plan_panel(editing)))
    return html(status_ok(), mesh_shell(title, content))
}

fn mesh_accept(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    let count: u32 = node_count()
    if count < 1 {
        save_setting("mesh_message", "Add at least one node before accepting the topology.")
        return mesh_page(req)
    }
    var index: u32 = 1
    while index <= count {
        if node_value(index, "role", "") == "" || node_value(index, "board", "") == "" ||
            node_value(index, "parent", "") == "" || node_value(index, "link", "") == "" {
            save_setting("mesh_message", "Node " + rho_int_to_str(index) + " is incomplete.")
            return mesh_page(req)
        }
        index = index + 1
    }
    save_setting("step_topology", "done")
    mesh_reset_after("topology")
    save_setting("mesh_message", "Topology accepted. The tree is locked.")
    return mesh_page(req)
}

fn mesh_reopen(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    save_setting("step_topology", "pending")
    mesh_reset_after("topology")
    save_setting("mesh_message", "Topology unlocked for editing.")
    return mesh_page(req)
}

fn mesh_secret(name: string, label: string, value: string) string {
    return "<label>" + escape_html(label) + "<input type=\"password\" name=\"" +
        escape_html(name) + "\" value=\"" + escape_html(value) + "\"></label>"
}

fn node_network_row(index: u32) string {
    let prefix: string = "node." + rho_int_to_str(index) + "."
    let link: string = node_value(index, "link", "uart")
    let name: string = node_value(index, "name", "Node " + rho_int_to_str(index))
    let role: string = node_value(index, "role", "node")
    let parent: string = node_value(index, "parent", "gateway")
    var fields: string = ""
    if link == "wifi" {
        fields = mesh_input(prefix + "ssid", "SSID",
            default_value(prefix + "ssid", default_value("ssid", "")), "")
        fields = fields + mesh_secret(prefix + "password", "Password",
            default_value(prefix + "password", default_value("password", "")))
        fields = fields + mesh_input(prefix + "gateway_host", "Gateway host",
            default_value(prefix + "gateway_host", default_value("gateway_host", "127.0.0.1")), "")
    } else {
        fields = mesh_input(prefix + "serial_port", "Serial port",
            default_value(prefix + "serial_port", default_value("serial_port", "/dev/ttyACM0")), "")
    }
    return "<tr><td><strong>" + escape_html(name) + "</strong><br><small>" +
        escape_html(role) + "</small></td><td>" + escape_html(link_label(link)) +
        "</td><td>" + escape_html(parent) + "</td><td>" + fields + "</td></tr>"
}

fn mesh_network_form() string {
    let stage: string = "network"
    var global_fields: string = ""
    var fields: string = field_keys(stage)
    while fields != "" {
        let at: i32 = rho_str_index_of(fields, "\n")
        let name: string = ""
        if at < 0 {
            name = fields
            fields = ""
        } else {
            name = rho_str_slice(fields, 0, u32(at))
            fields = rho_str_slice(fields, u32(at) + 1, u32(rho_strlen(fields)) - u32(at) - 1)
        }
        if name != "" {
            global_fields = global_fields + field_input(stage, name)
        }
    }
    var rows: string = ""
    var index: u32 = 1
    let count: u32 = node_count()
    while index <= count {
        rows = rows + node_network_row(index)
        index = index + 1
    }
    return "<form class=\"grid\" method=\"post\" action=\"/mesh/step/network\">" +
        "<input type=\"hidden\" name=\"action\" value=\"save_network\">" +
        global_fields +
        "<h3>Node network</h3>" +
        "<table class=\"network-nodes\"><thead><tr><th>Node</th><th>Link</th>" +
        "<th>Parent</th><th>Address</th></tr></thead><tbody>" + rows +
        "</tbody></table>" +
        "<button type=\"submit\">Save network</button></form>"
}

fn endpoint_value(index: u32, key: string, fallback: string) string {
    return default_value("node." + rho_int_to_str(index) + "." + key, fallback)
}

fn connection_summary(index: u32) string {
    let parent: string = node_value(index, "parent", "gateway")
    let link: string = node_value(index, "link", "uart")
    var parent_name: string = "Gateway"
    if parent != "gateway" {
        let parent_index: u32 = rho_int_from_str(
            rho_str_slice(parent, 5, u32(rho_strlen(parent)) - 5))
        parent_name = node_value(parent_index, "name", "Node " + rho_int_to_str(parent_index))
    }
    let child_name: string = node_value(index, "name", "Node " + rho_int_to_str(index))
    let prefix: string = "node." + rho_int_to_str(index) + "."
    var detail: string = ""
    if link == "wifi" {
        let ssid: string = default_value(prefix + "ssid", default_value("ssid", ""))
        let host: string = default_value(prefix + "parent_host", default_value("gateway_host", "127.0.0.1"))
        let port: string = default_value(prefix + "port", default_value("uplink_port", "5001"))
        detail = "SSID " + ssid + " · " + host + ":" + port
    } else if link == "ethernet" || link == "socket" {
        let parent_ep: string = default_value(prefix + "parent_endpoint", default_value("gateway_host", ""))
        let child_ep: string = default_value(prefix + "child_endpoint", "")
        let port: string = default_value(prefix + "port", "")
        detail = parent_ep + " ↔ " + child_ep + ":" + port
    } else if link == "spi" || link == "i2c" || link == "rs485" {
        let parent_ep: string = default_value(prefix + "parent_endpoint", "")
        let child_ep: string = default_value(prefix + "child_endpoint", "")
        let address: string = default_value(prefix + "bus_address", "")
        detail = parent_ep + " ↔ " + child_ep + " · address " + address
    } else {
        let parent_ep: string = default_value(prefix + "parent_endpoint", "/dev/ttyACM0")
        let child_ep: string = default_value(prefix + "child_endpoint", "/dev/ttyACM0")
        let baud: string = default_value(prefix + "baud", "115200")
        detail = parent_ep + " ↔ " + child_ep + " @ " + baud
    }
    return "<div class=\"connection-summary\"><div><strong>" + escape_html(parent_name) +
        " → " + escape_html(child_name) + "</strong><span class=\"connection-transport\">" +
        escape_html(transport_label(link)) + "</span></div><small>" + escape_html(detail) +
        "</small>" + network_badge(network_ready(index)) +
        "<a class=\"connection-edit\" href=\"/mesh/network/link/" + rho_int_to_str(index) +
        "\">Edit connection →</a></div>"
}

fn connection_transport_form(index: u32) string {
    let current: string = node_value(index, "link", "uart")
    return "<form class=\"grid\" method=\"post\" action=\"/mesh/network/link/" +
        rho_int_to_str(index) + "\"><input type=\"hidden\" name=\"action\" value=\"choose_transport\">" +
        "<label>Transport<select name=\"transport\">" + transport_options_for(index) +
        "</select><small>Only transports both boards can serve are offered.</small></label>" +
        "<button type=\"submit\">Use transport</button></form>"
}

fn serial_settings(index: u32) string {
    let prefix: string = "node." + rho_int_to_str(index) + "."
    let link: string = node_value(index, "link", "uart")
    var parent_label: string = "Parent serial port"
    var child_label: string = "Node serial port"
    var child_default: string = "/dev/ttyACM0"
    if link == "uart" {
        child_default = "uart1"
    } else if link == "usb" {
        parent_label = "Parent USB device"
        child_label = "Node USB CDC"
        child_default = "console"
    } else if link == "console" {
        parent_label = "Parent console device"
        child_label = "Node console"
        child_default = "console"
    } else if link == "rs485" {
        parent_label = "Parent RS-485 port"
        child_label = "Node RS-485 port"
    }
    let parent: string = default_value(prefix + "parent_endpoint", default_value("serial_port", "/dev/ttyACM0"))
    let child: string = default_value(prefix + "child_endpoint", child_default)
    let baud: string = default_value(prefix + "baud", "115200")
    let parent_node: string = node_value(index, "parent", "gateway")
    let parent_native: bool = parent_node == "gateway" &&
        default_value("gateway", "native") == "native"
    var parent_control: string = ""
    if parent_native {
        let ports: string = serial_port_options(parent)
        if ports != "" {
            parent_control = mesh_select(prefix + "parent_endpoint", parent_label, ports,
                "Serial devices on this host; choose the one the node is on.")
        }
    }
    if parent_control == "" {
        parent_control = mesh_input(prefix + "parent_endpoint", parent_label, parent,
            "The gateway or relay side of this connection.")
    }
    var fields: string = parent_control +
        mesh_input(prefix + "child_endpoint", child_label, child,
            "The node's side of this connection.") +
        mesh_input(prefix + "baud", "Baud", baud, "")
    if link == "rs485" {
        fields = fields + mesh_input(prefix + "bus_address", "RS-485 address",
            default_value(prefix + "bus_address", ""), "")
    }
    return fields
}

fn wifi_settings(index: u32) string {
    let prefix: string = "node." + rho_int_to_str(index) + "."
    return mesh_input(prefix + "ssid", "WiFi SSID",
        default_value(prefix + "ssid", default_value("ssid", "")), "") +
        mesh_secret(prefix + "password", "WiFi password",
            default_value(prefix + "password", default_value("password", ""))) +
        mesh_input(prefix + "parent_host", "Parent host",
            default_value(prefix + "parent_host", default_value("gateway_host", "127.0.0.1")),
            "The gateway or relay this node dials.") +
        mesh_input(prefix + "child_host", "Node host",
            default_value(prefix + "child_host", ""), "Optional hostname or address for this node.") +
        mesh_input(prefix + "port", "TCP port",
            default_value(prefix + "port", default_value("uplink_port", "5001")), "")
}

fn network_settings(index: u32) string {
    let prefix: string = "node." + rho_int_to_str(index) + "."
    let link: string = node_value(index, "link", "uart")
    if link == "wifi" {
        return wifi_settings(index)
    }
    if link == "uart" || link == "usb" || link == "console" || link == "rs485" {
        return serial_settings(index)
    }
    if link == "spi" || link == "i2c" {
        return mesh_input(prefix + "parent_endpoint", "Parent bus",
            default_value(prefix + "parent_endpoint", ""), "") +
            mesh_input(prefix + "child_endpoint", "Node bus",
                default_value(prefix + "child_endpoint", ""), "") +
            mesh_input(prefix + "bus_address", "Address",
                default_value(prefix + "bus_address", ""), "")
    }
    return mesh_input(prefix + "parent_endpoint", "Parent host / interface",
        default_value(prefix + "parent_endpoint", default_value("gateway_host", "")), "") +
        mesh_input(prefix + "child_endpoint", "Node host / address",
            default_value(prefix + "child_endpoint", ""), "") +
        mesh_input(prefix + "port", "Port", default_value(prefix + "port", ""), "")
}

fn connection_settings_form(index: u32) string {
    return "<form class=\"grid\" method=\"post\" action=\"/mesh/network/link/" +
        rho_int_to_str(index) + "\"><input type=\"hidden\" name=\"action\" value=\"save_settings\">" +
        network_settings(index) + "<button type=\"submit\">Save connection</button></form>"
}

fn mesh_connection_page(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    ensure_wizard_dir()
    if mesh_step_lock("network") != "" {
        return mesh_network_page(req)
    }
    let index: u32 = rho_int_from_str(param(req, "index"))
    if index < 1 || index > node_count() {
        return mesh_network_page(req)
    }
    let parent: string = node_value(index, "parent", "gateway")
    var parent_card: string = "<div class=\"node-card gateway readonly\">" + gateway_network_body() + "</div>"
    if parent != "gateway" {
        let parent_index: u32 = rho_int_from_str(
            rho_str_slice(parent, 5, u32(rho_strlen(parent)) - 5))
        parent_card = "<div class=\"node-card " + node_value(parent_index, "role", "node") +
            " readonly\">" + node_network_body(parent_index) + "</div>"
    }
    let child_card: string = "<div class=\"node-card " + node_value(index, "role", "node") +
        " readonly\">" + node_network_body(index) + "</div>"
    let name: string = node_value(index, "name", "Node " + rho_int_to_str(index))
    let fields: string = "<p>Both ends of this connection:</p>" +
        "<div class=\"connection-cards\">" + parent_card + child_card + "</div>" +
        connection_transport_form(index) + connection_settings_form(index)
    let content: string = template_fill(template_get("wizard-step"),
        vars("title", "Connection to " + name) +
        vars("step", "network") +
        vars("description", "Choose the transport and set the endpoint on each side.") +
        vars("steps", mesh_steps("network")) +
        vars("tree", mesh_network_tree()) +
        vars("notice", status_notice("network") + state_value("message.connection")) +
        vars("fields", fields) +
        vars("actions", "") +
        vars("output", "") +
        vars("nav", "<p class=\"mesh-nav\"><a href=\"/mesh/step/network\">← Network</a></p>"))
    return html(status_ok(), mesh_shell("Connection", content))
}

fn mesh_connection_post(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    ensure_wizard_dir()
    if mesh_step_lock("network") != "" {
        return mesh_network_page(req)
    }
    let index: u32 = rho_int_from_str(param(req, "index"))
    if index < 1 || index > node_count() {
        return mesh_network_page(req)
    }
    let body: string = request_body(req)
    let action: string = form_value(body, "action")
    let prefix: string = "node." + rho_int_to_str(index) + "."
    if action == "choose_transport" {
        let transport: string = form_value(body, "transport")
        if transport != "" {
            save_setting(prefix + "link", transport)
            save_setting("step_network", "pending")
            reset_build_statuses()
            save_setting("step_build", "pending")
            save_setting("step_verify", "pending")
            save_setting("message.connection", "Transport set to " + transport_label(transport) + ".")
        }
        return mesh_connection_page(req)
    }
    if action != "save_settings" {
        return mesh_connection_page(req)
    }
    let link: string = node_value(index, "link", "uart")
    if link == "wifi" {
        save_setting(prefix + "ssid", form_value(body, prefix + "ssid"))
        save_setting(prefix + "password", form_value(body, prefix + "password"))
        save_setting(prefix + "parent_host", form_value(body, prefix + "parent_host"))
        save_setting(prefix + "child_host", form_value(body, prefix + "child_host"))
        save_setting(prefix + "port", form_value(body, prefix + "port"))
    } else if link == "uart" || link == "usb" || link == "rs485" {
        save_setting(prefix + "parent_endpoint", form_value(body, prefix + "parent_endpoint"))
        save_setting(prefix + "child_endpoint", form_value(body, prefix + "child_endpoint"))
        save_setting(prefix + "baud", form_value(body, prefix + "baud"))
        if link == "rs485" {
            save_setting(prefix + "bus_address", form_value(body, prefix + "bus_address"))
        }
    } else if link == "spi" || link == "i2c" {
        save_setting(prefix + "parent_endpoint", form_value(body, prefix + "parent_endpoint"))
        save_setting(prefix + "child_endpoint", form_value(body, prefix + "child_endpoint"))
        save_setting(prefix + "bus_address", form_value(body, prefix + "bus_address"))
    } else {
        save_setting(prefix + "parent_endpoint", form_value(body, prefix + "parent_endpoint"))
        save_setting(prefix + "child_endpoint", form_value(body, prefix + "child_endpoint"))
        save_setting(prefix + "port", form_value(body, prefix + "port"))
    }
    save_setting("step_network", "pending")
    reset_build_statuses()
    save_setting("step_build", "pending")
    save_setting("step_verify", "pending")
    save_setting("message.connection", "Connection saved.")
    info("mesh", "connection " + rho_int_to_str(index) + " saved as " + transport_label(link))
    return mesh_connection_page(req)
}

fn mesh_network_page(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    ensure_wizard_dir()
    let lock: string = mesh_step_lock("network")
    let accepted: bool = default_value("step_network", "pending") == "done"
    var notice: string = ""
    var panel: string = ""
    if lock != "" {
        notice = "<p class=\"notice bad\">" + escape_html(lock) + "</p>"
    } else {
        var ready: u32 = 0
        var index: u32 = 1
        let count: u32 = node_count()
        while index <= count {
            if network_ready(index) {
                ready = ready + 1
            }
            index = index + 1
        }
        panel = "<p>Click a connection badge on the tree to choose its transport and set both ends. " +
            "Click a node card for that node's network settings.</p>" +
            "<dl class=\"settings\"><dt>Connections configured</dt><dd>" +
            rho_int_to_str(ready) + " of " + rho_int_to_str(count) + "</dd></dl>"
        if accepted {
            panel = panel + "<p class=\"notice\">Network accepted.</p>" +
                "<p><a class=\"button\" href=\"/mesh/step/build\">Next: build &amp; program →</a></p>"
        } else if network_all_ready() {
            panel = panel + "<form method=\"post\" action=\"/mesh/network/accept\">" +
                "<button type=\"submit\">Accept network</button></form>"
        } else {
            panel = panel + "<p class=\"notice\">Every connection needs a transport and its endpoints " +
                "before the network can be accepted.</p>"
        }
    }
    let content: string = template_fill(template_get("mesh-network"),
        vars("steps", mesh_steps("network")) +
        vars("tree", mesh_network_tree()) +
        vars("notice", notice) +
        vars("panel", panel) +
        vars("nav", "<p class=\"mesh-nav\"><a href=\"/mesh\">← Plan</a></p>"))
    return html(status_ok(), mesh_shell("Network", content))
}

fn mesh_network_accept(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    if mesh_step_lock("network") != "" {
        return mesh_network_page(req)
    }
    if !network_all_ready() {
        save_setting("message.network", "Every connection needs a transport and its endpoints.")
        return mesh_network_page(req)
    }
    save_setting("step_network", "done")
    save_setting("message.network", "Network accepted.")
    info("mesh", "network accepted")
    reset_build_statuses()
    save_setting("step_build", "pending")
    save_setting("step_verify", "pending")
    return mesh_network_page(req)
}

fn mesh_network_node_page(req: Request) Response {
    if current_project() == "" {
        return mesh_dashboard(req)
    }
    ensure_wizard_dir()
    if mesh_step_lock("network") != "" {
        return mesh_network_page(req)
    }
    let index: u32 = rho_int_from_str(param(req, "index"))
    if index < 1 || index > node_count() {
        return mesh_network_page(req)
    }
    let name: string = node_value(index, "name", "Node " + rho_int_to_str(index))
    var outgoing: string = ""
    var child: u32 = 1
    let count: u32 = node_count()
    while child <= count {
        if node_value(child, "parent", "gateway") == "node." + rho_int_to_str(index) {
            outgoing = outgoing + connection_summary(child)
        }
        child = child + 1
    }
    var outgoing_html: string = "<p><small>This node has no children.</small></p>"
    if outgoing != "" {
        outgoing_html = outgoing
    }
    let fields: string = "<div class=\"node-card " + node_value(index, "role", "node") +
        " readonly\">" + node_network_body(index) + "</div>" +
        "<h3>Incoming connection</h3>" + connection_summary(index) +
        "<h3>Connections to children</h3>" + outgoing_html
    let content: string = template_fill(template_get("wizard-step"),
        vars("title", "Network: " + name) +
        vars("step", "network") +
        vars("description", "The node's connections and the endpoints it serves on them.") +
        vars("steps", mesh_steps("network")) +
        vars("tree", mesh_network_tree()) +
        vars("notice", "") +
        vars("fields", fields) +
        vars("actions", "") +
        vars("output", "") +
        vars("nav", "<p class=\"mesh-nav\"><a href=\"/mesh/step/network\">← Network</a></p>"))
    return html(status_ok(), mesh_shell("Node network", content))
}

fn mesh_gateway_network_form() string {
    let host: string = default_value("gateway_host", "127.0.0.1")
    let rest: string = default_value("rest_port", WIZARD_DEFAULT_REST)
