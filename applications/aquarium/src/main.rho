module aquarium

// The aquarium host. It owns the router and the port; the inventory module
// included here adds its own routes under /expenses.
include "settings"
include "i18n"
include "storage.rho"
include "db/models.rho"
include "db/queries.rho"
include "inventory"
include "scheduler"
include "gateway"
include "widgets"
include "htmx"
include "aquarium.rho"

import std.sql
import std.web.http
import std.web.template
import rho.log

route GET "/" => aquarium_home
route GET "/docs" => aquarium_docs
route GET "/equipment" => equipment_page
route POST "/equipment/add" => equipment_add
route POST "/equipment/state" => equipment_state
route POST "/equipment/value" => equipment_value
route GET "/automation" => automation_page
route POST "/automation/add" => automation_add
route POST "/automation/simulate" => automation_simulate
route GET "/chemistry" => chemistry_page
route POST "/chemistry/add" => chemistry_add
route GET "/modes" => modes_page
route POST "/modes/start" => modes_start
route POST "/modes/stop" => modes_stop
route GET "/events" => events_page
route GET "/settings" => aqua_settings_page
route POST "/settings" => aqua_settings_save

fn aquarium_keeper_link() string {
    return aqua_keeper_link()
}

fn aquarium_docs(req: Request) Response {
    let root: string = getenv("ROBOHUB_WORKSPACE")
    var path: string = "applications/aquarium/docs/index.md"
    if root != "" {
        path = root + "/applications/aquarium/docs/index.md"
    }
    var content: string = "No documentation found."
    if rho_path_exists(path) {
        content = rho_read_text(path)
    }
    let body: string = "<h1>Documentation</h1><pre class=\"docs\">" + escape_html(content) + "</pre>"
    let document: string = template_fill(template_get("layout"),
        vars("title", "Documentation") + vars("htmx", htmx_head()) + i18n_vars(req) + vars("body", body) +
        vars("keeper", aquarium_keeper_link()) +
        vars("notifications", notification_embed()) +
        vars("forms_style", forms_style()))
    return html(status_ok(), document)
}

fn aquarium_home(req: Request) Response {
    let body: string = template_fill(template_get("home"),
        i18n_vars(req) + vars("widgets", widgets_dashboard_cards(true, i18n_locale(req))))
    let document: string = template_fill(template_get("layout"),
        vars("title", "Aquarium") + vars("htmx", htmx_head()) + i18n_vars(req) + vars("body", body) +
        vars("keeper", aquarium_keeper_link()) +
        vars("notifications", notification_embed()) +
        vars("forms_style", forms_style()))
    return html(status_ok(), document)
}
