module aquarium

// The aquarium host. It owns the router and the port; the inventory module
// included here adds its own routes under /expenses.
include "settings"
include "i18n"
include "storage.rho"
include "db/models.rho"
include "db/queries.rho"
include "inventory"
include "scheduler"
include "gateway"
include "widgets"
include "logging"
include "htmx"
include "aquarium.rho"

import std.sql
import std.web.http
import std.web.template
import rho.log

route GET "/" => aquarium_home
route GET "/docs" => aquarium_docs
route GET "/equipment" => equipment_page
route POST "/equipment/add" => equipment_add
route POST "/equipment/state" => equipment_state
route POST "/equipment/value" => equipment_value
route GET "/automation" => automation_page
route POST "/automation/add" => automation_add
route POST "/automation/simulate" => automation_simulate
route GET "/chemistry" => chemistry_page
route POST "/chemistry/add" => chemistry_add
route GET "/modes" => modes_page
route POST "/modes/start" => modes_start
route POST "/modes/stop" => modes_stop
route GET "/events" => events_page
route GET "/settings" => aqua_settings_page
route POST "/settings" => aqua_settings_save

fn aquarium_keeper_link() string {
    return aqua_keeper_link()
}

fn aquarium_docs(req: Request) Response {
    let root: string = getenv("ROBOHUB_WORKSPACE")
    var path: string = "applications/aquarium/docs/index.md"
    if root != "" {
        path = root + "/applications/aquarium/docs/index.md"
    }
    var content: string = "No documentation found."
    if rho_path_exists(path) {
        content = rho_read_text(path)
    }
    let body: string = "<h1>Documentation</h1><pre class=\"docs\">" + escape_html(content) + "</pre>"
    let document: string = template_fill(template_get("layout"),
        vars("title", "Documentation") + vars("htmx", htmx_head()) + i18n_vars(req) + vars("body", body) +
        vars("keeper", aquarium_keeper_link()) +
        vars("notifications", notification_embed()) +
        vars("forms_style", forms_style()) +
        vars("widgets_style", widgets_style()))
    return html(status_ok(), document)
}

fn aqua_port() string {
    var addr: string = getenv("RHO_HTTP_ADDR")
    if addr == "" {
        return "8480"
    }
    var last: i32 = -1
    var i: u32 = 0
    while i < u32(rho_strlen(addr)) {
        if rho_str_eq(rho_str_slice(addr, i, 1), ":") {
            last = i32(i)
        }
        i = i + 1
    }
    if last >= 0 {
        return rho_str_slice(addr, u32(last) + 1,
            u32(rho_strlen(addr)) - u32(last) - 1)
    }
    return addr
}

fn aqua_base_url() string {
    return "http://127.0.0.1:" + aqua_port()
}

fn aquarium_instance_id() string {
    let id: string = settings_get("aquarium.instance_id", "")
    if id == "" {
        return "aquarium-" + aqua_port()
    }
    return id
}

fn aquarium_mesh_register() void {
    let response: string = gateway_register_client("robohub-aquarium",
        aquarium_instance_id(), aqua_base_url() + "/api/aquarium/mesh/events",
        "energy.fault,energy.mode")
    let client_id: string = aqua_json_string_field(response, "client_id")
    let secret: string = aqua_json_string_field(response, "secret")
    if client_id != "" {
        settings_set("aquarium.mesh_client_id", client_id)
        settings_set("aquarium.mesh_secret", secret)
        info("aquarium.mesh", "registered as " + client_id)
    } else {
        warn("aquarium.mesh", "registration did not return a client id")
    }
}

fn aquarium_heartbeat() void {
    let client_id: string = settings_get("aquarium.mesh_client_id", "")
    if client_id != "" {
        ignore_string(gateway_client_heartbeat(client_id))
    }
}

fn aquarium_mesh_event(req: Request) Response {
    let secret: string = settings_get("aquarium.mesh_secret", "")
    let auth: string = header_str(req, "Authorization")
    if secret == "" || !rho_str_eq(auth, "Bearer " + secret) {
        return json(401, "{\"ok\":false,\"error\":\"unauthorized\"}")
    }
    let body: string = request_body(req)
    let topic: string = aqua_json_string_field(body, "topic")
    let payload: string = aqua_json_string_field(body, "payload")
    if topic == "" {
        return json(400, "{\"ok\":false,\"error\":\"topic is required\"}")
    }
    if rho_str_index_of(topic, "energy.fault") == 0 {
        warn("aquarium", "energy fault: " + payload)
        notification_live_event("warning", "Energy: " + payload)
    } else {
        notification_live_event("info", "Mesh " + topic + ": " + payload)
    }
    return json(status_ok(), "{\"ok\":true}")
}

fn init() void {
    log_config_apply("aquarium")
    info("aquarium", "starting")
    aqua_hydrate_gateway_settings()
    aquarium_mesh_register()
}

fn background() void {
    var ticks: u32 = 0
    while true {
        ticks = ticks + 1
        if ticks % 15 == 0 {
            if settings_get("aquarium.mesh_client_id", "") == "" {
                aquarium_mesh_register()
            } else {
                aquarium_heartbeat()
            }
        }
        ignore_u32(rho_exec("sleep", "2", "/dev/null"))
    }
}

fn aquarium_home(req: Request) Response {
    let body: string = template_fill(template_get("home"),
        i18n_vars(req) + vars("widgets", widgets_dashboard_cards(true, i18n_locale(req))))
    let document: string = template_fill(template_get("layout"),
        vars("title", "Aquarium") + vars("htmx", htmx_head()) + i18n_vars(req) + vars("body", body) +
        vars("keeper", aquarium_keeper_link()) +
        vars("notifications", notification_embed()) +
        vars("forms_style", forms_style()) +
        vars("widgets_style", widgets_style()))
    return html(status_ok(), document)
}

route POST "/api/aquarium/mesh/events" => aquarium_mesh_event
