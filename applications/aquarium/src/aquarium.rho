/* -------------------------------------------------------------------------- */
/*  Automation                                                                */
/* -------------------------------------------------------------------------- */

fn automation_page(req: Request) Response {
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if !opened.is_ok {
        return aqua_page(req, "Automation", "<p>The database could not be opened.</p>")
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let rules: AutomationRules[256]
    let slice: Slice[AutomationRules] = Slice[AutomationRules]{
        Ptr[AutomationRules](&rules[0]), AQUA_CAPACITY }
    let listed: Result[u32, SqlError] = ListRules(db, slice, AQUA_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    sql_close(db)
    var rows: string = ""
    var i: u32 = 0
    while i < count {
        let rule: AutomationRules = rules[i]
        let html: string = template_fill(template_get("automation-row"),
            vars("id", rho_int_to_str(u32(rule.id))) +
            vars("name", rule.name) +
            vars("kind", rule.kind) +
            vars("metric", rule.metric) +
            vars("operator", rule.operator) +
            vars("threshold", rule.threshold) +
            vars("state", rule.state))
        rows = rows + html + "\n"
        i = i + 1
    }
    if rows == "" {
        rows = "<tr><td colspan=\"5\">No automation rules.</td></tr>"
    }
    let body: string = template_fill(template_get("automation"),
        vars("rows", rows))
    return aqua_page(req, "Automation", body)
}

fn automation_add(req: Request) Response {
    let body: string = request_body(req)
    let name: string = aqua_trim(aqua_form(body, "name"))
    if rho_strlen(name) == 0 {
        return automation_page(req)
    }
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if opened.is_ok {
        let db: SqlDb = opened.ok
        ignore_u32(sql_apply(db, ""))
        aqua_ignore_result(InsertRule(name, aqua_trim(aqua_form(body, "kind")),
            aqua_trim(aqua_form(body, "metric")), aqua_trim(aqua_form(body, "operator")),
            aqua_trim(aqua_form(body, "threshold")), aqua_trim(aqua_form(body, "action")),
            "1", rho_int_to_str(aqua_now()), db))
        sql_close(db)
    }
    return automation_page(req)
}

fn automation_simulate(req: Request) Response {
    let body: string = request_body(req)
    let id: u32 = rho_int_from_str(aqua_trim(aqua_form(body, "id")))
    let value: string = aqua_trim(aqua_form(body, "value"))
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if !opened.is_ok {
        return automation_page(req)
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let rules: AutomationRules[256]
    let slice: Slice[AutomationRules] = Slice[AutomationRules]{
        Ptr[AutomationRules](&rules[0]), AQUA_CAPACITY }
    let listed: Result[u32, SqlError] = ListRules(db, slice, AQUA_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    var i: u32 = 0
    while i < count {
        if u32(rules[i].id) == id {
            let rule: AutomationRules = rules[i]
            let triggered: bool = aqua_compare(value, rule.operator, rule.threshold)
            var state: string = "normal"
            if triggered {
                state = "triggered"
            }
            aqua_ignore_result(UpdateRule(rule.enabled, state, value, i64(aqua_now()),
                i64(id), db))
            if triggered {
                aqua_ignore_result(InsertEvent("WARNING", rule.kind,
                    rule.name + " triggered at " + value, rho_int_to_str(aqua_now()), db))
            }
        }
        i = i + 1
    }
    sql_close(db)
    return automation_page(req)
}

/* -------------------------------------------------------------------------- */
/*  Chemistry, modes and events                                               */
/* -------------------------------------------------------------------------- */

fn chemistry_page(req: Request) Response {
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if !opened.is_ok {
        return aqua_page(req, "Chemistry", "<p>The database could not be opened.</p>")
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let tests: WaterTests[256]
    let slice: Slice[WaterTests] = Slice[WaterTests]{ Ptr[WaterTests](&tests[0]), AQUA_CAPACITY }
    let listed: Result[u32, SqlError] = ListTests(db, slice, AQUA_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    sql_close(db)
    var rows: string = ""
    var i: u32 = 0
    while i < count {
        let test: WaterTests = tests[i]
        let html: string = template_fill(template_get("chemistry-row"),
            vars("parameter", test.parameter) +
            vars("value", test.value) +
            vars("unit", test.unit) +
            vars("tested_at", test.testedAt) +
            vars("note", test.note))
        rows = rows + html + "\n"
        i = i + 1
    }
    if rows == "" {
        rows = "<tr><td colspan=\"4\">No water tests recorded.</td></tr>"
    }
    let today: string = aqua_date(aqua_now())
    let body: string = template_fill(template_get("chemistry"),
        vars("rows", rows) + vars("today", today))
    return aqua_page(req, "Chemistry", body)
}

fn chemistry_add(req: Request) Response {
    let body: string = request_body(req)
    let parameter: string = aqua_trim(aqua_form(body, "parameter"))
    if rho_strlen(parameter) == 0 {
        return chemistry_page(req)
    }
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if opened.is_ok {
        let db: SqlDb = opened.ok
        ignore_u32(sql_apply(db, ""))
        aqua_ignore_result(InsertTest(parameter, aqua_trim(aqua_form(body, "value")),
            aqua_trim(aqua_form(body, "unit")), aqua_trim(aqua_form(body, "tested_at")),
            aqua_trim(aqua_form(body, "note")), db))
        sql_close(db)
    }
    return chemistry_page(req)
}

fn modes_page(req: Request) Response {
    let now: u32 = aqua_now()
    let body: string = template_fill(template_get("modes"),
        vars("now", aqua_date(now)))
    return aqua_page(req, "Modes", body)
}

fn modes_start(req: Request) Response {
    let body: string = request_body(req)
    let name: string = aqua_trim(aqua_form(body, "name"))
    var minutes: u32 = rho_int_from_str(aqua_trim(aqua_form(body, "minutes")))
    if minutes == 0 {
        minutes = 30
    }
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if opened.is_ok {
        let db: SqlDb = opened.ok
        ignore_u32(sql_apply(db, ""))
        aqua_ignore_result(SetMode(name, rho_int_to_str(aqua_now() + minutes * 60),
            aqua_trim(aqua_form(body, "note")), db))
        aqua_ignore_result(InsertEvent("INFO", "mode",
            name + " started for " + rho_int_to_str(minutes) + " minutes",
            rho_int_to_str(aqua_now()), db))
        sql_close(db)
    }
    return modes_page(req)
}

fn modes_stop(req: Request) Response {
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if opened.is_ok {
        let db: SqlDb = opened.ok
        ignore_u32(sql_apply(db, ""))
        aqua_ignore_result(SetMode("water_change", "0", "", db))
        aqua_ignore_result(SetMode("feeding", "0", "", db))
        aqua_ignore_result(InsertEvent("INFO", "mode", "normal operation resumed",
            rho_int_to_str(aqua_now()), db))
        sql_close(db)
    }
    return modes_page(req)
}

fn events_page(req: Request) Response {
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if !opened.is_ok {
        return aqua_page(req, "Events", "<p>The database could not be opened.</p>")
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let events: SystemEvents[256]
    let slice: Slice[SystemEvents] = Slice[SystemEvents]{
        Ptr[SystemEvents](&events[0]), AQUA_CAPACITY }
    let listed: Result[u32, SqlError] = ListEvents(db, slice, AQUA_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    sql_close(db)
    var rows: string = ""
    var i: u32 = 0
    while i < count {
        let event: SystemEvents = events[i]
        let html: string = template_fill(template_get("events-row"),
            vars("date", aqua_date(u32(event.createdEpoch))) +
            vars("severity", event.severity) +
            vars("kind", event.kind) +
            vars("message", event.message))
        rows = rows + html + "\n"
        i = i + 1
    }
    if rows == "" {
        rows = "<tr><td colspan=\"4\">No events recorded.</td></tr>"
    }
    let body: string = template_fill(template_get("events"),
        vars("rows", rows))
    return aqua_page(req, "Events", body)
}
