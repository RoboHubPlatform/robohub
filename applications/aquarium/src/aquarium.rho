module aquarium

// The aquarium domain: equipment, automation rules, chemistry, operational
// modes and the audit trail.
//
// There is no hardware binding yet. A device has a state and a last value; a
// rule is evaluated against a value fed in from the page or an API. The same
// tables and rules can be driven by a node later without changing the UI.

import std.core.ptr
import std.core.result
import std.core.slice
import std.sql
import std.web.http
import std.web.template

const AQUA_CAPACITY: u32 = 256

fn aqua_trim(text: string) string {
    var out: string = text
    while rho_strlen(out) > 0 &&
        (rho_str_eq(rho_str_slice(out, 0, 1), " ") || rho_str_eq(rho_str_slice(out, 0, 1), "\n")) {
        out = rho_str_slice(out, 1, u32(rho_strlen(out)) - 1)
    }
    while rho_strlen(out) > 0 &&
        (rho_str_eq(rho_str_slice(out, u32(rho_strlen(out)) - 1, 1), " ") ||
         rho_str_eq(rho_str_slice(out, u32(rho_strlen(out)) - 1, 1), "\n")) {
        out = rho_str_slice(out, 0, u32(rho_strlen(out)) - 1)
    }
    return out
}

fn aqua_form(body: string, name: string) string {
    var rest: string = body + "&"
    while rho_strlen(rest) > 0 {
        let amp: i32 = rho_str_index_of(rest, "&")
        if amp < 0 {
            break
        }
        let pair: string = rho_str_slice(rest, 0, u32(amp))
        rest = rho_str_slice(rest, u32(amp) + 1, u32(rho_strlen(rest)) - u32(amp) - 1)
        let equals: i32 = rho_str_index_of(pair, "=")
        if equals < 0 {
            continue
        }
        if rho_str_eq(rho_str_slice(pair, 0, u32(equals)), name) {
            return aqua_decode(rho_str_slice(pair, u32(equals) + 1,
                u32(rho_strlen(pair)) - u32(equals) - 1))
        }
    }
    return ""
}

fn aqua_decode(value: string) string {
    var out: string = ""
    var i: u32 = 0
    let length: u32 = u32(rho_strlen(value))
    while i < length {
        let ch: string = rho_str_slice(value, i, 1)
        if rho_str_eq(ch, "+") {
            out = out + " "
            i = i + 1
        } else if rho_str_eq(ch, "%") && i + 2 < length {
            let high: u32 = aqua_hex(rho_str_slice(value, i + 1, 1))
            let low: u32 = aqua_hex(rho_str_slice(value, i + 2, 1))
            out = out + rho_str_from_byte(u8(high * 16 + low))
            i = i + 3
        } else {
            out = out + ch
            i = i + 1
        }
    }
    return out
}

fn aqua_hex(ch: string) u32 {
    let digits: string = "0123456789abcdef"
    let upper: string = "0123456789ABCDEF"
    var i: u32 = 0
    while i < 16 {
        if rho_str_eq(ch, rho_str_slice(digits, i, 1)) ||
            rho_str_eq(ch, rho_str_slice(upper, i, 1)) {
            return i
        }
        i = i + 1
    }
    return 0
}

fn aqua_setting_file(key: string) string {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/aquarium"
    }
    let dir: string = workspace + "/data"
    ignore_u32(rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt"))
    return dir + "/" + key
}

fn aqua_setting_key(key: string) string {
    if rho_str_eq(key, "mesh_url") { return "gateway.url" }
    if rho_str_eq(key, "mesh_project") { return "gateway.project" }
    if rho_str_eq(key, "mesh_token") { return "gateway.token" }
    if rho_str_eq(key, "gateway_url") { return "gateway.resolved" }
    return "gateway." + key
}

fn aqua_setting(key: string) string {
    let mapped: string = aqua_setting_key(key)
    let value: string = settings_get(mapped, "")
    if value != "" {
        return value
    }
    // Older installs kept one file per key; read it once so an upgrade keeps
    // the values a person already set.
    let legacy: string = aqua_trim(rho_read_text(aqua_setting_file(key)))
    if legacy != "" {
        return legacy
    }
    // The gateway's own settings are the last word on the connection: the
    // binding's defaults, or what this page saved into them.
    if rho_str_eq(key, "mesh_url") {
        return gateway.config("url")
    }
    if rho_str_eq(key, "mesh_project") {
        return gateway.config("project")
    }
    if rho_str_eq(key, "mesh_token") {
        return gateway.token()
    }
    return ""
}

fn aqua_hydrate_gateway_settings() void {
    let url: string = gateway.config("url")
    let project: string = gateway.config("project")
    let token: string = gateway.token()
    if url != "" && settings_get("gateway.url", "") == "" {
        settings_set("gateway.url", url)
    }
    if project != "" && settings_get("gateway.project", "") == "" {
        settings_set("gateway.project", project)
    }
    if token != "" && settings_get("gateway.token", "") == "" {
        settings_set("gateway.token", token)
    }
}

fn aqua_setting_set(key: string, value: string) void {
    settings_set(aqua_setting_key(key), aqua_trim(value))
}

fn aqua_json_string_field(text: string, key: string) string {
    let at: i32 = rho_str_index_of(text, "\"" + key + "\":\"")
    if at < 0 {
        return ""
    }
    let start: u32 = u32(at) + u32(rho_strlen(key)) + 4
    let rest: string = rho_str_slice(text, start, u32(rho_strlen(text)) - start)
    let end: i32 = rho_str_index_of(rest, "\"")
    if end < 0 {
        return ""
    }
    return rho_str_slice(rest, 0, u32(end))
}

fn aqua_curl(url: string, report_name: string) string {
    let report: string = aqua_setting_file(report_name)
    let code: u32 = rho_exec("curl", "-fsS -m 3 " + url, report)
    if code != 0 {
        return ""
    }
    return rho_read_text(report)
}

// The gateway is the provider this application binds. The settings this page
// keeps are the provider's own — Mesh's address and the project — written into
// the binding's settings for this installation.
fn aqua_write_gateway_conf() void {
    let url: string = aqua_setting("mesh_url")
    let project: string = aqua_setting("mesh_project")
    // No token is kept: the provider asks for a short-lived service token for
    // Mesh with the credential keeper gave this application.
    if url != "" && !rho_str_eq(url, gateway.config("url")) {
        ignore_bool(gateway.configure("url", url))
    }
    if project != "" && !rho_str_eq(project, gateway.config("project")) {
        ignore_bool(gateway.configure("project", project))
    }
}

fn aqua_ensure_gateway_conf() void {
    aqua_write_gateway_conf()
}

fn aqua_refresh_gateway() string {
    aqua_ensure_gateway_conf()
    let resolved: string = gateway.gateway()
    if resolved != "" {
        ignore_bool(rho_write_text(aqua_setting_file("gateway_url"), resolved))
        return resolved
    }
    return aqua_setting("gateway_url")
}

fn aqua_gateway_project_choices() string {
    var out: string = ""
    let text: string = gateway.projects()
    if text == "" {
        return out
    }
    var rest: string = text
    while rho_strlen(rest) > 0 {
        let at: i32 = rho_str_index_of(rest, "},{")
        var object: string = ""
        if at < 0 {
            object = rest
            rest = ""
        } else {
            object = rho_str_slice(rest, 0, u32(at) + 1)
            rest = rho_str_slice(rest, u32(at) + 3, u32(rho_strlen(rest)) - u32(at) - 3)
        }
        let id: string = aqua_json_string_field(object, "id")
        let name: string = aqua_json_string_field(object, "name")
        if id == "" {
            continue
        }
        if name == "" {
            name = id
        }
        if out != "" {
            out = out + ","
        }
        out = out + id + "|" + name
    }
    return out
}

fn aqua_settings_tab(req: Request) string {
    let tab: string = request_query_param(req, "tab")
    if tab == "" { return "general" }
    if rho_str_eq(tab, "general") || rho_str_eq(tab, "inventory") ||
        rho_str_eq(tab, "scheduler") || rho_str_eq(tab, "widgets") ||
        rho_str_eq(tab, "logging") || rho_str_eq(tab, "configuration") {
        return tab
    }
    return "gateway"
}

fn aqua_settings_nav(req: Request, active: string) string {
    var out: string = "<nav class=\"settings-tabs\">"
    let ids: string = "general,gateway,inventory,scheduler,widgets,logging,configuration"
    let keys: string = "settings.tab.general,settings.tab.gateway,settings.tab.inventory,settings.tab.scheduler,settings.tab.widgets,settings.tab.logging,settings.tab.configuration"
    while ids != "" {
        let id_at: i32 = rho_str_index_of(ids, ",")
        let key_at: i32 = rho_str_index_of(keys, ",")
        var id: string = ids
        var key: string = keys
        if id_at < 0 { ids = "" } else {
            id = rho_str_slice(ids, 0, u32(id_at))
            ids = rho_str_slice(ids, u32(id_at) + 1, u32(rho_strlen(ids)) - u32(id_at) - 1)
        }
        if key_at < 0 { keys = "" } else {
            key = rho_str_slice(keys, 0, u32(key_at))
            keys = rho_str_slice(keys, u32(key_at) + 1, u32(rho_strlen(keys)) - u32(key_at) - 1)
        }
        var css: string = ""
        if rho_str_eq(id, active) { css = " class=\"active\"" }
        out = out + "<a href=\"/settings?tab=" + id + "\"" + css + ">" + i18n_t(req, key) + "</a>"
    }
    return out + "</nav>"
}

fn aqua_settings_form(req: Request, tab: string) string {
    if rho_str_eq(tab, "logging") {
        return log_settings_form("aquarium", "/settings?tab=logging",
            i18n_locale(req))
    }
    if rho_str_eq(tab, "general") {
        var fields: FormField[1]
        fields[0] = FormField{ "tabs", "select", i18n_t(req, "settings.orientation"), "",
            "", false, "", "vertical|" + i18n_t(req, "settings.orientation.vertical") +
            ",horizontal|" + i18n_t(req, "settings.orientation.horizontal"),
            settings_get("ui.tabs", "vertical"), "", "" }
        return forms_open(fields, 1, "/settings?tab=general",
            i18n_t(req, "settings.save"), i18n_locale(req))
    }
    if rho_str_eq(tab, "inventory") {
        var fields: FormField[4]
        fields[0] = FormField{ "currency", "select", i18n_t(req, "settings.inventory.currency"), "",
            "", false, "", "RON|RON,EUR|EUR,USD|USD",
            settings_get("inventory.currency", "RON"), "", "" }
        fields[1] = FormField{ "default_unit", "text", i18n_t(req, "settings.inventory.unit"), "",
            "unit, kg, L", false, "", "", settings_get("inventory.default_unit", ""), "", "" }
        fields[2] = FormField{ "decimals", "select", i18n_t(req, "settings.inventory.decimals"), "",
            "", false, "", "0|0,1|0.1,2|0.01,3|0.001",
            settings_get("inventory.decimals", "2"), "", "" }
        fields[3] = FormField{ "reorder", "text", i18n_t(req, "settings.inventory.reorder"), "",
            "0", false, "", "", settings_get("inventory.reorder", "0"), "", "decimal" }
        return forms_open(fields, 4, "/settings?tab=inventory",
            i18n_t(req, "settings.save"), i18n_locale(req))
    }
    if rho_str_eq(tab, "scheduler") {
        var fields: FormField[3]
        fields[0] = FormField{ "timezone", "text", i18n_t(req, "settings.scheduler.timezone"), "",
            "Europe/Bucharest", false, "", "",
            settings_get("scheduler.timezone", "Europe/Bucharest"), "", "" }
        fields[1] = FormField{ "priority", "text", i18n_t(req, "settings.scheduler.priority"), "",
            "normal", false, "", "", settings_get("scheduler.priority", "normal"), "", "" }
        fields[2] = FormField{ "grace_hours", "text", i18n_t(req, "settings.scheduler.grace"), "",
            "12", false, "", "", settings_get("scheduler.grace_hours", "12"), "", "numeric" }
        return forms_open(fields, 3, "/settings?tab=scheduler",
            i18n_t(req, "settings.save"), i18n_locale(req))
    }
    if rho_str_eq(tab, "widgets") {
        var fields: FormField[3]
        fields[0] = FormField{ "refresh_seconds", "text", i18n_t(req, "settings.widgets.refresh"), "",
            "10", false, "", "", settings_get("widgets.refresh_seconds", "10"), "", "numeric" }
        fields[1] = FormField{ "decimals", "select", i18n_t(req, "settings.widgets.decimals"), "",
            "", false, "", "0|0,1|0.1,2|0.01,3|0.001",
            settings_get("widgets.decimals", "2"), "", "" }
        fields[2] = FormField{ "points", "text", i18n_t(req, "settings.widgets.points"), "",
            "24", false, "", "", settings_get("widgets.points", "24"), "", "numeric" }
        return forms_open(fields, 3, "/settings?tab=widgets",
            i18n_t(req, "settings.save"), i18n_locale(req))
    }
    if rho_str_eq(tab, "configuration") {
        let url: string = aqua_setting("mesh_url")
        let project: string = aqua_setting("mesh_project")
        let resolved: string = aqua_refresh_gateway()
        return "<dl class=\"settings\"><dt>Application</dt><dd>aquarium</dd>" +
            "<dt>Route</dt><dd>/</dd><dt>Port</dt><dd>8480</dd>" +
            "<dt>Gateway provider</dt><dd>" + escape_html(gateway.provider()) + "</dd>" +
            "<dt>Gateway URL</dt><dd>" + escape_html(url) + "</dd>" +
            "<dt>Gateway project</dt><dd>" + escape_html(project) + "</dd>" +
            "<dt>Resolved gateway</dt><dd>" + escape_html(resolved) + "</dd>" +
            "<dt>Modules</dt><dd>inventory, scheduler, widgets</dd></dl>"
    }
    var fields: FormField[3]
    fields[0] = FormField{ "mesh_url", "text",
        i18n_t(req, "settings.url"), i18n_t(req, "settings.url_hint"),
        "http://127.0.0.1:8478", false, "url", "", aqua_setting("mesh_url"), "", "" }
    fields[1] = FormField{ "mesh_project", "select",
        i18n_t(req, "settings.project"), i18n_t(req, "settings.project_hint"),
        i18n_t(req, "settings.project_prompt"), false, "",
        aqua_gateway_project_choices(), aqua_setting("mesh_project"), "", "" }
    fields[2] = FormField{ "mesh_token", "password",
        i18n_t(req, "settings.token"), i18n_t(req, "settings.token_hint"),
        "", false, "", "", aqua_setting("mesh_token"), "", "" }
    var form: string = forms_open(fields, 3, "/settings?tab=gateway",
        i18n_t(req, "settings.save"), i18n_locale(req))
    var link: string = ""
    let mesh_url: string = aqua_setting("mesh_url")
    let mesh_project: string = aqua_setting("mesh_project")
    if mesh_url != "" && mesh_project != "" {
        var base: string = mesh_url
        while rho_strlen(base) > 0 && rho_str_eq(rho_str_slice(base,
                u32(rho_strlen(base)) - 1, 1), "/") {
            base = rho_str_slice(base, 0, u32(rho_strlen(base)) - 1)
        }
        link = "<p class=\"live-meta\">Generate or copy this application's per-project token in <a href=\"" +
            escape_html(base + "/mesh/project/" + mesh_project + "/settings") +
            "\" target=\"_blank\" rel=\"noopener\">Mesh project settings</a>.</p>"
    }
    if aqua_setting("mesh_token") == "" {
        return link + "<p class=\"notice\">A Mesh token is required before the project list can load. Generate one in Mesh project settings.</p>" + form
    }
    return link + form
}

fn aqua_settings_page_message(req: Request, message: string) Response {
    let tab: string = aqua_settings_tab(req)
    var notice: string = ""
    if message != "" {
        notice = "<p class=\"notice\">" + escape_html(message) + "</p>"
    }
    aqua_ensure_gateway_conf()
    let body: string = template_fill(template_get("settings"),
        i18n_vars(req) +
        vars("notice", notice) +
        vars("nav", aqua_settings_nav(req, tab)) +
        vars("tab_content", aqua_settings_form(req, tab)))
    return aqua_page(req, "Settings", body)
}

fn aqua_settings_page(req: Request) Response {
    return aqua_settings_page_message(req, "")
}

fn aqua_settings_save(req: Request) Response {
    let body: string = request_body(req)
    let tab: string = aqua_settings_tab(req)
    if !forms_csrf_ok(body) {
        return aqua_settings_page_message(req, i18n_t(req, "settings.csrf_refused"))
    }
    if rho_str_eq(tab, "general") {
        settings_set("ui.tabs", aqua_trim(aqua_form(body, "tabs")))
        return redirect("/settings?tab=general")
    }
    if rho_str_eq(tab, "inventory") {
        settings_set("inventory.currency", aqua_trim(aqua_form(body, "currency")))
        settings_set("inventory.default_unit", aqua_trim(aqua_form(body, "default_unit")))
        settings_set("inventory.decimals", aqua_trim(aqua_form(body, "decimals")))
        settings_set("inventory.reorder", aqua_trim(aqua_form(body, "reorder")))
        return redirect("/settings?tab=inventory")
    }
    if rho_str_eq(tab, "scheduler") {
        settings_set("scheduler.timezone", aqua_trim(aqua_form(body, "timezone")))
        settings_set("scheduler.priority", aqua_trim(aqua_form(body, "priority")))
        settings_set("scheduler.grace_hours", aqua_trim(aqua_form(body, "grace_hours")))
        return redirect("/settings?tab=scheduler")
    }
    if rho_str_eq(tab, "widgets") {
        settings_set("widgets.refresh_seconds", aqua_trim(aqua_form(body, "refresh_seconds")))
        settings_set("widgets.decimals", aqua_trim(aqua_form(body, "decimals")))
        settings_set("widgets.points", aqua_trim(aqua_form(body, "points")))
        return redirect("/settings?tab=widgets")
    }
    if rho_str_eq(tab, "logging") {
        if log_settings_save("aquarium", body) {
            info("aquarium", "logging settings updated")
        }
        return redirect("/settings?tab=logging")
    }
    aqua_setting_set("mesh_url", aqua_form(body, "mesh_url"))
    aqua_setting_set("mesh_project", aqua_form(body, "mesh_project"))
    let posted_token: string = aqua_form(body, "mesh_token")
    if posted_token == "" {
        posted_token = aqua_setting("mesh_token")
    }
    aqua_setting_set("mesh_token", posted_token)
    aqua_write_gateway_conf()
    ignore_string(aqua_refresh_gateway())
    aquarium_mesh_register()
    return redirect("/settings?tab=gateway")
}

fn aqua_db_path() string {
    let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/aquarium"
    }
    let dir: string = workspace + "/data"
    ignore_u32(rho_exec("mkdir", "-p " + dir, dir + "/mkdir.txt"))
    return dir + "/app.db"
}

fn aqua_now() u32 {
    let report: string = aqua_db_path() + ".now"
    if rho_exec("date", "+%s", report) == 0 {
        return rho_int_from_str(aqua_trim(rho_read_text(report)))
    }
    return 0
}

fn aqua_date(epoch: u32) string {
    if epoch == 0 {
        return ""
    }
    let report: string = aqua_db_path() + ".date"
    if rho_exec("date", "-d @" + rho_int_to_str(epoch) + " \"+%Y-%m-%d %H:%M\"", report) == 0 {
        return aqua_trim(rho_read_text(report))
    }
    return ""
}

fn aqua_parse_milli(text: string) i64 {
    var value: string = aqua_trim(text)
    var sign: i64 = 1
    if rho_strlen(value) > 0 && rho_str_eq(rho_str_slice(value, 0, 1), "-") {
        sign = -1
        value = rho_str_slice(value, 1, u32(rho_strlen(value)) - 1)
    }
    var whole: string = value
    var fraction: string = ""
    let dot: i32 = rho_str_index_of(value, ".")
    if dot >= 0 {
        whole = rho_str_slice(value, 0, u32(dot))
        fraction = rho_str_slice(value, u32(dot) + 1,
            u32(rho_strlen(value)) - u32(dot) - 1)
    }
    if rho_strlen(whole) == 0 {
        whole = "0"
    }
    var frac: i64 = 0
    var i: u32 = 0
    while i < 3 {
        if i < u32(rho_strlen(fraction)) {
            frac = frac * 10 + i64(rho_int_from_str(rho_str_slice(fraction, i, 1)))
        } else {
            frac = frac * 10
        }
        i = i + 1
    }
    return sign * (i64(rho_int_from_str(whole)) * 1000 + frac)
}

fn aqua_compare(value: string, operator: string, threshold: string) bool {
    let left: i64 = aqua_parse_milli(value)
    let right: i64 = aqua_parse_milli(threshold)
    if rho_str_eq(operator, "<") {
        return left < right
    }
    if rho_str_eq(operator, "<=") {
        return left <= right
    }
    if rho_str_eq(operator, ">") {
        return left > right
    }
    if rho_str_eq(operator, ">=") {
        return left >= right
    }
    return left == right
}

fn aqua_alert(level: string, message: string) void {
    // The audit trail is always written. A notification hub is optional: the
    // aquarium's plugins list is what turns an event into an e-mail or a chat.
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if opened.is_ok {
        let db: SqlDb = opened.ok
        ignore_u32(sql_apply(db, ""))
        aqua_ignore_result(InsertEvent(level, "automation", message,
            rho_int_to_str(aqua_now()), db))
        sql_close(db)
    }
}

fn aqua_ignore_result(value: Result[u32, SqlError]) void {
}

fn aqua_keeper_link() string {
    var port: string = getenv("RHO_KEEPER_PORT")
    if port == "" {
        // A keeper-hosted workspace is under the keeper's state; a missing
        // environment variable there is a configuration omission, not a
        // standalone run, so the default keeper port is the useful link.
        let workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
        if rho_str_index_of(workspace, "/.rho/keeper/workspaces/") >= 0 {
            port = "19090"
        }
    }
    if port == "" {
        return ""
    }
    return "<a class=\"keeper\" href=\"#\" data-keeper-port=\"" + escape_html(port) +
        "\"><span aria-hidden=\"true\">↑</span> Keeper</a>"
}

fn aqua_page(req: Request, title: string, body: string) Response {
    let document: string = template_fill(template_get("layout"),
        vars("title", title) + vars("htmx", htmx_head()) + i18n_vars(req) + vars("body", body) + vars("keeper", aqua_keeper_link()) +
        vars("notifications", notification_embed()) + vars("forms_style", forms_style()) + vars("widgets_style", widgets_style()))
    return html(status_ok(), document)
}

/* -------------------------------------------------------------------------- */
/*  Equipment                                                                 */
/* -------------------------------------------------------------------------- */

fn host_shell(req: Request, title: string, body: string, scripts: string) Response {
    return aqua_page(req, title, body + scripts)
}

fn equipment_page(req: Request) Response {
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if !opened.is_ok {
        return aqua_page(req, "Equipment", "<p>The database could not be opened.</p>")
    }
    let db: SqlDb = opened.ok
    ignore_u32(sql_apply(db, ""))
    let devices: Devices[256]
    let slice: Slice[Devices] = Slice[Devices]{ Ptr[Devices](&devices[0]), AQUA_CAPACITY }
    let listed: Result[u32, SqlError] = ListDevices(db, slice, AQUA_CAPACITY)
    var count: u32 = 0
    if listed.is_ok {
        count = listed.ok
    }
    sql_close(db)
    var rows: string = ""
    var i: u32 = 0
    while i < count {
        let device: Devices = devices[i]
        let html: string = template_fill(template_get("equipment-row"),
            vars("id", rho_int_to_str(u32(device.id))) +
            vars("name", device.name) +
            vars("kind", device.kind) +
            vars("state", device.state) +
            vars("last_value", device.lastValue))
        rows = rows + html + "\n"
        i = i + 1
    }
    if rows == "" {
        rows = "<tr><td colspan=\"5\">No equipment defined.</td></tr>"
    }
    let body: string = template_fill(template_get("equipment"),
        vars("rows", rows))
    return aqua_page(req, "Equipment", body)
}

fn equipment_add(req: Request) Response {
    let body: string = request_body(req)
    let name: string = aqua_trim(aqua_form(body, "name"))
    if rho_strlen(name) == 0 {
        return equipment_page(req)
    }
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if opened.is_ok {
        let db: SqlDb = opened.ok
