//
// @file bus.rho
// @brief The message bus interface: publish, follow, and the newest message of a topic, through the bound broker.
//
// @module robohub.bus
// @project robohub-bus
// @author Aurel Miron
// @date 2026-11-13
//
// SPDX-License-Identifier: MIT
