module robohub.alert

// The alert interface.
//
// An application raises an alert; every channel it binds receives it, unless the
// channel is disabled or the alert is below the channel's severity threshold.
// The calls to the channels — send_to, bound_providers, bind_config — are
// generated from the application's binding.

include "rule.rho"

extern fn rho_str_index_of(s: string, needle: string) i32

// raise delivers an alert and answers how many channels accepted it.
fn raise(level: string, message: string, metadata: string) u32 {
    var sent: u32 = 0
    var rest: string = bound_providers()
    while rest != "" {
        let at: i32 = str_index_of(rest, "\n")
        let provider: string = str_slice(rest, 0, u32(at))
        rest = str_slice(rest, u32(at) + 1, strlen(rest) - u32(at) - 1)
        if enabled(provider) && severity_passes(level, bind_config(provider, "severity_threshold")) {
            sent = sent + send_to(provider, level, message, metadata)
        }
    }
    return sent
}

// test sends a message through one channel, whatever its settings, so a
// settings page can show that the channel works.
fn test(provider: string, message: string) u32 {
    return send_to(provider, "INFO", message, "test")
}

// providers are the channels the application binds, one per line.
fn providers() string {
    return bound_providers()
}

// enabled is whether a channel receives alerts: unless its `enabled` setting
// says false.
fn enabled(provider: string) bool {
    return bind_config(provider, "enabled") != "false"
}

// config is one of a channel's settings; configure changes it on the running
// installation.
fn config(provider: string, key: string) string {
    return bind_config(provider, key)
}

fn configure(provider: string, key: string, value: string) bool {
    return bind_config_set(provider, key, value)
}

// severity_rank orders the levels; a level is read in any case, so a rule that
// raises "warning" passes a channel that wants WARNING.
fn severity_rank(raw: string) u32 {
    let level: string = str_upper(str_trim(raw))
    if level == "CRITICAL" {
        return 3
    }
    if level == "ERROR" {
        return 2
    }
    if level == "WARNING" {
        return 1
    }
    return 0
}

fn severity_passes(level: string, threshold: string) bool {
    if threshold == "" {
        return true
    }
    return severity_rank(level) >= severity_rank(threshold)
}
